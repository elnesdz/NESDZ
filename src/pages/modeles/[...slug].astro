---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const slugify = (input) =>
  String(input)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

export async function getStaticPaths() {
  const entries = await getCollection("models");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const d = entry.data;

const editorialStatusLabels = {
  "en-cours": "Fiche en cours",
  enrichie: "Fiche enrichie",
  "a-completer": "Données à compléter",
};

const editorialStatusLabel = d.editorialStatus
  ? editorialStatusLabels[d.editorialStatus] ?? null
  : null;

const spec = [
  ["Catégorie", d.category],
  ["Constructeur", d.manufacturer ?? "—"],
  ["Places", String(d.seats)],
  ["Moteur", d.engine ?? "—"],
  ["Masse à vide (kg)", d.emptyWeightKg ? String(d.emptyWeightKg) : "—"],
  ["MTOW / masse max (kg)", d.mtowKg ? String(d.mtowKg) : "—"],
  ["Vitesse de croisière (km/h)", d.cruiseKmh ? String(d.cruiseKmh) : "—"],
  ["Vitesse de décrochage (km/h)", d.stallKmh ? String(d.stallKmh) : "—"],
  ["VSO (km/h)", d.vsoKmh ? String(d.vsoKmh) : "—"],
  ["VNE (km/h)", d.vneKmh ? String(d.vneKmh) : "—"],
  ["Autonomie (km)", d.rangeKm ? String(d.rangeKm) : "—"],
  ["Facteur de charge +G", d.limitLoadPositiveG ? String(d.limitLoadPositiveG) : "—"],
  ["Facteur de charge -G", d.limitLoadNegativeG ? String(d.limitLoadNegativeG) : "—"],
  ["Année", d.year ? String(d.year) : "—"],
  ["Pays", d.country ?? "—"],
];

const youtubeId = d.youtube?.url
  ? (() => {
      try {
        const u = new URL(d.youtube.url);
        if (u.hostname.includes("youtu.be")) return u.pathname.slice(1);
        if (u.searchParams.get("v")) return u.searchParams.get("v");
        const m = u.pathname.match(/\/embed\/([^/?]+)/);
        return m?.[1] ?? null;
      } catch {
        return null;
      }
    })()
  : null;

const youtubeSearchQuery =
  d.youtubeSearchQuery ?? `${d.manufacturer ?? "ULM"} ${d.name} essai en vol`;
const youtubeSearchUrl = `https://www.youtube.com/results?search_query=${encodeURIComponent(youtubeSearchQuery)}`;

// URL absolue du site
const SITE = "https://nesdz.com";
const canonicalUrl = `${SITE}/modeles/${entry.slug}/`;

// --- JSON-LD BreadcrumbList (SEO)
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Accueil",
      item: `${SITE}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Modèles",
      item: `${SITE}/modeles/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: d.name,
      item: canonicalUrl,
    },
  ],
};

// --- Articles liés (tags modèle ↔ tags articles)
const articles = (await getCollection("articles")).filter((a) => !a.data.draft);
const modelTagSlugs = new Set((d.tags ?? []).map((t) => slugify(t)).filter(Boolean));

const relatedArticles = articles
  .map((a) => {
    const articleTagSlugs = (a.data.tags ?? []).map((t) => slugify(t)).filter(Boolean);
    const score = articleTagSlugs.filter((s) => modelTagSlugs.has(s)).length;
    const freshness = (a.data.updated ?? a.data.date).valueOf();
    return { a, score, freshness };
  })
  .filter((x) => x.score > 0)
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.freshness - a.freshness ||
      a.a.data.title.localeCompare(b.a.data.title, "fr", { sensitivity: "base" })
  )
  .slice(0, 4)
  .map((x) => x.a);

// --- Précédent / Suivant (ordre alphabétique par nom)
const modelsAll = (await getCollection("models")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, "fr", { sensitivity: "base" })
);

const currentIndex = modelsAll.findIndex((m) => m.slug === entry.slug);

const prevModel = currentIndex > 0 ? modelsAll[currentIndex - 1] : null;
const nextModel =
  currentIndex >= 0 && currentIndex < modelsAll.length - 1
    ? modelsAll[currentIndex + 1]
    : null;
---

<BaseLayout
  title={d.name}
  description={`Fiche ULM : ${d.name} — specs, liens et vidéo.`}
  image={d.heroImage}
  canonical={canonicalUrl}
>
  <article class="container" style="padding: 28px 0 26px;">
    <div class="card">
      <div class="pad">
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbJsonLd)}
        ></script>

        <nav
          class="meta"
          aria-label="Fil d’Ariane"
          style="margin:0 0 10px; flex-wrap:wrap;"
        >
          <a href="/" style="color:inherit;text-decoration:none;opacity:.9;">Accueil</a>
          <span class="sep" style="opacity:.7;">›</span>
          <a href="/modeles/" style="color:inherit;text-decoration:none;opacity:.9;">Modèles</a>
          <span class="sep" style="opacity:.7;">›</span>
          <span style="opacity:.85;">{d.name}</span>
        </nav>

        <div class="row" style="justify-content:space-between;flex-wrap:wrap;">
          <div class="row" style="gap:10px;flex-wrap:wrap;">
            <span class="badge">{d.category}</span>

            {(d.tags ?? []).map((t) => (
              <a class="pill" href={"/tags/" + slugify(t) + "/"} title={"Tag : " + t}>
                {t}
              </a>
            ))}
          </div>

          <a class="btn" href="/modeles/">← Annuaire</a>
        </div>

        <h1 style="margin-top:14px;">{d.name}</h1>

        {editorialStatusLabel && (
          <div class="row" style="gap:10px;flex-wrap:wrap;margin:6px 0 0;">
            <span
              class="pill"
              aria-label={`Statut éditorial : ${editorialStatusLabel}`}
              title={`Statut éditorial : ${editorialStatusLabel}`}
            >
              {editorialStatusLabel}
            </span>
          </div>
        )}

        <p class="lead">
          {d.heroImage && (
            <div class="model-hero">
              <img src={d.heroImage} alt={d.name} loading="lazy" />
            </div>
          )}
          {(d.manufacturer ? `${d.manufacturer} · ` : "")}{d.seats} place{d.seats > 1 ? "s" : ""}
          {d.engine ? ` · ${d.engine}` : ""}
        </p>

        <div class="grid grid-2" style="margin-top: 14px;">
          <div class="card" style="box-shadow:none;">
            <div class="pad">
              <h2>Fiche technique</h2>
              <div class="stack" style="gap:10px;">
                {spec.map(([k, v]) => (
                  <div class="row" style="justify-content:space-between;gap:14px;">
                    <span style="color:var(--muted);">{k}</span>
                    <strong style="text-align:right;">{v}</strong>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="card" style="box-shadow:none;">
            <div class="pad">
              <h2>Vidéos</h2>
              {youtubeId ? (
                <div style="position:relative;padding-top:56.25%;border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,.10);background:rgba(255,255,255,.03);">
                  <iframe
                    style="position:absolute;inset:0;width:100%;height:100%;"
                    src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
                    title={d.youtube?.title ?? `Vidéo sur ${d.name}`}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>
                </div>
              ) : (
                <div class="model-video-discovery">
                  <span class="model-video-discovery__icon" aria-hidden="true">▶</span>
                  <div>
                    <strong>Découvrir ce modèle en vidéo</strong>
                    <p>
                      Ouvre une recherche YouTube ciblée sur ce modèle. Vérifie toujours
                      l’auteur, la version présentée et la date de publication.
                    </p>
                  </div>
                </div>
              )}

              <a
                class="btn model-youtube-link"
                href={youtubeSearchUrl}
                rel="noopener noreferrer nofollow"
                target="_blank"
                aria-label={`Rechercher des vidéos YouTube sur ${d.name}`}
              >
                ▶ Voir les vidéos sur YouTube
              </a>

              <hr class="sep" />
              <h3>Liens</h3>
              <div class="stack" style="gap:10px;">
                {(d.links ?? []).length
                  ? d.links.map((l) => (
                      <a class="btn" href={l.url} rel="noopener noreferrer" target="_blank">
                        {l.label}
                      </a>
                    ))
                  : <p>Aucun lien externe pour l’instant.</p>}
              </div>
            </div>
          </div>
        </div>

        <hr class="sep" />
        <div class="card" style="box-shadow:none;">
          <div class="pad" style="max-width: 80ch;">
            <h2>Notes & description</h2>
            <Content />
            <p style="font-size:12px;margin-top:14px;">
              Avertissement : cette fiche est une synthèse. Pour une décision d’achat / exploitation,
              vérifie toujours les docs constructeur et la réglementation applicable.
            </p>
          </div>
        </div>

        {relatedArticles.length > 0 && (
          <>
            <hr class="sep" />

            <div style="margin-top:18px;">
              <div
                class="row"
                style="justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;"
              >
                <h2 style="margin:0;">Articles liés</h2>
                <span class="pill">{relatedArticles.length}</span>
              </div>

              <p style="margin:8px 0 0; color:var(--muted);">
                Des articles du journal en lien avec cette fiche, selon les tags partagés.
              </p>

              <div class="grid grid-2" style="gap:12px; margin-top:12px;">
                {relatedArticles.map((a) => {
                  const articleDate = a.data.updated ?? a.data.date;
                  const articleDateLabel = articleDate.toLocaleDateString("fr-FR", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  });

                  return (
                    <a class="card" style="text-decoration:none;" href={`/journal/${a.slug}/`}>
                      <div class="pad">
                        <div class="row" style="justify-content:space-between;flex-wrap:wrap;gap:8px;">
                          <span class="badge">{a.data.category}</span>
                          <span class="pill">{articleDateLabel}</span>
                        </div>

                        <h3 style="margin:12px 0 8px;">{a.data.title}</h3>
                        <p class="s" style="margin:0 0 12px;">{a.data.description}</p>

                        {(a.data.tags ?? []).length > 0 && (
                          <div class="row" style="gap:8px;flex-wrap:wrap;">
                            {(a.data.tags ?? []).slice(0, 3).map((tag) => (
                              <span class="pill">{tag}</span>
                            ))}
                          </div>
                        )}
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>
          </>
        )}

{(prevModel || nextModel) && (
  <>
    <hr class="sep" />

    <div style="margin-top:22px;">
      <h2 style="margin:0 0 10px;">Continuer l’exploration</h2>

      <div class="grid grid-2 model-nav-grid" style="gap:12px;">
        {prevModel ? (
          <a class="card explore-card" href={`/modeles/${prevModel.slug}/`}>
            <div class="pad explore-card__pad">
              <div class="pill explore-card__kicker">← Précédent</div>
              <div class="t explore-card__title">{prevModel.data.name}</div>
              <div class="s explore-card__meta">
                {prevModel.data.manufacturer ?? "Constructeur non renseigné"} · {prevModel.data.category}
              </div>
            </div>
          </a>
        ) : (
          <div></div>
        )}

        {nextModel ? (
          <a class="card explore-card" href={`/modeles/${nextModel.slug}/`}>
            <div class="pad explore-card__pad">
              <div class="pill explore-card__kicker">Suivant →</div>
              <div class="t explore-card__title">{nextModel.data.name}</div>
              <div class="s explore-card__meta">
                {nextModel.data.manufacturer ?? "Constructeur non renseigné"} · {nextModel.data.category}
              </div>
            </div>
          </a>
        ) : (
          <div></div>
        )}
      </div>
    </div>
  </>
)}
      </div>
    </div>
  </article>
<style>
  .model-nav-grid {
    margin-top: 2px;
  }

  .explore-card {
    position: relative;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    transition:
      background-color 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      transform 0.18s ease;
  }

  .explore-card:hover,
  .explore-card:focus-visible {
    background: rgba(139, 220, 255, 0.05);
    border-color: rgba(139, 220, 255, 0.18);
    box-shadow: inset 0 0 0 1px rgba(139, 220, 255, 0.10);
    transform: translateY(-1px);
  }

  .explore-card__pad {
    min-height: 126px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .explore-card__kicker {
    display: inline-flex;
    margin-bottom: 12px;
    align-self: flex-start;
  }

  .explore-card__title {
    transition: color 0.18s ease;
  }

  .explore-card:hover .explore-card__title,
  .explore-card:focus-visible .explore-card__title {
    color: #8bdcff;
  }

  .explore-card__meta {
    margin-top: 8px;
    line-height: 1.55;
  }

  .model-video-discovery {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    padding: 14px;
    border: 1px solid rgba(255, 101, 101, 0.24);
    border-radius: 16px;
    background: rgba(255, 70, 70, 0.055);
  }

  .model-video-discovery__icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    color: #fff;
    background: #d92f2f;
    box-shadow: 0 7px 18px rgba(217, 47, 47, 0.25);
  }

  .model-video-discovery p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .model-youtube-link {
    width: 100%;
    justify-content: center;
    margin-top: 12px;
    border-color: rgba(255, 101, 101, 0.34);
  }
</style>
</BaseLayout>

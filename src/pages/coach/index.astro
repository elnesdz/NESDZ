---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  ALGORITHMIC_VARIANTS,
  COACH_QUALITY,
  EXAM_RULES,
  THEMES,
  getQuestionCounts,
} from "../../lib/coach-engine.mjs";

const questionCounts = getQuestionCounts();
---

<BaseLayout
  title="Coach théorique ULM"
  description="Entraînement au théorique commun ULM : QCM expliqués, navigation calculée, examen blanc et suivi de progression."
>
  <section class="coach-shell">
    <div class="container">
      <header class="coach-hero">
        <div class="coach-hero-copy">
          <div class="coach-eyebrow"><span aria-hidden="true">●</span> NESDZ TRAINING SYSTEM</div>
          <h1>Coach théorique ULM</h1>
          <p>
            Révisez intelligemment, comprenez vos erreurs et entraînez-vous sur des
            scénarios de navigation renouvelés à chaque session.
          </p>
          <div class="coach-hero-actions">
            <button class="coach-btn coach-btn--primary" type="button" data-start="quick">
              Lancer une série rapide
              <span>15 questions</span>
            </button>
            <button class="coach-btn" type="button" data-start="exam">
              Examen blanc
              <span>{EXAM_RULES.questionCount} questions · {EXAM_RULES.durationMinutes} min</span>
            </button>
          </div>
        </div>

        <div class="coach-radar" aria-hidden="true">
          <div class="coach-radar-grid">
            <span class="coach-radar-sweep"></span>
            <span class="coach-radar-point coach-radar-point--1"></span>
            <span class="coach-radar-point coach-radar-point--2"></span>
            <span class="coach-radar-point coach-radar-point--3"></span>
          </div>
          <div class="coach-radar-readout">
            <span>OBJECTIF</span>
            <strong>{EXAM_RULES.passingPercent}%</strong>
            <small>SEUIL EXAMEN</small>
          </div>
        </div>
      </header>

      <aside class="coach-safety-note" aria-label="Limites de l’outil">
        <strong>NON AGRÉÉ DGAC · Outil d’entraînement indépendant.</strong>
        <span>
          Les questions sont originales et adossées au programme officiel. Elles ne constituent
          ni la banque réelle de la DGAC, ni un substitut à une formation avec instructeur.
        </span>
        <small>Banque v{COACH_QUALITY.bankVersion} · revue interne du {new Date(COACH_QUALITY.reviewedAt).toLocaleDateString("fr-FR")}</small>
      </aside>

      <section class="coach-dashboard" aria-labelledby="dashboard-title">
        <div class="coach-section-heading">
          <div>
            <span class="coach-section-code">PROGRESSION LOCALE</span>
            <h2 id="dashboard-title">Votre tableau de bord</h2>
          </div>
          <button class="coach-link-button" id="reset-progress" type="button">Effacer ma progression</button>
        </div>

        <div class="coach-kpis">
          <article>
            <span>Maîtrise globale</span>
            <strong id="kpi-score">—</strong>
            <small id="kpi-score-detail">Commencez une première série</small>
          </article>
          <article>
            <span>Questions traitées</span>
            <strong id="kpi-answered">0</strong>
            <small>enregistrées sur cet appareil</small>
          </article>
          <article>
            <span>Meilleure série</span>
            <strong id="kpi-streak">0</strong>
            <small>bonnes réponses consécutives</small>
          </article>
          <article class="coach-kpi-focus">
            <span>Axe conseillé</span>
            <strong id="kpi-focus">Diagnostic</strong>
            <small id="kpi-focus-detail">Une série mixte évaluera vos acquis</small>
          </article>
        </div>

        <div class="coach-mastery" id="mastery-list" aria-live="polite"></div>
      </section>

      <section class="coach-modes" aria-labelledby="modes-title">
        <div class="coach-section-heading">
          <div>
            <span class="coach-section-code">MODES D’ENTRAÎNEMENT</span>
            <h2 id="modes-title">Choisissez votre mission</h2>
          </div>
          <span class="coach-data-badge">{ALGORITHMIC_VARIANTS.toLocaleString("fr-FR")}+ variantes calculées</span>
        </div>

        <div class="coach-mode-grid">
          <button type="button" class="coach-mode-card coach-mode-card--nav" data-start="navigation">
            <span class="coach-mode-icon">NAV</span>
            <span class="coach-mode-copy">
              <strong>Navigation illimitée</strong>
              <small>Vent, dérive, caps, échelles, temps et conversions</small>
            </span>
            <span class="coach-mode-status">GÉNÉRATIF</span>
          </button>
          <button type="button" class="coach-mode-card" data-start="quick">
            <span class="coach-mode-icon">MIX</span>
            <span class="coach-mode-copy">
              <strong>Série rapide</strong>
              <small>15 questions équilibrées avec correction immédiate</small>
            </span>
            <span class="coach-mode-status">15 Q</span>
          </button>
          <button type="button" class="coach-mode-card coach-mode-card--exam" data-start="exam">
            <span class="coach-mode-icon">EXAM</span>
            <span class="coach-mode-copy">
              <strong>Examen blanc</strong>
              <small>60 questions, 90 minutes et corrections à la fin</small>
            </span>
            <span class="coach-mode-status">75% REQUIS</span>
          </button>
          <button type="button" class="coach-mode-card" data-start="mistakes" id="mistakes-mode">
            <span class="coach-mode-icon">RETRY</span>
            <span class="coach-mode-copy">
              <strong>Revoir mes erreurs</strong>
              <small id="mistakes-copy">Aucune erreur enregistrée</small>
            </span>
            <span class="coach-mode-status" id="mistakes-count">0 Q</span>
          </button>
        </div>
      </section>

      <section class="coach-themes" aria-labelledby="themes-title">
        <div class="coach-section-heading">
          <div>
            <span class="coach-section-code">PROGRAMME THÉORIQUE COMMUN</span>
            <h2 id="themes-title">Travailler un thème précis</h2>
          </div>
          <a class="coach-source-link" href="https://www.legifrance.gouv.fr/loda/id/JORFTEXT000000401045/" target="_blank" rel="noopener noreferrer">
            Voir le programme officiel ↗
          </a>
        </div>

        <div class="coach-theme-grid">
          {THEMES.map((theme) => (
            <button
              type="button"
              class={`coach-theme-card coach-theme-card--${theme.color}`}
              data-theme={theme.id}
              data-start="theme"
            >
              <span class="coach-theme-code">{theme.icon}</span>
              <span class="coach-theme-name">{theme.label}</span>
              <span class="coach-theme-meta">
                {questionCounts[theme.id]} questions sourcées
                {(theme.id === "navigation" || theme.id === "performances") && " + exercices calculés"}
              </span>
              <span class="coach-theme-progress" data-theme-progress={theme.id}>Non commencé</span>
            </button>
          ))}
        </div>
      </section>

      <section class="coach-quiz" id="quiz-panel" hidden aria-labelledby="question-title">
        <div class="coach-quiz-topbar">
          <div class="coach-quiz-mode">
            <span id="quiz-mode-code">TRAINING</span>
            <strong id="quiz-mode-label">Série rapide</strong>
          </div>
          <div class="coach-quiz-instruments">
            <div>
              <span>QUESTION</span>
              <strong><span id="question-index">1</span>/<span id="question-total">15</span></strong>
            </div>
            <div id="timer-instrument" hidden>
              <span>CHRONO</span>
              <strong id="exam-timer">90:00</strong>
            </div>
            <button type="button" id="quit-session">Quitter</button>
          </div>
        </div>

        <div class="coach-progress-track" aria-hidden="true"><span id="quiz-progress"></span></div>
        <nav class="coach-exam-navigator" id="exam-navigator" aria-label="Navigation entre les questions" hidden></nav>

        <div class="coach-question-layout">
          <aside class="coach-question-context" id="question-visual" aria-label="Données de l’exercice"></aside>

          <article class="coach-question-card">
            <div class="coach-question-meta">
              <span id="question-theme">Navigation</span>
              <span id="question-difficulty">Niveau 2</span>
              <span id="question-generated" hidden>VARIANTE CALCULÉE</span>
            </div>
            <h2 id="question-title" tabindex="-1">Question</h2>

            <div class="coach-options" id="answer-options" role="group" aria-labelledby="question-title"></div>

            <div class="coach-question-actions">
              <button class="coach-control-button" type="button" id="previous-question" hidden>
                Question précédente
              </button>
              <button class="coach-hint-button" type="button" id="show-hint" aria-expanded="false" aria-controls="question-hint">
                Afficher un indice
              </button>
              <button class="coach-control-button" type="button" id="flag-question" aria-pressed="false" hidden>
                À revoir
              </button>
              <button class="coach-btn coach-btn--primary coach-next" type="button" id="next-question" disabled>
                Question suivante
              </button>
              <button class="coach-btn coach-btn--finish" type="button" id="finish-exam" hidden>
                Terminer l’examen
              </button>
            </div>

            <p class="coach-hint" id="question-hint" hidden></p>
            <div class="coach-feedback" id="question-feedback" hidden aria-live="polite"></div>
          </article>
        </div>
      </section>

      <section class="coach-results" id="results-panel" hidden aria-labelledby="results-title">
        <div class="coach-result-gauge" id="result-gauge" aria-hidden="true">
          <div><strong id="result-percent">0%</strong><span>RÉSULTAT</span></div>
        </div>
        <div class="coach-result-copy">
          <span class="coach-section-code" id="result-code">SESSION TERMINÉE</span>
          <h2 id="results-title" tabindex="-1">Votre débriefing</h2>
          <p id="result-summary"></p>
          <div class="coach-result-actions">
            <button class="coach-btn coach-btn--primary" type="button" id="restart-session">Nouvelle série</button>
            <button class="coach-btn" type="button" id="print-results">Imprimer le débriefing</button>
            <button class="coach-btn" type="button" id="return-dashboard">Retour au tableau de bord</button>
          </div>
        </div>
        <div class="coach-result-breakdown" id="result-breakdown"></div>
        <details class="coach-review" id="review-errors">
          <summary>Revoir les réponses à travailler</summary>
          <div id="review-list"></div>
        </details>
      </section>

      <noscript>
        <p class="coach-safety-note">Le coach nécessite JavaScript pour calculer les exercices et mémoriser votre progression.</p>
      </noscript>
    </div>
  </section>

  <script>
    import {
      EXAM_RULES,
      THEMES,
      createSession,
      formatHeading,
    } from "../../lib/coach-engine.mjs";

    const STORAGE_KEY = "nesdz-coach-progress-v1";
    const letters = ["A", "B", "C", "D"];
    const setupSections = [
      document.querySelector(".coach-dashboard"),
      document.querySelector(".coach-modes"),
      document.querySelector(".coach-themes"),
    ];
    const quizPanel = document.querySelector("#quiz-panel");
    const resultsPanel = document.querySelector("#results-panel");
    const optionsNode = document.querySelector("#answer-options");
    const feedbackNode = document.querySelector("#question-feedback");
    const nextButton = document.querySelector("#next-question");
    const previousButton = document.querySelector("#previous-question");
    const flagButton = document.querySelector("#flag-question");
    const finishButton = document.querySelector("#finish-exam");
    const examNavigator = document.querySelector("#exam-navigator");
    const hintButton = document.querySelector("#show-hint");
    const hintNode = document.querySelector("#question-hint");
    const themeById = Object.fromEntries(THEMES.map((theme) => [theme.id, theme]));

    let progress = loadProgress();
    let session = null;

    function emptyProgress() {
      return { answered: 0, correct: 0, streak: 0, bestStreak: 0, byTheme: {}, mistakes: [] };
    }

    function loadProgress() {
      try {
        return { ...emptyProgress(), ...JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}") };
      } catch {
        return emptyProgress();
      }
    }

    function saveProgress() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
      renderDashboard();
    }

    function themeStats(themeId) {
      return progress.byTheme?.[themeId] || { answered: 0, correct: 0 };
    }

    function percent(correct, answered) {
      return answered ? Math.round((correct / answered) * 100) : 0;
    }

    function renderDashboard() {
      const globalPercent = percent(progress.correct, progress.answered);
      document.querySelector("#kpi-score").textContent = progress.answered ? `${globalPercent}%` : "—";
      document.querySelector("#kpi-score-detail").textContent = progress.answered
        ? `${progress.correct} bonnes réponses sur ${progress.answered}`
        : "Commencez une première série";
      document.querySelector("#kpi-answered").textContent = String(progress.answered);
      document.querySelector("#kpi-streak").textContent = String(progress.bestStreak || 0);

      const ranked = THEMES
        .map((theme) => ({ theme, ...themeStats(theme.id) }))
        .sort((a, b) => {
          if (!a.answered && b.answered) return -1;
          if (a.answered && !b.answered) return 1;
          return percent(a.correct, a.answered) - percent(b.correct, b.answered);
        });
      const focus = ranked[0];
      document.querySelector("#kpi-focus").textContent = focus?.answered ? focus.theme.short : "Diagnostic";
      document.querySelector("#kpi-focus-detail").textContent = focus?.answered
        ? `${percent(focus.correct, focus.answered)}% de réussite : thème prioritaire`
        : "Une série mixte évaluera vos acquis";

      document.querySelector("#mastery-list").innerHTML = THEMES.map((theme) => {
        const stats = themeStats(theme.id);
        const value = percent(stats.correct, stats.answered);
        return `<div class="coach-mastery-row">
          <span>${theme.short}</span>
          <div role="progressbar" aria-label="Maîtrise ${theme.label}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${value}"><i style="width:${value}%"></i></div>
          <strong>${stats.answered ? `${value}%` : "—"}</strong>
        </div>`;
      }).join("");

      document.querySelectorAll("[data-theme-progress]").forEach((node) => {
        const stats = themeStats(node.dataset.themeProgress);
        node.textContent = stats.answered ? `${percent(stats.correct, stats.answered)}% · ${stats.answered} réponses` : "Non commencé";
      });

      const mistakes = progress.mistakes?.length || 0;
      document.querySelector("#mistakes-count").textContent = `${mistakes} Q`;
      document.querySelector("#mistakes-copy").textContent = mistakes
        ? "Retravaillez les notions qui vous ont posé problème"
        : "Aucune erreur enregistrée";
      document.querySelector("#mistakes-mode").disabled = mistakes === 0;
    }

    function startSession(mode, theme = "all") {
      let questions;
      if (mode === "mistakes") {
        questions = (progress.mistakes || []).slice(-20).reverse();
        if (!questions.length) return;
      } else {
        questions = createSession({ mode, theme, seed: Date.now() });
      }

      session = {
        mode,
        theme,
        questions,
        index: 0,
        answers: [],
        score: 0,
        startedAt: Date.now(),
        secondsLeft: EXAM_RULES.durationMinutes * 60,
        timer: null,
        flagged: new Set(),
        completed: false,
      };

      setupSections.forEach((section) => section.hidden = true);
      resultsPanel.hidden = true;
      quizPanel.hidden = false;
      document.querySelector("#timer-instrument").hidden = mode !== "exam";
      examNavigator.hidden = mode !== "exam";
      document.querySelector("#quiz-mode-code").textContent = mode === "exam" ? "EXAM MODE" : mode === "navigation" ? "NAV LAB" : "TRAINING";
      document.querySelector("#quiz-mode-label").textContent = modeLabel(mode, theme);
      document.querySelector("#question-total").textContent = String(questions.length);

      if (mode === "exam") startTimer();
      renderQuestion();
      quizPanel.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function modeLabel(mode, theme) {
      if (mode === "exam") return "Examen blanc ULM";
      if (mode === "navigation") return "Navigation illimitée";
      if (mode === "mistakes") return "Révision des erreurs";
      if (mode === "theme") return themeById[theme]?.label || "Entraînement thématique";
      return "Série rapide";
    }

    function startTimer() {
      updateTimer();
      session.timer = window.setInterval(() => {
        session.secondsLeft -= 1;
        updateTimer();
        if (session.secondsLeft <= 0) finishSession();
      }, 1000);
    }

    function updateTimer() {
      const minutes = Math.floor(session.secondsLeft / 60);
      const seconds = session.secondsLeft % 60;
      document.querySelector("#exam-timer").textContent = `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
    }

    function renderQuestion() {
      const question = session.questions[session.index];
      const theme = themeById[question.theme] || { label: question.theme, short: question.theme };
      const isExam = session.mode === "exam";
      const isLast = session.index === session.questions.length - 1;
      const selected = session.answers[session.index];
      document.querySelector("#question-index").textContent = String(session.index + 1);
      document.querySelector("#quiz-progress").style.width = `${((session.index + 1) / session.questions.length) * 100}%`;
      document.querySelector("#question-theme").textContent = theme.label;
      document.querySelector("#question-difficulty").textContent = `Niveau ${question.difficulty}`;
      document.querySelector("#question-generated").hidden = !question.generated;
      document.querySelector("#question-title").textContent = question.prompt;
      hintNode.textContent = question.hint;
      hintNode.hidden = true;
      hintButton.hidden = isExam;
      hintButton.setAttribute("aria-expanded", "false");
      hintButton.textContent = "Afficher un indice";
      feedbackNode.hidden = true;
      feedbackNode.innerHTML = "";
      nextButton.disabled = !isExam && selected === undefined;
      nextButton.hidden = isExam && isLast;
      nextButton.textContent = session.index === session.questions.length - 1 ? "Voir le résultat" : "Question suivante";
      previousButton.hidden = !isExam || session.index === 0;
      flagButton.hidden = !isExam;
      flagButton.setAttribute("aria-pressed", String(session.flagged.has(session.index)));
      flagButton.textContent = session.flagged.has(session.index) ? "Marquée à revoir" : "À revoir";
      finishButton.hidden = !isExam;
      renderVisual(question);

      optionsNode.innerHTML = question.options.map((option, index) => `
        <button type="button" class="coach-option" data-answer="${index}">
          <span>${letters[index]}</span><strong>${escapeHtml(option)}</strong>
        </button>
      `).join("");
      optionsNode.querySelectorAll("button").forEach((button) => {
        button.classList.toggle("is-selected", Number(button.dataset.answer) === selected);
        button.addEventListener("click", () => answerQuestion(Number(button.dataset.answer)));
      });
      renderExamNavigator();
      document.querySelector("#question-title").focus({ preventScroll: true });
    }

    function renderExamNavigator() {
      if (session?.mode !== "exam") return;
      examNavigator.innerHTML = session.questions.map((_, index) => {
        const classes = [
          index === session.index ? "is-current" : "",
          session.answers[index] !== undefined ? "is-answered" : "",
          session.flagged.has(index) ? "is-flagged" : "",
        ].filter(Boolean).join(" ");
        const status = session.answers[index] !== undefined ? "répondue" : "sans réponse";
        return `<button type="button" class="${classes}" data-question-index="${index}" aria-label="Question ${index + 1}, ${status}${session.flagged.has(index) ? ", marquée à revoir" : ""}" ${index === session.index ? 'aria-current="step"' : ""}>${index + 1}</button>`;
      }).join("");
      examNavigator.querySelectorAll("button").forEach((button) => button.addEventListener("click", () => goToQuestion(Number(button.dataset.questionIndex))));
    }

    function goToQuestion(index) {
      if (session?.mode !== "exam" || index < 0 || index >= session.questions.length) return;
      session.index = index;
      renderQuestion();
    }

    function answerQuestion(selected) {
      const question = session.questions[session.index];
      const alreadyAnswered = session.answers[session.index] !== undefined;
      if (alreadyAnswered && session.mode !== "exam") return;
      session.answers[session.index] = selected;
      nextButton.disabled = false;

      const buttons = [...optionsNode.querySelectorAll("button")];
      buttons.forEach((button) => button.classList.toggle("is-selected", Number(button.dataset.answer) === selected));

      if (session.mode === "exam") {
        renderExamNavigator();
        return;
      }

      buttons.forEach((button) => button.disabled = true);
      const isCorrect = selected === question.correct;
      buttons[question.correct]?.classList.add("is-correct");
      if (!isCorrect) buttons[selected]?.classList.add("is-wrong");
      if (isCorrect) session.score += 1;
      recordAnswer(question, isCorrect);
      renderVisual(question, true);
      feedbackNode.className = `coach-feedback ${isCorrect ? "is-correct" : "is-wrong"}`;
      feedbackNode.innerHTML = `<strong>${isCorrect ? "Bonne réponse" : "À retravailler"}</strong>
        <div class="coach-answer-comparison">
          <p><span>VOTRE RÉPONSE</span><b>${letters[selected]} — ${escapeHtml(question.options[selected])}</b></p>
          <p><span>RÉPONSE ATTENDUE</span><b>${letters[question.correct]} — ${escapeHtml(question.options[question.correct])}</b></p>
        </div>
        <p>${escapeHtml(question.feedback?.[selected] || question.explanation)}</p>
        <div class="coach-method"><span>MÉTHODE ET RAISONNEMENT</span><p>${escapeHtml(question.explanation)}</p></div>
        ${editorialTrace(question)}`;
      feedbackNode.hidden = false;
    }

    function recordAnswer(question, isCorrect) {
      progress.answered += 1;
      if (isCorrect) {
        progress.correct += 1;
        progress.streak = (progress.streak || 0) + 1;
        progress.bestStreak = Math.max(progress.bestStreak || 0, progress.streak);
        progress.mistakes = (progress.mistakes || []).filter((item) => item.id !== question.id);
      } else {
        progress.streak = 0;
        const snapshot = JSON.parse(JSON.stringify(question));
        progress.mistakes = [...(progress.mistakes || []).filter((item) => item.id !== question.id), snapshot].slice(-50);
      }
      const stats = themeStats(question.theme);
      progress.byTheme[question.theme] = {
        answered: stats.answered + 1,
        correct: stats.correct + (isCorrect ? 1 : 0),
      };
      saveProgress();
    }

    function nextQuestion() {
      if (session.mode !== "exam" && session.answers[session.index] === undefined) return;
      if (session.index >= session.questions.length - 1) {
        if (session.mode !== "exam") finishSession();
        return;
      }
      session.index += 1;
      renderQuestion();
    }

    function finishSession() {
      if (!session || session.completed) return;
      session.completed = true;
      if (session.timer) window.clearInterval(session.timer);

      if (session.mode === "exam") {
        session.questions.forEach((question, index) => {
          const isCorrect = session.answers[index] === question.correct;
          if (isCorrect) session.score += 1;
          recordAnswer(question, isCorrect);
        });
      }

      const resultPercent = percent(session.score, session.questions.length);
      quizPanel.hidden = true;
      resultsPanel.hidden = false;
      document.querySelector("#result-percent").textContent = `${resultPercent}%`;
      const passed = resultPercent >= EXAM_RULES.passingPercent;
      const gaugeColor = passed ? "#55ddb0" : "#f0b94d";
      document.querySelector("#result-gauge").style.background = `conic-gradient(${gaugeColor} 0 ${resultPercent}%, #12223a ${resultPercent}% 100%)`;
      document.querySelector("#result-code").textContent = session.mode === "exam"
        ? passed ? "SEUIL ATTEINT" : "SEUIL À CONSOLIDER"
        : "SESSION TERMINÉE";
      document.querySelector("#result-summary").textContent = session.mode === "exam"
        ? `${session.score} bonnes réponses sur ${session.questions.length} en ${formatDuration(Math.round((Date.now() - session.startedAt) / 1000))}. ${passed ? "Vous atteignez le seuil réglementaire de 75 % sur cette simulation non agréée." : "Le seuil de 75 % n’est pas encore atteint : utilisez le débriefing pour cibler la prochaine série."}`
        : `${session.score} bonnes réponses sur ${session.questions.length}. Le tableau ci-dessous montre les thèmes à consolider.`;
      renderResults();
      document.querySelector("#results-title").focus({ preventScroll: true });
      resultsPanel.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function renderResults() {
      const byTheme = {};
      session.questions.forEach((question, index) => {
        const stats = byTheme[question.theme] || { answered: 0, correct: 0 };
        stats.answered += 1;
        if (session.answers[index] === question.correct) stats.correct += 1;
        byTheme[question.theme] = stats;
      });
      document.querySelector("#result-breakdown").innerHTML = Object.entries(byTheme).map(([themeId, stats]) => {
        const value = percent(stats.correct, stats.answered);
        return `<div><span>${themeById[themeId]?.short || themeId}</span><strong>${value}%</strong><i><b style="width:${value}%"></b></i></div>`;
      }).join("");

      const errors = session.questions.map((question, index) => ({ question, index, selected: session.answers[index] }))
        .filter(({ question, selected }) => selected !== question.correct);
      document.querySelector("#review-errors").hidden = errors.length === 0;
      document.querySelector("#review-list").innerHTML = errors.map(({ question, index, selected }) => `
        <article>
          <span class="coach-review-number">QUESTION ${index + 1} · ${escapeHtml(themeById[question.theme]?.short || question.theme)}</span>
          <strong>${escapeHtml(question.prompt)}</strong>
          ${reviewVisual(question)}
          <div class="coach-answer-comparison">
            <p><span>VOTRE RÉPONSE</span><b>${selected === undefined ? "Sans réponse" : `${letters[selected]} — ${escapeHtml(question.options[selected])}`}</b></p>
            <p><span>RÉPONSE ATTENDUE</span><b>${letters[question.correct]} — ${escapeHtml(question.options[question.correct])}</b></p>
          </div>
          <p>${escapeHtml(selected === undefined ? `Cette question est restée sans réponse. ${question.explanation}` : question.feedback?.[selected] || question.explanation)}</p>
          <div class="coach-method"><span>MÉTHODE ET RAISONNEMENT</span><p>${escapeHtml(question.explanation)}</p></div>
          ${editorialTrace(question)}
        </article>
      `).join("");
    }

    function reviewVisual(question) {
      const visual = question.visual;
      if (!visual || (visual.type !== "wind" && visual.type !== "wind-triangle")) return "";
      const track = visual.track ?? visual.course;
      return `<div class="coach-review-visual" aria-label="Schéma corrigé de la route et du vent">
        <div class="coach-compass-ring"><span class="north">N</span><span class="east">E</span><span class="south">S</span><span class="west">W</span>
          <i class="track-needle" style="transform:rotate(${track}deg)"></i>
          <i class="wind-needle" style="transform:rotate(${visual.windFrom + 180}deg)"></i>
          ${visual.type === "wind-triangle" ? `<i class="heading-needle" style="transform:rotate(${visual.heading}deg)"></i>` : ""}
          <b></b>
        </div>
        <p>Route ${formatHeading(track)} · vent ${formatHeading(visual.windFrom)} / ${visual.windSpeed} kt${visual.type === "wind-triangle" ? ` · cap corrigé ${formatHeading(visual.heading)} · vitesse sol ${visual.groundspeed} kt` : ""}</p>
      </div>`;
    }

    function renderVisual(question, revealSolution = false) {
      const node = document.querySelector("#question-visual");
      const visual = question.visual;
      if (!visual) {
        node.innerHTML = `<div class="coach-reference-panel"><span>MODULE</span><strong>${escapeHtml(themeById[question.theme]?.icon || "ULM")}</strong><small>Analysez chaque proposition avant de répondre.</small></div>`;
        return;
      }
      if (visual.type === "wind") {
        node.innerHTML = `<div class="coach-nav-dial">
          <div class="coach-compass-ring"><span class="north">N</span><span class="east">E</span><span class="south">S</span><span class="west">W</span>
            <i class="course-needle" style="transform:rotate(${visual.course}deg)"></i>
            <i class="wind-needle" style="transform:rotate(${visual.windFrom + 180}deg)"></i>
            <b></b>
          </div>
          <dl><div><dt>AXE</dt><dd>${formatHeading(visual.course)}</dd></div><div><dt>VENT</dt><dd>${formatHeading(visual.windFrom)} / ${visual.windSpeed} kt</dd></div></dl>
        </div>`;
        return;
      }
      if (visual.type === "wind-triangle") {
        node.innerHTML = `<div class="coach-nav-dial coach-wind-triangle">
          <div class="coach-compass-ring"><span class="north">N</span><span class="east">E</span><span class="south">S</span><span class="west">W</span>
            <i class="track-needle" style="transform:rotate(${visual.track}deg)" title="Route à suivre"></i>
            <i class="wind-needle" style="transform:rotate(${visual.windFrom + 180}deg)" title="Direction vers laquelle souffle le vent"></i>
            ${revealSolution ? `<i class="heading-needle" style="transform:rotate(${visual.heading}deg)" title="Cap corrigé"></i>` : ""}
            <b></b>
          </div>
          <div class="coach-vector-legend"><span class="track">Route</span><span class="wind">Vent</span>${revealSolution ? '<span class="heading">Cap corrigé</span>' : ""}</div>
          <dl>
            <div><dt>ROUTE VRAIE</dt><dd>${formatHeading(visual.track)}</dd></div>
            <div><dt>VENT</dt><dd>${formatHeading(visual.windFrom)} / ${visual.windSpeed} kt</dd></div>
            <div><dt>VITESSE AIR</dt><dd>${visual.trueAirspeed} kt</dd></div>
            <div><dt>${revealSolution ? "CAP / VS" : "CAP"}</dt><dd>${revealSolution ? `${formatHeading(visual.heading)} / ${visual.groundspeed} kt` : "À CALCULER"}</dd></div>
          </dl>
        </div>`;
        return;
      }
      const rows = visualRows(visual);
      node.innerHTML = `<div class="coach-reference-panel"><span>DONNÉES DE VOL</span>${rows.map(([label, value]) => `<div><small>${label}</small><strong>${value}</strong></div>`).join("")}</div>`;
    }

    function visualRows(visual) {
      if (visual.type === "scale") return [["ÉCHELLE", `1/${visual.scale.toLocaleString("fr-FR")}`], ["MESURE", `${visual.centimetres} cm`]];
      if (visual.type === "route") return [["DISTANCE", `${visual.distance} NM`], ["VITESSE SOL", `${visual.groundspeed} kt`]];
      if (visual.type === "fuel") return [["CONSOMMATION", `${visual.consumption} L/h`], ["VOL", `${visual.flightMinutes} min`], ["RÉSERVE", `${visual.reserveMinutes} min`]];
      if (visual.type === "compass") return [["ROUTE VRAIE", formatHeading(visual.trueRoute)], ["DÉCLINAISON", `${visual.variation}° ${visual.direction}`]];
      if (visual.type === "distance") return [["DISTANCE", `${visual.distanceNm} NM`], ["CONVERSION", "1 NM = 1,852 km"]];
      return [["MODULE", "NAV"]];
    }

    function leaveSession() {
      if (session?.timer) window.clearInterval(session.timer);
      session = null;
      quizPanel.hidden = true;
      resultsPanel.hidden = true;
      setupSections.forEach((section) => section.hidden = false);
      renderDashboard();
      document.querySelector(".coach-dashboard").scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>'"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" })[character]);
    }

    function editorialTrace(question) {
      const editorial = question.editorial || {};
      return `<footer class="coach-traceability">
        <a href="${escapeHtml(question.source.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(question.source.label)} ↗</a>
        <span>${escapeHtml(editorial.syllabusReference || "Programme théorique ULM")}</span>
        <small>Banque v${escapeHtml(editorial.bankVersion || "—")} · revue ${escapeHtml(editorial.reviewedAt || "—")} · ${escapeHtml(editorial.status || "revue interne")}</small>
      </footer>`;
    }

    function formatDuration(totalSeconds) {
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;
      return `${minutes} min ${String(seconds).padStart(2, "0")} s`;
    }

    function requestExamFinish() {
      if (session?.mode !== "exam") return;
      const unanswered = session.questions.length - session.answers.filter((answer) => answer !== undefined).length;
      if (unanswered > 0 && !window.confirm(`Il reste ${unanswered} question${unanswered > 1 ? "s" : ""} sans réponse. Terminer quand même ?`)) return;
      finishSession();
    }

    document.querySelectorAll("[data-start]").forEach((button) => button.addEventListener("click", () => startSession(button.dataset.start, button.dataset.theme || "all")));
    nextButton.addEventListener("click", nextQuestion);
    previousButton.addEventListener("click", () => goToQuestion(session.index - 1));
    flagButton.addEventListener("click", () => {
      if (session.flagged.has(session.index)) session.flagged.delete(session.index);
      else session.flagged.add(session.index);
      renderQuestion();
    });
    finishButton.addEventListener("click", requestExamFinish);
    hintButton.addEventListener("click", () => {
      const willOpen = hintNode.hidden;
      hintNode.hidden = !willOpen;
      hintButton.setAttribute("aria-expanded", String(willOpen));
      hintButton.textContent = willOpen ? "Masquer l’indice" : "Afficher un indice";
    });
    document.querySelector("#quit-session").addEventListener("click", leaveSession);
    document.querySelector("#return-dashboard").addEventListener("click", leaveSession);
    document.querySelector("#print-results").addEventListener("click", () => {
      document.querySelector("#review-errors").open = true;
      window.print();
    });
    document.querySelector("#restart-session").addEventListener("click", () => {
      const { mode, theme } = session;
      startSession(mode === "mistakes" ? "quick" : mode, theme);
    });
    document.querySelector("#reset-progress").addEventListener("click", () => {
      if (!window.confirm("Effacer toute la progression et la liste des erreurs sur cet appareil ?")) return;
      progress = emptyProgress();
      saveProgress();
    });
    renderDashboard();
  </script>


---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import ModelCard from "../../components/ModelCard.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  // slugify défini ICI => garanti disponible pendant getStaticPaths
  const slugify = (input) =>
    String(input)
      .trim()
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

  const articles = await getCollection("articles");
  const models = await getCollection("models");

  // slug -> label affichable (accentué si dispo)
  const tagMap = new Map();

  const addTag = (label) => {
    const slug = slugify(label);
    if (!slug) return;
    if (!tagMap.has(slug)) tagMap.set(slug, label);
  };

  for (const a of articles) {
    for (const t of a.data.tags ?? []) addTag(t);
  }

  for (const m of models) {
    for (const t of m.data.tags ?? []) addTag(t);
  }

  return Array.from(tagMap.entries()).map(([slug, tagLabel]) => ({
    params: { tag: slug },
    props: { tagLabel },
  }));
}

// params + props
const { tag } = Astro.params;     // ex: "tube-toile"
const { tagLabel } = Astro.props; // ex: "tube-toile" ou "sécurité"
const displayTag = tagLabel ?? tag;

// slugify aussi pour filtrer (duplication OK et claire)
const slugify = (input) =>
  String(input)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const articles = await getCollection("articles");
const models = await getCollection("models");

const filteredArticles = articles
  .filter((a) => (a.data.tags ?? []).some((t) => slugify(t) === tag))
  .sort((a, b) => {
    const dateA = a.data.updated ?? a.data.date;
    const dateB = b.data.updated ?? b.data.date;
    return dateB.valueOf() - dateA.valueOf();
  });

const filteredModels = models
  .filter((m) => (m.data.tags ?? []).some((t) => slugify(t) === tag))
  .sort((a, b) => a.data.name.localeCompare(b.data.name, "fr", { sensitivity: "base" }));
---

<BaseLayout
  title={`Tag : ${displayTag} · NESDZ`}
  description={`Contenus NESDZ liés au tag "${displayTag}" : articles et modèles ULM.`}
>
  <section class="container">
    <div class="row" style="justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;">
      <div>
        <h1 style="margin:0 0 6px;">Tag : {displayTag}</h1>
        <p class="lead" style="margin:0;">Articles et modèles ULM liés à ce thème.</p>
      </div>

      <div class="row" style="gap:8px;flex-wrap:wrap;">
        <span class="pill" title="Articles">{filteredArticles.length} articles</span>
        <span class="pill" title="Modèles">{filteredModels.length} modèles</span>
      </div>
    </div>

    {filteredArticles.length > 0 ? (
      <>
        <h2 style="margin:18px 0 10px;">Articles</h2>
        <div class="grid">
          {filteredArticles.map((a) => (
            <ArticleCard
              href={`/journal/${a.slug}/`}
              title={a.data.title}
              description={a.data.description}
              date={a.data.date}
              category={a.data.category}
              tags={a.data.tags}
              image={a.data.image}
            />
          ))}
        </div>
      </>
    ) : (
      <p style="margin-top:18px;opacity:.85;">Aucun article pour ce tag pour le moment.</p>
    )}

    {filteredModels.length > 0 ? (
      <>
        <h2 style="margin:22px 0 10px;">Modèles ULM</h2>
        <div class="list">
          {filteredModels.map((m) => (
            <ModelCard
              href={`/modeles/${m.slug}/`}
              name={m.data.name}
              manufacturer={m.data.manufacturer}
              category={m.data.category}
              seats={m.data.seats}
              engine={m.data.engine}
              cruiseKmh={m.data.cruiseKmh}
              tags={m.data.tags}
            />
          ))}
        </div>
      </>
    ) : (
      <p style="margin-top:12px;opacity:.85;">Aucun modèle associé à ce tag.</p>
    )}
  </section>
</BaseLayout>

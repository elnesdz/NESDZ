---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";
const slugify = (s) =>
  s
    .toString()
    .trim()
    .toLowerCase()
    .normalize("NFD")                 // sépare les accents
    .replace(/[\u0300-\u036f]/g, "")   // supprime les accents
    .replace(/[^a-z0-9]+/g, "-")       // tout le reste -> "-"
    .replace(/^-+|-+$/g, "");          // trim des "-"
export async function getStaticPaths() {
  const articles = await getCollection("articles");

  const allTags = [
    ...new Set(
      articles.flatMap((a) => a.data.tags ?? [])
    ),
  ];

  return allTags.map((tagOriginal) => ({
    params: { tag: slugify(tagOriginal) }, // URL propre
    props: { tagOriginal },                // label humain
  }));
}

const { tag } = Astro.params; // tag = "securite"
const articles = await getCollection("articles");

const filtered = articles.filter((a) =>
  (a.data.tags ?? []).some((t) => slugify(t) === tag)
);
---

<BaseLayout title={`Tag : ${tag}`}>
  <section class="container">
    <h1>Articles : {tag}</h1>

    <div class="grid">
      {articles.map(a => (
        <ArticleCard
          href={`/journal/${a.slug}/`}
          title={a.data.title}
          description={a.data.description}
          date={a.data.date}
          category={a.data.category}
          tags={a.data.tags}
          image={a.data.image}
        />
      ))}
    </div>
  </section>
</BaseLayout>

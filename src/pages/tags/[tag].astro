---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";

// Helper slug: "Sécurité" -> "securite"
const slugify = (s: string) =>
  s
    .toString()
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const tags = [...new Set(articles.flatMap((a) => a.data.tags ?? []))];

  return tags.map((tagOriginal) => ({
    params: { tag: slugify(tagOriginal) },
    props: { tagOriginal },
  }));
}

const { tag } = Astro.params; // ex: "securite"
const { tagOriginal } = Astro.props; // ex: "Sécurité"

const articles = await getCollection("articles");

const filtered = articles.filter((a) =>
  (a.data.tags ?? []).some((t) => slugify(t) === tag)
);
---

<BaseLayout title={`Articles : ${tagOriginal}`} description={`Articles taggés : ${tagOriginal}`}>
  <section class="container">
    <h1>Articles : {tagOriginal}</h1>

    <div class="grid">
      {filtered.map((a) => (
        <ArticleCard
          href={`/journal/${a.slug}/`}
          title={a.data.title}
          description={a.data.description}
          date={a.data.date}
          category={a.data.category}
          tags={a.data.tags}
          image={a.data.image}
        />
      ))}
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  // helper LOCAL = zéro risque "not defined"
  const slugify = (input) =>
    String(input)
      .trim()
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

  const articles = await getCollection("articles");
  const allTags = [...new Set(articles.flatMap((a) => a.data.tags ?? []))];

  return allTags.map((tagOriginal) => ({
    params: { tag: slugify(tagOriginal) },
    props: { tagOriginal },
  }));
}

// pour l'affichage
const { tag } = Astro.params;        // ex: "securite"
const { tagOriginal } = Astro.props; // ex: "sécurité"

// même slugify ici aussi (tu peux le dupliquer, c'est OK)
const slugify = (input) =>
  String(input)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const articles = await getCollection("articles");
const filtered = articles.filter((a) =>
  (a.data.tags ?? []).some((t) => slugify(t) === tag)
);
---

<BaseLayout title={`Articles : ${tagOriginal ?? tag}`}>
  <section class="container">
    <h1>Articles : {tagOriginal ?? tag}</h1>

    <div class="grid">
      {filtered.map((a) => (
        <ArticleCard
          href={`/journal/${a.slug}/`}
          title={a.data.title}
          description={a.data.description}
          date={a.data.date}
          category={a.data.category}
          tags={a.data.tags}
          image={a.data.image}
        />
      ))}
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getTagByKey } from "../../lib/tags";

function slugify(input: string) {
  return String(input)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

const articles = (await getCollection("articles")).filter((a) => !a.data.draft);
const models = await getCollection("models");

const articleTagMap = new Map<string, { label: string; count: number }>();

for (const article of articles) {
  for (const rawLabel of article.data.tags ?? []) {
    const slug = slugify(rawLabel);
    if (!slug) continue;

    const canonical = getTagByKey(slug);
    const label = canonical?.label ?? rawLabel;

    const existing = articleTagMap.get(slug);
    if (existing) {
      existing.count += 1;
    } else {
      articleTagMap.set(slug, { label, count: 1 });
    }
  }
}

const articleTags = Array.from(articleTagMap.entries())
  .map(([slug, value]) => ({
    slug,
    label: value.label,
    count: value.count,
  }))
  .sort(
    (a, b) =>
      b.count - a.count ||
      a.label.localeCompare(b.label, "fr", { sensitivity: "base" })
  );

const modelTagMap = new Map<string, { label: string; count: number }>();

for (const model of models) {
  for (const rawLabel of model.data.tags ?? []) {
    const slug = slugify(rawLabel);
    if (!slug) continue;

    const canonical = getTagByKey(slug);
    const label = canonical?.label ?? rawLabel;

    const existing = modelTagMap.get(slug);
    if (existing) {
      existing.count += 1;
    } else {
      modelTagMap.set(slug, { label, count: 1 });
    }
  }
}

const modelTags = Array.from(modelTagMap.entries())
  .map(([slug, value]) => ({
    slug,
    label: value.label,
    count: value.count,
  }))
  .sort(
    (a, b) =>
      b.count - a.count ||
      a.label.localeCompare(b.label, "fr", { sensitivity: "base" })
  );
---

<BaseLayout
  title="Tags"
  description="Index thématique NESDZ : tags du journal et de l’annuaire ULM."
>
  <section class="container" style="padding: 28px 0 10px;">
    <div class="card">
      <div class="pad">
        <div
          class="row"
          style="justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;"
        >
          <div>
            <h1 style="margin:0 0 8px;">Tags</h1>
            <p class="lead" style="margin:0;">
              Une table des matières par thèmes pour explorer le journal et l’annuaire ULM.
            </p>
          </div>

          <div class="row" style="gap:8px;flex-wrap:wrap;">
            <span class="pill">{articleTags.length} tags journal</span>
            <span class="pill">{modelTags.length} tags modèles</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container" style="padding: 10px 0 26px;">
    <div class="card">
      <div class="pad">
        <div
          class="row"
          style="justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;"
        >
          <h2 style="margin:0;">Tags du journal</h2>
          <span class="pill">{articleTags.length}</span>
        </div>

        <p style="margin:8px 0 0; color:var(--muted);">
          Pilotage, sécurité, météo, navigation, essais, comparatifs et autres thèmes éditoriaux.
        </p>

        <div class="row" style="gap:10px;flex-wrap:wrap;margin-top:14px;">
          {articleTags.map((t) => (
            <a
              class="pill"
              href={`/tags/${t.slug}/`}
              title={`Voir : ${t.label}`}
              style="text-decoration:none;"
            >
              {t.label} · {t.count}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div style="height:16px;"></div>

    <div class="card">
      <div class="pad">
        <div
          class="row"
          style="justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;"
        >
          <h2 style="margin:0;">Tags des modèles</h2>
          <span class="pill">{modelTags.length}</span>
        </div>

        <p style="margin:8px 0 0; color:var(--muted);">
          STOL, voyage, école, matériaux, polyvalence et profils d’usage des machines.
        </p>

        <div class="row" style="gap:10px;flex-wrap:wrap;margin-top:14px;">
          {modelTags.map((t) => (
            <a
              class="pill"
              href={`/tags/${t.slug}/`}
              title={`Voir : ${t.label}`}
              style="text-decoration:none;"
            >
              {t.label} · {t.count}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

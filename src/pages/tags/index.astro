---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

function slugify(input: string) {
  return String(input)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

const articles = await getCollection("articles");

// Map slug -> { label, count }
// label = version “humaine” (avec accents) telle qu’elle apparaît dans le contenu
const tagMap = new Map<string, { label: string; count: number }>();

for (const article of articles) {
  const tags = article.data.tags ?? [];
  for (const label of tags) {
    const slug = slugify(label);
    if (!slug) continue;

    const existing = tagMap.get(slug);
    if (existing) existing.count += 1;
    else tagMap.set(slug, { label, count: 1 });
  }
}

const tags = Array.from(tagMap.entries()).map(([slug, v]) => ({
  slug,
  label: v.label,
  count: v.count,
}));

// Tri “magazine” : les thèmes les plus présents d’abord, puis alpha (FR)
tags.sort(
  (a, b) =>
    b.count - a.count ||
    a.label.localeCompare(b.label, "fr", { sensitivity: "base" })
);
---

<BaseLayout
  title={`Tags · NESDZ`}
  description="Tous les tags du journal NESDZ, pour naviguer par thèmes."
>
  <section class="container">
    <div
      class="row"
      style="justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;"
    >
      <div>
        <h1 style="margin:0 0 8px;">Tags</h1>
        <p class="lead" style="margin:0;">
          Une table des matières par thèmes : sécurité, pilotage, météo…
        </p>
      </div>

      <span class="pill" title="Nombre de tags">{tags.length}</span>
    </div>
  </section>

  <section class="container" style="padding: 10px 0 26px;">
    <div class="card">
      <div class="pad">
        <div class="row" style="gap:8px;flex-wrap:wrap;">
          {
            tags.map((t) => (
              <a class="pill" href={`/tags/${t.slug}/`} title={`Voir : ${t.label}`}>
                <span>{t.label}</span>
                <span class="pill" style="padding:2px 8px;" aria-label="Nombre d’articles">
                  {t.count}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Météo & terrains"
  description="Météo aviation, METAR, TAF et terrains proches."
>
  <section class="container tool-page" style="padding: 20px 0;">
    <div class="card">
      <div class="pad">
        <h1>Météo & terrains</h1>

        <div class="tool-block tool-entry-block">
          <label for="icaoInput" class="tool-entry-label">
            Aérodrome / code OACI
          </label>
          <p class="tool-entry-help">
            Entrer un terrain comme <strong>LFQQ</strong>, <strong>LFPN</strong>
            ou <strong>LFPA</strong> pour afficher la météo aviation, la radio
            utile et les terrains proches.
          </p>

          <div class="row tool-row">
            <input
              id="icaoInput"
              placeholder="Ex : LFQQ"
              value="LFQQ"
              inputmode="text"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              aria-label="Aérodrome ou code OACI"
            />
            <button
              id="loadMetarBtn"
              class="tool-action-btn tool-action-btn--primary"
              type="button"
            >
              Voir METAR / TAF
            </button>
          </div>
        </div>

        <div class="tool-block">
          <h2>Lecture rapide</h2>

          <div class="decoded-grid">
            <div class="decoded-card">
              <span class="decoded-label">Statut</span>
              <strong id="statusValue">Aucune donnée</strong>
            </div>

            <div class="decoded-card">
              <span class="decoded-label">Terrain</span>
              <strong id="nameValue">—</strong>
            </div>

            <div class="decoded-card">
              <span class="decoded-label">Vent</span>
              <strong id="windValue">—</strong>
            </div>

            <div class="decoded-card">
              <span class="decoded-label">Visibilité</span>
              <strong id="visibilityValue">—</strong>
            </div>

            <div class="decoded-card">
              <span class="decoded-label">Nuages</span>
              <strong id="cloudsValue">—</strong>
            </div>

            <div class="decoded-card">
              <span class="decoded-label">Température</span>
              <strong id="tempValue">—</strong>
            </div>

            <div class="decoded-card">
              <span class="decoded-label">Pression</span>
              <strong id="pressureValue">—</strong>
            </div>

            <div class="decoded-card">
              <span class="decoded-label">Catégorie vol</span>
              <strong id="fltCatValue">—</strong>
            </div>

            <div class="decoded-card decoded-card-wide">
              <span class="decoded-label">Radio</span>

              <div class="radio-panel">
                <div class="radio-primary">
                  <div class="radio-primary-head">
                    <span id="radioTypeValue" class="radio-badge">Radio</span>
                    <span class="radio-primary-note">
                      Fréquence principale retenue pour le briefing. Confirmer la
                      fréquence active dans les publications officielles.
                    </span>
                  </div>

                  <div id="radioValue" class="radio-primary-main">—</div>

                  <div id="radioLabelValue" class="radio-primary-label">
                    Aucune fréquence disponible
                  </div>
                </div>

                <div id="radioSecondaryBlock" class="radio-secondary" hidden>
                  <div class="radio-secondary-title">
                    Autres fréquences à connaître
                  </div>
                  <ul id="radioList" class="radio-list"></ul>
                </div>
              </div>
            </div>
          </div>

          <p class="decoded-note">
            Données fournies pour le briefing pilote. Pour toute exploitation,
            confirmer les informations utiles dans les publications officielles
            et consignes locales (AIP, VAC, NOTAM, SUP AIP).
          </p>
        </div>

        <div class="tool-block">
          <h2>Lecture prévision</h2>
          <div class="decoded-grid">
            <div class="decoded-card decoded-card-wide">
              <span class="decoded-label">Tendance</span>
              <strong id="tafSummaryValue">Aucune donnée</strong>
            </div>
          </div>
        </div>

        <div class="tool-block">
          <h2>METAR brut</h2>
          <pre id="metarOutput">Aucune donnée</pre>
        </div>

        <div class="tool-block">
          <h2>TAF brut</h2>
          <pre id="tafOutput">Aucune donnée</pre>
        </div>

        <div
          id="weatherRefsBlock"
          class="tool-block weather-refs-block"
          hidden
        >
          <div class="weather-refs-head">
            <div>
              <h2>Repères météo voisins</h2>
              <p class="weather-refs-note">Aide au briefing uniquement</p>
            </div>
          </div>

          <ul id="weatherRefsList" class="weather-refs-list"></ul>
        </div>

        <div class="tool-block">
          <h2>Aérodromes à proximité</h2>
          <button
            id="nearbyBtn"
            class="tool-action-btn tool-action-btn--secondary"
            type="button"
          >
            Afficher les terrains proches
          </button>
          <ul id="nearbyAirports" class="nearby-list"></ul>
        </div>

        <div class="tool-block tool-block--compact">
          <details class="tool-disclosure">
            <summary>Sources officielles &amp; limites d’usage</summary>

            <div class="tool-disclosure-content">
              <p>
                <strong>Source météo</strong><br />
                Aviation Weather Center — METAR / TAF officiels.
              </p>

              <p>
                <strong>Fréquences radio</strong><br />
                Base radio NESDZ croisée à partir des données SIA lorsqu’elles
                sont disponibles, complétées par une source secondaire.
              </p>

              <p>
                <strong>Terrains &amp; plateformes</strong><br />
                Informations affichées à partir des bases terrains et ULM NESDZ.
              </p>

              <p>
                <strong>Repère météo voisin</strong><br />
                Lorsqu’un terrain ne publie pas de METAR / TAF, NESDZ peut
                afficher un terrain météo voisin clairement identifié pour aider
                au briefing.
              </p>

              <p>
                <strong>Utilisation</strong><br />
                Les informations affichées assistent le briefing pilote et ne
                remplacent pas l’AIP, les cartes VAC, les NOTAM et les
                consignes locales.
              </p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <script>
    const WORKER_URL = "https://metar-proxy-nesdz.elnesdz.workers.dev/";
    const AIRPORTS_URL = "/data/airports-fr-full.json";
    const ULM_URL = "/data/ulm-fr.json";
    const FREQUENCIES_URL = "/data/frequencies-fr-merged.json";
    const WEATHER_REFERENCE_MAX_KM = 50 * 1.852;

    const icaoInput = document.getElementById("icaoInput");
    const metarOutput = document.getElementById("metarOutput");
    const tafOutput = document.getElementById("tafOutput");
    const nearbyAirports = document.getElementById("nearbyAirports");
    const loadMetarBtn = document.getElementById("loadMetarBtn");
    const nearbyBtn = document.getElementById("nearbyBtn");

    const statusValue = document.getElementById("statusValue");
    const nameValue = document.getElementById("nameValue");
    const windValue = document.getElementById("windValue");
    const visibilityValue = document.getElementById("visibilityValue");
    const cloudsValue = document.getElementById("cloudsValue");
    const tempValue = document.getElementById("tempValue");
    const pressureValue = document.getElementById("pressureValue");
    const fltCatValue = document.getElementById("fltCatValue");
    const radioValue = document.getElementById("radioValue");
    const radioTypeValue = document.getElementById("radioTypeValue");
    const radioLabelValue = document.getElementById("radioLabelValue");
    const radioSecondaryBlock = document.getElementById("radioSecondaryBlock");
    const radioList = document.getElementById("radioList");
    const tafSummaryValue = document.getElementById("tafSummaryValue");

    const weatherRefsBlock = document.getElementById("weatherRefsBlock");
    const weatherRefsList = document.getElementById("weatherRefsList");

    let airportsCache = null;
    let airportsPromise = null;

    let ulmCache = null;
    let ulmPromise = null;

    let frequenciesCache = null;
    let frequenciesPromise = null;

    function resetDecoded() {
      statusValue.textContent = "Aucune donnée";
      nameValue.textContent = "—";
      windValue.textContent = "—";
      visibilityValue.textContent = "—";
      cloudsValue.textContent = "—";
      tempValue.textContent = "—";
      pressureValue.textContent = "—";
      fltCatValue.textContent = "—";

      radioValue.textContent = "—";
      if (radioTypeValue) radioTypeValue.textContent = "Radio";
      if (radioLabelValue) {
        radioLabelValue.textContent = "Aucune fréquence disponible";
      }
      if (radioSecondaryBlock) radioSecondaryBlock.hidden = true;
      if (radioList) radioList.innerHTML = "";

      tafSummaryValue.textContent = "Aucune donnée";
    }

    function resetWeatherReferences() {
      if (weatherRefsBlock) weatherRefsBlock.hidden = true;
      if (weatherRefsList) weatherRefsList.innerHTML = "";
    }

    function showWeatherReferencesMessage(message) {
      if (!weatherRefsBlock || !weatherRefsList) return;

      weatherRefsBlock.hidden = false;
      weatherRefsList.innerHTML = `
        <li class="weather-ref-empty">${message}</li>
      `;
    }

    function normalizeCode(value) {
      return String(value || "").trim().toUpperCase();
    }

    function isValidWeatherCode(code) {
      return /^[A-Z]{4}$/.test(normalizeCode(code));
    }

    function getIcaoFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const value = normalizeCode(params.get("icao") || "");
      return isValidWeatherCode(value) ? value : "";
    }

    function syncIcaoInUrl(icao) {
      const url = new URL(window.location.href);

      if (icao && isValidWeatherCode(icao)) {
        url.searchParams.set("icao", icao);
      } else {
        url.searchParams.delete("icao");
      }

      const nextUrl = `${url.pathname}${url.search}${url.hash}`;
      window.history.replaceState({}, "", nextUrl);
    }

    function formatWind(dir, speed) {
      if (dir == null || speed == null) return "—";
      return `${dir}° à ${speed} kt`;
    }

    function formatVisibility(visib) {
      if (visib == null) return "—";
      if (Number(visib) >= 10) return "10 km ou plus";
      return `${visib} km`;
    }

    function formatClouds(item) {
      if (item?.cover && item?.clouds?.length) {
        const firstCloud = item.clouds[0];
        if (firstCloud?.base) {
          return `${item.cover} à ${firstCloud.base} ft`;
        }
        return item.cover;
      }

      if (item?.cover) return item.cover;
      return "—";
    }

    function formatTemp(temp, dewpoint) {
      if (temp == null && dewpoint == null) return "—";
      if (temp != null && dewpoint != null) {
        return `${temp}°C / rosée ${dewpoint}°C`;
      }
      if (temp != null) return `${temp}°C`;
      return `Rosée ${dewpoint}°C`;
    }

    function formatPressure(altim) {
      if (altim == null) return "—";
      return `${altim} hPa`;
    }

    function formatStatus(item) {
      if (!item) return "Aucune donnée";
      if (item.fltCat === "VFR") return "🟢 Conditions VFR (bonnes)";
      if (item.fltCat === "MVFR") return "🟡 VFR marginal (à surveiller)";
      if (item.fltCat === "IFR") return "🔴 IFR (dégradé)";
      if (item.fltCat === "LIFR") return "🚨 IFR basse (très dégradé)";
      return "Données météo reçues";
    }

    function buildSimpleTaf(rawOb, item, icao) {
      if (!rawOb) {
        return `Aucune prévision TAF disponible pour ${icao}. Ce terrain ne publie probablement pas de TAF.`;
      }

      if (item?.fltCat === "VFR") {
        return "🟢 Prévision favorable : conditions VFR attendues si la tendance se maintient.";
      }

      if (item?.fltCat === "MVFR") {
        return "🟡 Prévision à surveiller : conditions VFR marginales possibles.";
      }

      if (item?.fltCat === "IFR") {
        return "🔴 Prévision dégradée : conditions IFR probables.";
      }

      if (item?.fltCat === "LIFR") {
        return "🚨 Prévision critique : conditions très dégradées.";
      }

      return "Prévision disponible en brut ci-dessous.";
    }

    function getAirportWeatherCode(airport) {
      const icao = normalizeCode(airport?.icao);
      if (isValidWeatherCode(icao)) return icao;

      const gpsCode = normalizeCode(airport?.gps_code);
      if (isValidWeatherCode(gpsCode)) return gpsCode;

      return "";
    }

    function normalizeAirportRecord(airport) {
      const weatherCode = getAirportWeatherCode(airport);
      const latitude = Number(airport?.latitude);
      const longitude = Number(airport?.longitude);

      return {
        ...airport,
        weatherCode,
        latitude,
        longitude,
      };
    }

    function isUsableAirport(airport) {
      return (
        airport &&
        airport.type !== "closed" &&
        airport.weatherCode &&
        Number.isFinite(airport.latitude) &&
        Number.isFinite(airport.longitude)
      );
    }

    function dedupeAirports(list) {
      const seen = new Set();

      return list.filter((airport) => {
        const key = airport.weatherCode;
        if (!key || seen.has(key)) return false;
        seen.add(key);
        return true;
      });
    }

    async function loadAirports() {
      if (airportsCache) return airportsCache;

      if (!airportsPromise) {
        airportsPromise = fetch(AIRPORTS_URL)
          .then(async (res) => {
            if (!res.ok) {
              throw new Error("Impossible de charger la base d’aérodromes.");
            }

            const data = await res.json();

            if (!Array.isArray(data)) {
              throw new Error("Format JSON inattendu pour la base d’aérodromes.");
            }

            airportsCache = dedupeAirports(
              data.map(normalizeAirportRecord).filter(isUsableAirport)
            );

            return airportsCache;
          })
          .catch((error) => {
            airportsPromise = null;
            throw error;
          });
      }

      return airportsPromise;
    }

    async function findAirportByCode(code) {
      const normalized = normalizeCode(code);

      if (!normalized) return null;

      try {
        const airports = await loadAirports();
        return (
          airports.find((airport) => airport.weatherCode === normalized) || null
        );
      } catch (error) {
        console.error(error);
        return null;
      }
    }

    function formatAirportDisplayName(airport, fallbackCode) {
      if (!airport) return fallbackCode || "—";

      const labelCode = airport.weatherCode || fallbackCode || "—";
      const municipality = airport.municipality
        ? ` — ${airport.municipality}`
        : "";

      return `${airport.name} (${labelCode})${municipality}`;
    }

    function formatMatchedDisplayName(matchedAirport, matchedUlm) {
      if (matchedAirport) {
        return formatAirportDisplayName(
          matchedAirport,
          matchedAirport.weatherCode
        );
      }

      if (matchedUlm?.name) {
        const codeLabel = matchedUlm.weatherCode || matchedUlm.code || "";
        return codeLabel
          ? `${matchedUlm.name} (${codeLabel})`
          : matchedUlm.name;
      }

      return "";
    }

    function normalizeUlmRecord(item) {
      const code = normalizeCode(item?.code || item?.source_id || "");
      const weatherCode = isValidWeatherCode(item?.weather_code)
        ? normalizeCode(item.weather_code)
        : "";

      return {
        ...item,
        code,
        weatherCode,
        latitude: Number(item?.latitude),
        longitude: Number(item?.longitude),
        platformType: item?.platform_type || "unknown",
        operationalLabel: item?.operational_label || "Plateforme spécifique",
        accessTags: Array.isArray(item?.access_tags) ? item.access_tags : [],
        weatherCapable: Boolean(weatherCode),
      };
    }

    function isUsableUlm(item) {
      return (
        item &&
        Number.isFinite(item.latitude) &&
        Number.isFinite(item.longitude) &&
        item.platformType !== "helistation"
      );
    }

    async function loadUlmBases() {
      if (ulmCache) return ulmCache;

      if (!ulmPromise) {
        ulmPromise = fetch(ULM_URL)
          .then(async (res) => {
            if (!res.ok) {
              throw new Error("Impossible de charger la base ULM.");
            }

            const data = await res.json();

            if (!Array.isArray(data)) {
              throw new Error("Format JSON inattendu pour la base ULM.");
            }

            ulmCache = data.map(normalizeUlmRecord).filter(isUsableUlm);
            return ulmCache;
          })
          .catch((error) => {
            ulmPromise = null;
            throw error;
          });
      }

      return ulmPromise;
    }

    async function findUlmByCode(code) {
      const normalized = normalizeCode(code);

      if (!normalized) return null;

      try {
        const ulmBases = await loadUlmBases();
        return (
          ulmBases.find(
            (item) =>
              item.code === normalized || item.weatherCode === normalized
          ) || null
        );
      } catch (error) {
        console.error(error);
        return null;
      }
    }

    function normalizeFrequencyItem(entry) {
      return {
        ...entry,
        frequency_type: String(entry?.frequency_type || "").trim(),
        label: String(entry?.label || "").trim(),
        description: String(entry?.description || "").trim(),
        service_code: String(entry?.service_code || "").trim(),
        frequency_mhz: Number(entry?.frequency_mhz),
      };
    }

    function normalizeFrequencyRecord(item) {
      return {
        ...item,
        airport_ident: normalizeCode(item?.airport_ident || ""),
        weather_code: normalizeCode(item?.weather_code || ""),
        airport_name: String(item?.airport_name || "").trim(),
        frequencies: Array.isArray(item?.frequencies)
          ? item.frequencies.map(normalizeFrequencyItem)
          : [],
        primary_frequency: item?.primary_frequency
          ? normalizeFrequencyItem(item.primary_frequency)
          : null,
      };
    }

    async function loadFrequencies() {
      if (frequenciesCache) return frequenciesCache;

      if (!frequenciesPromise) {
        frequenciesPromise = fetch(FREQUENCIES_URL)
          .then(async (res) => {
            if (!res.ok) {
              throw new Error("Impossible de charger la base fréquences.");
            }

            const data = await res.json();

            if (!Array.isArray(data)) {
              throw new Error("Format JSON inattendu pour la base fréquences.");
            }

            frequenciesCache = data.map(normalizeFrequencyRecord);
            return frequenciesCache;
          })
          .catch((error) => {
            frequenciesPromise = null;
            throw error;
          });
      }

      return frequenciesPromise;
    }

    async function findFrequencyByCode(code) {
      const normalized = normalizeCode(code);
      if (!normalized) return null;

      try {
        const allFrequencies = await loadFrequencies();

        return (
          allFrequencies.find(
            (item) =>
              item.weather_code === normalized ||
              item.airport_ident === normalized
          ) || null
        );
      } catch (error) {
        console.error(error);
        return null;
      }
    }

    function formatFrequencyMhz(value) {
      const parsed = Number(value);
      return Number.isFinite(parsed) ? `${parsed.toFixed(3)} MHz` : "";
    }

    function normalizeRadioText(value) {
      return String(value || "").trim().replace(/\s+/g, " ");
    }

    function getRadioServiceKey(frequency) {
      const rawType = String(frequency?.frequency_type || "")
        .trim()
        .toLowerCase();

      if (rawType === "tower" || rawType === "twr") return "tower";
      if (rawType === "ground" || rawType === "gnd") return "ground";
      if (rawType === "approach" || rawType === "app") return "approach";
      if (
        rawType === "information" ||
        rawType === "afis" ||
        rawType === "info" ||
        rawType === "fis"
      ) {
        return "information";
      }
      if (rawType === "atis") return "atis";
      if (
        rawType === "air_to_air" ||
        rawType === "air-to-air" ||
        rawType === "ctaf" ||
        rawType === "unicom"
      ) {
        return "air_to_air";
      }

      const rawLabel = normalizeRadioText(
        frequency?.label || frequency?.description
      ).toUpperCase();

      if (rawLabel.includes("ATIS")) return "atis";
      if (
        rawLabel.includes("GND") ||
        rawLabel.includes("GROUND") ||
        rawLabel.includes("SOL")
      ) {
        return "ground";
      }
      if (
        rawLabel.includes("APP") ||
        rawLabel.includes("APPROACH") ||
        rawLabel.includes("APPROCHE")
      ) {
        return "approach";
      }
      if (
        rawLabel.includes("INFO") ||
        rawLabel.includes("INFORMATION") ||
        rawLabel.includes("AFIS") ||
        rawLabel.includes("FIS")
      ) {
        return "information";
      }
      if (
        rawLabel.includes("TWR") ||
        rawLabel.includes("TOUR") ||
        rawLabel.includes("TOWER")
      ) {
        return "tower";
      }
      if (
        rawLabel.includes("AUTO") ||
        rawLabel.includes("AUTO-INFO") ||
        rawLabel.includes("AUTO INFO") ||
        rawLabel.includes("A/A") ||
        rawLabel.includes("UNICOM") ||
        rawLabel.includes("CTAF")
      ) {
        return "air_to_air";
      }

      return rawType || "other";
    }

    function getRadioServiceLabel(frequency) {
      switch (getRadioServiceKey(frequency)) {
        case "tower":
          return "Tour";
        case "ground":
          return "Sol";
        case "approach":
          return "Approche";
        case "information":
          return "Info";
        case "atis":
          return "ATIS";
        case "air_to_air":
          return "Auto-information";
        default:
          return "Radio";
      }
    }

    function getRadioServicePriorityByLabel(serviceLabel) {
      const normalized = normalizeRadioText(serviceLabel).toLowerCase();

      if (normalized === "atis") return 1;
      if (normalized === "sol") return 2;
      if (normalized === "tour") return 3;
      if (normalized === "approche") return 4;
      if (normalized === "info") return 5;
      if (normalized === "auto-information") return 6;
      return 9;
    }

    function getRadioServicePriority(frequency) {
      return getRadioServicePriorityByLabel(getRadioServiceLabel(frequency));
    }

    function formatRadioPlaceName(text) {
      return String(text || "")
        .split(" ")
        .filter(Boolean)
        .map((word) => {
          if (!word) return "";

          if (word.includes("-")) {
            return word
              .split("-")
              .map((part) => {
                if (!part) return "";
                return (
                  part.charAt(0).toUpperCase() + part.slice(1).toLowerCase()
                );
              })
              .join("-");
          }

          return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
        })
        .join(" ");
    }

    function extractRadioPlaceLabel(rawLabel) {
      const cleaned = normalizeRadioText(rawLabel)
        .replace(
          /\b(TWR|TOWER|TOUR|GND|GROUND|SOL|APP|APPROACH|APPROCHE|INFO|INFORMATION|AFIS|FIS|ATIS|AUTO-INFO|AUTO INFO|AUTO|A\/A|UNICOM|CTAF|RADIO)\b/gi,
          " "
        )
        .replace(/[·|/]+/g, " ")
        .replace(/\s+/g, " ")
        .trim();

      return formatRadioPlaceName(cleaned);
    }

    function getRadioDisplayLabel(frequency) {
      const rawLabel = normalizeRadioText(
        frequency?.label || frequency?.description || ""
      );
      const serviceLabel = getRadioServiceLabel(frequency);

      if (!rawLabel) {
        return serviceLabel || "Fréquence";
      }

      const placeLabel = extractRadioPlaceLabel(rawLabel);

      if (serviceLabel === "Radio") {
        return placeLabel || rawLabel || "Fréquence";
      }

      return placeLabel ? `${serviceLabel} ${placeLabel}` : serviceLabel;
    }

    function getRadioGroupKey(frequency) {
      return `${getRadioServiceKey(frequency)}|${formatFrequencyMhz(
        frequency?.frequency_mhz
      )}`;
    }

    function getRadioRank(frequency) {
      const label = getRadioDisplayLabel(frequency);
      const hasServiceCode = frequency?.service_code ? 10 : 0;
      const hasDescription = normalizeRadioText(frequency?.description).length
        ? 4
        : 0;

      return label.length + hasServiceCode + hasDescription;
    }

    function pickBestRadioFrequency(frequencies = []) {
      return frequencies.reduce((best, current) => {
        if (!best) return current;
        return getRadioRank(current) > getRadioRank(best) ? current : best;
      }, null);
    }

    function dedupeRadioFrequencies(frequencies = []) {
      const groups = new Map();

      frequencies.forEach((frequency) => {
        const key = getRadioGroupKey(frequency);
        const current = groups.get(key);

        if (!current || getRadioRank(frequency) > getRadioRank(current)) {
          groups.set(key, frequency);
        }
      });

      return Array.from(groups.values());
    }

    function mergeRadioFrequenciesByMhz(frequencies = []) {
      const buckets = new Map();

      frequencies.forEach((frequency) => {
        const mhzLabel = formatFrequencyMhz(frequency?.frequency_mhz);
        if (!mhzLabel) return;

        if (!buckets.has(mhzLabel)) {
          buckets.set(mhzLabel, {
            key: mhzLabel,
            frequency_mhz: Number(frequency?.frequency_mhz),
            bestItem: frequency,
            services: new Map(),
            places: new Map(),
          });
        }

        const bucket = buckets.get(mhzLabel);

        if (getRadioRank(frequency) > getRadioRank(bucket.bestItem)) {
          bucket.bestItem = frequency;
        }

        const serviceLabel = getRadioServiceLabel(frequency);
        if (serviceLabel && serviceLabel !== "Radio") {
          bucket.services.set(serviceLabel.toLowerCase(), serviceLabel);
        }

        const placeLabel = extractRadioPlaceLabel(
          frequency?.label || frequency?.description || ""
        );

        if (placeLabel) {
          bucket.places.set(
            placeLabel,
            (bucket.places.get(placeLabel) || 0) + 1
          );
        }
      });

      return Array.from(buckets.values())
        .map((bucket) => {
          const mergedServices = Array.from(bucket.services.values()).sort(
            (a, b) => {
              const priorityDiff =
                getRadioServicePriorityByLabel(a) -
                getRadioServicePriorityByLabel(b);

              if (priorityDiff !== 0) return priorityDiff;

              return a.localeCompare(b, "fr", { sensitivity: "base" });
            }
          );

          const dominantPlace =
            Array.from(bucket.places.entries()).sort((a, b) => {
              if (b[1] !== a[1]) return b[1] - a[1];
              return a[0].localeCompare(b[0], "fr", {
                sensitivity: "base",
              });
            })[0]?.[0] || "";

          let displayLabel = "";

          if (mergedServices.length > 0 && dominantPlace) {
            displayLabel = `${mergedServices.join(" / ")} ${dominantPlace}`;
          } else if (mergedServices.length > 0) {
            displayLabel = mergedServices.join(" / ");
          } else if (dominantPlace) {
            displayLabel = dominantPlace;
          } else {
            displayLabel = getRadioDisplayLabel(bucket.bestItem);
          }

          return {
            key: bucket.key,
            frequency_mhz: bucket.frequency_mhz,
            displayLabel,
            priority:
              mergedServices.length > 0
                ? getRadioServicePriorityByLabel(mergedServices[0])
                : getRadioServicePriority(bucket.bestItem),
          };
        })
        .sort((a, b) => {
          if (a.priority !== b.priority) {
            return a.priority - b.priority;
          }

          const labelDiff = a.displayLabel.localeCompare(
            b.displayLabel,
            "fr",
            { sensitivity: "base" }
          );

          if (labelDiff !== 0) return labelDiff;

          const mhzA = Number(a.frequency_mhz);
          const mhzB = Number(b.frequency_mhz);

          if (Number.isFinite(mhzA) && Number.isFinite(mhzB)) {
            return mhzA - mhzB;
          }

          return 0;
        });
    }

    function renderFrequencyPanel(record) {
      if (!radioValue || !radioTypeValue || !radioLabelValue) return;

      if (radioList) radioList.innerHTML = "";
      if (radioSecondaryBlock) radioSecondaryBlock.hidden = true;

      if (
        !record ||
        !Array.isArray(record.frequencies) ||
        record.frequencies.length === 0
      ) {
        radioTypeValue.textContent = "Radio";
        radioValue.textContent = "Non disponible";
        radioLabelValue.textContent =
          "Aucune fréquence exploitable trouvée pour ce terrain.";
        return;
      }

      const allFrequencies = Array.isArray(record.frequencies)
        ? record.frequencies
        : [];

      const dedupedFrequencies = dedupeRadioFrequencies(allFrequencies);

      const primaryCandidate = record.primary_frequency
        ? pickBestRadioFrequency(
            allFrequencies.filter(
              (frequency) =>
                getRadioGroupKey(frequency) ===
                getRadioGroupKey(record.primary_frequency)
            )
          )
        : null;

      const primaryFrequency =
        primaryCandidate || dedupedFrequencies[0] || null;

      if (!primaryFrequency) {
        radioTypeValue.textContent = "Radio";
        radioValue.textContent = "Non disponible";
        radioLabelValue.textContent =
          "Aucune fréquence exploitable trouvée pour ce terrain.";
        return;
      }

      radioTypeValue.textContent = getRadioServiceLabel(primaryFrequency);
      radioValue.textContent =
        formatFrequencyMhz(primaryFrequency.frequency_mhz) || "—";
      radioLabelValue.textContent = getRadioDisplayLabel(primaryFrequency);

      const primaryMhzLabel = formatFrequencyMhz(primaryFrequency.frequency_mhz);

      const secondaryBuckets = mergeRadioFrequenciesByMhz(
        dedupedFrequencies.filter(
          (frequency) =>
            formatFrequencyMhz(frequency.frequency_mhz) !== primaryMhzLabel
        )
      );

      if (!radioList || secondaryBuckets.length === 0) return;

      if (radioSecondaryBlock) radioSecondaryBlock.hidden = false;

      secondaryBuckets.forEach((entry) => {
        const item = document.createElement("li");

        item.innerHTML = `
          <div>
            <strong>${entry.displayLabel}</strong>
          </div>
          <span>${formatFrequencyMhz(entry.frequency_mhz) || "—"}</span>
        `;

        radioList.appendChild(item);
      });
    }

    function getDistanceKm(lat1, lon1, lat2, lon2) {
      const toRad = (value) => (value * Math.PI) / 180;
      const R = 6371;

      const dLat = toRad(lat2 - lat1);
      const dLon = toRad(lon2 - lon1);

      const a =
        Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(toRad(lat1)) *
          Math.cos(toRad(lat2)) *
          Math.sin(dLon / 2) *
          Math.sin(dLon / 2);

      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      return R * c;
    }

    function formatDistanceLabel(distanceKm) {
      if (!Number.isFinite(distanceKm)) return "";
      const distanceNm = distanceKm / 1.852;
      return `${distanceNm.toFixed(0)} NM · ${distanceKm.toFixed(1)} km`;
    }

    function formatReferenceIdentity(reference) {
      if (!reference?.airport) return "";

      const code = reference.airport.weatherCode || reference.snapshot?.icao || "";
      const name = reference.airport.name || code || "Terrain voisin";

      return code ? `${name} (${code})` : name;
    }

    function formatNeighborStatus(reference) {
      const identity = formatReferenceIdentity(reference);

      if (reference?.snapshot?.fltCat === "VFR") {
        return `🟢 VFR voisin — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "MVFR") {
        return `🟡 MVFR voisin — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "IFR") {
        return `🔴 IFR voisin — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "LIFR") {
        return `🚨 LIFR voisin — ${identity}`;
      }

      return `Repère météo voisin — ${identity}`;
    }

    function formatNeighborFlightCategory(reference) {
      const category = reference?.snapshot?.fltCat;
      return category ? `${category} voisin` : "Voisin";
    }

    function buildNeighborMetarOutput(reference, targetCode, fallbackMessage) {
      if (!reference?.snapshot?.rawOb) return fallbackMessage;

      const identity = formatReferenceIdentity(reference);
      const distanceLabel = formatDistanceLabel(reference.distanceKm);

      return `Aucun METAR publié pour ${targetCode}.
Repère voisin retenu : ${identity}${distanceLabel ? ` — ${distanceLabel}` : ""}.

${reference.snapshot.rawOb}`;
    }

    function buildNeighborTafOutput(reference, targetCode, fallbackMessage) {
      if (!reference) return fallbackMessage;

      const identity = formatReferenceIdentity(reference);
      const distanceLabel = formatDistanceLabel(reference.distanceKm);

      if (reference?.snapshot?.taf) {
        return `Aucun TAF publié pour ${targetCode}.
Repère voisin retenu : ${identity}${distanceLabel ? ` — ${distanceLabel}` : ""}.

${reference.snapshot.taf}`;
      }

      return `Aucun TAF publié pour ${targetCode}.
Repère voisin retenu : ${identity}${distanceLabel ? ` — ${distanceLabel}` : ""}.

TAF voisin indisponible sur ce terrain de référence.`;
    }

    function buildNeighborTafSummary(reference) {
      if (!reference) return "Prévision indisponible";

      const identity = formatReferenceIdentity(reference);

      if (!reference?.snapshot?.taf) {
        return `Prévision voisine indisponible — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "VFR") {
        return `🟢 Tendance voisine VFR — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "MVFR") {
        return `🟡 Tendance voisine MVFR — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "IFR") {
        return `🔴 Tendance voisine IFR — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "LIFR") {
        return `🚨 Tendance voisine LIFR — ${identity}`;
      }

      return `Prévision voisine disponible — ${identity}`;
    }

    function getAirportOperationalLabel(airport, basulmOverlay) {
      if (basulmOverlay?.operationalLabel) return basulmOverlay.operationalLabel;

      if (airport.type === "large_airport") return "Aérodrome principal";
      if (airport.type === "medium_airport") return "Aérodrome";
      if (airport.type === "small_airport") return "Aérodrome";
      return "Plateforme aéronautique";
    }

    function formatAccessTags(tags = []) {
      const labels = [];

      if (tags.includes("open_to_ulm")) labels.push("Ouvert aux ULM");
      if (tags.includes("authorization_required")) {
        labels.push("Autorisation obligatoire");
      }
      if (tags.includes("private")) labels.push("Privé");
      if (tags.includes("restricted")) labels.push("Restrictions");
      if (tags.includes("specific_rules")) labels.push("Règles spécifiques");
      if (tags.includes("in_service")) labels.push("En service");

      return labels.join(" · ");
    }

    function buildBasulmIndexByWeatherCode(ulmBases) {
      const map = new Map();

      ulmBases.forEach((item) => {
        if (!item.weatherCode) return;
        if (!map.has(item.weatherCode)) {
          map.set(item.weatherCode, item);
        }
      });

      return map;
    }

    async function fetchWeatherSnapshot(icao) {
      const normalized = normalizeCode(icao);
      if (!normalized) return null;

      try {
        const res = await fetch(
          `${WORKER_URL}?icao=${encodeURIComponent(normalized)}`
        );

        if (!res.ok) return null;

        const data = await res.json();

        if (!Array.isArray(data) || data.length === 0) return null;

        const item = data[0];

        if (!item || typeof item !== "object" || !item.rawOb) return null;

        return {
          icao: normalized,
          rawOb: item.rawOb || "",
          taf: item.taf || "",
          fltCat: item.fltCat || "",
        };
      } catch (error) {
        console.error(error);
        return null;
      }
    }

    function formatWeatherReferenceMeta(snapshot) {
      const parts = ["METAR disponible"];
      parts.push(snapshot?.taf ? "TAF disponible" : "TAF indisponible");

      if (snapshot?.fltCat) {
        parts.push(snapshot.fltCat);
      }

      return parts.join(" · ");
    }

    function getWeatherReferenceCenter(matchedAirport, matchedUlm) {
      if (
        matchedAirport &&
        Number.isFinite(matchedAirport.latitude) &&
        Number.isFinite(matchedAirport.longitude)
      ) {
        return {
          latitude: matchedAirport.latitude,
          longitude: matchedAirport.longitude,
        };
      }

      if (
        matchedUlm &&
        Number.isFinite(matchedUlm.latitude) &&
        Number.isFinite(matchedUlm.longitude)
      ) {
        return {
          latitude: matchedUlm.latitude,
          longitude: matchedUlm.longitude,
        };
      }

      return null;
    }

    async function findNearbyWeatherReferences(
      targetCode,
      matchedAirport,
      matchedUlm
    ) {
      const center = getWeatherReferenceCenter(matchedAirport, matchedUlm);
      if (!center) return [];

      try {
        const airports = await loadAirports();

        const nearbyCandidates = airports
          .filter((airport) => airport.weatherCode !== normalizeCode(targetCode))
          .map((airport) => ({
            airport,
            distanceKm: getDistanceKm(
              center.latitude,
              center.longitude,
              airport.latitude,
              airport.longitude
            ),
          }))
          .filter((item) => item.distanceKm <= WEATHER_REFERENCE_MAX_KM)
          .sort((a, b) => a.distanceKm - b.distanceKm)
          .slice(0, 12);

        if (nearbyCandidates.length === 0) return [];

        const candidateResults = await Promise.all(
          nearbyCandidates.map(async (item) => {
            const snapshot = await fetchWeatherSnapshot(item.airport.weatherCode);

            return snapshot
              ? {
                  airport: item.airport,
                  distanceKm: item.distanceKm,
                  snapshot,
                }
              : null;
          })
        );

        return candidateResults.filter(Boolean).slice(0, 3);
      } catch (error) {
        console.error(error);
        return [];
      }
    }

    async function loadWeatherReferences(
      targetCode,
      matchedAirport,
      matchedUlm,
      precomputedReferences = null
    ) {
      if (!weatherRefsBlock || !weatherRefsList) return;

      const references =
        precomputedReferences ||
        (await findNearbyWeatherReferences(targetCode, matchedAirport, matchedUlm));

      if (!references || references.length === 0) {
        showWeatherReferencesMessage(
          "Aucun repère météo publié trouvé dans un rayon de 50 NM autour de ce terrain."
        );
        return;
      }

      weatherRefsBlock.hidden = false;
      weatherRefsList.innerHTML = "";

      references.forEach((reference) => {
        const li = document.createElement("li");

        li.innerHTML = `
          <button type="button" class="weather-ref-card">
            <div class="weather-ref-top">
              <strong>${reference.airport.weatherCode}</strong>
              <span>${formatDistanceLabel(reference.distanceKm)}</span>
            </div>
            <div class="weather-ref-name">${reference.airport.name}</div>
            <div class="weather-ref-meta">${formatWeatherReferenceMeta(reference.snapshot)}</div>
            <div class="weather-ref-action">Voir METAR / TAF</div>
          </button>
        `;

        const button = li.querySelector("button");

        button?.addEventListener("click", () => {
          icaoInput.value = reference.airport.weatherCode;
          loadMetar();
          window.scrollTo({ top: 0, behavior: "smooth" });
        });

        weatherRefsList.appendChild(li);
      });
    }

    async function applyMissingLocalWeatherState({
      icao,
      matchedAirport,
      matchedUlm,
      matchedFrequency,
      metarMessage,
      tafMessage,
      emptyStatusMessage,
    }) {
      const references = await findNearbyWeatherReferences(
        icao,
        matchedAirport,
        matchedUlm
      );
      const primaryReference = references[0] || null;

      resetDecoded();

      nameValue.textContent =
        formatMatchedDisplayName(matchedAirport, matchedUlm) || icao;
      windValue.textContent = "Non disponible";
      visibilityValue.textContent = "Non disponible";
      cloudsValue.textContent = "Non disponible";
      tempValue.textContent = "Non disponible";
      pressureValue.textContent = "Non disponible";
      renderFrequencyPanel(matchedFrequency);

      if (primaryReference) {
        statusValue.textContent = formatNeighborStatus(primaryReference);
        fltCatValue.textContent = formatNeighborFlightCategory(primaryReference);
        metarOutput.textContent = buildNeighborMetarOutput(
          primaryReference,
          icao,
          metarMessage
        );
        tafOutput.textContent = buildNeighborTafOutput(
          primaryReference,
          icao,
          tafMessage
        );
        tafSummaryValue.textContent = buildNeighborTafSummary(primaryReference);
      } else {
        statusValue.textContent = emptyStatusMessage;
        fltCatValue.textContent = "Non disponible";
        metarOutput.textContent = metarMessage;
        tafOutput.textContent = tafMessage;
        tafSummaryValue.textContent = "Prévision indisponible";
      }

      await loadWeatherReferences(
        icao,
        matchedAirport,
        matchedUlm,
        references
      );
    }

    async function resolveNearbyCenter() {
      const enteredCode = normalizeCode(icaoInput?.value);

      if (enteredCode) {
        const matchedAirport = await findAirportByCode(enteredCode);
        if (matchedAirport) {
          return {
            latitude: matchedAirport.latitude,
            longitude: matchedAirport.longitude,
            label: `Terrains autour de ${matchedAirport.weatherCode} — ${matchedAirport.name}`,
          };
        }

        const matchedUlm = await findUlmByCode(enteredCode);
        if (matchedUlm) {
          return {
            latitude: matchedUlm.latitude,
            longitude: matchedUlm.longitude,
            label: `Terrains autour de ${matchedUlm.code} — ${matchedUlm.name}`,
          };
        }
      }

      if (!navigator.geolocation) {
        throw new Error("geolocation_not_supported");
      }

      return new Promise((resolve, reject) => {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            resolve({
              latitude: pos.coords.latitude,
              longitude: pos.coords.longitude,
              label: "Terrains autour de votre position",
            });
          },
          () => reject(new Error("geolocation_failed"))
        );
      });
    }

    function renderNearbyHeader(centerLabel) {
      const li = document.createElement("li");
      li.className = "nearby-section-header";
      li.innerHTML = `
        <strong>${centerLabel}</strong>
        <small>
          Vérifier systématiquement les conditions d’utilisation publiées
          (AIP, VAC, NOTAM, consignes locales) avant toute exploitation.
        </small>
      `;
      nearbyAirports.appendChild(li);
    }

    function renderNearbyGroupTitle(title) {
      const li = document.createElement("li");
      const isUlmGroup = title.toLowerCase().includes("ulm");

      li.className = isUlmGroup
        ? "nearby-group-title nearby-group-title--ulm"
        : "nearby-group-title nearby-group-title--airports";

      li.textContent = title;
      nearbyAirports.appendChild(li);
    }

    function renderEmptyGroup(message) {
      const li = document.createElement("li");
      li.className = "nearby-empty";
      li.textContent = message;
      nearbyAirports.appendChild(li);
    }

    function renderWeatherNearbyItem(item) {
      const li = document.createElement("li");
      li.className = "nearby-item";

      const button = document.createElement("button");
      button.type = "button";
      button.className = "airport-nearby-card airport-nearby-card--clickable";

      const accessLine = item.accessLabel
        ? `<div class="airport-nearby-access">${item.accessLabel}</div>`
        : "";

      button.innerHTML = `
        <div class="airport-nearby-top">
          <strong>${item.code}</strong>
          <span>${formatDistanceLabel(item.distanceKm)}</span>
        </div>
        <div class="airport-nearby-name">${item.name}</div>
        <div class="airport-nearby-meta">
          ${item.operationalLabel}${item.municipality ? ` · ${item.municipality}` : ""}
        </div>
        ${accessLine}
        <div class="airport-nearby-action">Voir METAR / TAF</div>
      `;

      button.addEventListener("click", () => {

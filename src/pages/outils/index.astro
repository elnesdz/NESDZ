    : "";

  const weatherLine = item.weatherCapable
    ? `<div class="airport-nearby-support">Code météo possible : ${item.weatherCode}</div>`
    : `<div class="airport-nearby-support">Repère météo voisin si disponible</div>`;

  button.innerHTML = `

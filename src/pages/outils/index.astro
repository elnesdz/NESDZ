---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="NESDZ"
  description="ULM, aviation légère, journal éditorial, annuaire ULM et outil météo & terrains pour le briefing pilote."
>
  <section class="container home-page" style="padding: 24px 0 36px;">
    <div class="home-hero card">
      <div class="pad home-hero-pad">
        <div class="home-hero-copy">
          <p class="home-kicker">ULM · aviation légère · briefing pilote</p>

          <h1>NESDZ</h1>

          <p class="home-intro">
            Un site pensé pour les pilotes et passionnés d’aviation légère :
            journal, annuaire ULM, contenus éditoriaux et outil météo &amp;
            terrains pour préparer un vol plus clairement.
          </p>

          <div class="home-actions">
            <a class="home-primary-cta" href="/outils/">
              <span class="home-primary-cta__eyebrow">Outil pilote</span>
              <span class="home-primary-cta__label">Météo &amp; terrains</span>
            </a>

            <div class="home-secondary-actions">
              <a class="home-secondary-link" href="/journal/">Journal</a>
              <a class="home-secondary-link" href="/modeles/">Annuaire ULM</a>
              <a class="home-secondary-link" href="/edito/">Édito</a>
            </div>
          </div>
        </div>

        <div class="home-hero-panel">
          <div class="home-hero-panel-card home-hero-panel-card--primary">
            <span class="home-panel-kicker">Accès rapide</span>
            <h2>Météo &amp; terrains</h2>
            <p>
              METAR, TAF, radio utile, terrains voisins, plateformes ULM et
              repères météo proches dans une interface pensée briefing.
            </p>
            <a class="home-panel-link" href="/outils/">Ouvrir l’outil</a>
          </div>

          <div class="home-hero-panel-grid">
            <a class="home-mini-card" href="/journal/">
              <span class="home-mini-card__kicker">Journal</span>
              <strong>Derniers articles</strong>
              <p>Analyses, billets et contenus aviation légère.</p>
            </a>

            <a class="home-mini-card" href="/modeles/">
              <span class="home-mini-card__kicker">Annuaire ULM</span>
              <strong>Modèles en vedette</strong>
              <p>Explorer la base ULM et les fiches utiles.</p>
            </a>

            <a class="home-mini-card" href="/edito/">
              <span class="home-mini-card__kicker">Édito</span>
              <strong>Vision NESDZ</strong>
              <p>Une ligne éditoriale premium, claire et utile.</p>
            </a>

            <a class="home-mini-card" href="/a-propos/">
              <span class="home-mini-card__kicker">À propos</span>
              <strong>Le projet</strong>
              <p>Comprendre l’ambition produit et l’approche du site.</p>
            </a>
          </div>
        </div>
      </div>
    </div>

    <section class="home-section">
      <div class="home-section-head">
        <div>
          <p class="home-section-kicker">Navigation rapide</p>
          <h2>Les grandes entrées du site</h2>
        </div>
      </div>

      <div class="home-grid">
        <a class="home-feature-card home-feature-card--tool" href="/outils/">
          <span class="home-feature-card__kicker">Outil du site</span>
          <h3>Météo &amp; terrains</h3>
          <p>
            L’accès le plus direct vers la météo aviation, les radios utiles, les
            terrains voisins et les plateformes spécifiques.
          </p>
          <span class="home-feature-card__cta">Accéder à l’outil</span>
        </a>

        <a class="home-feature-card" href="/journal/">
          <span class="home-feature-card__kicker">Lecture</span>
          <h3>Journal</h3>
          <p>
            Retrouver les derniers articles, analyses et billets publiés sur
            NESDZ.
          </p>
          <span class="home-feature-card__cta">Lire le journal</span>
        </a>

        <a class="home-feature-card" href="/modeles/">
          <span class="home-feature-card__kicker">Annuaire</span>
          <h3>Annuaire ULM</h3>
          <p>
            Explorer les modèles, bases et entrées utiles liées à l’ULM et à
            l’aviation légère.
          </p>
          <span class="home-feature-card__cta">Voir l’annuaire</span>
        </a>
      </div>
    </section>
  </section>

  <style is:global>
    .home-page {
      display: grid;
      gap: 28px;
    }

    .home-page .home-hero {
      overflow: hidden;
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background:
        radial-gradient(
          circle at top right,
          rgba(111, 184, 214, 0.14),
          transparent 30%
        ),
        radial-gradient(
          circle at left center,
          rgba(111, 184, 214, 0.08),
          transparent 32%
        ),
        linear-gradient(
          135deg,
          rgba(11, 18, 26, 0.98),
          rgba(12, 22, 34, 0.96)
        );
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.03),
        0 18px 42px rgba(0, 0, 0, 0.18);
    }

    .home-page .home-hero-pad {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
      gap: 28px;
      align-items: stretch;
      padding: 30px;
    }

    .home-page .home-hero-copy {
      display: grid;
      align-content: start;
      gap: 16px;
    }

    .home-page .home-kicker,
    .home-page .home-section-kicker,
    .home-page .home-panel-kicker,
    .home-page .home-feature-card__kicker,
    .home-page .home-mini-card__kicker,
    .home-page .home-primary-cta__eyebrow {
      margin: 0;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(181, 205, 220, 0.84);
    }

    .home-page h1 {
      margin: 0;
      font-size: clamp(3.4rem, 8vw, 5.5rem);
      line-height: 0.98;
      letter-spacing: -0.03em;
    }

    .home-page .home-intro {
      margin: 0;
      max-width: 62ch;
      font-size: 1.08rem;
      line-height: 1.7;
      color: rgba(225, 233, 241, 0.86);
    }

    .home-page .home-actions {
      display: grid;
      gap: 14px;
      margin-top: 6px;
    }

    .home-page .home-primary-cta {
      display: inline-grid;
      gap: 4px;
      align-content: center;
      width: fit-content;
      min-width: 290px;
      padding: 16px 22px;
      border-radius: 18px;
      text-decoration: none;
      color: #f7fbff;
      border: 1px solid rgba(111, 184, 214, 0.9);
      background:
        linear-gradient(
          180deg,
          rgba(111, 184, 214, 0.56),
          rgba(111, 184, 214, 0.24)
        ),
        rgba(18, 37, 51, 0.98);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.14),
        0 0 0 1px rgba(111, 184, 214, 0.14),
        0 14px 34px rgba(0, 0, 0, 0.2);
      transition:
        transform 0.18s ease,
        border-color 0.18s ease,
        box-shadow 0.18s ease,
        background 0.18s ease;
    }

    .home-page .home-primary-cta:hover {
      transform: translateY(-1px);
      border-color: rgba(143, 206, 233, 1);
      background:
        linear-gradient(
          180deg,
          rgba(111, 184, 214, 0.68),
          rgba(111, 184, 214, 0.3)
        ),
        rgba(18, 37, 51, 1);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.16),
        0 0 0 4px rgba(111, 184, 214, 0.16),
        0 18px 38px rgba(0, 0, 0, 0.24);
    }

    .home-page .home-primary-cta__label {
      font-size: 1.32rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.05;
    }

    .home-page .home-secondary-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .home-page .home-secondary-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 10px 14px;
      border-radius: 12px;
      text-decoration: none;
      color: rgba(236, 242, 247, 0.95);
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
      transition:
        transform 0.18s ease,
        border-color 0.18s ease,
        background 0.18s ease;
    }

    .home-page .home-secondary-link:hover {
      transform: translateY(-1px);
      border-color: rgba(111, 184, 214, 0.36);
      background: rgba(255, 255, 255, 0.06);
    }

    .home-page .home-hero-panel {
      display: grid;
      gap: 14px;
    }

    .home-page .home-hero-panel-card,
    .home-page .home-mini-card,
    .home-page .home-feature-card {
      border-radius: 18px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      text-decoration: none;
      color: inherit;
      background:
        linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.04),
          rgba(255, 255, 255, 0.025)
        ),
        rgba(16, 24, 33, 0.76);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
      transition:
        transform 0.18s ease,
        border-color 0.18s ease,
        background 0.18s ease,
        box-shadow 0.18s ease;
    }

    .home-page .home-hero-panel-card:hover,
    .home-page .home-mini-card:hover,
    .home-page .home-feature-card:hover {
      transform: translateY(-1px);
      border-color: rgba(111, 184, 214, 0.28);
      background:
        linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.05),
          rgba(255, 255, 255, 0.03)
        ),
        rgba(16, 24, 33, 0.84);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.04),
        0 12px 28px rgba(0, 0, 0, 0.16);
    }

    .home-page .home-hero-panel-card {
      display: grid;
      gap: 10px;
      padding: 20px;
    }

    .home-page .home-hero-panel-card h2,
    .home-page .home-feature-card h3 {
      margin: 0;
      font-size: 1.55rem;
      line-height: 1.1;
    }

    .home-page .home-hero-panel-card p,
    .home-page .home-feature-card p,
    .home-page .home-mini-card p {
      margin: 0;
      color: rgba(220, 229, 236, 0.8);
      line-height: 1.6;
    }

    .home-page .home-panel-link,
    .home-page .home-feature-card__cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 2px;
      color: rgba(203, 236, 252, 0.98);
      font-weight: 700;
    }

    .home-page .home-hero-panel-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .home-page .home-mini-card {
      display: grid;
      gap: 8px;
      padding: 18px;
    }

    .home-page .home-mini-card strong {
      font-size: 1.04rem;
      color: rgba(241, 246, 250, 0.98);
    }

    .home-page .home-section {
      display: grid;
      gap: 16px;
    }

    .home-page .home-section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 14px;
    }

    .home-page .home-section-head h2 {
      margin: 4px 0 0;
      font-size: clamp(1.7rem, 3vw, 2.4rem);
      line-height: 1.08;
    }

    .home-page .home-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .home-page .home-feature-card {
      display: grid;
      gap: 12px;
      padding: 22px;
    }

    .home-page .home-feature-card--tool {
      border-color: rgba(111, 184, 214, 0.36);
      background:
        linear-gradient(
          180deg,
          rgba(111, 184, 214, 0.14),
          rgba(255, 255, 255, 0.025)
        ),
        rgba(16, 24, 33, 0.82);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.04),
        0 0 0 1px rgba(111, 184, 214, 0.05);
    }

    @media (max-width: 1080px) {
      .home-page .home-hero-pad {
        grid-template-columns: 1fr;
      }

      .home-page .home-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 720px) {
      .home-page .home-hero-pad {
        padding: 22px 20px;
        gap: 22px;
      }

      .home-page .home-intro {
        font-size: 1rem;
      }

      .home-page .home-primary-cta {
        width: 100%;
        min-width: 0;
      }

      .home-page .home-hero-panel-grid {
        grid-template-columns: 1fr;
      }

      .home-page .home-feature-card,
      .home-page .home-mini-card,
      .home-page .home-hero-panel-card {
        padding: 18px;
      }
    }
  </style>
</BaseLayout>

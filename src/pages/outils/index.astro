---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Météo & terrains"
  description="Météo aviation, METAR, TAF et terrains proches."
>
  <section class="container tool-page" style="padding: 20px 0;">
    <div class="card">
      <div class="pad">
        <h1>Météo & terrains</h1>

        <div class="tool-block tool-entry-block">
          <label for="icaoInput" class="tool-entry-label">
            Code OACI ou ville
          </label>
          <p class="tool-entry-help">
            Entre un code OACI, une ville ou utilise <strong>Me localiser</strong>.
          </p>
          <div class="row tool-row">
            <div class="tool-search-col">
              <input
                id="icaoInput"
                placeholder="Ex : LFQQ ou Lille"
                value="LFQQ"
                inputmode="text"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
                enterkeyhint="search"
                aria-label="Terrain, code OACI ou ville"
              />
              <div
                id="searchSuggestions"
                class="tool-search-suggestions"
                role="listbox"
                aria-label="Suggestions de recherche"
                hidden
              ></div>
              <p id="searchFeedback" class="tool-search-feedback" hidden></p>
            </div>
            <div class="tool-entry-actions">
              <button
                id="loadMetarBtn"
                class="tool-action-btn tool-action-btn--primary"
                type="button"
              >
                Voir METAR / TAF
              </button>
              <button
                id="locateBtn"
                class="tool-action-btn tool-action-btn--secondary"
                type="button"
              >
                Me localiser
              </button>
            </div>
          </div>

          <p class="tool-entry-help tool-entry-help--reference">
            Pour la préparation du vol, les services officiels en vigueur restent la référence.
          </p>
        </div>

        <div class="tool-block">
          <h2>Lecture rapide</h2>

          <div class="decoded-grid decoded-grid--summary">
            <div class="decoded-card decoded-card-status decoded-card-mobile-wide">
              <span class="decoded-label">Statut</span>
              <strong id="statusValue">Aucune donnée</strong>
            </div>

            <div class="decoded-card decoded-card-terrain decoded-card-mobile-wide">
              <span class="decoded-label">Terrain</span>
              <strong id="nameValue">—</strong>
            </div>

            <div class="decoded-card decoded-card-metric">
              <span class="decoded-label">Vent</span>
              <strong id="windValue">—</strong>
            </div>

            <div class="decoded-card decoded-card-metric">
              <span class="decoded-label">Visibilité</span>
              <strong id="visibilityValue">—</strong>
            </div>

            <div class="decoded-card decoded-card-metric">
              <span class="decoded-label">Nuages</span>
              <strong id="cloudsValue">—</strong>
              <small id="cloudsMeta" class="decoded-micro-note" hidden></small>
            </div>

            <div class="decoded-card decoded-card-metric">
              <span class="decoded-label">Température</span>
              <strong id="tempValue">—</strong>
            </div>

            <div class="decoded-card decoded-card-metric">
              <span class="decoded-label">Pression</span>
              <strong id="pressureValue">—</strong>
            </div>

            <div class="decoded-card decoded-card-metric">
              <span class="decoded-label">Catégorie météo</span>
              <strong id="fltCatValue">—</strong>
            </div>
          </div>

          <p class="decoded-note decoded-note--micro">
            Météo : AWC · repère voisin si besoin.
          </p>
          <p id="weatherFreshnessNote" class="decoded-note decoded-note--micro decoded-note--timing" hidden></p>

          <div class="decoded-grid decoded-grid--summary-extra">
            <div class="decoded-card decoded-card-wide">
              <span class="decoded-label">Radio</span>

              <div class="radio-panel">
                <div class="radio-primary">
                  <div class="radio-primary-head">
                    <span id="radioTypeValue" class="radio-badge">Radio</span>
                    <span id="radioSourceValue" class="radio-primary-note">
                      Radio : SIA / BASULM.
                    </span>
                  </div>

                  <div id="radioValue" class="radio-primary-main">—</div>

                  <div id="radioLabelValue" class="radio-primary-label">
                    Aucune fréquence disponible
                  </div>
                </div>

                <div id="radioSupportBlock" class="radio-support-grid" hidden>
                  <div id="radioAtisCard" class="radio-support-card" hidden>
                    <div class="radio-support-head">
                      <span class="radio-support-badge">ATIS</span>
                      <span id="radioAtisSourceValue" class="radio-support-note">Information arrivée / départ</span>
                    </div>
                    <div id="radioAtisValue" class="radio-support-main">—</div>
                    <div id="radioAtisLabel" class="radio-support-label">—</div>
                  </div>

                  <div id="radioPhoneCard" class="radio-support-card" hidden>
                    <div class="radio-support-head">
                      <span class="radio-support-badge">Téléphone publié</span>
                      <span id="radioPhoneSourceValue" class="radio-support-note">Publié pour le terrain</span>
                    </div>
                    <div id="radioPhoneValue" class="radio-support-main">—</div>
                    <div id="radioPhoneLabel" class="radio-support-label">Coordonnée terrain publiée</div>
                  </div>
                </div>

                <details id="radioSecondaryBlock" class="radio-secondary radio-secondary-disclosure" hidden>
                  <summary class="radio-secondary-summary">
                    <span class="radio-secondary-title">Fréquences complémentaires</span>
                    <span id="radioSecondaryCount" class="radio-secondary-count">0</span>
                  </summary>
                  <ul id="radioList" class="radio-list"></ul>
                </details>
              </div>
            </div>
          </div>
        </div>

        <div id="platformBlock" class="tool-block tool-block--compact" hidden>
          <div class="terrain-info-head">
            <h2>Infos terrain</h2>
            <span id="platformSourceValue" class="terrain-source-badge">—</span>
          </div>

          <div class="decoded-grid terrain-info-grid">
            <div class="decoded-card">
              <span class="decoded-label">Type & accès</span>
              <strong id="platformTypeValue">—</strong>
            </div>

            <div class="decoded-card decoded-card-wide">
              <span class="decoded-label">Pistes</span>
              <strong id="platformRunwaysValue">—</strong>
            </div>

            <div id="platformWindCard" class="decoded-card decoded-card-wide terrain-visual-card" hidden>
              <div class="terrain-visual-head">
                <span class="decoded-label">Lecture vent / axes de piste</span>
                <span id="platformWindMeta" class="terrain-visual-meta">Vent indisponible</span>
              </div>

              <div id="platformWindVisual" class="terrain-visual-canvas" aria-label="Schéma vent et pistes"></div>
            </div>

            <div class="decoded-card decoded-card-wide">
              <span class="decoded-label">Contact / site</span>
              <strong id="platformContactValue">—</strong>
            </div>

          </div>

          <div id="platformDocsPanel" class="tool-block tool-block--compact platform-docs-panel" hidden>
            <div class="platform-docs-panel-head">
              <span class="decoded-label">Documents officiels</span>
            </div>
            <div class="platform-docs-actions">
              <button
                id="platformVacBtn"
                class="platform-doc-link platform-doc-link--vac platform-doc-button"
                type="button"
                hidden
              >
                <span class="platform-doc-link-title">VAC</span>
                <span class="platform-doc-link-note">Carte terrain SIA</span>
              </button>

              <button
                id="platformAipBtn"
                class="platform-doc-link platform-doc-link--aip platform-doc-button"
                type="button"
                hidden
              >
                <span class="platform-doc-link-title">AIP AD</span>
                <span class="platform-doc-link-note">Fiche officielle terrain</span>
              </button>
            </div>
          </div>

          <details id="platformDetailsDisclosure" class="tool-disclosure terrain-disclosure" hidden>
            <summary>Afficher les détails terrain</summary>

            <div class="tool-disclosure-content">
              <p id="platformRadioLine" hidden>
                <strong>Radio publiée</strong><br />
                <span id="platformRadioValue">—</span>
              </p>

              <p id="platformSiteLine" hidden>
                <strong>Site / gestionnaire</strong><br />
                <span id="platformSiteValue">—</span>
              </p>

              <p id="platformNotesLine" hidden>
                <strong>Consignes</strong><br />
                <span id="platformNotesValue">—</span>
              </p>

              <p id="platformUpdatedLine" hidden>
                <strong>Mise à jour</strong><br />
                <span id="platformUpdatedValue">—</span>
              </p>
            </div>
          </details>

          <p id="platformSourceNote" class="decoded-note decoded-note--micro">
            Terrains : base monde · France / BASULM.
          </p>
        </div>

        <div class="tool-block">
          <h2>Lecture prévision</h2>
          <div class="decoded-grid decoded-grid--forecast">
            <div class="decoded-card decoded-card-wide taf-decode-card">
              <div class="taf-head">
                <span class="decoded-label">TAF décodé</span>
                <strong id="tafSummaryValue">Aucune donnée</strong>
              </div>

              <div id="tafMetaGrid" class="taf-meta-grid" hidden>
                <div id="tafIssuedCard" class="taf-meta-card" hidden>
                  <span class="taf-meta-label">Émission</span>
                  <strong id="tafIssuedValue">—</strong>
                </div>

                <div id="tafValidityCard" class="taf-meta-card" hidden>
                  <span class="taf-meta-label">Validité</span>
                  <strong id="tafValidityValue">—</strong>
                </div>

                <div id="tafModifierCard" class="taf-meta-card taf-meta-card--compact" hidden>
                  <span class="taf-meta-label">Statut</span>
                  <strong id="tafModifierValue">—</strong>
                </div>
              </div>

              <p id="tafDecoderMeta" class="taf-decoder-meta" hidden></p>

              <div id="tafVisualBlock" class="taf-visual-block" hidden>
                <div class="taf-visual-head">
                  <div>
                    <span class="taf-visual-kicker">Lecture TAF</span>
                    <strong>Chronologie décodée</strong>
                  </div>
                  <span class="taf-visual-source">Codes TAF conservés · lecture guidée</span>
                </div>

                <p class="taf-visual-intro">
                  Les codes aéronautiques restent visibles. Chaque carte est cliquable : lecture immédiate en façade, détail complet au clic ou au toucher.
                </p>

                <div id="tafVisualOverview" class="taf-visual-overview"></div>

                <div class="taf-visual-detail-head" hidden>
                  <span class="taf-visual-detail-title">Détail par phase</span>
                  <span class="taf-visual-detail-note">Cliquez ou touchez une phase pour afficher son détail.</span>
                </div>

                <div id="tafVisualCards" class="taf-visual-cards"></div>

                <details class="taf-visual-disclosure" hidden>
                  <summary>
                    <span class="taf-visual-disclosure-title">Vue technique TAF</span>
                    <span class="taf-visual-disclosure-note">Cliquez pour ouvrir la vue experte.</span>
                  </summary>

                  <div class="taf-visual-disclosure-content">
                    <div id="tafVisualBadges" class="taf-visual-badges" hidden></div>

                    <div id="tafVisualMobileList" class="taf-visual-mobile-list" hidden></div>

                    <div class="taf-visual-timeline-wrap" aria-label="Frise horaire du TAF">
                      <div id="tafVisualScale" class="taf-visual-scale"></div>
                      <div id="tafVisualBands" class="taf-visual-bands"></div>
                    </div>

                    <div id="tafVisualMatrix" class="taf-visual-matrix"></div>
                  </div>
                </details>

                <p class="taf-visual-note" hidden>
                  Lecture graphique factuelle : les valeurs sont extraites du TAF disponible. Les catégories affichées sont indicatives et ne remplacent pas le briefing officiel.
                </p>
              </div>

              <div id="tafDecodeBlock" class="taf-decode-block" hidden>
                <details id="tafBaseDisclosure" class="taf-disclosure" open>
                  <summary>
                    <span class="taf-disclosure-title">Prévision de base</span>
                    <span id="tafBaseCount" class="taf-disclosure-count">0</span>
                  </summary>
                  <div class="taf-disclosure-content">
                    <ul id="tafBaseList" class="taf-bullet-list"></ul>
                  </div>
                </details>

                <details id="tafChangesSection" class="taf-disclosure" hidden>
                  <summary>
                    <span class="taf-disclosure-title">Évolutions prévues</span>
                    <span id="tafChangesCount" class="taf-disclosure-count">0</span>
                  </summary>
                  <div class="taf-disclosure-content">
                    <div id="tafChangesList" class="taf-timeline"></div>
                  </div>
                </details>

                <details id="tafTempsSection" class="taf-disclosure" hidden>
                  <summary>
                    <span class="taf-disclosure-title">Températures prévues</span>
                    <span id="tafTempsCount" class="taf-disclosure-count">0</span>
                  </summary>
                  <div class="taf-disclosure-content">
                    <ul id="tafTempList" class="taf-bullet-list"></ul>
                  </div>
                </details>
              </div>
            </div>
          </div>
          <p id="forecastFreshnessNote" class="decoded-note decoded-note--micro decoded-note--timing" hidden></p>
        </div>

        <details class="tool-block tool-disclosure raw-weather-disclosure">
          <summary>
            <span class="raw-weather-summary-text">
              <span class="raw-weather-summary-title">METAR brut</span>
              <span class="raw-weather-summary-note">Message brut consultable si besoin.</span>
            </span>
          </summary>

          <div class="tool-disclosure-content raw-weather-content">
            <pre id="metarOutput">Aucune donnée</pre>
          </div>
        </details>

        <details class="tool-block tool-disclosure raw-weather-disclosure">
          <summary>
            <span class="raw-weather-summary-text">
              <span class="raw-weather-summary-title">TAF brut</span>
              <span class="raw-weather-summary-note">Prévision brute consultable si besoin.</span>
            </span>
          </summary>

          <div class="tool-disclosure-content raw-weather-content">
            <pre id="tafOutput">Aucune donnée</pre>
          </div>
        </details>

        <div
          id="weatherRefsBlock"
          class="tool-block weather-refs-block"
          hidden
        >
          <div class="weather-refs-head">
            <div>
              <h2>Repères météo voisins</h2>
              <p class="weather-refs-note">Repère voisin si besoin.</p>
            </div>
          </div>

          <ul id="weatherRefsList" class="weather-refs-list"></ul>
        </div>

        <div class="tool-block nearby-block nearby-block--spotlight">
          <span class="nearby-kicker">Navigation locale</span>
          <div class="nearby-block-head">
            <div class="nearby-block-heading">
              <h2>Terrains proches</h2>
              <p class="nearby-block-note">
                Alternatives autour du terrain affiché ou de votre position.
              </p>
            </div>
            <button
              id="nearbyBtn"
              class="tool-action-btn tool-action-btn--secondary nearby-btn"
              type="button"
              aria-expanded="false"
              aria-controls="nearbyPanel"
            >
              Voir la liste des terrains
            </button>
          </div>
          <p id="nearbySummary" class="nearby-summary" hidden></p>
          <div id="nearbyPanel" class="nearby-panel" hidden>
            <ul id="nearbyAirports" class="nearby-list"></ul>
          </div>
        </div>

        <div class="tool-block notam-block">
          <span class="notam-kicker">Briefing réglementaire</span>
          <div class="notam-head">
            <div class="notam-heading">
              <h2>NOTAM officiels</h2>
              <p class="notam-note">
                Consulte le PIB officiel avant le vol.
              </p>
            </div>
            <div class="notam-actions">
              <a
                class="tool-action-btn tool-action-btn--primary notam-btn"
                href="https://sofia-briefing.aviation-civile.gouv.fr/"
                target="_blank"
                rel="noopener noreferrer"
              >
                Ouvrir SOFIA-Briefing
              </a>
            </div>
          </div>
          <p class="decoded-note decoded-note--micro notam-source">
            PIB officiel via SOFIA-Briefing.
          </p>
        </div>

        <div class="tool-block tool-block--compact tool-sources-strip">
          <p class="tool-source-line">
            Sources : AWC · SIA / BASULM · base monde, couche France / BASULM.
          </p>
          <p class="tool-source-line">
            Repère voisin si besoin.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const WORKER_URL = "https://metar-proxy-nesdz.elnesdz.workers.dev/";
    const AIRPORTS_FR_URL = "/data/airports-fr-full.json";
    const AIRPORTS_WORLD_URL = "/data/airports-world-lite.json";
    const ULM_URL = "/data/ulm-fr.json";
    const ULM_DETAILS_URL = "/data/ulm-fr-details.json";
    const FREQUENCIES_URL = "/data/frequencies-fr-merged.json";
    const WEATHER_REFERENCE_MAX_KM = 50 * 1.852;
    const LOCATION_ENTRY_RADIUS_KM = 120;

    const SIA_VAC_AD_BASE_URL = "/docs/sia/vac/ad/";
    const SIA_AIP_AD_BASE_URL = "/docs/sia/aip-ad/";

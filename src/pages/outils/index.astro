    const HOSTED_AIP_AD_CODES = new Set(["LFAC", "LFAQ", "LFAT", "LFAV", "LFAY", "LFBA", "LFBC", "LFBD", "LFBE", "LFBF", "LFBG", "LFBH", "LFBI", "LFBK", "LFBL", "LFBM", "LFBN", "LFBO", "LFBP", "LFBR", "LFBS", "LFBT", "LFBU", "LFBX", "LFBY", "LFBZ", "LFCC", "LFCI", "LFCK", "LFCR", "LFCY", "LFDH", "LFDJ", "LFDN", "LFEC", "LFEV", "LFEY", "LFFK", "LFGA", "LFGJ", "LFHP", "LFHV", "LFHY", "LFJL", "LFJR", "LFJY", "LFKB", "LFKC", "LFKF", "LFKJ", "LFKS", "LFLA", "LFLB", "LFLC", "LFLD", "LFLG", "LFLH", "LFLL", "LFLN", "LFLO", "LFLP", "LFLS", "LFLU", "LFLV", "LFLW", "LFLX", "LFLY", "LFMA", "LFMC", "LFMD", "LFMH", "LFMI", "LFMK", "LFML", "LFMN", "LFMO", "LFMP", "LFMQ", "LFMT", "LFMU", "LFMV", "LFMY", "LFNB", "LFOA", "LFOB", "LFOE", "LFOH", "LFOJ", "LFOK", "LFOP", "LFOQ", "LFOT", "LFOU", "LFOV", "LFOZ", "LFPB", "LFPG", "LFPM", "LFPN", "LFPO", "LFPT", "LFPV", "LFQA", "LFQB", "LFQE", "LFQG", "LFQM", "LFQP", "LFQQ", "LFQT", "LFRB", "LFRC", "LFRD", "LFRG", "LFRH", "LFRI", "LFRJ", "LFRK", "LFRL", "LFRM", "LFRN", "LFRO", "LFRQ", "LFRS", "LFRT", "LFRU", "LFRV", "LFRZ", "LFSB", "LFSD", "LFSG", "LFSI", "LFSL", "LFSM", "LFSN", "LFSO", "LFST", "LFSX", "LFTH", "LFTW", "LFTZ"]);
    
    // ... (toutes vos variables let et const, de airportsFrCache à platformAipBtn)
    
    let airportsFrCache = null;
    let airportsWorldCache = null;
    let searchIndex = null;
    let ulmFrCache = null;
    let ulmDetailsCache = null;
    let frequenciesCache = null;
    let currentWindDirection = null;

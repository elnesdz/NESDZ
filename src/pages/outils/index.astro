---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="NESDZ — ULM · Ultra-léger · Passion"
  description="NESDZ, journal ULM & aviation légère. Météo aviation, terrains, journal, modèles et ressources utiles pour les pilotes."
>
  <section class="container home-page">
    <div class="home-shell">
      <section class="hero card">
        <div class="hero-grid pad">
          <div class="hero-copy">
            <span class="hero-kicker">ULM · Aviation légère · Briefing utile</span>
            <h1>NESDZ</h1>
            <p class="hero-lead">
              Un site éditorial premium qui devient aussi un vrai outil pilote : météo aviation,
              terrains proches, radio utile, bases France et contenus sélectionnés pour voler
              avec plus de clarté.
            </p>

            <div class="hero-actions">
              <a class="hero-tool-btn" href="/outils/">
                <span class="hero-tool-btn__eyebrow">Outil du site</span>
                <span class="hero-tool-btn__label">Météo &amp; terrains</span>
              </a>

              <a class="hero-link-btn" href="/journal/">Voir le journal</a>
            </div>

            <ul class="hero-points">
              <li>Météo aviation claire pour le briefing</li>
              <li>Aérodromes proches et plateformes ULM distingués</li>
              <li>Base France terrains et fréquences utiles</li>
            </ul>
          </div>

          <aside class="hero-side">
            <div class="hero-panel hero-panel--tool">
              <span class="hero-panel__label">Accès direct</span>
              <strong>Ouvrir l’outil pilote</strong>
              <p>
                Accède immédiatement à la météo terrain, aux fréquences radio utiles et aux
                terrains proches.
              </p>
              <a class="hero-panel__cta" href="/outils/?icao=LFQQ">Tester avec LFQQ</a>
            </div>

            <div class="hero-panel hero-panel--meta">
              <span class="hero-panel__label">NESDZ</span>
              <strong>Premium, sobre, utile</strong>
              <p>
                Une home éditoriale claire pour découvrir le site, puis un outil dédié pour le
                briefing pilote.
              </p>
            </div>
          </aside>
        </div>
      </section>

      <section class="section-block">
        <div class="section-head">
          <h2>Explorer NESDZ</h2>
          <p>Les grandes entrées du site, sans casser l’équilibre éditorial validé.</p>
        </div>

        <div class="entry-grid">
          <a class="entry-card" href="/journal/">
            <span class="entry-card__kicker">Lecture</span>
            <strong>Derniers articles</strong>
            <p>Retrouve le journal NESDZ et les contenus récents autour de l’ULM et du vol léger.</p>
          </a>

          <a class="entry-card" href="/modeles/">
            <span class="entry-card__kicker">Sélection</span>
            <strong>Modèles en vedette</strong>
            <p>Accède aux fiches et sélections de modèles déjà présents dans le site.</p>
          </a>

          <a class="entry-card entry-card--accent" href="/outils/">
            <span class="entry-card__kicker">Cockpit</span>
            <strong>Météo &amp; terrains</strong>
            <p>L’entrée la plus utile pour préparer un vol : météo, radio, repères voisins et terrains proches.</p>
          </a>
        </div>
      </section>

      <section class="section-block card">
        <div class="pad utility-strip">
          <div>
            <span class="utility-strip__label">L’outil pilote NESDZ</span>
            <h2>Accès rapide au briefing terrain</h2>
            <p>
              Ouvre directement l’outil et saisis un code comme LFQQ, LFPN ou LFPA pour afficher
              la météo, la radio utile et les terrains proches.
            </p>
          </div>

          <div class="utility-strip__actions">
            <a class="utility-strip__primary" href="/outils/">Ouvrir Météo &amp; terrains</a>
            <a class="utility-strip__secondary" href="/annuaire-ulm/">Voir l’annuaire ULM</a>
          </div>
        </div>
      </section>

      <section class="section-block editorial-grid">
        <div class="editorial-card card">
          <div class="pad">
            <span class="editorial-card__label">Journal</span>
            <h2>Une ligne éditoriale claire</h2>
            <p>
              NESDZ garde une vraie dimension éditoriale : articles, regards, sélections et contenus
              pensés pour les pilotes et passionnés d’aviation légère.
            </p>
            <a class="editorial-card__link" href="/journal/">Entrer dans le journal</a>
          </div>
        </div>

        <div class="editorial-card card">
          <div class="pad">
            <span class="editorial-card__label">Ressources</span>
            <h2>Des briques utiles, pas une démo</h2>
            <p>
              Base France d’aérodromes, plateformes ULM, fréquences radio et outils orientés usage
              réel : le produit continue de se consolider sans refonte brutale.
            </p>
            <a class="editorial-card__link" href="/outils/">Accéder à l’outil</a>
          </div>
        </div>
      </section>
    </div>
  </section>

  <style is:global>
    .home-page {
      padding: 22px 0 34px;
    }

    .home-page .home-shell {
      display: grid;
      gap: 22px;
    }

    .home-page .hero {
      overflow: hidden;
      border: 1px solid rgba(111, 184, 214, 0.18);
      background:
        radial-gradient(circle at top left, rgba(111, 184, 214, 0.12), transparent 36%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.028), rgba(255, 255, 255, 0.018)),
        rgba(10, 18, 26, 0.82);
    }

    .home-page .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.9fr);
      gap: 24px;
      align-items: stretch;
    }

    .home-page .hero-copy {
      display: grid;
      align-content: start;
      gap: 18px;
    }

    .home-page .hero-kicker {
      display: inline-flex;
      width: fit-content;
      padding: 6px 11px;
      border-radius: 999px;
      border: 1px solid rgba(111, 184, 214, 0.22);
      background: rgba(111, 184, 214, 0.1);
      color: rgba(221, 237, 245, 0.88);
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .home-page h1 {
      margin: 0;
      font-size: clamp(3rem, 7vw, 5rem);
      line-height: 0.95;
      letter-spacing: -0.04em;
    }

    .home-page .hero-lead {
      margin: 0;
      max-width: 760px;
      font-size: 1.08rem;
      line-height: 1.72;
      color: rgba(223, 234, 241, 0.86);
    }

    .home-page .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }

    .home-page .hero-tool-btn {
      display: inline-grid;
      gap: 4px;
      min-width: 270px;
      padding: 14px 18px 15px;
      border-radius: 18px;
      border: 1px solid rgba(111, 184, 214, 0.88);
      background:
        linear-gradient(180deg, rgba(111, 184, 214, 0.5), rgba(111, 184, 214, 0.3)),
        rgba(18, 34, 46, 0.98);
      color: #f8fcff;
      text-decoration: none;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.16),
        0 0 0 1px rgba(111, 184, 214, 0.16),
        0 16px 36px rgba(0, 0, 0, 0.22),
        0 0 28px rgba(111, 184, 214, 0.14);
      transition:
        transform 0.18s ease,
        box-shadow 0.18s ease,
        border-color 0.18s ease,
        background 0.18s ease;
    }

    .home-page .hero-tool-btn:hover {
      transform: translateY(-1px);
      border-color: rgba(111, 184, 214, 1);
      background:
        linear-gradient(180deg, rgba(111, 184, 214, 0.62), rgba(111, 184, 214, 0.38)),
        rgba(18, 34, 46, 1);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.18),
        0 0 0 1px rgba(111, 184, 214, 0.2),
        0 18px 40px rgba(0, 0, 0, 0.24),
        0 0 34px rgba(111, 184, 214, 0.18);
    }

    .home-page .hero-tool-btn__eyebrow {
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(234, 246, 255, 0.82);
    }

    .home-page .hero-tool-btn__label {
      font-size: 1.2rem;
      font-weight: 800;
      line-height: 1.15;
      color: #ffffff;
    }

    .home-page .hero-link-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 50px;
      padding: 0 18px;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.04);
      color: rgba(245, 249, 252, 0.96);
      text-decoration: none;
      font-weight: 700;
      transition:
        transform 0.18s ease,
        border-color 0.18s ease,
        background 0.18s ease;
    }

    .home-page .hero-link-btn:hover {
      transform: translateY(-1px);
      border-color: rgba(255, 255, 255, 0.24);
      background: rgba(255, 255, 255, 0.065);
    }

    .home-page .hero-points {
      margin: 0;
      padding-left: 18px;
      display: grid;
      gap: 8px;
      color: rgba(215, 227, 236, 0.84);
      line-height: 1.55;
    }

    .home-page .hero-side {
      display: grid;
      gap: 14px;
      align-content: stretch;
    }

    .home-page .hero-panel {
      display: grid;
      gap: 10px;
      padding: 18px;
      border-radius: 18px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.025)),
        rgba(12, 20, 28, 0.72);
    }

    .home-page .hero-panel--tool {
      border-color: rgba(111, 184, 214, 0.28);
      background:
        linear-gradient(180deg, rgba(111, 184, 214, 0.1), rgba(255, 255, 255, 0.03)),
        rgba(12, 20, 28, 0.8);
    }

    .home-page .hero-panel__label,
    .home-page .utility-strip__label,
    .home-page .entry-card__kicker,
    .home-page .editorial-card__label {
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(202, 221, 233, 0.74);
    }

    .home-page .hero-panel strong,
    .home-page .entry-card strong,
    .home-page .editorial-card h2,
    .home-page .utility-strip h2 {
      color: rgba(245, 249, 252, 0.98);
    }

    .home-page .hero-panel p,
    .home-page .entry-card p,
    .home-page .editorial-card p,
    .home-page .utility-strip p,
    .home-page .section-head p {
      margin: 0;
      color: rgba(214, 226, 235, 0.82);
      line-height: 1.65;
    }

    .home-page .hero-panel__cta,
    .home-page .editorial-card__link {
      width: fit-content;
      color: #dff2ff;
      text-decoration: none;
      font-weight: 700;
    }

    .home-page .section-block {
      display: grid;
      gap: 14px;
    }

    .home-page .section-head h2 {
      margin: 0 0 6px;
      font-size: clamp(1.7rem, 3vw, 2.25rem);
    }

    .home-page .entry-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .home-page .entry-card {
      display: grid;
      gap: 10px;
      padding: 18px;
      border-radius: 18px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.042), rgba(255, 255, 255, 0.02)),
        rgba(11, 19, 27, 0.8);
      color: inherit;
      text-decoration: none;
      transition:
        transform 0.18s ease,
        border-color 0.18s ease,
        background 0.18s ease;
    }

    .home-page .entry-card:hover {
      transform: translateY(-1px);
      border-color: rgba(255, 255, 255, 0.14);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.052), rgba(255, 255, 255, 0.026)),
        rgba(11, 19, 27, 0.88);
    }

    .home-page .entry-card--accent {
      border-color: rgba(111, 184, 214, 0.24);
      background:
        linear-gradient(180deg, rgba(111, 184, 214, 0.1), rgba(255, 255, 255, 0.025)),
        rgba(11, 19, 27, 0.84);
    }

    .home-page .utility-strip {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) auto;
      gap: 18px;
      align-items: center;
    }

    .home-page .utility-strip__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: flex-end;
    }

    .home-page .utility-strip__primary,
    .home-page .utility-strip__secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 18px;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 700;
    }

    .home-page .utility-strip__primary {
      border: 1px solid rgba(111, 184, 214, 0.78);
      background:
        linear-gradient(180deg, rgba(111, 184, 214, 0.52), rgba(111, 184, 214, 0.3)),
        rgba(20, 40, 54, 0.98);
      color: #f8fcff;
    }

    .home-page .utility-strip__secondary {
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.04);
      color: rgba(245, 249, 252, 0.96);
    }

    .home-page .editorial-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .home-page .editorial-card {
      border: 1px solid rgba(255, 255, 255, 0.08);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.042), rgba(255, 255, 255, 0.02)),
        rgba(10, 18, 26, 0.78);
    }

    @media (max-width: 980px) {
      .home-page .hero-grid,
      .home-page .utility-strip,
      .home-page .entry-grid,
      .home-page .editorial-grid {
        grid-template-columns: 1fr;
      }

      .home-page .utility-strip__actions {
        justify-content: flex-start;
      }
    }

    @media (max-width: 720px) {
      .home-page {
        padding: 18px 0 28px;
      }

      .home-page .hero-actions,
      .home-page .utility-strip__actions {
        display: grid;
      }

      .home-page .hero-tool-btn,
      .home-page .hero-link-btn,
      .home-page .utility-strip__primary,
      .home-page .utility-strip__secondary {
        width: 100%;
      }

      .home-page .hero-tool-btn {
        min-width: 0;
      }
    }
  </style>
</BaseLayout>

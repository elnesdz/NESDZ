    async function loadMetar() {
      const icao = normalizeCode(icaoInput?.value);

      resetWeatherReferences();

      if (!icao) {
        syncIcaoInUrl("");
        metarOutput.textContent = "Entre un code OACI.";
        tafOutput.textContent = "Entre un code OACI.";
        resetDecoded();
        return;
      }

      metarOutput.textContent = "Chargement...";
      tafOutput.textContent = "Chargement...";
      statusValue.textContent = "Chargement...";
      nameValue.textContent = "…";
      windValue.textContent = "…";
      visibilityValue.textContent = "…";
      cloudsValue.textContent = "…";
      tempValue.textContent = "…";
      pressureValue.textContent = "…";
      fltCatValue.textContent = "…";

      radioValue.textContent = "Chargement...";
      if (radioTypeValue) radioTypeValue.textContent = "Radio";
      if (radioLabelValue) {
        radioLabelValue.textContent = "Recherche des fréquences utiles...";
      }
      if (radioSourceValue) {
        radioSourceValue.textContent = "Radio : SIA prioritaire · BASULM selon terrain.";
      }
      if (radioSecondaryBlock) radioSecondaryBlock.hidden = true;
      if (radioList) radioList.innerHTML = "";

      tafSummaryValue.textContent = "Chargement...";

      const matchedAirport = await findAirportByCode(icao);
      const matchedUlm = await findUlmByCode(icao);
      const matchedUlmDetails = await findUlmDetailsByCode(icao);
      const matchedFrequency = await findFrequencyByCode(icao);

      syncIcaoInUrl(icao);
      renderPlatformBlock(matchedAirport, matchedUlm, matchedUlmDetails);

      try {
        const res = await fetch(`${WORKER_URL}?icao=${encodeURIComponent(icao)}`);

        if (!res.ok) {
          await applyMissingLocalWeatherState({
            icao,
            matchedAirport,
            matchedUlm,
            matchedUlmDetails,
            matchedFrequency,
            metarMessage:
              `Aucune météo exploitable trouvée pour ${icao}. Ce terrain ne publie peut-être pas de METAR, ou la source n’a pas de donnée disponible actuellement.`,
            tafMessage:
              `Aucune prévision TAF exploitable trouvée pour ${icao}.`,
            emptyStatusMessage: "⚠️ Pas de météo terrain publiée",
          });
          return;
        }

        const data = await res.json();

        if (!Array.isArray(data) || data.length === 0) {
          await applyMissingLocalWeatherState({
            icao,
            matchedAirport,
            matchedUlm,
            matchedUlmDetails,
            matchedFrequency,
            metarMessage:
              `Aucune observation METAR trouvée pour ${icao}. Vérifie le code OACI ou teste un terrain disposant d’une météo publiée.`,
            tafMessage: `Aucune prévision TAF trouvée pour ${icao}.`,
            emptyStatusMessage: "Aucune donnée météo disponible",
          });
          return;
        }

        const item = data[0];

        if (!item || typeof item !== "object") {
          await applyMissingLocalWeatherState({
            icao,
            matchedAirport,
            matchedUlm,
            matchedUlmDetails,
            matchedFrequency,
            metarMessage: `Réponse météo inexploitable pour ${icao}.`,
            tafMessage: `Réponse prévision inexploitable pour ${icao}.`,
            emptyStatusMessage: "Réponse invalide",
          });
          return;
        }

        if (!item.rawOb) {
          await applyMissingLocalWeatherState({
            icao,
            matchedAirport,
            matchedUlm,
            matchedUlmDetails,
            matchedFrequency,
            metarMessage:
              `Aucune observation METAR exploitable trouvée pour ${icao}.`,
            tafMessage:
              item.taf
                ? `TAF local disponible ci-dessous.`
                : `Aucune prévision TAF trouvée pour ${icao}.`,
            emptyStatusMessage: "⚠️ Pas de météo terrain publiée",
          });
          return;
        }

        metarOutput.textContent = item.rawOb || "METAR brut indisponible";
        tafOutput.textContent =
          item.taf || "TAF non disponible via cette source actuelle";

        statusValue.textContent = formatStatus(item);
        nameValue.textContent =
          formatMatchedDisplayName(matchedAirport, matchedUlm) ||
          item.name ||
          item.icaoId ||
          icao;
        windValue.textContent = formatWind(item.wdir, item.wspd);
        visibilityValue.textContent = formatVisibility(item.visib);
        cloudsValue.textContent = formatClouds(item);
        tempValue.textContent = formatTemp(item.temp, item.dewp);
        pressureValue.textContent = formatPressure(item.altim);
        fltCatValue.textContent = item.fltCat || "—";
        renderFrequencyPanel(matchedFrequency, matchedUlmDetails?.radio || null, matchedUlmDetails);
        tafSummaryValue.textContent = buildSimpleTaf(item.taf, item, icao);
      } catch (error) {
        await applyMissingLocalWeatherState({
          icao,
          matchedAirport,
          matchedUlm,
          matchedUlmDetails,
          matchedFrequency,
          metarMessage:
            `Impossible de joindre la météo pour ${icao} pour le moment. Réessaie dans quelques instants ou teste un terrain plus couvert comme LFQQ ou LFPN.`,
          tafMessage:
            `Impossible de joindre la prévision pour ${icao} pour le moment.`,
          emptyStatusMessage: "⚠️ Service météo indisponible",
        });
        console.error(error);
      }
    }

    async function getLocation() {
      nearbyAirports.innerHTML =
        "<li class='nearby-loading'>Recherche des terrains proches...</li>";

      try {
        const center = await resolveNearbyCenter();
        const [airports, ulmBases] = await Promise.all([
          loadAirports(),
          loadUlmBases(),
        ]);

        const basulmByWeatherCode = buildBasulmIndexByWeatherCode(ulmBases);
        const radiusKm = 120;

        const weatherNearby = airports
          .map((airport) => {
            const overlay = basulmByWeatherCode.get(airport.weatherCode) || null;

            return {
              code: airport.weatherCode,
              name: airport.name,
              municipality: airport.municipality || "",
              distanceKm: getDistanceKm(
                center.latitude,
                center.longitude,
                airport.latitude,
                airport.longitude
              ),
              operationalLabel: getAirportOperationalLabel(airport, overlay),
              accessLabel: formatAccessTags(overlay?.accessTags || []),
            };
          })
          .filter((item) => item.distanceKm <= radiusKm)
          .sort((a, b) => a.distanceKm - b.distanceKm)
          .slice(0, 10);

        const weatherCodesShown = new Set(
          weatherNearby.map((item) => item.code)
        );

        const ulmNearby = ulmBases
          .map((item) => ({
            code: item.code,
            name: item.name,
            weatherCode: item.weatherCode,
            weatherCapable: item.weatherCapable,
            distanceKm: getDistanceKm(
              center.latitude,
              center.longitude,
              item.latitude,
              item.longitude
            ),
            operationalLabel: item.operationalLabel,
            accessLabel: formatAccessTags(item.accessTags),
          }))
          .filter((item) => item.distanceKm <= radiusKm)
          .filter((item) => {
            if (item.weatherCode && weatherCodesShown.has(item.weatherCode)) {
              return false;
            }
            return true;
          })
          .sort((a, b) => a.distanceKm - b.distanceKm)
          .slice(0, 10);

        nearbyAirports.innerHTML = "";
        renderNearbyHeader(center.label);

        renderNearbyGroupTitle("Aérodromes avec météo publiée");
        if (weatherNearby.length === 0) {
          renderEmptyGroup(
            "Aucun terrain météo exploitable trouvé dans le rayon retenu."
          );
        } else {
          weatherNearby.forEach(renderWeatherNearbyItem);
        }

        renderNearbyGroupTitle("Plateformes ULM / terrains spécifiques");
        if (ulmNearby.length === 0) {
          renderEmptyGroup(
            "Aucune plateforme ULM ou spécifique trouvée dans le rayon retenu."
          );
        } else {
          ulmNearby.forEach(renderUlmNearbyItem);
        }
      } catch (error) {
        if (error.message === "geolocation_not_supported") {
          nearbyAirports.innerHTML =
            "<li class='nearby-empty'>La géolocalisation n’est pas supportée sur cet appareil.</li>";
          return;
        }

        if (error.message === "geolocation_failed") {
          nearbyAirports.innerHTML =
            "<li class='nearby-empty'>Impossible de récupérer la position. Saisis un terrain comme LFQQ puis relance la recherche.</li>";
          return;
        }

        nearbyAirports.innerHTML =
          "<li class='nearby-empty'>Impossible de charger les terrains proches pour le moment.</li>";
        console.error(error);
      }
    }

    loadMetarBtn?.addEventListener("click", loadMetar);
    nearbyBtn?.addEventListener("click", getLocation);

    icaoInput?.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        loadMetar();
      }
    });

    const initialIcao = getIcaoFromUrl();

    if (initialIcao && icaoInput) {
      icaoInput.value = initialIcao;
    }

    if (icaoInput?.value) {
      loadMetar();
    }
  </script>


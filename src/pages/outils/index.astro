---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Météo & terrains"
  description="Météo aviation, METAR, TAF et terrains proches."
>
  <section class="container tool-page" style="padding: 20px 0;">
    <div class="card">
      <div class="pad">
        <h1>Météo & terrains</h1>

        <div class="tool-block tool-entry-block">
          <label for="icaoInput" class="tool-entry-label">
            Code OACI ou ville
          </label>
          <p class="tool-entry-help">
            Entre un code OACI, une ville ou utilise <strong>Me localiser</strong>.
          </p>

          <div class="row tool-row">
            <div class="tool-search-col">
              <input
                id="icaoInput"
                placeholder="Ex : LFQQ ou Lille"
                value="LFQQ"
                inputmode="text"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
                enterkeyhint="search"
                aria-label="Terrain, code OACI ou ville"
              />
              <div
                id="searchSuggestions"
                class="tool-search-suggestions"
                role="listbox"
                aria-label="Suggestions de recherche"
                hidden
              ></div>
              <p id="searchFeedback" class="tool-search-feedback" hidden></p>
            </div>
            <div class="tool-entry-actions">
              <button
                id="loadMetarBtn"
                class="tool-action-btn tool-action-btn--primary"
                type="button"
              >
                Voir METAR / TAF
              </button>
              <button
                id="locateBtn"
                class="tool-action-btn tool-action-btn--secondary"
                type="button"
              >
                Me localiser
              </button>
            </div>
          </div>
        </div>

        <div class="tool-block">
          <h2>Lecture rapide</h2>

          <div class="decoded-grid decoded-grid--summary">
            <div class="decoded-card decoded-card-status decoded-card-mobile-wide">
              <span class="decoded-label">Statut</span>
              <strong id="statusValue">Aucune donnée</strong>
            </div>

            <div class="decoded-card decoded-card-terrain decoded-card-mobile-wide">
              <span class="decoded-label">Terrain</span>
              <strong id="nameValue">—</strong>
            </div>

            <div class="decoded-card decoded-card-metric">
              <span class="decoded-label">Vent</span>
              <strong id="windValue">—</strong>
            </div>

            <div class="decoded-card decoded-card-metric">
              <span class="decoded-label">Visibilité</span>
              <strong id="visibilityValue">—</strong>
            </div>

            <div class="decoded-card decoded-card-metric">
              <span class="decoded-label">Nuages</span>
              <strong id="cloudsValue">—</strong>
            </div>

            <div class="decoded-card decoded-card-metric">
              <span class="decoded-label">Température</span>
              <strong id="tempValue">—</strong>
            </div>

            <div class="decoded-card decoded-card-metric">
              <span class="decoded-label">Pression</span>
              <strong id="pressureValue">—</strong>
            </div>

            <div class="decoded-card decoded-card-metric">
              <span class="decoded-label">Catégorie météo</span>
              <strong id="fltCatValue">—</strong>
            </div>

            <div class="decoded-card decoded-card-wide">
              <span class="decoded-label">Radio</span>

              <div class="radio-panel">
                <div class="radio-primary">
                  <div class="radio-primary-head">
                    <span id="radioTypeValue" class="radio-badge">Radio</span>
                    <span id="radioSourceValue" class="radio-primary-note">
                      Radio : SIA prioritaire · BASULM selon terrain.
                    </span>
                  </div>

                  <div id="radioValue" class="radio-primary-main">—</div>

                  <div id="radioLabelValue" class="radio-primary-label">
                    Aucune fréquence disponible
                  </div>
                </div>

                <div id="radioSupportBlock" class="radio-support-grid" hidden>
                  <div id="radioAtisCard" class="radio-support-card" hidden>
                    <div class="radio-support-head">
                      <span class="radio-support-badge">ATIS</span>
                      <span id="radioAtisSourceValue" class="radio-support-note">Information arrivée / départ</span>
                    </div>
                    <div id="radioAtisValue" class="radio-support-main">—</div>
                    <div id="radioAtisLabel" class="radio-support-label">—</div>
                  </div>

                  <div id="radioPhoneCard" class="radio-support-card" hidden>
                    <div class="radio-support-head">
                      <span class="radio-support-badge">Téléphone publié</span>
                      <span id="radioPhoneSourceValue" class="radio-support-note">Publié pour le terrain</span>
                    </div>
                    <div id="radioPhoneValue" class="radio-support-main">—</div>
                    <div id="radioPhoneLabel" class="radio-support-label">Coordonnée terrain publiée</div>
                  </div>
                </div>

                <details id="radioSecondaryBlock" class="radio-secondary radio-secondary-disclosure" hidden>
                  <summary class="radio-secondary-summary">
                    <span class="radio-secondary-title">Fréquences complémentaires</span>
                    <span id="radioSecondaryCount" class="radio-secondary-count">0</span>
                  </summary>
                  <ul id="radioList" class="radio-list"></ul>
                </details>
              </div>
            </div>
          </div>

          <p class="decoded-note decoded-note--micro">
            Météo : Aviation Weather Center · repère voisin si besoin.
          </p>
        </div>

        <div id="platformBlock" class="tool-block tool-block--compact" hidden>
          <div class="terrain-info-head">
            <h2>Infos terrain</h2>
            <span id="platformSourceValue" class="terrain-source-badge">—</span>
          </div>

          <div class="decoded-grid terrain-info-grid">
            <div class="decoded-card">
              <span class="decoded-label">Type & accès</span>
              <strong id="platformTypeValue">—</strong>
            </div>

            <div class="decoded-card decoded-card-wide">
              <span class="decoded-label">Pistes</span>
              <strong id="platformRunwaysValue">—</strong>
            </div>

            <div id="platformWindCard" class="decoded-card decoded-card-wide terrain-visual-card" hidden>
              <div class="terrain-visual-head">
                <span class="decoded-label">Lecture vent / axes de piste</span>
                <span id="platformWindMeta" class="terrain-visual-meta">Vent indisponible</span>
              </div>

              <div id="platformWindVisual" class="terrain-visual-canvas" aria-label="Schéma vent et pistes"></div>
            </div>

            <div class="decoded-card decoded-card-wide">
              <span class="decoded-label">Contact / site</span>
              <strong id="platformContactValue">—</strong>
            </div>
          </div>

          <details id="platformDetailsDisclosure" class="tool-disclosure terrain-disclosure" hidden>
            <summary>Afficher les détails terrain</summary>

            <div class="tool-disclosure-content">
              <p id="platformRadioLine" hidden>
                <strong>Radio publiée</strong><br />
                <span id="platformRadioValue">—</span>
              </p>

              <p id="platformSiteLine" hidden>
                <strong>Site / gestionnaire</strong><br />
                <span id="platformSiteValue">—</span>
              </p>

              <p id="platformNotesLine" hidden>
                <strong>Consignes</strong><br />
                <span id="platformNotesValue">—</span>
              </p>

              <p id="platformUpdatedLine" hidden>
                <strong>Mise à jour</strong><br />
                <span id="platformUpdatedValue">—</span>
              </p>
            </div>
          </details>

          <p id="platformSourceNote" class="decoded-note decoded-note--micro">
            Terrains : base monde · couche enrichie France / BASULM.
          </p>
        </div>

        <div class="tool-block">
          <h2>Lecture prévision</h2>
          <div class="decoded-grid">
            <div class="decoded-card decoded-card-wide">
              <span class="decoded-label">Tendance</span>
              <strong id="tafSummaryValue">Aucune donnée</strong>
            </div>
          </div>
        </div>

        <div class="tool-block">
          <h2>METAR brut</h2>
          <pre id="metarOutput">Aucune donnée</pre>
        </div>

        <div class="tool-block">
          <h2>TAF brut</h2>
          <pre id="tafOutput">Aucune donnée</pre>
        </div>

        <div
          id="weatherRefsBlock"
          class="tool-block weather-refs-block"
          hidden
        >
          <div class="weather-refs-head">
            <div>
              <h2>Repères météo voisins</h2>
              <p class="weather-refs-note">Repère voisin si besoin.</p>
            </div>
          </div>

          <ul id="weatherRefsList" class="weather-refs-list"></ul>
        </div>

        <div class="tool-block">
          <h2>Aérodromes à proximité</h2>
          <button
            id="nearbyBtn"
            class="tool-action-btn tool-action-btn--secondary"
            type="button"
          >
            Afficher les terrains proches
          </button>
          <ul id="nearbyAirports" class="nearby-list"></ul>
        </div>

        <div class="tool-block tool-block--compact tool-sources-strip">
          <p class="tool-source-line">
            Sources : météo AWC · radio SIA / BASULM · terrains base monde, couche enrichie France / BASULM.
          </p>
          <p class="tool-source-line">
            Repère voisin si besoin.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const WORKER_URL = "https://metar-proxy-nesdz.elnesdz.workers.dev/";
    const AIRPORTS_FR_URL = "/data/airports-fr-full.json";
    const AIRPORTS_WORLD_URL = "/data/airports-world-lite.json";
    const ULM_URL = "/data/ulm-fr.json";
    const ULM_DETAILS_URL = "/data/ulm-fr-details.json";
    const FREQUENCIES_URL = "/data/frequencies-fr-merged.json";
    const WEATHER_REFERENCE_MAX_KM = 50 * 1.852;
    const LOCATION_ENTRY_RADIUS_KM = 120;

    const icaoInput = document.getElementById("icaoInput");
    const metarOutput = document.getElementById("metarOutput");
    const tafOutput = document.getElementById("tafOutput");
    const nearbyAirports = document.getElementById("nearbyAirports");
    const loadMetarBtn = document.getElementById("loadMetarBtn");
    const locateBtn = document.getElementById("locateBtn");
    const nearbyBtn = document.getElementById("nearbyBtn");
    const searchSuggestions = document.getElementById("searchSuggestions");
    const searchFeedback = document.getElementById("searchFeedback");

    const statusValue = document.getElementById("statusValue");
    const nameValue = document.getElementById("nameValue");
    const windValue = document.getElementById("windValue");
    const visibilityValue = document.getElementById("visibilityValue");
    const cloudsValue = document.getElementById("cloudsValue");
    const tempValue = document.getElementById("tempValue");
    const pressureValue = document.getElementById("pressureValue");
    const fltCatValue = document.getElementById("fltCatValue");
    const radioValue = document.getElementById("radioValue");
    const radioTypeValue = document.getElementById("radioTypeValue");
    const radioLabelValue = document.getElementById("radioLabelValue");
    const radioSourceValue = document.getElementById("radioSourceValue");
    const radioSupportBlock = document.getElementById("radioSupportBlock");
    const radioAtisCard = document.getElementById("radioAtisCard");
    const radioAtisValue = document.getElementById("radioAtisValue");
    const radioAtisLabel = document.getElementById("radioAtisLabel");
    const radioAtisSourceValue = document.getElementById("radioAtisSourceValue");
    const radioPhoneCard = document.getElementById("radioPhoneCard");
    const radioPhoneValue = document.getElementById("radioPhoneValue");
    const radioPhoneLabel = document.getElementById("radioPhoneLabel");
    const radioPhoneSourceValue = document.getElementById("radioPhoneSourceValue");
    const radioSecondaryBlock = document.getElementById("radioSecondaryBlock");
    const radioSecondaryCount = document.getElementById("radioSecondaryCount");
    const radioList = document.getElementById("radioList");
    const tafSummaryValue = document.getElementById("tafSummaryValue");

    const weatherRefsBlock = document.getElementById("weatherRefsBlock");
    const weatherRefsList = document.getElementById("weatherRefsList");
    const platformBlock = document.getElementById("platformBlock");
    const platformSourceValue = document.getElementById("platformSourceValue");
    const platformTypeValue = document.getElementById("platformTypeValue");
    const platformRadioValue = document.getElementById("platformRadioValue");
    const platformContactValue = document.getElementById("platformContactValue");
    const platformSiteValue = document.getElementById("platformSiteValue");
    const platformRunwaysValue = document.getElementById("platformRunwaysValue");
    const platformWindCard = document.getElementById("platformWindCard");
    const platformWindVisual = document.getElementById("platformWindVisual");
    const platformWindMeta = document.getElementById("platformWindMeta");
    const platformNotesValue = document.getElementById("platformNotesValue");
    const platformUpdatedValue = document.getElementById("platformUpdatedValue");
    const platformSourceNote = document.getElementById("platformSourceNote");
    const platformDetailsDisclosure = document.getElementById("platformDetailsDisclosure");
    const platformRadioLine = document.getElementById("platformRadioLine");
    const platformSiteLine = document.getElementById("platformSiteLine");
    const platformNotesLine = document.getElementById("platformNotesLine");
    const platformUpdatedLine = document.getElementById("platformUpdatedLine");

    let airportsFrCache = null;
    let airportsFrPromise = null;
    let airportsWorldCache = null;
    let airportsWorldPromise = null;

    let ulmCache = null;
    let ulmPromise = null;

    let frequenciesCache = null;
    let frequenciesPromise = null;
let ulmDetailsCache = null;
let ulmDetailsPromise = null;

    let currentWindDirection = null;
    let currentWindSpeed = null;
    let currentWindVariable = false;

    let searchIndexCache = null;
    let searchIndexPromise = null;
    let currentSearchResults = [];
    let searchHideTimer = null;

    function resetDecoded() {
      statusValue.textContent = "Aucune donnée";
      nameValue.textContent = "—";
      windValue.textContent = "—";
      visibilityValue.textContent = "—";
      cloudsValue.textContent = "—";
      tempValue.textContent = "—";
      pressureValue.textContent = "—";
      fltCatValue.textContent = "—";

      radioValue.textContent = "—";
      if (radioTypeValue) radioTypeValue.textContent = "Radio";
      if (radioLabelValue) {
        radioLabelValue.textContent = "Aucune fréquence disponible";
      }
      if (radioSourceValue) {
        radioSourceValue.textContent =
          "Radio : SIA prioritaire · BASULM selon terrain.";
      }
      if (radioSupportBlock) radioSupportBlock.hidden = true;
      if (radioAtisCard) radioAtisCard.hidden = true;
      if (radioAtisValue) radioAtisValue.textContent = "—";
      if (radioAtisLabel) radioAtisLabel.textContent = "—";
      if (radioAtisSourceValue) {
        radioAtisSourceValue.textContent = "Information arrivée / départ";
      }
      if (radioPhoneCard) radioPhoneCard.hidden = true;
      if (radioPhoneValue) radioPhoneValue.textContent = "—";
      if (radioPhoneLabel) radioPhoneLabel.textContent = "Coordonnée terrain publiée";
      if (radioPhoneSourceValue) {
        radioPhoneSourceValue.textContent = "Publié pour le terrain";
      }
      if (radioSecondaryBlock) {
        radioSecondaryBlock.hidden = true;
        radioSecondaryBlock.open = false;
      }
      if (radioSecondaryCount) radioSecondaryCount.textContent = "0";
      if (radioList) radioList.innerHTML = "";

      tafSummaryValue.textContent = "Aucune donnée";
      currentWindDirection = null;
      currentWindSpeed = null;
      currentWindVariable = false;
      resetPlatformBlock();
    }

    function resetWeatherReferences() {
      if (weatherRefsBlock) weatherRefsBlock.hidden = true;
      if (weatherRefsList) weatherRefsList.innerHTML = "";
    }

    function showWeatherReferencesMessage(message) {
      if (!weatherRefsBlock || !weatherRefsList) return;

      weatherRefsBlock.hidden = false;
      weatherRefsList.innerHTML = `
        <li class="weather-ref-empty">${message}</li>
      `;
    }

    function normalizeCode(value) {
      return String(value || "").trim().toUpperCase();
    }

    function isValidWeatherCode(code) {
      return /^[A-Z]{4}$/.test(normalizeCode(code));
    }

    function getIcaoFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const value = normalizeCode(params.get("icao") || "");
      return isValidWeatherCode(value) ? value : "";
    }

    function syncIcaoInUrl(icao) {
      const url = new URL(window.location.href);

      if (icao && isValidWeatherCode(icao)) {
        url.searchParams.set("icao", icao);
      } else {
        url.searchParams.delete("icao");
      }

      const nextUrl = `${url.pathname}${url.search}${url.hash}`;
      window.history.replaceState({}, "", nextUrl);
    }

    function formatWind(dir, speed) {
      if (dir == null || speed == null) return "—";
      return `${dir}° à ${speed} kt`;
    }

    function formatVisibility(visib) {
      if (visib == null) return "—";
      if (Number(visib) >= 10) return "10 km ou plus";
      return `${visib} km`;
    }

    function formatClouds(item) {
      if (item?.cover && item?.clouds?.length) {
        const firstCloud = item.clouds[0];
        if (firstCloud?.base) {
          return `${item.cover} à ${firstCloud.base} ft`;
        }
        return item.cover;
      }

      if (item?.cover) return item.cover;
      return "—";
    }

    function formatTemp(temp, dewpoint) {
      if (temp == null && dewpoint == null) return "—";
      if (temp != null && dewpoint != null) {
        return `${temp}°C / rosée ${dewpoint}°C`;
      }
      if (temp != null) return `${temp}°C`;
      return `Rosée ${dewpoint}°C`;
    }

    function formatPressure(altim) {
      if (altim == null) return "—";
      return `${altim} hPa`;
    }

    function formatStatus(item) {
      if (!item) return "Aucune donnée";
      if (item.fltCat === "VFR") return "🟢 Météo VFR";
      if (item.fltCat === "MVFR") return "🟡 Météo marginale (MVFR)";
      if (item.fltCat === "IFR") return "🔴 Météo IFR";
      if (item.fltCat === "LIFR") return "🚨 Météo LIFR";
      return "Données météo reçues";
    }

    function formatWeatherCategoryLabel(category) {
      switch (category) {
        case "VFR":
          return "Météo VFR";
        case "MVFR":
          return "Météo marginale (MVFR)";
        case "IFR":
          return "Météo IFR";
        case "LIFR":
          return "Météo LIFR";
        default:
          return category || "Non disponible";
      }
    }

    function buildSimpleTaf(rawOb, item, icao) {
      if (!rawOb) {
        return `Aucune prévision TAF disponible pour ${icao}. Ce terrain ne publie probablement pas de TAF.`;
      }

      if (item?.fltCat === "VFR") {
        return "🟢 Prévision favorable : météo VFR attendue si la tendance se maintient.";
      }

      if (item?.fltCat === "MVFR") {
        return "🟡 Prévision à surveiller : météo marginale (MVFR) possible.";
      }

      if (item?.fltCat === "IFR") {
        return "🔴 Prévision dégradée : conditions IFR probables.";
      }

      if (item?.fltCat === "LIFR") {
        return "🚨 Prévision critique : conditions très dégradées.";
      }

      return "Prévision disponible en brut ci-dessous.";
    }

    function getAirportWeatherCode(airport) {
      const icao = normalizeCode(airport?.icao);
      if (isValidWeatherCode(icao)) return icao;

      const gpsCode = normalizeCode(airport?.gps_code);
      if (isValidWeatherCode(gpsCode)) return gpsCode;

      return "";
    }

    function normalizeAirportRecord(airport) {
      const weatherCode = getAirportWeatherCode(airport);
      const latitude = Number(airport?.latitude);
      const longitude = Number(airport?.longitude);

      return {
        ...airport,
        weatherCode,
        latitude,
        longitude,
        municipality: String(airport?.municipality || "").trim(),
        country: normalizeCode(airport?.iso_country || airport?.country || "FR"),
        sourceScope: "fr",
      };
    }

    function normalizeWorldAirportRecord(airport) {
      const weatherCode = normalizeCode(airport?.icao || airport?.weatherCode || airport?.gps_code || "");
      const latitude = Number(airport?.latitude);
      const longitude = Number(airport?.longitude);

      return {
        ...airport,
        weatherCode,
        icao: weatherCode,
        latitude,
        longitude,
        name: String(airport?.name || "").trim(),
        municipality: String(airport?.municipality || "").trim(),
        country: normalizeCode(airport?.country || airport?.iso_country || ""),
        type: String(airport?.type || "airport").trim(),
        sourceScope: "world",
      };
    }

    function isUsableAirport(airport) {
      return (
        airport &&
        airport.type !== "closed" &&
        airport.weatherCode &&
        Number.isFinite(airport.latitude) &&
        Number.isFinite(airport.longitude)
      );
    }

    function dedupeAirports(list) {
      const seen = new Set();

      return list.filter((airport) => {
        const key = airport.weatherCode;
        if (!key || seen.has(key)) return false;
        seen.add(key);
        return true;
      });
    }

    async function loadAirports() {
      if (airportsFrCache) return airportsFrCache;

      if (!airportsFrPromise) {
        airportsFrPromise = fetch(AIRPORTS_FR_URL)
          .then(async (res) => {
            if (!res.ok) {
              throw new Error("Impossible de charger la base France d’aérodromes.");
            }

            const data = await res.json();

            if (!Array.isArray(data)) {
              throw new Error("Format JSON inattendu pour la base France d’aérodromes.");
            }

            airportsFrCache = dedupeAirports(
              data.map(normalizeAirportRecord).filter(isUsableAirport)
            );

            return airportsFrCache;
          })
          .catch((error) => {
            airportsFrPromise = null;
            throw error;
          });
      }

      return airportsFrPromise;
    }

    async function loadWorldAirports() {
      if (airportsWorldCache) return airportsWorldCache;

      if (!airportsWorldPromise) {
        airportsWorldPromise = fetch(AIRPORTS_WORLD_URL)
          .then(async (res) => {
            if (!res.ok) {
              throw new Error("Impossible de charger la base mondiale d’aérodromes.");
            }

            const data = await res.json();

            if (!Array.isArray(data)) {
              throw new Error("Format JSON inattendu pour la base mondiale d’aérodromes.");
            }

            airportsWorldCache = dedupeAirports(
              data.map(normalizeWorldAirportRecord).filter(isUsableAirport)
            );

            return airportsWorldCache;
          })
          .catch(async (error) => {
            console.error(error);
            airportsWorldPromise = null;
            return loadAirports();
          });
      }

      return airportsWorldPromise;
    }

    async function findAirportByCode(code) {
      const normalized = normalizeCode(code);

      if (!normalized) return null;

      try {
        const airports = await loadWorldAirports();
        return (
          airports.find((airport) => airport.weatherCode === normalized) || null
        );
      } catch (error) {
        console.error(error);
        return null;
      }
    }

    async function findWorldAirportByCode(code) {
      const normalized = normalizeCode(code);

      if (!normalized) return null;

      try {
        const airports = await loadWorldAirports();
        return (
          airports.find((airport) => airport.weatherCode === normalized) || null
        );
      } catch (error) {
        console.error(error);
        return null;
      }
    }

    async function findAnyAirportByCode(code) {
      const localAirport = await findAirportByCode(code);
      if (localAirport) return localAirport;
      return findWorldAirportByCode(code);
    }

    function formatAirportDisplayName(airport, fallbackCode) {
      if (!airport) return fallbackCode || "—";

      const labelCode = airport.weatherCode || fallbackCode || "—";
      const municipality = airport.municipality
        ? ` — ${airport.municipality}`
        : "";
      const country =
        airport.sourceScope === "world" && airport.country
          ? ` (${airport.country})`
          : "";

      return `${airport.name} (${labelCode})${municipality}${country}`;
    }

    function formatMatchedDisplayName(matchedAirport, matchedUlm) {
      if (matchedAirport) {
        return formatAirportDisplayName(
          matchedAirport,
          matchedAirport.weatherCode
        );
      }

      if (matchedUlm?.name) {
        const codeLabel = matchedUlm.weatherCode || matchedUlm.code || "";
        return codeLabel
          ? `${matchedUlm.name} (${codeLabel})`
          : matchedUlm.name;
      }

      return "";
    }

    function normalizeUlmRecord(item) {
      const code = normalizeCode(item?.code || item?.source_id || "");
      const weatherCode = isValidWeatherCode(item?.weather_code)
        ? normalizeCode(item.weather_code)
        : "";

      return {
        ...item,
        code,
        weatherCode,
        latitude: Number(item?.latitude),
        longitude: Number(item?.longitude),
        platformType: item?.platform_type || "unknown",
        operationalLabel: item?.operational_label || "Plateforme spécifique",
        accessTags: Array.isArray(item?.access_tags) ? item.access_tags : [],
        weatherCapable: Boolean(weatherCode),
      };
    }

    function isUsableUlm(item) {
      return (
        item &&
        Number.isFinite(item.latitude) &&
        Number.isFinite(item.longitude) &&
        item.platformType !== "helistation"
      );
    }

    async function loadUlmBases() {
      if (ulmCache) return ulmCache;

      if (!ulmPromise) {
        ulmPromise = fetch(ULM_URL)
          .then(async (res) => {
            if (!res.ok) {
              throw new Error("Impossible de charger la base ULM.");
            }

            const data = await res.json();

            if (!Array.isArray(data)) {
              throw new Error("Format JSON inattendu pour la base ULM.");
            }

            ulmCache = data.map(normalizeUlmRecord).filter(isUsableUlm);
            return ulmCache;
          })
          .catch((error) => {
            ulmPromise = null;
            throw error;
          });
      }

      return ulmPromise;
    }

    async function findUlmByCode(code) {
      const normalized = normalizeCode(code);

      if (!normalized) return null;

      try {
        const ulmBases = await loadUlmBases();
        return (
          ulmBases.find(
            (item) =>
              item.code === normalized || item.weatherCode === normalized
          ) || null
        );
      } catch (error) {
        console.error(error);
        return null;
      }
    }

    function normalizeSearchText(value) {
      return String(value || "")
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .replace(/[’'`]/g, " ")
        .replace(/[^a-zA-Z0-9]+/g, " ")
        .trim()
        .toUpperCase()
        .replace(/\s+/g, " ");
    }

    function buildAirportSearchEntry(airport, basulmOverlay = null) {
      const targetCode = airport?.weatherCode || "";
      if (!targetCode) return null;

      const name = String(airport?.name || "").trim();
      const municipality = String(airport?.municipality || "").trim();
      const country = normalizeCode(airport?.country || airport?.iso_country || "");
      const metaParts = [targetCode];

      if (municipality) metaParts.push(municipality);
      if (country) metaParts.push(country);

      return {
        kind: "airport",
        targetCode,
        displayCode: targetCode,
        weatherCode: targetCode,
        code: targetCode,
        name,
        municipality,
        country,
        typeLabel: getAirportOperationalLabel(airport, basulmOverlay),
        metaLabel: metaParts.join(" · "),
        searchName: normalizeSearchText(name),
        searchMunicipality: normalizeSearchText(municipality),
        searchCountry: normalizeSearchText(country),
        searchCodes: [normalizeSearchText(targetCode)].filter(Boolean),
      };
    }

    function buildUlmSearchEntry(item) {
      const targetCode = normalizeCode(item?.code || item?.weatherCode || "");
      if (!targetCode) return null;

      const code = normalizeCode(item?.code || "");
      const weatherCode = normalizeCode(item?.weatherCode || "");
      const name = String(item?.name || "").trim();
      const metaParts = [code || weatherCode || targetCode];

      if (weatherCode && weatherCode !== code) {
        metaParts.push(`météo ${weatherCode}`);
      }

      return {
        kind: "ulm",
        targetCode,
        displayCode: code || weatherCode || targetCode,
        weatherCode,
        code,
        name,
        municipality: "",
        country: "FR",
        typeLabel: item?.operationalLabel || "Plateforme ULM",
        metaLabel: metaParts.join(" · "),
        searchName: normalizeSearchText(name),
        searchMunicipality: "",
        searchCountry: "FR",
        searchCodes: [code, weatherCode, targetCode]
          .map((value) => normalizeSearchText(value))
          .filter(Boolean),
      };
    }

    async function loadSearchIndex() {
      if (searchIndexCache) return searchIndexCache;

      if (!searchIndexPromise) {
        searchIndexPromise = Promise.all([loadWorldAirports(), loadUlmBases()])
          .then(([airports, ulmBases]) => {
            const basulmByWeatherCode = buildBasulmIndexByWeatherCode(ulmBases);

            const airportEntries = airports
              .map((airport) => {
                const overlay = basulmByWeatherCode.get(airport.weatherCode) || null;
                return buildAirportSearchEntry(airport, overlay);
              })
              .filter(Boolean);

            const ulmEntries = ulmBases.map(buildUlmSearchEntry).filter(Boolean);

            searchIndexCache = [...airportEntries, ...ulmEntries];
            return searchIndexCache;
          })
          .catch((error) => {
            searchIndexPromise = null;
            throw error;
          });
      }

      return searchIndexPromise;
    }

    function computeSearchScore(query, entry) {
      const normalizedQuery = normalizeSearchText(query);
      if (!normalizedQuery) return null;

      let score = 0;
      let matchKind = "";

      if (entry.searchCodes.includes(normalizedQuery)) {
        score = 1200;
        matchKind = "code_exact";
      } else if (entry.searchCodes.some((code) => code.startsWith(normalizedQuery))) {
        score = 1080;
        matchKind = "code_prefix";
      } else if (entry.searchName === normalizedQuery) {
        score = 980;
        matchKind = "name_exact";
      } else if (
        entry.searchMunicipality &&
        entry.searchMunicipality === normalizedQuery
      ) {
        score = 940;
        matchKind = "municipality_exact";
      } else if (entry.searchName.startsWith(normalizedQuery)) {
        score = 900;
        matchKind = "name_prefix";
      } else if (
        entry.searchMunicipality &&
        entry.searchMunicipality.startsWith(normalizedQuery)
      ) {
        score = 860;
        matchKind = "municipality_prefix";
      } else if (entry.searchCountry && entry.searchCountry === normalizedQuery) {
        score = 620;
        matchKind = "country_exact";
      } else {
        const nameWords = entry.searchName.split(" ").filter(Boolean);
        const cityWords = entry.searchMunicipality.split(" ").filter(Boolean);
        const anyWordPrefix = [...nameWords, ...cityWords].some((word) =>
          word.startsWith(normalizedQuery)
        );

        if (anyWordPrefix) {
          score = 810;
          matchKind = "word_prefix";
        } else {
          const allFields = [
            entry.searchName,
            entry.searchMunicipality,
            entry.searchCountry,
            ...entry.searchCodes,
          ]
            .filter(Boolean)
            .join(" ");

          if (allFields.includes(normalizedQuery)) {
            score = 760;
            matchKind = "partial";
          }
        }
      }

      if (!score) return null;

      if (entry.kind === "airport") score += 8;

      return { score, matchKind };
    }

    async function searchTerrainEntries(query, limit = 6) {
      const normalizedQuery = normalizeSearchText(query);
      if (normalizedQuery.length < 2) return [];

      const index = await loadSearchIndex();

      return index
        .map((entry) => {
          const scoring = computeSearchScore(query, entry);
          if (!scoring) return null;
          return { ...entry, ...scoring };
        })
        .filter(Boolean)
        .sort((a, b) => {
          if (b.score !== a.score) return b.score - a.score;
          if (a.kind !== b.kind) return a.kind === "airport" ? -1 : 1;

          const nameDiff = a.name.localeCompare(b.name, "fr", {
            sensitivity: "base",
          });
          if (nameDiff !== 0) return nameDiff;

          return a.displayCode.localeCompare(b.displayCode, "fr", {
            sensitivity: "base",
          });
        })
        .slice(0, limit);
    }

    function clearSearchFeedback() {
      if (!searchFeedback) return;
      searchFeedback.hidden = true;
      searchFeedback.textContent = "";
    }

    function setSearchFeedback(message) {
      if (!searchFeedback) return;
      if (!message) {
        clearSearchFeedback();
        return;
      }

      searchFeedback.hidden = false;
      searchFeedback.textContent = message;
    }

    function clearSearchSuggestions() {
      currentSearchResults = [];
      if (!searchSuggestions) return;
      searchSuggestions.hidden = true;
      searchSuggestions.innerHTML = "";
    }

    function applySearchSelection(selection) {
      if (!selection?.targetCode || !icaoInput) return;

      clearSearchFeedback();
      clearSearchSuggestions();
      icaoInput.value = selection.targetCode;
      loadMetar();
    }

    function renderSearchSuggestions(results) {
      currentSearchResults = Array.isArray(results) ? results : [];
      if (!searchSuggestions) return;

      if (!currentSearchResults.length) {
        clearSearchSuggestions();
        return;
      }

      searchSuggestions.hidden = false;
      searchSuggestions.innerHTML = "";

      currentSearchResults.forEach((item) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "tool-search-suggestion";
        button.setAttribute("role", "option");

        const kindLabel = item.kind === "airport" ? "Aérodrome" : "ULM";
        const metaLine = item.typeLabel
          ? `${item.metaLabel} · ${item.typeLabel}`
          : item.metaLabel;

        button.innerHTML = `
          <div class="tool-search-suggestion-top">
            <strong>${escapeHtml(item.name || item.displayCode)}</strong>
            <span class="tool-search-suggestion-badge">${escapeHtml(kindLabel)}</span>
          </div>
          <div class="tool-search-suggestion-meta">${escapeHtml(metaLine)}</div>
        `;

        button.addEventListener("mousedown", (event) => {
          event.preventDefault();
        });

        button.addEventListener("click", () => {
          applySearchSelection(item);
        });

        searchSuggestions.appendChild(button);
      });
    }

    async function refreshSearchSuggestions() {
      const rawQuery = String(icaoInput?.value || "").trim();
      clearSearchFeedback();

      if (!rawQuery) {
        clearSearchSuggestions();
        return;
      }

      if (isValidWeatherCode(rawQuery)) {
        clearSearchSuggestions();
        return;
      }

      if (normalizeSearchText(rawQuery).length < 2) {
        clearSearchSuggestions();
        return;
      }

      const requestValue = rawQuery;
      const results = await searchTerrainEntries(rawQuery, 6);

      if (String(icaoInput?.value || "").trim() !== requestValue) {
        return;
      }

      renderSearchSuggestions(results);
    }

    async function submitSearch() {
      const rawQuery = String(icaoInput?.value || "").trim();
      clearSearchFeedback();

      if (!rawQuery) {
        clearSearchSuggestions();
        syncIcaoInUrl("");
        metarOutput.textContent = "Entre un terrain, une ville ou un code OACI.";
        tafOutput.textContent = "Entre un terrain, une ville ou un code OACI.";
        resetDecoded();
        return;
      }

      const normalizedQuery = normalizeCode(rawQuery);
      if (isValidWeatherCode(normalizedQuery)) {
        clearSearchSuggestions();
        if (icaoInput) icaoInput.value = normalizedQuery;
        loadMetar();
        return;
      }

      const results = await searchTerrainEntries(rawQuery, 6);
      renderSearchSuggestions(results);

      if (!results.length) {
        setSearchFeedback(
          "Aucun terrain trouvé. Essaie un code OACI, un nom ou une ville."
        );
        metarOutput.textContent = `Aucun terrain trouvé pour « ${rawQuery} ». Essaie un code OACI, un nom ou une ville.`;
        tafOutput.textContent = "Aucune recherche météo lancée.";
        resetDecoded();
        return;
      }

      const top = results[0];
      const topCount = results.filter((item) => item.score === top.score).length;
      const singleClear =
        results.length === 1 ||
        ((top.matchKind === "code_exact" ||
          top.matchKind === "name_exact" ||
          top.matchKind === "municipality_exact") &&
          topCount === 1);

      if (singleClear) {
        applySearchSelection(top);
        return;
      }

      setSearchFeedback("Sélectionne un terrain dans la liste.");
    }

    function setLocateButtonState(isLoading) {
      if (!locateBtn) return;
      locateBtn.disabled = Boolean(isLoading);
      locateBtn.textContent = isLoading ? "Localisation..." : "Me localiser";
    }

    async function requestBrowserPosition() {
      if (!navigator.geolocation) {
        throw new Error("geolocation_not_supported");
      }

      return new Promise((resolve, reject) => {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            resolve({
              latitude: pos.coords.latitude,
              longitude: pos.coords.longitude,
            });
          },
          (error) => {
            if (error?.code === 1) {
              reject(new Error("geolocation_denied"));
              return;
            }

            if (error?.code === 2) {
              reject(new Error("geolocation_unavailable"));
              return;
            }

            if (error?.code === 3) {
              reject(new Error("geolocation_timeout"));
              return;
            }

            reject(new Error("geolocation_failed"));
          },
          {
            enableHighAccuracy: false,
            timeout: 10000,
            maximumAge: 120000,
          }
        );
      });
    }

    function buildLocationAirportEntry(airport, basulmOverlay, distanceKm) {
      const entry = buildAirportSearchEntry(airport, basulmOverlay);
      if (!entry) return null;

      return {
        ...entry,
        distanceKm,
        metaLabel: `${entry.metaLabel} · ${formatDistanceLabel(distanceKm)}`,
      };
    }

    function buildLocationUlmEntry(item, distanceKm) {
      const entry = buildUlmSearchEntry(item);
      if (!entry) return null;

      return {
        ...entry,
        distanceKm,
        metaLabel: `${entry.metaLabel} · ${formatDistanceLabel(distanceKm)}`,
      };
    }

    function buildEntryLocationResults(airports, ulmBases, center, limit = 3) {
      const basulmByWeatherCode = buildBasulmIndexByWeatherCode(ulmBases);

      const airportCandidates = airports
        .map((airport) => {
          const distanceKm = getDistanceKm(
            center.latitude,
            center.longitude,
            airport.latitude,
            airport.longitude
          );

          if (distanceKm > LOCATION_ENTRY_RADIUS_KM) return null;

          const overlay = basulmByWeatherCode.get(airport.weatherCode) || null;
          return buildLocationAirportEntry(airport, overlay, distanceKm);
        })
        .filter(Boolean)
        .sort((a, b) => a.distanceKm - b.distanceKm);

      const airportWeatherCodes = new Set(
        airportCandidates.map((item) => item.weatherCode).filter(Boolean)
      );

      const ulmCandidates = ulmBases
        .map((item) => {
          const distanceKm = getDistanceKm(
            center.latitude,
            center.longitude,
            item.latitude,
            item.longitude
          );

          if (distanceKm > LOCATION_ENTRY_RADIUS_KM) return null;
          if (item.weatherCode && airportWeatherCodes.has(item.weatherCode)) {
            return null;
          }

          return buildLocationUlmEntry(item, distanceKm);
        })
        .filter(Boolean)
        .sort((a, b) => a.distanceKm - b.distanceKm);

      const selected = [];
      const selectedKeys = new Set();

      const pushEntry = (entry) => {
        if (!entry) return;
        const key = `${entry.kind}:${entry.targetCode}`;
        if (selectedKeys.has(key)) return;
        selected.push(entry);
        selectedKeys.add(key);
      };

      pushEntry(airportCandidates[0] || null);
      pushEntry(airportCandidates[1] || null);
      pushEntry(ulmCandidates[0] || null);

      const overflow = [...airportCandidates.slice(2), ...ulmCandidates.slice(1)]
        .sort((a, b) => {
          if (a.distanceKm !== b.distanceKm) return a.distanceKm - b.distanceKm;
          if (a.kind !== b.kind) return a.kind === "airport" ? -1 : 1;
          return a.name.localeCompare(b.name, "fr", { sensitivity: "base" });
        });

      overflow.forEach((entry) => {
        if (selected.length >= limit) return;
        pushEntry(entry);
      });

      return selected.slice(0, limit);
    }

    async function locateFromEntry() {
      clearSearchSuggestions();
      setSearchFeedback("Localisation en cours...");
      setLocateButtonState(true);

      try {
        const center = await requestBrowserPosition();
        const [airports, ulmBases] = await Promise.all([
          loadWorldAirports(),
          loadUlmBases(),
        ]);

        const results = buildEntryLocationResults(
          airports,
          ulmBases,
          center,
          3
        );

        if (!results.length) {
          clearSearchSuggestions();
          setSearchFeedback(
            "Aucun terrain couvert trouvé près de votre position avec la base actuelle." 
          );
          return;
        }

        renderSearchSuggestions(results);
        setSearchFeedback("Terrains couverts près de votre position. Sélectionne un terrain.");
      } catch (error) {
        clearSearchSuggestions();

        if (error.message === "geolocation_not_supported") {
          setSearchFeedback("La géolocalisation n’est pas supportée sur cet appareil.");
          return;
        }

        if (error.message === "geolocation_denied") {
          setSearchFeedback("Géolocalisation refusée. Autorise la position ou saisis un terrain.");
          return;
        }

        if (
          error.message === "geolocation_unavailable" ||
          error.message === "geolocation_timeout" ||
          error.message === "geolocation_failed"
        ) {
          setSearchFeedback("Impossible de récupérer la position pour le moment.");
          return;
        }

        setSearchFeedback("Impossible de lancer la géolocalisation pour le moment.");
        console.error(error);
      } finally {
        setLocateButtonState(false);
      }
    }

function normalizeUlmDetailsRecord(item) {
      return {
        ...item,
        code: normalizeCode(item?.code || ""),
        operationalLabel: item?.operational_label || item?.operationalLabel || "Plateforme spécifique",
        accessTags: Array.isArray(item?.access_tags)
          ? item.access_tags
          : Array.isArray(item?.accessTags)
            ? item.accessTags
            : [],
        runways: Array.isArray(item?.runways) ? item.runways : [],
        radio: item?.radio || { documented: false, value: null },
        contact: item?.contact || {},
        notes: item?.notes || {},
        updatedAt: item?.updated_at || item?.updatedAt || null,
        sourceLabel: item?.source === "basulm_api" ? "BASULM" : "BASULM",
      };
    }

    async function loadUlmDetails() {
      if (ulmDetailsCache) return ulmDetailsCache;

      if (!ulmDetailsPromise) {
        ulmDetailsPromise = fetch(ULM_DETAILS_URL)
          .then(async (res) => {
            if (!res.ok) {
              throw new Error("Impossible de charger la base ULM détaillée.");
            }

            const data = await res.json();

            if (!Array.isArray(data)) {
              throw new Error("Format JSON inattendu pour la base ULM détaillée.");
            }

            ulmDetailsCache = data.map(normalizeUlmDetailsRecord);
            return ulmDetailsCache;
          })
          .catch((error) => {
            ulmDetailsPromise = null;
            throw error;
          });
      }

      return ulmDetailsPromise;
    }

    async function findUlmDetailsByCode(code) {
      const normalized = normalizeCode(code);
      if (!normalized) return null;

      try {
        const details = await loadUlmDetails();
        return details.find((item) => item.code === normalized) || null;
      } catch (error) {
        console.error(error);
        return null;
      }
    }

    function feetToMeters(value) {
      const parsed = Number(value);
      if (!Number.isFinite(parsed) || parsed <= 0) return null;
      return Math.round(parsed * 0.3048);
    }

    function formatRunwaySurfaceLabel(surface) {
      const value = String(surface || "").trim().toLowerCase();

      if (!value) return "surface non précisée";
      if (value.includes("herbe") || value.includes("grass") || value === "grs") {
        return "herbe";
      }
      if (
        value.includes("asphalt") ||
        value.includes("bitume") ||
        value.includes("concrete") ||
        value.includes("dur") ||
        value.includes("paved") ||
        value === "asp" ||
        value === "con"
      ) {
        return "dur";
      }
      if (value.includes("terre") || value.includes("earth")) return "terre";
      if (value.includes("gravel") || value.includes("grv")) return "gravier";
      if (value.includes("water")) return "eau";

      return String(surface).trim();
    }

    function formatAirportTypeLabel(type) {
      const value = String(type || "").trim().toLowerCase();

      if (value === "heliport") return "Hélistation";
      if (value === "seaplane_base") return "Hydrobase";
      if (value === "closed") return "Terrain fermé";
      if (value.includes("airport") || value.includes("aerodrome") || value.includes("aérodrome")) {
        return "Aérodrome";
      }

      return "Terrain";
    }

    function formatAirportRunwayIdent(runway) {
      const le = String(runway?.le_ident || "").trim();
      const he = String(runway?.he_ident || "").trim();
      if (le && he) return `${le}/${he}`;
      return le || he || "Piste";
    }

    function formatAirportRunwayEntry(runway) {
      const parts = [formatAirportRunwayIdent(runway)];
      const lengthM = feetToMeters(runway?.length_ft);
      const widthM = feetToMeters(runway?.width_ft);
      if (lengthM) parts.push(`${lengthM} m`);
      if (widthM) parts.push(`${widthM} m`);
      parts.push(formatRunwaySurfaceLabel(runway?.surface));
      return parts.join(" · ");
    }

    function formatUlmRunwayEntry(runway) {
      const parts = [];
      const ident = runway?.ident || runway?.orientation_raw || null;
      if (ident) parts.push(ident);
      if (runway?.length_m) parts.push(`${runway.length_m} m`);
      if (runway?.width_m) parts.push(`${runway.width_m} m`);
      parts.push(formatRunwaySurfaceLabel(runway?.surface));
      if (runway?.preferred_orientation_raw) {
        parts.push(`préférentielle ${runway.preferred_orientation_raw}`);
      }
      return parts.join(" · ");
    }

    function summarizeRunwayEntries(entries) {
      if (!Array.isArray(entries) || entries.length === 0) {
        return "Piste non documentée";
      }

      const limit = entries.length <= 5 ? entries.length : 4;
      const visible = entries.slice(0, limit);
      const suffix = entries.length > limit ? ` + ${entries.length - limit} autre(s)` : "";
      return `${visible.join(" / ")}${suffix}`;
    }

    function normalizeHeadingDegrees(value) {
      const parsed = Number(value);
      if (!Number.isFinite(parsed)) return null;
      const normalized = ((parsed % 360) + 360) % 360;
      return normalized;
    }

    function headingFromRunwayLabel(label) {
      const cleaned = String(label || "").trim().toUpperCase();
      const match = cleaned.match(/^(\d{2})/);
      if (!match) return null;
      const numeric = Number(match[1]);
      if (!Number.isFinite(numeric) || numeric < 1 || numeric > 36) return null;
      return normalizeHeadingDegrees((numeric % 36) * 10);
    }

    function reciprocalHeading(heading) {
      const normalized = normalizeHeadingDegrees(heading);
      if (normalized == null) return null;
      return normalizeHeadingDegrees(normalized + 180);
    }

    function parseOrientationPair(value) {
      const textValue = String(value || "").trim().toUpperCase();
      if (!textValue || textValue === "INCONNUE") return null;
      const parts = textValue.split(/\s*[\/-]\s*/).filter(Boolean);
      if (parts.length >= 2) {
        return {
          startLabel: parts[0],
          endLabel: parts[1],
          angleDeg: headingFromRunwayLabel(parts[0]),
        };
      }
      const heading = headingFromRunwayLabel(textValue);
      return heading == null
        ? null
        : {
            startLabel: textValue,
            endLabel: String(((Number(textValue.slice(0, 2)) + 18 - 1) % 36) + 1).padStart(2, "0"),
            angleDeg: heading,
          };
    }

    function preferredHeadingFromRaw(value) {
      const textValue = String(value || "").trim().toUpperCase();
      if (!textValue) return null;
      const parts = textValue.split(/\s*[\/-]\s*/).filter(Boolean);
      if (!parts.length) return null;
      return headingFromRunwayLabel(parts[0]);
    }

    function buildAirportRunwayVisuals(airport) {
      if (!airport || !Array.isArray(airport.runways)) return [];

      return airport.runways
        .map((runway) => {
          const startLabel = String(runway?.le_ident || "").trim().toUpperCase();
          const endLabel = String(runway?.he_ident || "").trim().toUpperCase();
          const angleDeg = headingFromRunwayLabel(startLabel);
          if (!startLabel || !endLabel || angleDeg == null) return null;
          return {
            key: `${startLabel}/${endLabel}`,
            startLabel,
            endLabel,
            angleDeg,
            reciprocalDeg: reciprocalHeading(angleDeg),
            lengthScore: Number(runway?.length_ft) || 0,
            preferredHeadingDeg: null,
            source: "airport",
          };
        })
        .filter(Boolean)
        .sort((a, b) => b.lengthScore - a.lengthScore)
        .slice(0, 5);
    }

    function buildUlmRunwayVisuals(details) {
      if (!details || !Array.isArray(details.runways)) return [];

      return details.runways
        .map((runway, index) => {
          const pair = parseOrientationPair(runway?.ident || runway?.orientation_raw || "");
          if (!pair || pair.angleDeg == null || !pair.startLabel || !pair.endLabel) return null;
          return {
            key: `${pair.startLabel}/${pair.endLabel}/${index}`,
            startLabel: pair.startLabel,
            endLabel: pair.endLabel,
            angleDeg: pair.angleDeg,
            reciprocalDeg: reciprocalHeading(pair.angleDeg),
            lengthScore: Number(runway?.length_m) || 0,
            preferredHeadingDeg: preferredHeadingFromRaw(runway?.preferred_orientation_raw),
            source: "ulm",
          };
        })
        .filter(Boolean)
        .sort((a, b) => b.lengthScore - a.lengthScore)
        .slice(0, 5);
    }

    function getTerrainRunwayVisuals(matchedAirport, matchedUlmDetails) {
      const airportVisuals = buildAirportRunwayVisuals(matchedAirport);
      if (airportVisuals.length) return airportVisuals;
      return buildUlmRunwayVisuals(matchedUlmDetails);
    }

    function getWindMetaLabel() {
      if (currentWindVariable && Number.isFinite(currentWindSpeed)) {
        return `Vent variable · ${currentWindSpeed} kt`;
      }
      if (Number.isFinite(currentWindDirection) && Number.isFinite(currentWindSpeed)) {
        return `Vent ${String(Math.round(currentWindDirection)).padStart(3, "0")}° · ${currentWindSpeed} kt`;
      }
      if (Number.isFinite(currentWindDirection)) {
        return `Vent ${String(Math.round(currentWindDirection)).padStart(3, "0")}°`;
      }
      return "Vent indisponible";
    }

    function headingToPoint(cx, cy, radius, headingDeg) {
      const rad = (headingDeg * Math.PI) / 180;
      return {
        x: cx + Math.sin(rad) * radius,
        y: cy - Math.cos(rad) * radius,
      };
    }

    function smallestAngularDiff(a, b) {
      const diff = Math.abs(a - b) % 360;
      return diff > 180 ? 360 - diff : diff;
    }

    function getBestWindAlignedHeading(runways) {
      if (!Array.isArray(runways) || !runways.length || !Number.isFinite(currentWindDirection)) {
        return null;
      }

      let best = null;
      for (const runway of runways) {
        const candidates = [runway.angleDeg, runway.reciprocalDeg].filter((v) => Number.isFinite(v));
        for (const candidate of candidates) {
          const score = smallestAngularDiff(candidate, currentWindDirection);
          if (!best || score < best.score) {
            best = { score, headingDeg: candidate, runwayKey: runway.key };
          }
        }
      }

      return best;
    }

    function escapeHtml(value) {
      return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function renderTerrainWindCard(matchedAirport, matchedUlmDetails) {
      if (!platformWindCard || !platformWindVisual || !platformWindMeta) return;

      const runways = getTerrainRunwayVisuals(matchedAirport, matchedUlmDetails);
      if (!runways.length) {
        platformWindCard.hidden = true;
        platformWindVisual.innerHTML = "";
        platformWindMeta.textContent = "Vent indisponible";
        return;
      }

      platformWindCard.hidden = false;
      platformWindMeta.textContent = getWindMetaLabel();

      const cx = 160;
      const cy = 110;
      const radius = 78;
      const runLength = 72;
      const bestWind = getBestWindAlignedHeading(runways);

      const ringMarkup = `
        <circle cx="${cx}" cy="${cy}" r="88" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1" />
        <circle cx="${cx}" cy="${cy}" r="70" fill="none" stroke="rgba(103,183,224,0.10)" stroke-width="1" stroke-dasharray="4 6" />
        <circle cx="${cx}" cy="${cy}" r="44" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1" stroke-dasharray="3 6" />
      `;

      const runwayMarkup = runways.map((runway) => {
        const isBestAxis = bestWind && bestWind.runwayKey === runway.key;
        const isPreferredStart = Number.isFinite(runway.preferredHeadingDeg) && smallestAngularDiff(runway.preferredHeadingDeg, runway.angleDeg) < 1;
        const isPreferredEnd = Number.isFinite(runway.preferredHeadingDeg) && smallestAngularDiff(runway.preferredHeadingDeg, runway.reciprocalDeg) < 1;

        const start = headingToPoint(cx, cy, runLength, runway.angleDeg);
        const end = headingToPoint(cx, cy, runLength, runway.reciprocalDeg);
        const startLabelPos = headingToPoint(cx, cy, runLength + 18, runway.angleDeg);
        const endLabelPos = headingToPoint(cx, cy, runLength + 18, runway.reciprocalDeg);

        const stroke = isBestAxis ? "rgba(136, 225, 255, 0.96)" : "rgba(216, 232, 244, 0.84)";
        const strokeWidth = isBestAxis ? 5.5 : 4;
        const glow = isBestAxis ? `
          <line x1="${start.x}" y1="${start.y}" x2="${end.x}" y2="${end.y}" stroke="rgba(90, 203, 255, 0.18)" stroke-width="11" stroke-linecap="round" />
        ` : "";

const prefStartDot = isPreferredStart
  ? `
    <circle cx="${start.x}" cy="${start.y}" r="11" fill="rgba(246, 178, 107, 0.14)" />
    <circle cx="${start.x}" cy="${start.y}" r="7.5" fill="none" stroke="rgba(246, 178, 107, 0.90)" stroke-width="2.2" />
    <circle cx="${start.x}" cy="${start.y}" r="3.2" fill="#f6b26b" stroke="rgba(255,255,255,0.55)" stroke-width="0.9" />
  `
  : "";

const prefEndDot = isPreferredEnd
  ? `
    <circle cx="${end.x}" cy="${end.y}" r="11" fill="rgba(246, 178, 107, 0.14)" />
    <circle cx="${end.x}" cy="${end.y}" r="7.5" fill="none" stroke="rgba(246, 178, 107, 0.90)" stroke-width="2.2" />
    <circle cx="${end.x}" cy="${end.y}" r="3.2" fill="#f6b26b" stroke="rgba(255,255,255,0.55)" stroke-width="0.9" />
  `
  : "";

        return `
          ${glow}
          <line x1="${start.x}" y1="${start.y}" x2="${end.x}" y2="${end.y}" stroke="${stroke}" stroke-width="${strokeWidth}" stroke-linecap="round" />
          ${prefStartDot}
          ${prefEndDot}
          <text x="${startLabelPos.x}" y="${startLabelPos.y}" text-anchor="middle" dominant-baseline="middle" fill="rgba(241,247,252,0.96)" font-size="13" font-weight="700">${escapeHtml(runway.startLabel)}</text>
          <text x="${endLabelPos.x}" y="${endLabelPos.y}" text-anchor="middle" dominant-baseline="middle" fill="rgba(241,247,252,0.96)" font-size="13" font-weight="700">${escapeHtml(runway.endLabel)}</text>
        `;
      }).join("");

      const windMarkup = Number.isFinite(currentWindDirection)
        ? (() => {
            const start = headingToPoint(cx, cy, radius, currentWindDirection);
            const end = headingToPoint(cx, cy, 18, currentWindDirection);
            return `
              <defs>
                <marker id="terrainWindArrow" markerWidth="10" markerHeight="10" refX="5" refY="5" orient="auto" markerUnits="strokeWidth">
                  <path d="M 0 0 L 10 5 L 0 10 z" fill="#ffb36b" />
                </marker>
              </defs>
              <line x1="${start.x}" y1="${start.y}" x2="${end.x}" y2="${end.y}" stroke="#ffb36b" stroke-width="4" stroke-linecap="round" marker-end="url(#terrainWindArrow)" />
              <circle cx="${start.x}" cy="${start.y}" r="3.5" fill="#ffb36b" fill-opacity="0.85" />
            `;
          })()
        : currentWindVariable
          ? `<circle cx="${cx}" cy="${cy}" r="12" fill="none" stroke="#ffb36b" stroke-width="3" stroke-dasharray="5 5" />`
          : "";

      platformWindVisual.innerHTML = `
        <svg viewBox="0 0 320 220" role="img" aria-label="Vent et pistes" class="terrain-visual-svg">
          <defs>
            <linearGradient id="terrainVisualGlow" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="rgba(103,183,224,0.16)" />
              <stop offset="100%" stop-color="rgba(103,183,224,0.04)" />
            </linearGradient>
          </defs>
          <rect x="0" y="0" width="320" height="220" rx="18" fill="url(#terrainVisualGlow)" />
          ${ringMarkup}
          ${runwayMarkup}
          ${windMarkup}
          <circle cx="${cx}" cy="${cy}" r="3.5" fill="rgba(255,255,255,0.72)" />
        </svg>
      `;
    }

    function getAirportRunwayEntries(airport) {
      if (!airport || !Array.isArray(airport.runways)) return [];
      return airport.runways.map(formatAirportRunwayEntry).filter(Boolean);
    }

    function getUlmRunwayEntries(details) {
      if (!details || !Array.isArray(details.runways)) return [];
      return details.runways.map(formatUlmRunwayEntry).filter(Boolean);
    }

    function formatTerrainIdentity(matchedAirport, matchedUlm, matchedUlmDetails) {
      const typeLabel = matchedUlmDetails?.operationalLabel || matchedUlm?.operationalLabel || formatAirportTypeLabel(matchedAirport?.type);
      const accessLabel = formatAccessTags(matchedUlmDetails?.accessTags || matchedUlm?.accessTags || []);
      return accessLabel ? `${typeLabel} · ${accessLabel}` : typeLabel || "Terrain";
    }

    function formatContactSummary(contact = {}, airport = null) {
      const parts = [];
      if (contact?.phone_1) parts.push(contact.phone_1);
      if (contact?.phone_2) parts.push(contact.phone_2);
      if (!parts.length && contact?.website) parts.push(contact.website);
      if (!parts.length && airport?.home_link) parts.push(airport.home_link);
      if (!parts.length && contact?.manager) parts.push(contact.manager);
      return parts.length ? parts.join(" · ") : "Non documenté";
    }

    function formatSiteDetails(contact = {}, airport = null) {
      const parts = [];
      if (contact?.website) parts.push(contact.website);
      if (contact?.manager) parts.push(contact.manager);
      if (!parts.length && airport?.home_link) parts.push(airport.home_link);
      if (!parts.length && airport?.wikipedia_link) parts.push(airport.wikipedia_link);
      return parts.length ? parts.join(" · ") : "";
    }

    function formatNotesSummary(details) {
      const consignes = details?.notes?.consignes;
      const infos = details?.notes?.infos;
      if (consignes) return consignes;
      if (infos) return infos;
      return "";
    }

    function getTerrainSourceMeta(matchedAirport, matchedUlmDetails) {
      if (matchedAirport && matchedUlmDetails) {
        return {
          badge: "Base France · BASULM",
          note: "Terrains : base France · BASULM.",
        };
      }
      if (matchedUlmDetails) {
        return {
          badge: "BASULM",
          note: "Terrains : BASULM.",
        };
      }
      if (matchedAirport?.sourceScope === "world") {
        return {
          badge: "Base monde",
          note: "Terrains : base monde.",
        };
      }
      return {
        badge: "Base France",
        note: "Terrains : base France.",
      };
    }

    function resetPlatformBlock() {
      if (platformBlock) platformBlock.hidden = true;
      if (platformSourceValue) platformSourceValue.textContent = "—";
      if (platformTypeValue) platformTypeValue.textContent = "—";
      if (platformContactValue) platformContactValue.textContent = "—";
      if (platformRunwaysValue) platformRunwaysValue.textContent = "—";
      if (platformRadioValue) platformRadioValue.textContent = "—";
      if (platformSiteValue) platformSiteValue.textContent = "—";
      if (platformNotesValue) platformNotesValue.textContent = "—";
      if (platformUpdatedValue) platformUpdatedValue.textContent = "—";
      if (platformSourceNote) {
        platformSourceNote.textContent = "Terrains : base monde · couche enrichie France / BASULM.";
      }
      if (platformDetailsDisclosure) {
        platformDetailsDisclosure.hidden = true;
        platformDetailsDisclosure.open = false;
      }
      if (platformRadioLine) platformRadioLine.hidden = true;
      if (platformSiteLine) platformSiteLine.hidden = true;
      if (platformNotesLine) platformNotesLine.hidden = true;
      if (platformUpdatedLine) platformUpdatedLine.hidden = true;
    }

    function renderPlatformBlock(matchedAirport, matchedUlm, matchedUlmDetails) {
      if (
        !platformBlock ||
        !platformSourceValue ||
        !platformTypeValue ||
        !platformRunwaysValue ||
        !platformContactValue ||
        !platformSourceNote
      ) {
        return;
      }

      if (!matchedAirport && !matchedUlm && !matchedUlmDetails) {
        resetPlatformBlock();
        return;
      }

      const sourceMeta = getTerrainSourceMeta(matchedAirport, matchedUlmDetails);
      const airportRunwayEntries = getAirportRunwayEntries(matchedAirport);
      const ulmRunwayEntries = getUlmRunwayEntries(matchedUlmDetails);
      const runwayEntries = airportRunwayEntries.length ? airportRunwayEntries : ulmRunwayEntries;
      const siteDetails = formatSiteDetails(matchedUlmDetails?.contact || {}, matchedAirport);
      const notesSummary = formatNotesSummary(matchedUlmDetails);
      const radioSummary = matchedUlmDetails?.radio?.documented && matchedUlmDetails?.radio?.value
        ? matchedUlmDetails.radio.value
        : "";
      const updatedSummary = matchedUlmDetails?.updatedAt || "";

      platformSourceValue.textContent = sourceMeta.badge;
      platformTypeValue.textContent = formatTerrainIdentity(
        matchedAirport,
        matchedUlm,
        matchedUlmDetails
      );
      platformRunwaysValue.textContent = summarizeRunwayEntries(runwayEntries);
      platformContactValue.textContent = formatContactSummary(
        matchedUlmDetails?.contact || {},
        matchedAirport
      );
      renderTerrainWindCard(matchedAirport, matchedUlmDetails);
      platformSourceNote.textContent = sourceMeta.note;

      const hasDetails = Boolean(siteDetails || notesSummary || radioSummary || updatedSummary);

      if (platformRadioLine) platformRadioLine.hidden = !radioSummary;
      if (platformSiteLine) platformSiteLine.hidden = !siteDetails;
      if (platformNotesLine) platformNotesLine.hidden = !notesSummary;
      if (platformUpdatedLine) platformUpdatedLine.hidden = !updatedSummary;

      if (platformRadioValue) platformRadioValue.textContent = radioSummary || "—";
      if (platformSiteValue) platformSiteValue.textContent = siteDetails || "—";
      if (platformNotesValue) platformNotesValue.textContent = notesSummary || "—";
      if (platformUpdatedValue) platformUpdatedValue.textContent = updatedSummary || "—";

      if (platformDetailsDisclosure) {
        platformDetailsDisclosure.hidden = !hasDetails;
        if (!hasDetails) platformDetailsDisclosure.open = false;
      }

      platformBlock.hidden = false;
    }

function normalizeFrequencyItem(entry) {
      return {
        ...entry,
        frequency_type: String(entry?.frequency_type || "").trim(),
        label: String(entry?.label || "").trim(),
        description: String(entry?.description || "").trim(),
        service_code: String(entry?.service_code || "").trim(),
        sector: String(entry?.sector || "").trim(),
        remark: String(entry?.remark || "").trim(),
        suppletive: String(entry?.suppletive || "").trim(),
        frequency_mhz: Number(entry?.frequency_mhz),
      };
    }

    function normalizeFrequencyRecord(item) {
      return {
        ...item,
        airport_ident: normalizeCode(item?.airport_ident || ""),
        weather_code: normalizeCode(item?.weather_code || ""),
        airport_name: String(item?.airport_name || "").trim(),
        frequencies: Array.isArray(item?.frequencies)
          ? item.frequencies.map(normalizeFrequencyItem)
          : [],
        primary_frequency: item?.primary_frequency
          ? normalizeFrequencyItem(item.primary_frequency)
          : null,
      };
    }

    async function loadFrequencies() {
      if (frequenciesCache) return frequenciesCache;

      if (!frequenciesPromise) {
        frequenciesPromise = fetch(FREQUENCIES_URL)
          .then(async (res) => {
            if (!res.ok) {
              throw new Error("Impossible de charger la base fréquences.");
            }

            const data = await res.json();

            if (!Array.isArray(data)) {
              throw new Error("Format JSON inattendu pour la base fréquences.");
            }

            frequenciesCache = data.map(normalizeFrequencyRecord);
            return frequenciesCache;
          })
          .catch((error) => {
            frequenciesPromise = null;
            throw error;
          });
      }

      return frequenciesPromise;
    }

    async function findFrequencyByCode(code) {
      const normalized = normalizeCode(code);
      if (!normalized) return null;

      try {
        const allFrequencies = await loadFrequencies();

        return (
          allFrequencies.find(
            (item) =>
              item.weather_code === normalized ||
              item.airport_ident === normalized
          ) || null
        );
      } catch (error) {
        console.error(error);
        return null;
      }
    }

    function formatFrequencyMhz(value) {
      const parsed = Number(value);
      return Number.isFinite(parsed) ? `${parsed.toFixed(3)} MHz` : "";
    }

    function normalizeRadioText(value) {
      return String(value || "").trim().replace(/\s+/g, " ");
    }

    function getRadioServiceKey(frequency) {
      const rawType = String(frequency?.frequency_type || "")
        .trim()
        .toLowerCase();

      const rawLabel = normalizeRadioText(
        `${frequency?.label || ""} ${frequency?.description || ""}`
      ).toUpperCase();

      if (rawLabel.includes("D-ATIS") || rawLabel.includes("ATIS")) {
        return "atis";
      }

      if (
        rawLabel.includes("PREVOL") ||
        rawLabel.includes("PRÉVOL") ||
        rawLabel.includes("PREFLIGHT") ||
        rawLabel.includes("PRE-FLIGHT")
      ) {
        return "preflight";
      }

      if (rawLabel.includes("TRAFIC") || rawLabel.includes("TRAFFIC")) {
        return "traffic";
      }

      if (
        rawLabel.includes("GND") ||
        rawLabel.includes("GROUND") ||
        rawLabel.includes("SOL")
      ) {
        return "ground";
      }

      if (
        rawLabel.includes("APP") ||
        rawLabel.includes("APPROACH") ||
        rawLabel.includes("APPROCHE")
      ) {
        return "approach";
      }

      if (
        rawLabel.includes("INFO") ||
        rawLabel.includes("INFORMATION") ||
        rawLabel.includes("AFIS") ||
        rawLabel.includes("FIS")
      ) {
        return "information";
      }

      if (
        rawLabel.includes("AUTO-INFORMATION") ||
        rawLabel.includes("AUTO INFORMATION") ||
        rawLabel.includes("AUTO-INFO") ||
        rawLabel.includes("AUTO INFO") ||
        rawLabel.includes("A/A") ||
        rawLabel.includes("UNICOM") ||
        rawLabel.includes("CTAF")
      ) {
        return "air_to_air";
      }

      if (
        rawLabel.includes("DEP") ||
        rawLabel.includes("DEPART") ||
        rawLabel.includes("DÉPART") ||
        rawLabel.includes("DEPARTURE")
      ) {
        return "departure";
      }

      if (
        rawLabel.includes("ARR") ||
        rawLabel.includes("ARRIVEE") ||
        rawLabel.includes("ARRIVÉE") ||
        rawLabel.includes("ARRIVAL")
      ) {
        return "arrival";
      }

      if (
        rawLabel.includes("TWR") ||
        rawLabel.includes("TOUR") ||
        rawLabel.includes("TOWER")
      ) {
        return "tower";
      }

      if (rawType === "tower" || rawType === "twr") return "tower";
      if (rawType === "ground" || rawType === "gnd") return "ground";
      if (rawType === "approach" || rawType === "app") return "approach";
      if (
        rawType === "information" ||
        rawType === "afis" ||
        rawType === "info" ||
        rawType === "fis"
      ) {
        return "information";
      }
      if (rawType === "atis") return "atis";
      if (
        rawType === "air_to_air" ||
        rawType === "air-to-air" ||
        rawType === "ctaf" ||
        rawType === "unicom"
      ) {
        return "air_to_air";
      }
      if (rawType === "departure" || rawType === "dep") return "departure";
      if (rawType === "arrival" || rawType === "arr") return "arrival";
      if (rawType === "radar" || rawType === "rad") return "radar";
      if (rawType === "control" || rawType === "acc" || rawType === "acs") {
        return "control";
      }

      return rawType || "other";
    }

    function getRadioServiceLabel(frequency) {
      const rawLabel = normalizeRadioText(
        `${frequency?.label || ""} ${frequency?.description || ""}`
      ).toUpperCase();
      const serviceKey = getRadioServiceKey(frequency);

      if (rawLabel.includes("AFIS")) return "AFIS";

      switch (serviceKey) {
        case "tower":
          return "Tour";
        case "ground":
          return "Sol";
        case "approach":
          return "Approche";
        case "information":
          return "Info";
        case "atis":
          return "ATIS";
        case "air_to_air":
          return "Auto-information";
        case "preflight":
          return "Prévol";
        case "traffic":
          return "Trafic";
        case "departure":
          return "Départ";
        case "arrival":
          return "Arrivée";
        default:
          return "Radio";
      }
    }

    function getRadioServicePriorityByLabel(serviceLabel) {
      const normalized = normalizeRadioText(serviceLabel).toLowerCase();

      if (normalized === "tour") return 1;
      if (normalized === "afis") return 2;
      if (normalized === "info") return 3;
      if (normalized === "sol") return 4;
      if (normalized === "approche") return 5;
      if (normalized === "trafic") return 6;
      if (normalized === "auto-information") return 7;
      if (normalized === "départ" || normalized === "depart") return 8;
      if (normalized === "arrivée" || normalized === "arrivee") return 9;
      if (normalized === "prévol" || normalized === "prevol") return 10;
      if (normalized === "atis") return 99;
      return 98;
    }

    function getRadioServicePriority(frequency) {
      return getRadioServicePriorityByLabel(getRadioServiceLabel(frequency));
    }

    function shouldHideFrequencyEntry(entry) {
      const serviceCode = normalizeCode(entry?.service_code || "");
      const labelText = normalizeRadioText(
        `${entry?.label || ""} ${entry?.description || ""}`
      ).toUpperCase();
      const mhz = Number(entry?.frequency_mhz);

      if (!Number.isFinite(mhz) || mhz <= 0) return true;
      if (serviceCode === "VDF") return true;
      if (labelText.includes("GONIO")) return true;
      if (labelText.includes("HOMER")) return true;

      return false;
    }

    function cleanOfficialQualifierText(value) {
      return normalizeRadioText(value)
        .replace(/#/g, " · ")
        .replace(/Secteur\/Sector/gi, "Secteur")
        .replace(/et\/and/gi, " et ")
        .replace(/à\/to/gi, " à ")
        .replace(/\bCanal\s+8\.33\b/gi, "")
        .replace(/\bCanal\s+25\b/gi, "")
        .replace(/\s*·\s*·\s*/g, " · ")
        .replace(/\s+/g, " ")
        .replace(/[.;]+$/g, "")
        .trim();
    }

    function normalizeSivQualifierText(value) {
      return cleanOfficialQualifierText(value)
        .replace(/\bSIV\s+/gi, "SIV ")
        .replace(/\s+et\s+/gi, " et ")
        .replace(/\s*\/\s*/g, " / ")
        .replace(/\s+/g, " ")
        .trim();
    }

    function extractOfficialQualifierFromRemark(remark) {
      const cleaned = cleanOfficialQualifierText(remark);
      if (!cleaned) return "";

      const sectorWithSivMatch = cleaned.match(
        /Secteur\s+([A-Z0-9.]+)\s*\((SIV[^)]+)\)/i
      );
      if (sectorWithSivMatch?.[1] && sectorWithSivMatch?.[2]) {
        return `Secteur ${sectorWithSivMatch[1]} (${normalizeSivQualifierText(
          sectorWithSivMatch[2]
        )})`;
      }

      const sectorOnlyMatch = cleaned.match(/Secteur\s+([A-Z0-9.]+)/i);
      if (sectorOnlyMatch?.[1]) {
        return `Secteur ${sectorOnlyMatch[1]}`;
      }

      const infoRadarMatch = cleaned.match(
        /Information\/Radar\s+(SIV\s+[^·]+)/i
      );
      if (infoRadarMatch?.[1]) {
        return normalizeSivQualifierText(infoRadarMatch[1]);
      }

      const sivMatch = cleaned.match(
        /(SIV\s+[0-9.]+(?:\s*(?:et|\/|à)\s*(?:SIV\s*)?[0-9.]+(?:\.[0-9]+)?)*)/i
      );
      if (sivMatch?.[1]) {
        return normalizeSivQualifierText(sivMatch[1]);
      }

      return "";
    }

    function getOfficialFrequencyBaseLabel(entry) {
      const label = normalizeRadioText(entry?.label || "");
      const description = normalizeRadioText(entry?.description || "");
      const serviceLabel = getRadioServiceLabel(entry);

      if (label) return label;
      if (description) return description;

      if (
        serviceLabel === "ATIS" ||
        serviceLabel === "Sol" ||
        serviceLabel === "Tour" ||
        serviceLabel === "Approche" ||
        serviceLabel === "Info" ||
        serviceLabel === "Auto-information" ||
        serviceLabel === "Prévol" ||
        serviceLabel === "Trafic"
      ) {
        return serviceLabel;
      }

      return "Radio";
    }

    function getOfficialSectorSuffix(entry) {
      const directSector = cleanOfficialQualifierText(entry?.sector || "");
      if (directSector) return directSector;

      const remarkQualifier = extractOfficialQualifierFromRemark(
        entry?.remark || ""
      );
      if (remarkQualifier) return remarkQualifier;

      const suppletive = cleanOfficialQualifierText(entry?.suppletive || "");
      if (suppletive && normalizeCode(suppletive) !== "NON") {
        return suppletive;
      }

      return "";
    }

    function getOperationalFrequencyLabel(entry) {
      const baseLabel = getOfficialFrequencyBaseLabel(entry);
      const sectorSuffix = getOfficialSectorSuffix(entry);

      if (!sectorSuffix) return baseLabel;

      return `${baseLabel} — ${sectorSuffix}`;
    }

    function getDisplayFrequencyKey(entry) {
      return [
        getOperationalFrequencyLabel(entry),
        formatFrequencyMhz(entry?.frequency_mhz),
      ].join("|");
    }

    function getFrequencyDetailScore(entry) {
      return (
        (normalizeRadioText(getOfficialSectorSuffix(entry)) ? 100 : 0) +
        (normalizeRadioText(entry?.remark || "") ? 10 : 0) +
        Math.min(
          normalizeRadioText(getOfficialFrequencyBaseLabel(entry)).length,
          40
        )
      );
    }

    function buildDisplayFrequencies(frequencies = []) {
      const visibleFrequencies = frequencies.filter(
        (entry) => !shouldHideFrequencyEntry(entry)
      );

      const grouped = new Map();

      visibleFrequencies.forEach((entry) => {
        const mhzLabel = formatFrequencyMhz(entry?.frequency_mhz);
        if (!mhzLabel) return;

        const baseKey = normalizeRadioText(
          getOfficialFrequencyBaseLabel(entry)
        ).toUpperCase();

        const groupKey = [baseKey, mhzLabel].join("|");

        if (!grouped.has(groupKey)) {
          grouped.set(groupKey, []);
        }

        grouped.get(groupKey).push(entry);
      });

      const reduced = [];

      grouped.forEach((entries) => {
        const qualifiedEntries = entries.filter((entry) =>
          normalizeRadioText(getOfficialSectorSuffix(entry))
        );

        const sourceEntries =
          qualifiedEntries.length > 0 ? qualifiedEntries : entries;

        const bestByQualifier = new Map();

        sourceEntries.forEach((entry) => {
          const qualifierKey =
            normalizeRadioText(getOfficialSectorSuffix(entry)).toLowerCase() ||
            "__default__";

          const current = bestByQualifier.get(qualifierKey);

          if (
            current == null ||
            getFrequencyDetailScore(entry) > getFrequencyDetailScore(current)
          ) {
            bestByQualifier.set(qualifierKey, entry);
          }
        });

        reduced.push(...bestByQualifier.values());
      });

      return reduced.sort((a, b) => {
        const serviceDiff =
          getRadioServicePriority(a) - getRadioServicePriority(b);
        if (serviceDiff !== 0) return serviceDiff;

        const labelDiff = getOperationalFrequencyLabel(a).localeCompare(
          getOperationalFrequencyLabel(b),
          "fr",
          { sensitivity: "base" }
        );
        if (labelDiff !== 0) return labelDiff;

        const freqA = Number(a?.frequency_mhz);
        const freqB = Number(b?.frequency_mhz);

        if (Number.isFinite(freqA) && Number.isFinite(freqB) && freqA !== freqB) {
          return freqA - freqB;
        }

        return 0;
      });
    }

    function formatPublishedPhones(details = null) {
      const phones = [details?.contact?.phone_1, details?.contact?.phone_2]
        .map((value) => normalizeRadioText(value))
        .filter(Boolean);

      return phones;
    }

    function getAtisDisplayEntries(displayFrequencies = []) {
      return displayFrequencies.filter(
        (entry) => getRadioServiceLabel(entry) === "ATIS"
      );
    }

    function getPrimaryRadioCandidates(displayFrequencies = []) {
      return displayFrequencies.filter(
        (entry) => getRadioServiceLabel(entry) !== "ATIS"
      );
    }

    function renderFrequencyPanel(record, fallbackRadio = null, matchedUlmDetails = null) {
      if (!radioValue || !radioTypeValue || !radioLabelValue) return;

      if (radioList) radioList.innerHTML = "";
      if (radioSupportBlock) radioSupportBlock.hidden = true;
      if (radioAtisCard) radioAtisCard.hidden = true;
      if (radioPhoneCard) radioPhoneCard.hidden = true;
      if (radioSecondaryBlock) {
        radioSecondaryBlock.hidden = true;
        radioSecondaryBlock.open = false;
      }
      if (radioSecondaryCount) radioSecondaryCount.textContent = "0";

      const publishedPhones = formatPublishedPhones(matchedUlmDetails);

      const renderPublishedPhone = () => {
        if (!radioSupportBlock || !radioPhoneCard || !publishedPhones.length) return;

        radioSupportBlock.hidden = false;
        radioPhoneCard.hidden = false;
        if (radioPhoneValue) radioPhoneValue.textContent = publishedPhones.join(" / ");
        if (radioPhoneLabel) {
          radioPhoneLabel.textContent = "Téléphone publié pour le terrain.";
        }
        if (radioPhoneSourceValue) {
          radioPhoneSourceValue.textContent = matchedUlmDetails ? "Source terrain publiée" : "Publié pour le terrain";
        }
      };

      const renderAtis = (atisEntry) => {
        if (!radioSupportBlock || !radioAtisCard || !atisEntry) return;

        radioSupportBlock.hidden = false;
        radioAtisCard.hidden = false;
        if (radioAtisValue) {
          radioAtisValue.textContent = formatFrequencyMhz(atisEntry.frequency_mhz) || "—";
        }
        if (radioAtisLabel) {
          radioAtisLabel.textContent = getOperationalFrequencyLabel(atisEntry);
        }
        if (radioAtisSourceValue) {
          radioAtisSourceValue.textContent = "Information arrivée / départ";
        }
      };

      const setUnavailable = () => {
        radioTypeValue.textContent = "Radio";
        radioValue.textContent = "Non disponible";
        radioLabelValue.textContent =
          "Aucune fréquence publiée trouvée pour ce terrain.";
        if (radioSourceValue) {
          radioSourceValue.textContent =
            "Radio : SIA prioritaire · BASULM selon terrain.";
        }
        renderPublishedPhone();
      };

      const renderBasulmFallback = () => {
        if (!fallbackRadio?.documented || !fallbackRadio?.value) {
          setUnavailable();
          return;
        }

        radioTypeValue.textContent = "Radio BASULM";
        radioValue.textContent = fallbackRadio.value;
        radioLabelValue.textContent =
          "Fréquence publiée BASULM pour la plateforme.";
        if (radioSourceValue) {
          radioSourceValue.textContent = "Radio : BASULM.";
        }
        renderPublishedPhone();
      };

      if (
        !record ||
        !Array.isArray(record.frequencies) ||
        record.frequencies.length === 0
      ) {
        renderBasulmFallback();
        return;
      }

      const allFrequencies = Array.isArray(record.frequencies)
        ? record.frequencies
        : [];

      const displayFrequencies = buildDisplayFrequencies(allFrequencies);

      if (!displayFrequencies.length) {
        renderBasulmFallback();
        return;
      }

      const atisEntries = getAtisDisplayEntries(displayFrequencies);
      const primaryCandidates = getPrimaryRadioCandidates(displayFrequencies);

      const primaryVisibleMatch = record.primary_frequency
        ? primaryCandidates.find((entry) => {
            return (
              formatFrequencyMhz(entry.frequency_mhz) ===
                formatFrequencyMhz(record.primary_frequency.frequency_mhz) &&
              normalizeRadioText(getOfficialFrequencyBaseLabel(entry)) ===
                normalizeRadioText(
                  getOfficialFrequencyBaseLabel(record.primary_frequency)
                )
            );
          })
        : null;

      const primaryFrequency =
        primaryVisibleMatch || primaryCandidates[0] || atisEntries[0] || null;

      if (!primaryFrequency) {
        renderBasulmFallback();
        return;
      }

      const inferredAfis = Boolean(
        matchedUlmDetails?.notes?.consignes &&
        /\bAFIS\b/i.test(matchedUlmDetails.notes.consignes) &&
        getRadioServiceLabel(primaryFrequency) === "Info"
      );

      radioTypeValue.textContent = inferredAfis
        ? "AFIS"
        : getRadioServiceLabel(primaryFrequency);
      radioValue.textContent =
        formatFrequencyMhz(primaryFrequency.frequency_mhz) || "—";
      radioLabelValue.textContent = getOperationalFrequencyLabel(primaryFrequency);
      if (radioSourceValue) {
        radioSourceValue.textContent = "Radio : SIA prioritaire · BASULM selon terrain.";
      }

      const primaryKey = getDisplayFrequencyKey(primaryFrequency);
      const atisKey = atisEntries[0] ? getDisplayFrequencyKey(atisEntries[0]) : null;

      const secondaryFrequencies = displayFrequencies.filter((entry) => {
        const entryKey = getDisplayFrequencyKey(entry);
        if (entryKey === primaryKey) return false;
        if (atisKey && entryKey === atisKey) return false;
        return true;
      });

      if (atisEntries.length) {
        const highlightedAtis = atisEntries.find(
          (entry) => getDisplayFrequencyKey(entry) !== primaryKey
        ) || atisEntries[0];
        if (highlightedAtis && getDisplayFrequencyKey(highlightedAtis) !== primaryKey) {
          renderAtis(highlightedAtis);
        }
      }

      renderPublishedPhone();

      if (!radioList || secondaryFrequencies.length === 0) return;

      if (radioSecondaryBlock) {
        radioSecondaryBlock.hidden = false;
        radioSecondaryBlock.open = false;
      }
      if (radioSecondaryCount) {
        radioSecondaryCount.textContent = String(secondaryFrequencies.length);
      }

      secondaryFrequencies.forEach((entry) => {
        const item = document.createElement("li");

        item.innerHTML = `
          <div>
            <strong>${getOperationalFrequencyLabel(entry)}</strong>
          </div>
          <span>${formatFrequencyMhz(entry.frequency_mhz) || "—"}</span>
        `;

        radioList.appendChild(item);
      });
    }

function getDistanceKm(lat1, lon1, lat2, lon2) {
      const toRad = (value) => (value * Math.PI) / 180;
      const R = 6371;

      const dLat = toRad(lat2 - lat1);
      const dLon = toRad(lon2 - lon1);

      const a =
        Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(toRad(lat1)) *
          Math.cos(toRad(lat2)) *
          Math.sin(dLon / 2) *
          Math.sin(dLon / 2);

      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      return R * c;
    }

    function formatDistanceLabel(distanceKm) {
      if (!Number.isFinite(distanceKm)) return "";
      const distanceNm = distanceKm / 1.852;
      return `${distanceNm.toFixed(0)} NM · ${distanceKm.toFixed(1)} km`;
    }

    function formatReferenceIdentity(reference) {
      if (!reference?.airport) return "";

      const code = reference.airport.weatherCode || reference.snapshot?.icao || "";
      const name = reference.airport.name || code || "Terrain voisin";

      return code ? `${name} (${code})` : name;
    }

    function formatNeighborStatus(reference) {
      const identity = formatReferenceIdentity(reference);

      if (reference?.snapshot?.fltCat === "VFR") {
        return `🟢 Météo voisine VFR — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "MVFR") {
        return `🟡 Météo voisine MVFR — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "IFR") {
        return `🔴 Météo voisine IFR — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "LIFR") {
        return `🚨 Météo voisine LIFR — ${identity}`;
      }

      return `Repère météo voisin — ${identity}`;
    }

function formatNeighborFlightCategory(reference) {
  const category = reference?.snapshot?.fltCat;
  return formatWeatherCategoryLabel(category);
}

    function buildNeighborMetarOutput(reference, targetCode, fallbackMessage) {
      if (!reference?.snapshot?.rawOb) return fallbackMessage;

      const identity = formatReferenceIdentity(reference);
      const distanceLabel = formatDistanceLabel(reference.distanceKm);

      return `Aucun METAR publié pour ${targetCode}.
Repère voisin retenu : ${identity}${distanceLabel ? ` — ${distanceLabel}` : ""}.

${reference.snapshot.rawOb}`;
    }

    function buildNeighborTafOutput(reference, targetCode, fallbackMessage) {
      if (!reference) return fallbackMessage;

      const identity = formatReferenceIdentity(reference);
      const distanceLabel = formatDistanceLabel(reference.distanceKm);

      if (reference?.snapshot?.taf) {
        return `Aucun TAF publié pour ${targetCode}.
Repère voisin retenu : ${identity}${distanceLabel ? ` — ${distanceLabel}` : ""}.

${reference.snapshot.taf}`;
      }

      return `Aucun TAF publié pour ${targetCode}.
Repère voisin retenu : ${identity}${distanceLabel ? ` — ${distanceLabel}` : ""}.

TAF voisin indisponible sur ce terrain de référence.`;
    }

    function buildNeighborTafSummary(reference) {
      if (!reference) return "Prévision indisponible";

      const identity = formatReferenceIdentity(reference);

      if (!reference?.snapshot?.taf) {
        return `Prévision voisine indisponible — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "VFR") {
        return `🟢 Tendance météo voisine VFR — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "MVFR") {
        return `🟡 Tendance météo voisine MVFR — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "IFR") {
        return `🔴 Tendance météo voisine IFR — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "LIFR") {
        return `🚨 Tendance météo voisine LIFR — ${identity}`;
      }

      return `Prévision voisine disponible — ${identity}`;
    }

    function getAirportOperationalLabel(airport, basulmOverlay) {
      if (basulmOverlay?.operationalLabel) return basulmOverlay.operationalLabel;

      if (airport.type === "large_airport") return "Aérodrome principal";
      if (airport.type === "medium_airport") return "Aérodrome";
      if (airport.type === "small_airport") return "Aérodrome";
      return "Plateforme aéronautique";
    }

    function formatAccessTags(tags = []) {
      const labels = [];

      if (tags.includes("open_to_ulm")) labels.push("Ouvert aux ULM");
      if (tags.includes("authorization_required")) {
        labels.push("Autorisation obligatoire");
      }
      if (tags.includes("private")) labels.push("Privé");
      if (tags.includes("restricted")) labels.push("Restrictions");
      if (tags.includes("specific_rules")) labels.push("Règles spécifiques");
      if (tags.includes("in_service")) labels.push("En service");

      return labels.join(" · ");
    }

    function buildBasulmIndexByWeatherCode(ulmBases) {
      const map = new Map();

      ulmBases.forEach((item) => {
        if (!item.weatherCode) return;
        if (!map.has(item.weatherCode)) {
          map.set(item.weatherCode, item);
        }
      });

      return map;
    }

async function fetchWeatherSnapshot(icao) {
  const normalized = normalizeCode(icao);
  if (!normalized) return null;

  try {
    const res = await fetch(
      `${WORKER_URL}?icao=${encodeURIComponent(normalized)}`
    );

    if (!res.ok) return null;

    const data = await res.json();

    if (!Array.isArray(data) || data.length === 0) return null;

    const item = data[0];

    if (!item || typeof item !== "object" || !item.rawOb) return null;

    return {
      icao: normalized,
      rawOb: item.rawOb || "",
      taf: item.taf || "",
      fltCat: item.fltCat || "",
      wdir: item.wdir ?? null,
      wspd: item.wspd ?? null,
      visib: item.visib ?? null,
      cover: item.cover ?? "",
      clouds: Array.isArray(item.clouds) ? item.clouds : [],
      temp: item.temp ?? null,
      dewp: item.dewp ?? null,
      altim: item.altim ?? null,
    };
  } catch (error) {
    console.error(error);
    return null;
  }
}

    function formatWeatherReferenceMeta(snapshot) {
      const parts = ["METAR disponible"];
      parts.push(snapshot?.taf ? "TAF disponible" : "TAF indisponible");

      if (snapshot?.fltCat) {
        parts.push(formatWeatherCategoryLabel(snapshot.fltCat));
      }

      return parts.join(" · ");
    }

    function getWeatherReferenceCenter(matchedAirport, matchedUlm) {
      if (
        matchedAirport &&
        Number.isFinite(matchedAirport.latitude) &&
        Number.isFinite(matchedAirport.longitude)
      ) {
        return {
          latitude: matchedAirport.latitude,
          longitude: matchedAirport.longitude,
        };
      }

      if (
        matchedUlm &&
        Number.isFinite(matchedUlm.latitude) &&
        Number.isFinite(matchedUlm.longitude)
      ) {
        return {
          latitude: matchedUlm.latitude,
          longitude: matchedUlm.longitude,
        };
      }

      return null;
    }

    async function findNearbyWeatherReferences(
      targetCode,
      matchedAirport,
      matchedUlm
    ) {
      const center = getWeatherReferenceCenter(matchedAirport, matchedUlm);
      if (!center) return [];

      try {
        const airports = await loadAirports();

        const nearbyCandidates = airports
          .filter((airport) => airport.weatherCode !== normalizeCode(targetCode))
          .map((airport) => ({
            airport,
            distanceKm: getDistanceKm(
              center.latitude,
              center.longitude,
              airport.latitude,
              airport.longitude
            ),
          }))
          .filter((item) => item.distanceKm <= WEATHER_REFERENCE_MAX_KM)
          .sort((a, b) => a.distanceKm - b.distanceKm)
          .slice(0, 12);

        if (nearbyCandidates.length === 0) return [];

        const candidateResults = await Promise.all(
          nearbyCandidates.map(async (item) => {
            const snapshot = await fetchWeatherSnapshot(item.airport.weatherCode);

            return snapshot
              ? {
                  airport: item.airport,
                  distanceKm: item.distanceKm,
                  snapshot,
                }
              : null;
          })
        );

        return candidateResults.filter(Boolean).slice(0, 3);
      } catch (error) {
        console.error(error);
        return [];
      }
    }

    async function loadWeatherReferences(
      targetCode,
      matchedAirport,
      matchedUlm,
      precomputedReferences = null
    ) {
      if (!weatherRefsBlock || !weatherRefsList) return;

      const references =
        precomputedReferences ||
        (await findNearbyWeatherReferences(targetCode, matchedAirport, matchedUlm));

      if (!references || references.length === 0) {
        showWeatherReferencesMessage(
          "Aucun repère météo publié trouvé dans un rayon de 50 NM autour de ce terrain."
        );
        return;
      }

      weatherRefsBlock.hidden = false;
      weatherRefsList.innerHTML = "";

      references.forEach((reference) => {
        const li = document.createElement("li");

        li.innerHTML = `
          <button type="button" class="weather-ref-card">
            <div class="weather-ref-top">
              <strong>${reference.airport.weatherCode}</strong>
              <span>${formatDistanceLabel(reference.distanceKm)}</span>
            </div>
            <div class="weather-ref-name">${reference.airport.name}</div>
            <div class="weather-ref-meta">${formatWeatherReferenceMeta(reference.snapshot)}</div>
            <div class="weather-ref-action">Voir METAR / TAF</div>
          </button>
        `;

        const button = li.querySelector("button");

        button?.addEventListener("click", () => {
          icaoInput.value = reference.airport.weatherCode;
          loadMetar();
          window.scrollTo({ top: 0, behavior: "smooth" });
        });

        weatherRefsList.appendChild(li);
      });
    }

async function applyMissingLocalWeatherState({
  icao,
  matchedAirport,
  matchedUlm,
  matchedUlmDetails,
  matchedFrequency,
  metarMessage,
  tafMessage,
  emptyStatusMessage,
}) {
  const references = await findNearbyWeatherReferences(
    icao,
    matchedAirport,
    matchedUlm
  );
  const primaryReference = references[0] || null;

  resetDecoded();
  renderPlatformBlock(matchedAirport, matchedUlm, matchedUlmDetails);

  nameValue.textContent =
    formatMatchedDisplayName(matchedAirport, matchedUlm) || icao;
  renderFrequencyPanel(matchedFrequency, matchedUlmDetails?.radio || null, matchedUlmDetails);

  if (primaryReference) {
    statusValue.textContent = formatNeighborStatus(primaryReference);

    currentWindDirection = Number.isFinite(Number(primaryReference.snapshot?.wdir))
      ? Number(primaryReference.snapshot?.wdir)
      : null;
    currentWindSpeed = Number.isFinite(Number(primaryReference.snapshot?.wspd))
      ? Number(primaryReference.snapshot?.wspd)
      : null;
    currentWindVariable =
      String(primaryReference.snapshot?.wdir || "").trim().toUpperCase() === "VRB";

    windValue.textContent = formatWind(
      primaryReference.snapshot?.wdir,
      primaryReference.snapshot?.wspd
    );
    visibilityValue.textContent = formatVisibility(
      primaryReference.snapshot?.visib
    );
    cloudsValue.textContent = formatClouds(primaryReference.snapshot);
    tempValue.textContent = formatTemp(
      primaryReference.snapshot?.temp,
      primaryReference.snapshot?.dewp
    );
    pressureValue.textContent = formatPressure(
      primaryReference.snapshot?.altim
    );

    fltCatValue.textContent = formatNeighborFlightCategory(primaryReference);

    metarOutput.textContent = buildNeighborMetarOutput(
      primaryReference,
      icao,
      metarMessage
    );
    tafOutput.textContent = buildNeighborTafOutput(
      primaryReference,
      icao,
      tafMessage
    );
    tafSummaryValue.textContent = buildNeighborTafSummary(primaryReference);
  } else {
    statusValue.textContent = emptyStatusMessage;
    windValue.textContent = "Non disponible";
    visibilityValue.textContent = "Non disponible";
    cloudsValue.textContent = "Non disponible";
    tempValue.textContent = "Non disponible";
    pressureValue.textContent = "Non disponible";
    fltCatValue.textContent = "Non disponible";
    metarOutput.textContent = metarMessage;
    tafOutput.textContent = tafMessage;
    tafSummaryValue.textContent = "Prévision indisponible";
    currentWindDirection = null;
    currentWindSpeed = null;
    currentWindVariable = false;
  }

  renderTerrainWindCard(matchedAirport, matchedUlmDetails);

  await loadWeatherReferences(
    icao,
    matchedAirport,
    matchedUlm,
    references
  );
}

    async function resolveNearbyCenter() {
      const enteredCode = normalizeCode(icaoInput?.value);

      if (enteredCode) {
        const matchedAirport = await findAnyAirportByCode(enteredCode);
        if (matchedAirport) {
          return {
            latitude: matchedAirport.latitude,
            longitude: matchedAirport.longitude,
            label: `Terrains autour de ${matchedAirport.weatherCode} — ${matchedAirport.name}`,
          };
        }

        const matchedUlm = await findUlmByCode(enteredCode);
        if (matchedUlm) {
          return {
            latitude: matchedUlm.latitude,
            longitude: matchedUlm.longitude,
            label: `Terrains autour de ${matchedUlm.code} — ${matchedUlm.name}`,
          };
        }
      }

      const position = await requestBrowserPosition();

      return {
        latitude: position.latitude,
        longitude: position.longitude,
        label: "Terrains autour de votre position",
      };
    }


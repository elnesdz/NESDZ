---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Outils pilote"
  description="Météo aviation, METAR, TAF et aérodromes à proximité."
>
  <section class="container" style="padding: 20px 0;">
    <div class="card">
      <div class="pad">
        <h1>Outils pilote</h1>

        <div class="tool-block">
          <label for="icaoInput">Code OACI</label>
          <div class="row tool-row">
            <input id="icaoInput" placeholder="Ex : LFQQ" value="LFQQ" />
            <button id="loadMetarBtn" type="button">Voir METAR / TAF</button>
          </div>
        </div>

        <div class="tool-block">
          <h2>Lecture rapide</h2>
          <div id="decodedOutput" class="decoded-grid">
            <div class="decoded-card">
              <span class="decoded-label">Statut</span>
              <strong id="statusValue">Aucune donnée</strong>
            </div>

            <div class="decoded-card">
              <span class="decoded-label">Terrain</span>
              <strong id="nameValue">—</strong>
            </div>

            <div class="decoded-card">
              <span class="decoded-label">Vent</span>
              <strong id="windValue">—</strong>
            </div>

            <div class="decoded-card">
              <span class="decoded-label">Visibilité</span>
              <strong id="visibilityValue">—</strong>
            </div>

            <div class="decoded-card">
              <span class="decoded-label">Nuages</span>
              <strong id="cloudsValue">—</strong>
            </div>

            <div class="decoded-card">
              <span class="decoded-label">Température</span>
              <strong id="tempValue">—</strong>
            </div>

            <div class="decoded-card">
              <span class="decoded-label">Pression</span>
              <strong id="pressureValue">—</strong>
            </div>

            <div class="decoded-card">
              <span class="decoded-label">Catégorie vol</span>
              <strong id="fltCatValue">—</strong>
            </div>
          </div>
        </div>

        <div class="tool-block">
          <h2>Lecture prévision</h2>
          <div class="decoded-grid">
            <div class="decoded-card decoded-card-wide">
              <span class="decoded-label">Tendance</span>
              <strong id="tafSummaryValue">Aucune donnée</strong>
            </div>
          </div>
        </div>

        <div class="tool-block">
          <h2>METAR brut</h2>
          <pre id="metarOutput">Aucune donnée</pre>
        </div>

        <div class="tool-block">
          <h2>TAF brut</h2>
          <pre id="tafOutput">Aucune donnée</pre>
        </div>

        <div class="tool-block">
          <h2>Aérodromes à proximité</h2>
          <button id="nearbyBtn" type="button">Autour de moi</button>
          <ul id="nearbyAirports"></ul>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const WORKER_URL = "https://metar-proxy-nesdz.elnesdz.workers.dev/";
    const AIRPORTS_URL = "/data/airports-fr.json";

    const icaoInput = document.getElementById("icaoInput");
    const metarOutput = document.getElementById("metarOutput");
    const tafOutput = document.getElementById("tafOutput");
    const nearbyAirports = document.getElementById("nearbyAirports");
    const loadMetarBtn = document.getElementById("loadMetarBtn");
    const nearbyBtn = document.getElementById("nearbyBtn");

    const statusValue = document.getElementById("statusValue");
    const nameValue = document.getElementById("nameValue");
    const windValue = document.getElementById("windValue");
    const visibilityValue = document.getElementById("visibilityValue");
    const cloudsValue = document.getElementById("cloudsValue");
    const tempValue = document.getElementById("tempValue");
    const pressureValue = document.getElementById("pressureValue");
    const fltCatValue = document.getElementById("fltCatValue");
    const tafSummaryValue = document.getElementById("tafSummaryValue");

    function resetDecoded() {
      statusValue.textContent = "Aucune donnée";
      nameValue.textContent = "—";
      windValue.textContent = "—";
      visibilityValue.textContent = "—";
      cloudsValue.textContent = "—";
      tempValue.textContent = "—";
      pressureValue.textContent = "—";
      fltCatValue.textContent = "—";
      tafSummaryValue.textContent = "Aucune donnée";
    }

    function formatWind(dir, speed) {
      if (dir == null || speed == null) return "—";
      return `${dir}° à ${speed} kt`;
    }

    function formatVisibility(visib) {
      if (visib == null) return "—";
      if (Number(visib) >= 10) return "10 km ou plus";
      return `${visib} km`;
    }

    function formatClouds(item) {
      if (item?.cover && item?.clouds?.length) {
        const firstCloud = item.clouds[0];
        if (firstCloud?.base) {
          return `${item.cover} à ${firstCloud.base} ft`;
        }
        return item.cover;
      }

      if (item?.cover) return item.cover;
      return "—";
    }

    function formatTemp(temp, dewpoint) {
      if (temp == null && dewpoint == null) return "—";
      if (temp != null && dewpoint != null) {
        return `${temp}°C / rosée ${dewpoint}°C`;
      }
      if (temp != null) return `${temp}°C`;
      return `Rosée ${dewpoint}°C`;
    }

    function formatPressure(altim) {
      if (altim == null) return "—";
      return `${altim} hPa`;
    }

    function formatStatus(item) {
      if (!item) return "Aucune donnée";
      if (item.fltCat === "VFR") return "🟢 Conditions VFR (bonnes)";
      if (item.fltCat === "MVFR") return "🟡 VFR marginal (à surveiller)";
      if (item.fltCat === "IFR") return "🔴 IFR (dégradé)";
      if (item.fltCat === "LIFR") return "🚨 IFR basse (très dégradé)";
      return "Données météo reçues";
    }

    function buildSimpleTaf(rawOb, item, icao) {
      if (!rawOb) {
        return `Aucune prévision TAF disponible pour ${icao}. Ce terrain ne publie probablement pas de TAF.`;
      }

      if (item?.fltCat === "VFR") {
        return "🟢 Prévision favorable : conditions VFR attendues si la tendance se maintient.";
      }

      if (item?.fltCat === "MVFR") {
        return "🟡 Prévision à surveiller : conditions VFR marginales possibles.";
      }

      if (item?.fltCat === "IFR") {
        return "🔴 Prévision dégradée : conditions IFR probables.";
      }

      if (item?.fltCat === "LIFR") {
        return "🚨 Prévision critique : conditions très dégradées.";
      }

      return "Prévision disponible en brut ci-dessous.";
    }

    async function loadMetar() {
      const icao = icaoInput?.value?.trim().toUpperCase();

      if (!icao) {
        metarOutput.textContent = "Entre un code OACI.";
        tafOutput.textContent = "Entre un code OACI.";
        resetDecoded();
        return;
      }

      metarOutput.textContent = "Chargement...";
      tafOutput.textContent = "Chargement...";
      statusValue.textContent = "Chargement...";
      nameValue.textContent = "…";
      windValue.textContent = "…";
      visibilityValue.textContent = "…";
      cloudsValue.textContent = "…";
      tempValue.textContent = "…";
      pressureValue.textContent = "…";
      fltCatValue.textContent = "…";
      tafSummaryValue.textContent = "Chargement...";

      try {
        const res = await fetch(`${WORKER_URL}?icao=${encodeURIComponent(icao)}`);

        if (!res.ok) {
          metarOutput.textContent =
            `Aucune météo exploitable trouvée pour ${icao}. Ce terrain ne publie peut-être pas de METAR, ou la source n’a pas de donnée disponible actuellement.`;
          tafOutput.textContent =
            `Aucune prévision TAF exploitable trouvée pour ${icao}.`;

          resetDecoded();
          statusValue.textContent = "⚠️ Météo indisponible";
          nameValue.textContent = icao;
          windValue.textContent = "Non disponible";
          visibilityValue.textContent = "Non disponible";
          cloudsValue.textContent = "Non disponible";
          tempValue.textContent = "Non disponible";
          pressureValue.textContent = "Non disponible";
          fltCatValue.textContent = "Non disponible";
          tafSummaryValue.textContent = "Prévision indisponible";
          return;
        }

        const data = await res.json();

        if (!Array.isArray(data) || data.length === 0) {
          metarOutput.textContent =
            `Aucune observation METAR trouvée pour ${icao}. Vérifie le code OACI ou teste un terrain disposant d’une météo publiée.`;
          tafOutput.textContent =
            `Aucune prévision TAF trouvée pour ${icao}.`;

          resetDecoded();
          statusValue.textContent = "Aucune donnée météo disponible";
          nameValue.textContent = icao;
          windValue.textContent = "Non disponible";
          visibilityValue.textContent = "Non disponible";
          cloudsValue.textContent = "Non disponible";
          tempValue.textContent = "Non disponible";
          pressureValue.textContent = "Non disponible";
          fltCatValue.textContent = "Non disponible";
          tafSummaryValue.textContent = "Prévision indisponible";
          return;
        }

        const item = data[0];

        if (!item || typeof item !== "object") {
          metarOutput.textContent = `Réponse météo inexploitable pour ${icao}.`;
          tafOutput.textContent = `Réponse prévision inexploitable pour ${icao}.`;

          resetDecoded();
          statusValue.textContent = "Réponse invalide";
          nameValue.textContent = icao;
          windValue.textContent = "Indisponible";
          visibilityValue.textContent = "Indisponible";
          cloudsValue.textContent = "Indisponible";
          tempValue.textContent = "Indisponible";
          pressureValue.textContent = "Indisponible";
          fltCatValue.textContent = "Indisponible";
          tafSummaryValue.textContent = "Prévision indisponible";
          return;
        }

        metarOutput.textContent = item.rawOb || "METAR brut indisponible";
        tafOutput.textContent =
          item.taf || "TAF non disponible via cette source actuelle";

        statusValue.textContent = formatStatus(item);
        nameValue.textContent = item.name || item.icaoId || icao;
        windValue.textContent = formatWind(item.wdir, item.wspd);
        visibilityValue.textContent = formatVisibility(item.visib);
        cloudsValue.textContent = formatClouds(item);
        tempValue.textContent = formatTemp(item.temp, item.dewp);
        pressureValue.textContent = formatPressure(item.altim);
        fltCatValue.textContent = item.fltCat || "—";
        tafSummaryValue.textContent = buildSimpleTaf(item.taf, item, icao);
      } catch (error) {
        metarOutput.textContent =
          `Impossible de joindre la météo pour ${icao} pour le moment. Réessaie dans quelques instants ou teste un terrain plus couvert comme LFQQ ou LFPN.`;
        tafOutput.textContent =
          `Impossible de joindre la prévision pour ${icao} pour le moment.`;

        resetDecoded();
        statusValue.textContent = "⚠️ Service météo indisponible";
        nameValue.textContent = icao;
        windValue.textContent = "Non disponible";
        visibilityValue.textContent = "Non disponible";
        cloudsValue.textContent = "Non disponible";
        tempValue.textContent = "Non disponible";
        pressureValue.textContent = "Non disponible";
        fltCatValue.textContent = "Non disponible";
        tafSummaryValue.textContent = "Prévision indisponible";
        console.error(error);
      }
    }

    function getDistanceKm(lat1, lon1, lat2, lon2) {
      const toRad = (value) => (value * Math.PI) / 180;
      const R = 6371;

      const dLat = toRad(lat2 - lat1);
      const dLon = toRad(lon2 - lon1);

      const a =
        Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(toRad(lat1)) *
          Math.cos(toRad(lat2)) *
          Math.sin(dLon / 2) *
          Math.sin(dLon / 2);

      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      return R * c;
    }

    function dedupeAirports(list) {
      const seen = new Set();

      return list.filter((airport) => {
        const key = airport.icao;
        if (!key || seen.has(key)) return false;
        seen.add(key);
        return true;
      });
    }

    async function getLocation() {
      nearbyAirports.innerHTML = "";

      if (!navigator.geolocation) {
        nearbyAirports.innerHTML =
          "<li>La géolocalisation n’est pas supportée sur cet appareil.</li>";
        return;
      }

      nearbyAirports.innerHTML = "<li>Recherche des terrains proches...</li>";

      navigator.geolocation.getCurrentPosition(
        async (pos) => {
          const lat = pos.coords.latitude;
          const lon = pos.coords.longitude;

          try {
            const res = await fetch(AIRPORTS_URL);
            const airportsRaw = await res.json();

            if (!Array.isArray(airportsRaw) || airportsRaw.length === 0) {
              nearbyAirports.innerHTML =
                "<li>Base d’aérodromes indisponible.</li>";
              return;
            }

            const airports = dedupeAirports(airportsRaw);

            const nearest = airports
  .map((airport) => ({
    ...airport,
    distanceKm: getDistanceKm(lat, lon, airport.lat, airport.lon),
  }))

  // 🔥 filtre utile
  .filter((airport) => {
    // garder uniquement les terrains avec code ICAO valide
    if (!airport.icao || airport.icao.length !== 4) return false;

    // limiter à 300 km max (évite Paris quand t’es à Lille)
    if (airport.distanceKm > 300) return false;

    return true;
  })

  // tri distance
  .sort((a, b) => a.distanceKm - b.distanceKm)

  // limiter affichage
  .slice(0, 10);

            nearbyAirports.innerHTML = "";

            nearest.forEach((airport) => {
              const li = document.createElement("li");
              const button = document.createElement("button");

              button.type = "button";
              button.className = "airport-nearby-btn";
              button.innerHTML = `
                <strong>${airport.icao}</strong> — ${airport.name}
                <span>${airport.distanceKm.toFixed(1)} km</span>
              `;

              button.addEventListener("click", () => {
                icaoInput.value = airport.icao;
                loadMetar();
              });

              li.appendChild(button);
              nearbyAirports.appendChild(li);
            });
          } catch (error) {
            nearbyAirports.innerHTML =
              "<li>Impossible de charger la base d’aérodromes.</li>";
            console.error(error);
          }
        },
        (error) => {
          nearbyAirports.innerHTML =
            "<li>Impossible de récupérer la position.</li>";
          console.error(error);
        }
      );
    }

    loadMetarBtn?.addEventListener("click", loadMetar);
    nearbyBtn?.addEventListener("click", getLocation);

    icaoInput?.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        loadMetar();
      }
    });
  </script>

  <style>
    .tool-block {
      margin-top: 24px;
    }

    .tool-row {
      gap: 12px;
      flex-wrap: wrap;
    }

    .tool-block input {
      min-width: 220px;
      padding: 10px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.05);
      color: white;
    }

    .tool-block button {
      padding: 10px 14px;
      border-radius: 8px;
      background: var(--accent);
      border: none;
      color: white;
      cursor: pointer;
    }

    .decoded-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      margin-top: 12px;
    }

    .decoded-card {
      padding: 14px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.03);
    }

    .decoded-card-wide {
      grid-column: 1 / -1;
    }

    .decoded-label {
      display: block;
      font-size: 0.9rem;
      color: var(--muted);
      margin-bottom: 6px;
    }

    pre {
      background: rgba(0, 0, 0, 0.4);
      padding: 12px;
      border-radius: 8px;
      overflow-x: auto;
      white-space: pre-wrap;
    }

    #nearbyAirports {
      margin-top: 12px;
      padding-left: 0;
      list-style: none;
      display: grid;
      gap: 10px;
    }

    .airport-nearby-btn {
      width: 100%;
      text-align: left;
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.03);
      color: white;
      cursor: pointer;
    }

    .airport-nearby-btn span {
      color: var(--muted);
      font-size: 0.95rem;
      white-space: nowrap;
    }

    @media (max-width: 720px) {
      .airport-nearby-btn {
        flex-direction: column;
        align-items: flex-start;
      }

      .airport-nearby-btn span {
        white-space: normal;
      }
    }
  </style>
</BaseLayout>

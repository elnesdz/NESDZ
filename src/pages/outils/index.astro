---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Météo & terrains"
  description="Météo aviation, METAR, TAF et terrains proches."
>
  <section class="container tool-page">
    <div class="card">
      <div class="pad">
        
        <!-- ======================================================================= -->
        <!-- HEADER & RECHERCHE (COMMUNS)                                          -->
        <!-- ======================================================================= -->
        <header class="tool-header">
          <h1>Météo & Terrains</h1>
          <div class="tool-search-entry">
            <label for="icaoInput" class="tool-entry-label">
              Terrain (OACI, Nom ou Ville)
            </label>
            <div class="tool-search-row">
              <div class="tool-search-col">
                <input
                  id="icaoInput"
                  placeholder="Ex : LFAC ou Calais"
                  value="LFAC"
                  inputmode="text"
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                  enterkeyhint="search"
                  aria-label="Terrain, code OACI ou ville"
                />
                <div id="searchSuggestions" class="tool-search-suggestions" role="listbox" hidden></div>
                <p id="searchFeedback" class="tool-search-feedback" hidden></p>
              </div>
              <div class="tool-search-actions">
                <button id="loadDataBtn" class="tool-action-btn tool-action-btn--primary" type="button">
                  Charger
                </button>
                <button id="locateBtn" class="tool-action-btn tool-action-btn--secondary" type="button" aria-label="Me localiser">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
                </button>
              </div>
            </div>
            <p class="tool-entry-help">
              Pour la préparation du vol, les services officiels restent la référence réglementaire.
            </p>
          </div>
        </header>

        <!-- ======================================================================= -->
        <!-- NAVIGATION PAR ONGLETS                                                -->
        <!-- ======================================================================= -->
        <nav id="tabNav" class="tab-nav" aria-label="Navigation principale">
          <button class="tab-btn is-active" data-tab="metar">METAR</button>
          <button class="tab-btn" data-tab="taf">TAF</button>
          <button class="tab-btn" data-tab="notam">NOTAM</button>
          <button class="tab-btn" data-tab="terrain">Terrain</button>
        </nav>

        <!-- ======================================================================= -->
        <!-- PANNEAUX DE CONTENU (ONGLETS)                                         -->
        <!-- ======================================================================= -->
        <main class="tab-content">

          <!-- ===== ONGLET METAR ===== -->
          <div id="tab-metar" class="tab-panel">
            <div class="tool-block">
              <h2>Lecture rapide</h2>
              <div class="decoded-grid decoded-grid--summary">
                <div class="decoded-card decoded-card-status decoded-card-mobile-wide"><span class="decoded-label">Statut</span><strong id="statusValue">...</strong></div>
                <div class="decoded-card decoded-card-terrain decoded-card-mobile-wide"><span class="decoded-label">Terrain</span><strong id="nameValue">...</strong></div>
                <div class="decoded-card decoded-card-metric"><span class="decoded-label">Vent</span><strong id="windValue">...</strong></div>
                <div class="decoded-card decoded-card-metric"><span class="decoded-label">Visibilité</span><strong id="visibilityValue">...</strong></div>
                <div class="decoded-card decoded-card-metric"><span class="decoded-label">Nuages</span><strong id="cloudsValue">...</strong><small id="cloudsMeta" class="decoded-micro-note" hidden></small></div>
                <div class="decoded-card decoded-card-metric"><span class="decoded-label">Température</span><strong id="tempValue">...</strong></div>
                <div class="decoded-card decoded-card-metric"><span class="decoded-label">Pression</span><strong id="pressureValue">...</strong></div>
                <div class="decoded-card decoded-card-metric"><span class="decoded-label">Cat. Météo</span><strong id="fltCatValue">...</strong></div>
              </div>
              <p id="weatherFreshnessNote" class="decoded-note decoded-note--micro decoded-note--timing" hidden></p>
            </div>
            
            <div id="platformWindCard" class="tool-block decoded-card decoded-card-wide terrain-visual-card terrain-visual-card--briefing" hidden>
              <div class="terrain-visual-head">
                <div><span class="decoded-label">Lecture pilote</span><strong class="terrain-visual-title">Vent & Axes de piste</strong></div>
                <span id="platformWindMeta" class="terrain-visual-meta">...</span>
              </div>
              <div id="platformWindVisual" class="terrain-visual-canvas" aria-label="Schéma vent et pistes"></div>
            </div>

            <details class="tool-block tool-disclosure raw-weather-disclosure">
              <summary><span class="raw-weather-summary-text"><span class="raw-weather-summary-title">METAR brut</span></span></summary>
              <div class="tool-disclosure-content raw-weather-content"><pre id="metarOutput">...</pre></div>
            </details>
          </div>

          <!-- ===== ONGLET TAF ===== -->
          <div id="tab-taf" class="tab-panel" hidden>
            <div class="tool-block">
              <h2>Lecture prévision</h2>
              <div class="decoded-grid decoded-grid--forecast">
                <div class="decoded-card decoded-card-wide taf-decode-card">
                  <div class="taf-head"><span class="decoded-label">Prévision</span><strong id="tafSummaryValue">...</strong></div>
                  <div id="tafMetaGrid" class="taf-meta-grid" hidden>
                    <div id="tafIssuedCard" class="taf-meta-card" hidden><span class="taf-meta-label">Émission</span><strong id="tafIssuedValue">...</strong></div>
                    <div id="tafValidityCard" class="taf-meta-card" hidden><span class="taf-meta-label">Validité</span><strong id="tafValidityValue">...</strong></div>
                    <div id="tafModifierCard" class="taf-meta-card taf-meta-card--compact" hidden><span class="taf-meta-label">Statut</span><strong id="tafModifierValue">...</strong></div>
                  </div>
                  <p id="tafDecoderMeta" class="taf-decoder-meta" hidden></p>
                  <div id="tafVisualBlock" class="taf-visual-block" hidden>
                    <div class="taf-visual-head">
                      <div><span class="taf-visual-kicker">Prévision principale</span><strong>BASE</strong></div>
                      <span class="taf-visual-source">TAF officiel décodé</span>
                    </div>
                    <p class="taf-visual-intro">Lecture simplifiée du TAF. Les évolutions prévues (TEMPO, BECMG...) sont détaillées ci-dessous.</p>
                    <div id="tafVisualOverview" class="taf-visual-overview"></div>
                  </div>
                  <div id="tafDecodeBlock" class="taf-decode-block" hidden>
                    <details id="tafChangesSection" class="taf-disclosure" hidden>
                      <summary><span class="taf-disclosure-title">Évolutions prévues</span><span id="tafChangesCount" class="taf-disclosure-count">0</span></summary>
                      <div class="taf-disclosure-content"><div id="tafChangesList" class="taf-timeline"></div></div>
                    </details>
                    <details id="tafTempsSection" class="taf-disclosure" hidden>
                      <summary><span class="taf-disclosure-title">Températures prévues</span><span id="tafTempsCount" class="taf-disclosure-count">0</span></summary>
                      <div class="taf-disclosure-content"><ul id="tafTempList" class="taf-bullet-list"></ul></div>
                    </details>
                  </div>
                </div>
              </div>
              <p id="forecastFreshnessNote" class="decoded-note decoded-note--micro decoded-note--timing" hidden></p>
            </div>
            <details class="tool-block tool-disclosure raw-weather-disclosure">
              <summary><span class="raw-weather-summary-text"><span class="raw-weather-summary-title">TAF brut</span></span></summary>
              <div class="tool-disclosure-content raw-weather-content"><pre id="tafOutput">...</pre></div>
            </details>
          </div>

          <!-- ===== ONGLET NOTAM ===== -->
          <div id="tab-notam" class="tab-panel" hidden>
             <div class="tool-block notam-cockpit-block">
              <div class="notam-cockpit-head">
                <div>
                  <span class="notam-kicker">Briefing réglementaire</span>
                  <div class="notam-title-row">
                    <h2 id="notamCockpitTitle">NOTAM</h2>
                    <span id="notamActiveCount" class="notam-count-badge">...</span>
                    <span id="notamImportantCount" class="notam-count-badge notam-count-badge--important">...</span>
                  </div>
                  <p class="notam-note"><span id="notamStatusText">...</span></p>
                </div>
                <a class="notam-source-link" href="https://sofia-briefing.aviation-civile.gouv.fr/" target="_blank" rel="noopener noreferrer">Source : SOFIA ↗</a>
              </div>
              <div id="notamCockpitGrid" class="notam-cockpit-grid" aria-label="NOTAM actifs"></div>
              <div id="notamDetailDock" class="notam-detail-dock" aria-live="polite"></div>
              <button id="notamAllBtn" class="notam-all-link" type="button" aria-label="Afficher tous les NOTAM actifs" hidden>...</button>
              <div class="notam-safety-strip">Les informations présentées sont fournies à titre indicatif et n’ont pas valeur réglementaire. Les services officiels restent la référence.</div>
            </div>
          </div>

          <!-- ===== ONGLET TERRAIN ===== -->
          <div id="tab-terrain" class="tab-panel" hidden>
            <div id="platformBlock" class="tool-block tool-block--compact">
              <div class="terrain-info-head">
                <h2>Infos terrain</h2>
                <span id="platformSourceValue" class="terrain-source-badge">...</span>
              </div>
              <div class="decoded-grid terrain-info-grid">
                <div class="decoded-card"><span class="decoded-label">Type & Accès</span><strong id="platformTypeValue">...</strong></div>
                <div class="decoded-card decoded-card-wide"><span class="decoded-label">Pistes</span><strong id="platformRunwaysValue">...</strong></div>
                <div class="decoded-card decoded-card-wide"><span class="decoded-label">Contact / Site</span><strong id="platformContactValue">...</strong></div>
              </div>
              <div class="terrain-radio-section">
                <div class="terrain-info-subhead"><span class="decoded-label">Exploitation terrain</span><strong>Radio & Contacts</strong></div>
                <div class="decoded-grid decoded-grid--summary-extra terrain-radio-grid">
                  <div class="decoded-card decoded-card-wide">
                    <span class="decoded-label">Radio</span>
                    <div class="radio-panel">
                      <div class="radio-primary">
                        <div class="radio-primary-head"><span id="radioTypeValue" class="radio-badge">...</span><span id="radioSourceValue" class="radio-primary-note">...</span></div>
                        <div id="radioValue" class="radio-primary-main">...</div>
                        <div id="radioLabelValue" class="radio-primary-label">...</div>
                      </div>
                      <div id="radioSupportBlock" class="radio-support-grid" hidden>
                        <div id="radioAtisCard" class="radio-support-card" hidden>
                          <div class="radio-support-head"><span class="radio-support-badge">ATIS</span><span id="radioAtisSourceValue" class="radio-support-note">...</span></div>
                          <div id="radioAtisValue" class="radio-support-main">...</div><div id="radioAtisLabel" class="radio-support-label">...</div>
                        </div>
                        <div id="radioPhoneCard" class="radio-support-card" hidden>
                          <div class="radio-support-head"><span class="radio-support-badge">Téléphone</span><span id="radioPhoneSourceValue" class="radio-support-note">...</span></div>
                          <div id="radioPhoneValue" class="radio-support-main">...</div><div id="radioPhoneLabel" class="radio-support-label">...</div>
                        </div>
                      </div>
                      <details id="radioSecondaryBlock" class="radio-secondary radio-secondary-disclosure" hidden>
                        <summary class="radio-secondary-summary"><span class="radio-secondary-title">Fréq. complémentaires</span><span id="radioSecondaryCount" class="radio-secondary-count">0</span></summary>
                        <ul id="radioList" class="radio-list"></ul>
                      </details>
                    </div>
                  </div>
                </div>
              </div>
              <div id="platformDocsPanel" class="tool-block tool-block--compact platform-docs-panel" hidden>
                <div class="platform-docs-panel-head"><span class="decoded-label">Documents officiels</span></div>
                <div class="platform-docs-actions">
                  <button id="platformVacBtn" class="platform-doc-link" type="button" hidden><span class="platform-doc-link-title">VAC</span><span class="platform-doc-link-note">Carte terrain SIA</span></button>
                  <button id="platformAipBtn" class="platform-doc-link" type="button" hidden><span class="platform-doc-link-title">AIP AD</span><span class="platform-doc-link-note">Fiche officielle</span></button>
                </div>
              </div>
              <p id="platformSourceNote" class="decoded-note decoded-note--micro">...</p>
            </div>
          </div>
        </main>
        
        <!-- ======================================================================= -->
        <!-- TERRAINS PROCHES & SOURCES (COMMUNS)                                  -->
        <!-- ======================================================================= -->
        <div class="tool-block" id="nearby-section">
          <h2>Terrains proches</h2>
          <div id="nearby-list" class="nearby-list"></div>
        </div>

        <footer class="tool-footer">
          <p>
            <strong>Sources :</strong> AWC (METAR/TAF) · Autorouter/EAD (NOTAM) · SIA/BASULM (Terrains FR) · OurAirports (Monde).
          </p>
          <p>
            <strong>Disclaimer :</strong> Cet outil est une aide à la préparation de vol et ne remplace en aucun cas la consultation des sources officielles (SOFIA, SIA).
          </p>
        </footer>

      </div>
    </div>
  </section>

  <script>
    // =======================================================================
    // INITIALISATION ET GESTIONNAIRES D'ÉVÉNEMENTS
    // =======================================================================
    const loadDataBtn = document.getElementById("loadDataBtn");
    
    // Tab switching logic
    document.getElementById('tabNav').addEventListener('click', (e) => {
      if (e.target.matches('.tab-btn')) {
        const tabId = e.target.dataset.tab;
        document.querySelectorAll('.tab-panel').forEach(p => p.hidden = true);
        document.getElementById(`tab-${tabId}`).hidden = false;
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('is-active'));
        e.target.classList.add('is-active');
      }
    });

    // Binding original load button
    if(loadDataBtn) loadDataBtn.addEventListener("click", submitSearch);


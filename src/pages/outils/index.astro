    function formatUtcClock(date) {
      return `${String(date.getUTCHours()).padStart(2, "0")}:${String(
        date.getUTCMinutes()
      ).padStart(2, "0")}Z`;
    }

    function formatLocalClock(date) {
      return `${String(date.getHours()).padStart(2, "0")}:${String(
        date.getMinutes()
      ).padStart(2, "0")}`;
    }

    function formatUtcDayMonth(date) {
      if (!(date instanceof Date) || Number.isNaN(date.getTime())) return "";
      return new Intl.DateTimeFormat("fr-FR", {
        day: "numeric",
        month: "long",
        timeZone: "UTC",
      }).format(date);
    }

    function formatLocalDayMonth(date) {
      if (!(date instanceof Date) || Number.isNaN(date.getTime())) return "";
      return new Intl.DateTimeFormat("fr-FR", {
        day: "numeric",
        month: "long",
      }).format(date);
    }

    function buildClosestUtcIssueDate(day, hour, minute, now = new Date()) {
      const year = now.getUTCFullYear();
      const month = now.getUTCMonth();
      const candidates = [-1, 0, 1].map((offset) =>
        new Date(Date.UTC(year, month + offset, day, hour, minute))
      );

      return candidates.reduce((best, candidate) => {
        if (!best) return candidate;
        return Math.abs(candidate.getTime() - now.getTime()) <
          Math.abs(best.getTime() - now.getTime())
          ? candidate
          : best;
      }, null);
    }

    function extractZuluIssueDate(rawText, now = new Date()) {
      const text = String(rawText || "").trim();
      if (!text) return null;

      const match = text.match(/\b(\d{2})(\d{2})(\d{2})Z\b/);
      if (!match) return null;

      const day = Number(match[1]);
      const hour = Number(match[2]);
      const minute = Number(match[3]);

      if (
        !Number.isFinite(day) ||
        !Number.isFinite(hour) ||
        !Number.isFinite(minute) ||
        day < 1 ||
        day > 31 ||
        hour > 23 ||
        minute > 59
      ) {
        return null;
      }

      return buildClosestUtcIssueDate(day, hour, minute, now);
    }

    function formatWeatherAge(issueDate, now = new Date()) {
      if (!(issueDate instanceof Date) || Number.isNaN(issueDate.getTime())) {
        return "";
      }

      const diffMinutes = Math.max(
        0,
        Math.round((now.getTime() - issueDate.getTime()) / 60000)
      );

      if (diffMinutes < 1) return "à l’instant";
      if (diffMinutes < 60) return `il y a ${diffMinutes} min`;

      const hours = Math.floor(diffMinutes / 60);
      const minutes = diffMinutes % 60;

      if (hours < 24) {
        return minutes
          ? `il y a ${hours} h ${String(minutes).padStart(2, "0")}`
          : `il y a ${hours} h`;
      }

      const days = Math.floor(hours / 24);
      const remHours = hours % 24;
      return remHours ? `il y a ${days} j ${remHours} h` : `il y a ${days} j`;
    }

    function buildMetarFreshnessText(rawMetar) {
      const now = new Date();
      const issueDate = extractZuluIssueDate(rawMetar, now);
      const clockLabel = `Heure ${formatLocalClock(now)} locale · ${formatUtcClock(now)}`;

      if (!issueDate) return clockLabel;

      return `METAR ${formatUtcClock(issueDate)} · ${formatWeatherAge(
        issueDate,
        now
      )} · ${clockLabel}`;
    }

    function buildTafFreshnessText(rawTaf) {
      const issueDate = extractZuluIssueDate(rawTaf, new Date());
      if (!issueDate) return "";
      return `TAF ${formatUtcClock(issueDate)} · ${formatWeatherAge(issueDate)}`;
    }


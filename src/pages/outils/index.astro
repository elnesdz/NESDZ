    function normalizeCode(value) {
      return String(value || "").trim().toUpperCase();
    }

    function isValidWeatherCode(code) {
      return /^[A-Z]{4}$/.test(normalizeCode(code));
    }

    function getIcaoFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const value = normalizeCode(params.get("icao") || "");
      return isValidWeatherCode(value) ? value : "";
    }

    function syncIcaoInUrl(icao) {
      const url = new URL(window.location.href);

      if (icao && isValidWeatherCode(icao)) {
        url.searchParams.set("icao", icao);
      } else {
        url.searchParams.delete("icao");
      }

      const nextUrl = `${url.pathname}${url.search}${url.hash}`;
      window.history.replaceState({}, "", nextUrl);
    }

    function isCalmWind(speed) {
      return Number.isFinite(Number(speed)) && Number(speed) === 0;
    }

    function formatWind(dir, speed) {
      if (speed == null && dir == null) return "—";
      if (isCalmWind(speed)) return "0 kt";
      if (String(dir || "").trim().toUpperCase() === "VRB" && speed != null) {
        return `Variable à ${speed} kt`;
      }
      if (speed != null && dir != null && Number.isFinite(Number(dir))) {
        return `${String(Math.round(Number(dir))).padStart(3, "0")}° à ${speed} kt`;
      }
      if (speed != null) return `${speed} kt`;
      return "—";
    }

    function formatVisibility(visib) {
      if (visib == null) return "—";
      if (Number(visib) >= 10) return "10 km ou plus";
      return `${visib} km`;
    }

    function buildCloudCode(item) {
      const cover = String(item?.cover || "").trim().toUpperCase();
      if (!cover) return "—";
      if (["CAVOK", "SKC", "CLR", "NSC", "NCD"].includes(cover)) return cover;
      const firstCloud = Array.isArray(item?.clouds) ? item.clouds[0] : null;
      const base = Number(firstCloud?.base);
      if (Number.isFinite(base) && base > 0) {
        return `${cover}${String(Math.round(base / 100)).padStart(3, "0")}`;
      }
      return cover;
    }

    function getCloudCoverBriefLabel(cover) {
      switch (String(cover || "").trim().toUpperCase()) {
        case "FEW":
          return "Quelques nuages";
        case "SCT":
          return "Épars";
        case "BKN":
          return "Fragmentés";
        case "OVC":
          return "Couvert";
        case "VV":
          return "Visib. verticale";
        case "NSC":
        case "NCD":
          return "Pas de nuage significatif";
        case "SKC":
        case "CLR":
          return "Ciel clair";
        case "CAVOK":
          return "Pas de nuage significatif";
        default:
          return "";
      }
    }

    function formatCloudHeightWithMeters(baseFt) {
      const meters = feetToMeters(baseFt);
      return meters ? `${baseFt} ft (~${meters} m)` : `${baseFt} ft`;
    }

    function formatClouds(item) {
      return buildCloudCode(item);
    }

    function formatCloudsMeta(item) {
      const cover = String(item?.cover || "").trim().toUpperCase();
      if (!cover) return "";

      const label = getCloudCoverBriefLabel(cover);
      const firstCloud = Array.isArray(item?.clouds) ? item.clouds[0] : null;
      const base = Number(firstCloud?.base);
      const hasBase = Number.isFinite(base) && base > 0;
      const isCeiling = ["BKN", "OVC", "VV"].includes(cover);

      if (["CAVOK", "NSC", "NCD", "SKC", "CLR"].includes(cover)) {
        return label;
      }

      if (cover === "VV" && hasBase) {
        return `${label} · ${formatCloudHeightWithMeters(base)}${isCeiling ? " · plafond" : ""}`;
      }

      if (hasBase) {
        return `${label} · base ${formatCloudHeightWithMeters(base)}${isCeiling ? " · plafond" : ""}`;
      }

      return `${label}${isCeiling ? " · plafond" : ""}`;
    }

    function formatTemp(temp, dewpoint) {
      if (temp == null && dewpoint == null) return "—";
      if (temp != null && dewpoint != null) {
        return `${temp}°C / rosée ${dewpoint}°C`;
      }
      if (temp != null) return `${temp}°C`;
      return `Rosée ${dewpoint}°C`;
    }

    function formatPressure(altim) {
      if (altim == null) return "—";
      return `${altim} hPa`;
    }

    function formatStatus(item) {
      if (!item) return "Aucune donnée";
      if (item.fltCat === "VFR") return "🟢 Météo VFR";
      if (item.fltCat === "MVFR") return "🟡 Météo marginale (MVFR)";
      if (item.fltCat === "IFR") return "🔴 Météo IFR";
      if (item.fltCat === "LIFR") return "🚨 Météo LIFR";
      return "Données météo reçues";
    }

    function formatWeatherCategoryLabel(category) {
      switch (category) {
        case "VFR":
          return "Météo VFR";
        case "MVFR":
          return "Météo marginale (MVFR)";
        case "IFR":
          return "Météo IFR";
        case "LIFR":
          return "Météo LIFR";
        default:
          return category || "Non disponible";
      }
    }

    function clearTafDecoded() {
      if (tafMetaGrid) tafMetaGrid.hidden = true;
      if (tafIssuedCard) tafIssuedCard.hidden = true;
      if (tafIssuedValue) tafIssuedValue.textContent = "";
      if (tafValidityCard) tafValidityCard.hidden = true;
      if (tafValidityValue) tafValidityValue.textContent = "";
      if (tafModifierCard) tafModifierCard.hidden = true;
      if (tafModifierValue) tafModifierValue.textContent = "";
      if (tafDecoderMeta) {
        tafDecoderMeta.hidden = true;
        tafDecoderMeta.textContent = "";
      }
      if (tafDecodeBlock) tafDecodeBlock.hidden = true;
      if (tafBaseDisclosure) tafBaseDisclosure.open = true;
      if (tafBaseCount) tafBaseCount.textContent = "0";
      if (tafBaseList) tafBaseList.innerHTML = "";
      if (tafChangesSection) {
        tafChangesSection.hidden = true;
        tafChangesSection.open = false;
      }
      if (tafChangesCount) tafChangesCount.textContent = "0";
      if (tafChangesList) tafChangesList.innerHTML = "";
      if (tafTempsSection) {
        tafTempsSection.hidden = true;
        tafTempsSection.open = false;
      }
      if (tafTempsCount) tafTempsCount.textContent = "0";
      if (tafTempList) tafTempList.innerHTML = "";
      if (tafVisualBlock) tafVisualBlock.hidden = true;
      if (tafVisualOverview) tafVisualOverview.innerHTML = "";
      if (tafVisualBadges) { tafVisualBadges.hidden = true; tafVisualBadges.innerHTML = ""; }
      if (tafVisualMobileList) { tafVisualMobileList.hidden = true; tafVisualMobileList.innerHTML = ""; }
      if (tafVisualScale) tafVisualScale.innerHTML = "";
      if (tafVisualBands) tafVisualBands.innerHTML = "";
      if (tafVisualMatrix) tafVisualMatrix.innerHTML = "";
      if (tafVisualCards) tafVisualCards.innerHTML = "";
    }

    function buildClosestUtcHourDate(day, hour, now = new Date()) {
      const year = now.getUTCFullYear();
      const month = now.getUTCMonth();
      const candidates = [-1, 0, 1].map((offset) =>
        new Date(Date.UTC(year, month + offset, day, hour, 0))
      );

      return candidates.reduce((best, candidate) => {
        if (!best) return candidate;
        return Math.abs(candidate.getTime() - now.getTime()) < Math.abs(best.getTime() - now.getTime())
          ? candidate
          : best;
      }, null);
    }

    function parseTafDayHour(dayHour, referenceDate) {
      if (!/^\d{4}$/.test(dayHour || "")) return null;
      const day = Number(dayHour.slice(0, 2));
      const hour = Number(dayHour.slice(2, 4));
      return buildClosestUtcHourDate(day, hour, referenceDate || new Date());
    }

    function parseTafFmDate(token, referenceDate) {
      if (!/^FM\d{6}$/.test(token || "")) return null;
      const digits = token.slice(2);
      const day = Number(digits.slice(0, 2));
      const hour = Number(digits.slice(2, 4));
      const minute = Number(digits.slice(4, 6));
      return buildClosestUtcIssueDate(day, hour, minute, referenceDate || new Date());
    }

    function parseTafValidityRange(token, referenceDate) {
      if (!/^\d{4}\/\d{4}$/.test(token || "")) return null;
      const [fromToken, toToken] = token.split("/");
      const start = parseTafDayHour(fromToken, referenceDate);
      let end = parseTafDayHour(toToken, start || referenceDate);
      if (start && end && end.getTime() <= start.getTime()) {
        end = new Date(end.getTime());
        end.setUTCDate(end.getUTCDate() + 1);
      }
      return start && end ? { start, end } : null;
    }

    function formatUtcAndLocal(date) {
      if (!(date instanceof Date) || Number.isNaN(date.getTime())) return "";
      const utcDate = formatUtcDayMonth(date);
      const localDate = formatLocalDayMonth(date);
      const utcPart = `${utcDate} · ${formatUtcClock(date).replace("Z", " UTC")}`;
      const localPart = utcDate === localDate
        ? `${formatLocalClock(date)} locale`
        : `${localDate} · ${formatLocalClock(date)} locale`;
      return `${utcPart} · ${localPart}`;
    }

    function formatUtcRange(range) {
      if (!range?.start || !range?.end) return "";
      const utcStartDate = formatUtcDayMonth(range.start);
      const utcEndDate = formatUtcDayMonth(range.end);
      const localStartDate = formatLocalDayMonth(range.start);
      const localEndDate = formatLocalDayMonth(range.end);

      if (utcStartDate === utcEndDate) {
        const utcPart = `${utcStartDate} · ${formatUtcClock(range.start).replace("Z", " UTC")} → ${formatUtcClock(range.end).replace("Z", " UTC")}`;
        const localPart = localStartDate === localEndDate
          ? `${localStartDate} · ${formatLocalClock(range.start)} → ${formatLocalClock(range.end)} locale`
          : `${localStartDate} ${formatLocalClock(range.start)} → ${localEndDate} ${formatLocalClock(range.end)} locale`;
        return `${utcPart} · ${localPart}`;
      }

      return `${formatUtcAndLocal(range.start)} → ${formatUtcAndLocal(range.end)}`;
    }

    function decodeWindToken(token) {
      const match = String(token || "").trim().toUpperCase().match(/^(\d{3}|VRB)(\d{2,3})(?:G(\d{2,3}))?(KT|MPS)$/);
      if (!match) return null;
      const [, dir, speed, gust, unit] = match;
      const speedValue = Number(speed);
      const gustValue = gust ? Number(gust) : null;
      const suffix = unit === "MPS" ? "m/s" : "kt";

      if (dir === "VRB") {
        return gustValue
          ? `Vent variable ${speedValue} ${suffix}, rafales ${gustValue} ${suffix}`
          : `Vent variable ${speedValue} ${suffix}`;
      }

      if (dir === "000" && speedValue === 0) return `Vent calme`;

      return gustValue
        ? `Vent ${dir}° à ${speedValue} ${suffix}, rafales ${gustValue} ${suffix}`
        : `Vent ${dir}° à ${speedValue} ${suffix}`;
    }

    function parseVisibilityMiles(token) {
      const upper = String(token || "").trim().toUpperCase();
      if (!upper.endsWith("SM")) return null;
      const value = upper.slice(0, -2);
      if (!value) return null;
      if (value === "P6") return "Plus de 6 SM (~10 km ou plus)";
      if (/^\d+$/.test(value)) {
        return `${value} SM (~${Math.round(Number(value) * 1.609)} km)`;
      }
      return `${value} SM`;
    }

    function decodeVisibilityToken(token) {
      const upper = String(token || "").trim().toUpperCase();
      if (upper === "CAVOK") return "10 km ou plus, pas de phénomène significatif, pas de nuage significatif sous 5000 ft";
      if (/^\d{4}$/.test(upper)) {
        if (upper === "9999") return "10 km ou plus";
        const meters = Number(upper);
        const km = meters >= 1000 ? `${(meters / 1000).toFixed(meters % 1000 === 0 ? 0 : 1).replace('.', ',')} km` : `${meters} m`;
        return `${km} de visibilité`;
      }
      const miles = parseVisibilityMiles(upper);
      return miles ? `Visibilité ${miles}` : null;
    }

    function decodeWeatherToken(token) {
      const upper = String(token || "").trim().toUpperCase();
      if (!upper) return null;
      if (upper === "NSW") return "Aucun phénomène significatif prévu";

      const intensityMap = { "-": "faible", "+": "fort", VC: "à proximité" };
      const descriptorMap = {
        MI: "bancs minces de",
        BC: "bancs de",
        PR: "partiel",
        DR: "chasse basse de",
        BL: "chasse élevée de",
        SH: "averses de",
        TS: "orage avec",
        FZ: "verglaçant",
      };
      const phenomenonMap = {
        DZ: "bruine",
        RA: "pluie",
        SN: "neige",
        SG: "neige en grains",
        IC: "cristaux de glace",
        PL: "granules de glace",
        GR: "grêle",
        GS: "grésil",
        UP: "précipitations inconnues",
        BR: "brume",
        FG: "brouillard",
        FU: "fumée",
        VA: "cendres volcaniques",
        DU: "poussière",
        SA: "sable",
        HZ: "brume sèche",
        PY: "embruns",
        PO: "tourbillons de poussière ou de sable",
        SQ: "grain",
        FC: "trombe ou tornade",
        SS: "tempête de sable",
        DS: "tempête de poussière",
      };

      let remaining = upper;
      let intensity = "";
      if (["-", "+"].includes(remaining[0])) {
        intensity = intensityMap[remaining[0]];
        remaining = remaining.slice(1);
      } else if (remaining.startsWith("VC")) {
        intensity = intensityMap.VC;
        remaining = remaining.slice(2);
      }

      let descriptor = "";
      const descriptorCode = Object.keys(descriptorMap).find((code) => remaining.startsWith(code));
      if (descriptorCode) {
        descriptor = descriptorMap[descriptorCode];
        remaining = remaining.slice(2);
      }

      const phenomena = [];
      while (remaining.length >= 2) {
        const code = remaining.slice(0, 2);
        if (phenomenonMap[code]) {
          phenomena.push(phenomenonMap[code]);
          remaining = remaining.slice(2);
        } else {
          break;
        }
      }

      if (!phenomena.length) return null;

      const parts = [];
      if (intensity) parts.push(intensity);
      if (descriptor) parts.push(`${descriptor} ${phenomena.join(" et ")}`.trim());
      else parts.push(phenomena.join(" et "));
      return parts.join(" ").replace(/\s+/g, " ").trim();
    }

    function decodeCloudToken(token) {
      const upper = String(token || "").trim().toUpperCase();
      if (!upper) return null;
      if (["NSC", "NCD"].includes(upper)) return "Pas de nuage significatif";
      if (["SKC", "CLR"].includes(upper)) return "Ciel clair";

      const match = upper.match(/^(FEW|SCT|BKN|OVC|VV)(\d{3}|\/\/\/)?(CB|TCU)?$/);
      if (!match) return null;
      const [, cover, baseCode, convective] = match;
      const coverLabel = getCloudCoverBriefLabel(cover) || cover;
      const isCeiling = ["BKN", "OVC", "VV"].includes(cover);
      const baseFt = /^\d{3}$/.test(baseCode || "") ? Number(baseCode) * 100 : null;
      let text = cover === "VV" ? coverLabel : `${coverLabel}`;
      if (baseFt) {
        text += cover === "VV"
          ? ` ${formatCloudHeightWithMeters(baseFt)}`
          : ` à ${formatCloudHeightWithMeters(baseFt)}`;
      }
      if (isCeiling && baseFt) text += ` · plafond ${formatCloudHeightWithMeters(baseFt)}`;
      else if (isCeiling) text += ` · plafond`;
      if (convective === "CB") text += ` · cumulonimbus`;
      if (convective === "TCU") text += ` · congestus`;
      return text;
    }

    function decodeTemperatureToken(token, referenceDate) {
      const upper = String(token || "").trim().toUpperCase();
      const match = upper.match(/^(T[XN])([M]?\d{2})\/(\d{2})(\d{2})Z$/);
      if (!match) return null;
      const [, kind, valueCode, dayCode, hourCode] = match;
      const negative = valueCode.startsWith("M");
      const value = Number(negative ? valueCode.slice(1) : valueCode) * (negative ? -1 : 1);
      const date = buildClosestUtcIssueDate(Number(dayCode), Number(hourCode), 0, referenceDate || new Date());
      return `${kind === "TX" ? "Température maximale" : "Température minimale"} : ${value}°C vers ${formatUtcAndLocal(date)}`;
    }

    function decodeTafSegment(tokens, referenceDate) {
      const cleaned = (tokens || []).map((token) => String(token || "").trim().toUpperCase()).filter(Boolean);
      const base = [];
      const temps = [];
      let wind = null;
      let visibility = null;
      let cavok = false;
      let nsw = false;
      const weather = [];
      const clouds = [];

      cleaned.forEach((token) => {
        if (token === "CAVOK") {
          cavok = true;
          return;
        }
        const windDecoded = decodeWindToken(token);
        if (windDecoded) { wind = windDecoded; return; }
        const visibilityDecoded = decodeVisibilityToken(token);
        if (visibilityDecoded) { visibility = visibilityDecoded; return; }
        const tempDecoded = decodeTemperatureToken(token, referenceDate);
        if (tempDecoded) { temps.push(tempDecoded); return; }
        const cloudDecoded = decodeCloudToken(token);
        if (cloudDecoded) { clouds.push(cloudDecoded); return; }
        const weatherDecoded = decodeWeatherToken(token);
        if (weatherDecoded) {
          if (token === "NSW") nsw = true;
          weather.push(weatherDecoded);
        }
      });

      if (cavok) {
        base.push("Visibilité : 10 km ou plus");
        base.push("Phénomènes : aucun phénomène significatif");
        base.push("Nuages : pas de nuage significatif sous 5000 ft");
      } else {
        if (wind) base.push(`Vent : ${wind}`);
        if (visibility) base.push(`Visibilité : ${visibility.replace(/^Visibilité\s+/i, "")}`);
        if (weather.length) base.push(`Phénomènes : ${weather.join(" · ")}`);
        else if (nsw) base.push("Phénomènes : aucun phénomène significatif");
        if (clouds.length) base.push(`Nuages : ${clouds.join(" · ")}`);
      }

      return { base, temps };
    }

    function isTafChangeToken(token) {
      const upper = String(token || "").trim().toUpperCase();
      return /^FM\d{6}$/.test(upper) || upper === "BECMG" || upper === "TEMPO" || upper === "INTER" || /^PROB(30|40)$/.test(upper);
    }


    function getTafGroupTypeLabel(group = {}) {
      const type = String(group.type || "BASE").toUpperCase();
      if (type === "BASE") return "BASE";
      if (type === "FM") return "FM";
      if (type === "BECMG") return "BECMG";
      if (type === "TEMPO") return "TEMPO";
      if (type === "INTER") return "INTER";
      if (/^PROB(30|40)$/.test(type)) return group.subType ? `${type} ${group.subType}` : type;
      return type;
    }

    function getTafGroupExplainLabel(group = {}) {
      const type = String(group.type || "BASE").toUpperCase();
      if (type === "BASE") return "Prévision principale sur la période publiée";
      if (type === "FM") return "Changement net à partir de l’heure indiquée";
      if (type === "BECMG") return "Évolution progressive sur la plage indiquée";
      if (type === "TEMPO") return "Conditions temporaires possibles sur la plage";
      if (type === "INTER") return "Conditions intermittentes possibles sur la plage";
      if (/^PROB(30|40)$/.test(type)) {
        const probability = type.replace("PROB", "Probabilité ") + " %";
        if (group.subType === "TEMPO") return `${probability} de conditions temporaires`;
        if (group.subType === "INTER") return `${probability} de conditions intermittentes`;
        return `${probability} que les conditions indiquées se produisent`;
      }
      return "Phase issue du TAF brut";
    }

    function getTafBandLabel(group = {}) {
      const type = String(group.type || "BASE").toUpperCase();
      if (type === "BASE") return "BASE";
      if (type === "FM") return "FM";
      if (type === "BECMG") return "BECMG";
      if (type === "TEMPO") return "TEMPO";
      if (type === "INTER") return "INTER";
      if (/^PROB(30|40)$/.test(type)) return type;
      return type;
    }

    function getTafMobilePhaseHint(group = {}) {
      const type = String(group.type || "BASE").toUpperCase();
      if (type === "BASE") return "Prévision principale";
      if (type === "FM") return "Changement net";
      if (type === "BECMG") return "Évolution progressive";
      if (type === "TEMPO") return "Temporairement";
      if (type === "INTER") return "Par intermittence";
      if (type === "PROB30") return "Probabilité 30 %";
      if (type === "PROB40") return "Probabilité 40 %";
      return "Phase TAF";
    }

    function getTafGroupTone(group = {}) {
      const type = String(group.type || "BASE").toUpperCase();
      if (type === "BASE") return "base";
      if (type === "FM") return "fm";
      if (type === "BECMG") return "becmg";
      if (type === "TEMPO" || type === "INTER") return "tempo";
      if (/^PROB(30|40)$/.test(type)) return "prob";
      return "base";
    }

    function decodeTafWindCompact(token) {
      const upper = String(token || "").trim().toUpperCase();
      const match = upper.match(/^(\d{3}|VRB)(\d{2,3})(?:G(\d{2,3}))?(KT|MPS)$/);
      if (!match) return null;
      const [, dir, speed, gust, unit] = match;
      const suffix = unit === "MPS" ? "m/s" : "kt";
      if (dir === "000" && Number(speed) === 0) return { label: "Calme", gust: null };
      const direction = dir === "VRB" ? "VRB" : `${dir}°`;
      return { label: `${direction} ${Number(speed)} ${suffix}${gust ? ` G${Number(gust)}` : ""}`, gust: gust ? `${Number(gust)} ${suffix}` : null };
    }

    function getTafVisibilityValueMeters(token) {
      const upper = String(token || "").trim().toUpperCase();
      if (upper === "CAVOK" || upper === "9999") return 10000;
      if (/^\d{4}$/.test(upper)) return Number(upper);
      if (upper.endsWith("SM")) {
        const raw = upper.slice(0, -2);
        if (raw === "P6") return 10000;
        if (/^\d+(?:\.\d+)?$/.test(raw)) return Number(raw) * 1609.34;
        const fraction = raw.match(/^(\d+)?\s?(\d)\/(\d)$/);
        if (fraction) {
          const whole = fraction[1] ? Number(fraction[1]) : 0;
          return (whole + Number(fraction[2]) / Number(fraction[3])) * 1609.34;
        }
      }
      return null;
    }

    function getTafCeilingFt(tokens = []) {
      let ceiling = null;
      tokens.forEach((token) => {
        const upper = String(token || "").trim().toUpperCase();
        const match = upper.match(/^(BKN|OVC|VV)(\d{3}|\/\/\/)?(?:CB|TCU)?$/);
        if (!match) return;
        const baseCode = match[2];
        if (!/^\d{3}$/.test(baseCode || "")) return;
        const baseFt = Number(baseCode) * 100;
        ceiling = ceiling === null ? baseFt : Math.min(ceiling, baseFt);
      });
      return ceiling;
    }

    function getTafVisualCategory({ visibilityMeters = null, ceilingFt = null, cavok = false } = {}) {
      if (cavok) return { code: "VFR", label: "VFR", tone: "vfr" };
      const visSm = typeof visibilityMeters === "number" ? visibilityMeters / 1609.34 : null;
      if ((typeof ceilingFt === "number" && ceilingFt < 500) || (typeof visSm === "number" && visSm < 1)) return { code: "LIFR", label: "LIFR", tone: "lifr" };
      if ((typeof ceilingFt === "number" && ceilingFt < 1000) || (typeof visSm === "number" && visSm < 3)) return { code: "IFR", label: "IFR", tone: "ifr" };
      if ((typeof ceilingFt === "number" && ceilingFt <= 3000) || (typeof visSm === "number" && visSm <= 5)) return { code: "MVFR", label: "MVFR", tone: "mvfr" };
      if (typeof ceilingFt === "number" || typeof visibilityMeters === "number") return { code: "VFR", label: "VFR", tone: "vfr" };
      return { code: "—", label: "—", tone: "unknown" };
    }

    function analyzeTafVisualTokens(tokens = [], referenceDate = new Date()) {
      const cleaned = (tokens || []).map((token) => String(token || "").trim().toUpperCase()).filter(Boolean);
      const cavok = cleaned.includes("CAVOK");
      const windToken = cleaned.find((token) => decodeTafWindCompact(token));
      const wind = windToken ? decodeTafWindCompact(windToken) : null;
      const visibilityToken = cleaned.find((token) => decodeVisibilityToken(token));
      const visibility = visibilityToken ? decodeVisibilityToken(visibilityToken) : "—";
      const visibilityMeters = visibilityToken ? getTafVisibilityValueMeters(visibilityToken) : null;
      const cloudTokens = cleaned.filter((token) => decodeCloudToken(token));
      const cloudLabels = cloudTokens.map((token) => decodeCloudToken(token)).filter(Boolean);
      const weatherTokens = cleaned.filter((token) => decodeWeatherToken(token));
      const weatherLabels = weatherTokens.map((token) => decodeWeatherToken(token)).filter(Boolean);
      const tempLabels = cleaned.map((token) => decodeTemperatureToken(token, referenceDate)).filter(Boolean);
      const ceilingFt = cavok ? null : getTafCeilingFt(cleaned);
      const category = getTafVisualCategory({ visibilityMeters, ceilingFt, cavok });

      return {
        cavok,
        category,
        wind: wind?.label || "—",
        gust: wind?.gust || "—",
        visibility: cavok ? "10 km ou plus" : (visibility || "—").replace(/^Visibilité\s+/i, ""),
        ceiling: cavok ? "Pas de plafond significatif" : (typeof ceilingFt === "number" ? `${ceilingFt.toLocaleString("fr-FR")} ft` : "—"),
        clouds: cavok ? ["Pas de nuage significatif sous 5000 ft"] : cloudLabels,
        weather: cavok ? ["Aucun phénomène significatif"] : weatherLabels,
        temperatures: tempLabels,
        rawTokens: cleaned,
      };
    }

    function buildTafVisualGroups(groups = [], context = {}) {
      const { validity, issueDate } = context;
      const reference = issueDate || validity?.start || new Date();
      const overallStart = validity?.start || null;
      const overallEnd = validity?.end || null;

      const getStartForGroup = (group) => {
        if (group.type === "FM") return parseTafFmDate(group.timeToken, reference);
        if (["TEMPO", "INTER", "BECMG"].includes(group.type) || /^PROB(30|40)$/.test(group.type || "")) {
          return parseTafValidityRange(group.validToken, overallStart || reference)?.start || null;
        }
        return overallStart;
      };

      const getEndForGroup = (group, index) => {
        if (["TEMPO", "INTER", "BECMG"].includes(group.type) || /^PROB(30|40)$/.test(group.type || "")) {
          return parseTafValidityRange(group.validToken, overallStart || reference)?.end || null;
        }
        if (group.type === "FM") {
          const nextFm = groups.slice(index + 1).find((nextGroup) => nextGroup.type === "FM");
          return nextFm ? parseTafFmDate(nextFm.timeToken, reference) : overallEnd;
        }
        return overallEnd;
      };

      return groups.map((group, index) => {
        const start = getStartForGroup(group);
        const end = getEndForGroup(group, index);
        const analysis = analyzeTafVisualTokens(group.tokens, reference);
        const rawParts = [];
        if (group.type === "FM") rawParts.push(group.timeToken);
        else if (group.type && group.type !== "BASE") {
          rawParts.push(group.type);
          if (group.subType) rawParts.push(group.subType);
          if (group.validToken) rawParts.push(group.validToken);
        }
        rawParts.push(...(group.tokens || []));
        return {
          id: `taf-group-${index}`,
          index,
          type: group.type || "BASE",
          label: getTafGroupTypeLabel(group),
          tone: getTafGroupTone(group),
          start,
          end,
          rangeLabel: start && end ? formatUtcRange({ start, end }) : (start ? `À partir de ${formatUtcAndLocal(start)}` : "Période non précisée"),
          analysis,
          raw: rawParts.join(" ").trim(),
        };
      }).filter((group) => group.raw || group.analysis.rawTokens.length);
    }

    function parseTaf(rawTaf, fallbackIcao = "") {
      const normalized = String(rawTaf || "").replace(/\s+/g, " ").trim();
      if (!normalized) return null;

      const tokens = normalized.split(" ");
      let index = 0;
      let modifier = "";
      if (tokens[index] === "TAF") index += 1;
      if (["AMD", "COR", "CNL"].includes(tokens[index])) { modifier = tokens[index]; index += 1; }
      const station = /^[A-Z]{4}$/.test(tokens[index] || "") ? tokens[index++] : fallbackIcao;
      const issueToken = /^\d{6}Z$/.test(tokens[index] || "") ? tokens[index++] : "";
      const validityToken = /^\d{4}\/\d{4}$/.test(tokens[index] || "") ? tokens[index++] : "";
      const issueDate = issueToken ? extractZuluIssueDate(issueToken, new Date()) : null;
      const validity = validityToken ? parseTafValidityRange(validityToken, issueDate || new Date()) : null;

      if (modifier === "CNL") return { station, modifier, issueDate, validity, cancelled: true, base: [], changes: [], temps: [] };

      const groups = [];
      let current = { type: "BASE", tokens: [] };
      while (index < tokens.length) {
        const token = tokens[index].trim().toUpperCase();
        if (isTafChangeToken(token)) {
          groups.push(current);
          if (/^FM\d{6}$/.test(token)) {
            current = { type: "FM", timeToken: token, tokens: [] };
            index += 1;
            continue;
          }
          if (["BECMG", "TEMPO", "INTER"].includes(token)) {
            const nextToken = String(tokens[index + 1] || "").toUpperCase();
            current = { type: token, validToken: /^\d{4}\/\d{4}$/.test(nextToken) ? nextToken : "", tokens: [] };
            index += /^\d{4}\/\d{4}$/.test(nextToken) ? 2 : 1;
            continue;
          }
          if (/^PROB(30|40)$/.test(token)) {
            let shift = 1;
            let subType = "";
            let validToken = "";
            const maybeSubtype = String(tokens[index + shift] || "").toUpperCase();
            if (["TEMPO", "INTER"].includes(maybeSubtype)) { subType = maybeSubtype; shift += 1; }
            const maybeValid = String(tokens[index + shift] || "").toUpperCase();
            if (/^\d{4}\/\d{4}$/.test(maybeValid)) { validToken = maybeValid; shift += 1; }
            current = { type: token, subType, validToken, tokens: [] };
            index += shift;
            continue;
          }
        }
        current.tokens.push(token);
        index += 1;
      }
      groups.push(current);
      const visualGroups = buildTafVisualGroups(groups, { validity, issueDate });

      const baseGroup = groups.shift() || { type: "BASE", tokens: [] };
      const baseDecoded = decodeTafSegment(baseGroup.tokens, issueDate || validity?.start || new Date());
      const temps = [...baseDecoded.temps];
      const changes = groups.map((group) => {
        const decoded = decodeTafSegment(group.tokens, issueDate || validity?.start || new Date());
        temps.push(...decoded.temps);
        let title = "Évolution";
        if (group.type === "FM") {
          const start = parseTafFmDate(group.timeToken, issueDate || validity?.start || new Date());
          title = start ? `À partir de ${formatUtcAndLocal(start)}` : "À partir de";
        } else if (group.type === "BECMG") {
          const range = parseTafValidityRange(group.validToken, validity?.start || issueDate || new Date());
          title = range ? `Évolution progressive entre ${formatUtcRange(range)}` : "Évolution progressive";
        } else if (group.type === "TEMPO") {
          const range = parseTafValidityRange(group.validToken, validity?.start || issueDate || new Date());
          title = range ? `Temporairement entre ${formatUtcRange(range)}` : "Temporairement";
        } else if (group.type === "INTER") {
          const range = parseTafValidityRange(group.validToken, validity?.start || issueDate || new Date());
          title = range ? `Par intermittence entre ${formatUtcRange(range)}` : "Par intermittence";
        } else if (/^PROB(30|40)$/.test(group.type)) {
          const range = parseTafValidityRange(group.validToken, validity?.start || issueDate || new Date());
          const prob = group.type.replace("PROB", "Probabilité ") + " %";
          const subtypeLabel = group.subType === "TEMPO" ? " de conditions temporaires" : group.subType === "INTER" ? " par intermittence" : "";
          title = range ? `${prob}${subtypeLabel} entre ${formatUtcRange(range)}` : `${prob}${subtypeLabel}`;
        }
        return { title, bullets: decoded.base.filter(Boolean) };
      }).filter((group) => group.bullets.length);

      return { station, modifier, issueDate, validity, base: baseDecoded.base.filter(Boolean), changes, temps, cancelled: false, visualGroups };
    }


    function buildTafVisualTicks(start, end) {
      if (!(start instanceof Date) || !(end instanceof Date) || end.getTime() <= start.getTime()) return [];
      const spanHours = Math.max(1, Math.round((end.getTime() - start.getTime()) / 36e5));
      const step = spanHours <= 12 ? 2 : spanHours <= 24 ? 4 : 6;
      const ticks = [];
      const first = new Date(start.getTime());
      first.setUTCMinutes(0, 0, 0);
      while (first.getUTCHours() % step !== 0) first.setUTCHours(first.getUTCHours() + 1);
      for (let cursor = first; cursor.getTime() <= end.getTime(); cursor = new Date(cursor.getTime() + step * 36e5)) {
        const pos = ((cursor.getTime() - start.getTime()) / (end.getTime() - start.getTime())) * 100;
        if (pos >= 0 && pos <= 100) ticks.push({ date: cursor, pos });
      }
      return ticks;
    }

    function getTafVisualPosition(group, start, end) {
      if (!(start instanceof Date) || !(end instanceof Date) || end.getTime() <= start.getTime()) return { left: 0, width: 100 };
      const groupStart = group.start instanceof Date ? group.start : start;
      const groupEnd = group.end instanceof Date ? group.end : end;
      const left = Math.max(0, Math.min(100, ((groupStart.getTime() - start.getTime()) / (end.getTime() - start.getTime())) * 100));
      const right = Math.max(0, Math.min(100, ((groupEnd.getTime() - start.getTime()) / (end.getTime() - start.getTime())) * 100));
      return { left, width: Math.max(3, right - left) };
    }

    function findLastGroupWithEnd(groups) {
      for (let i = groups.length - 1; i >= 0; i -= 1) {
        if (groups[i]?.end instanceof Date) return groups[i].end;
      }
      return null;
    }

    function renderTafVisual(decoded) {
      if (!tafVisualBlock || !tafVisualOverview) return;
      const groups = decoded?.visualGroups || [];
      if (!groups.length) return;

      if (tafVisualBadges) {
        tafVisualBadges.hidden = true;
        tafVisualBadges.innerHTML = "";
      }
      if (tafVisualMobileList) {
        tafVisualMobileList.hidden = true;
        tafVisualMobileList.innerHTML = "";
      }
      if (tafVisualScale) tafVisualScale.innerHTML = "";
      if (tafVisualBands) tafVisualBands.innerHTML = "";
      if (tafVisualMatrix) tafVisualMatrix.innerHTML = "";
      if (tafVisualCards) {
        tafVisualCards.hidden = true;
        tafVisualCards.innerHTML = "";
      }

      tafVisualOverview.innerHTML = groups.map((group) => {
        const categoryTone = escapeHtml(group.analysis.category.tone || "none");
        const categoryLabel = escapeHtml(group.analysis.category.label || "—");
        const explain = escapeHtml(getTafGroupExplainLabel(group));
        const rangeLabel = escapeHtml(group.rangeLabel || "Plage non précisée");
        const visibility = escapeHtml(group.analysis.visibility || "—");
        const ceiling = escapeHtml(group.analysis.ceiling || "—");
        const wind = escapeHtml(group.analysis.wind || "—");
        const weather = escapeHtml(group.analysis.weather.length ? group.analysis.weather.join(" · ") : "—");
        const clouds = escapeHtml(group.analysis.clouds.length ? group.analysis.clouds.join(" · ") : "—");
        const raw = escapeHtml(group.raw || "—");
        return `
          <details class="taf-visual-overview-item taf-visual-overview-item--${escapeHtml(group.tone)} taf-overview-phase">
            <summary class="taf-visual-overview-summary">
              <div class="taf-visual-overview-main">
                <div class="taf-visual-overview-top">
                  <span class="taf-visual-overview-code">${escapeHtml(group.label)}</span>
                  <strong class="taf-visual-cat taf-visual-cat--${categoryTone}">${categoryLabel}</strong>
                </div>
                <p class="taf-visual-overview-hint">${escapeHtml(getTafMobilePhaseHint(group))}</p>
                <p class="taf-visual-overview-explain">${explain}</p>
                <p class="taf-visual-overview-range">${rangeLabel}</p>
                <div class="taf-visual-overview-glance">
                  <span>${visibility}</span>
                  <span>${ceiling}</span>
                  <span>${wind}</span>
                </div>
              </div>
              <div class="taf-visual-overview-side">
                <span class="taf-visual-open-hint">Détail</span>
              </div>
            </summary>
            <div class="taf-phase-body">
              <dl class="taf-visual-facts">
                <div><dt>Vent</dt><dd>${wind}</dd></div>
                <div><dt>Visibilité</dt><dd>${visibility}</dd></div>
                <div><dt>Plafond</dt><dd>${ceiling}</dd></div>
                <div><dt>Nuages</dt><dd>${clouds}</dd></div>
                <div><dt>Temps</dt><dd>${weather}</dd></div>
              </dl>
              <code>${raw}</code>
            </div>
          </details>
        `;
      }).join("");

      tafVisualBlock.hidden = false;
    }

    function renderTafDecoded({ rawTaf = "", icao = "", neighborMeta = "", localAvailable = true } = {}) {
      clearTafDecoded();
      if (!rawTaf) {
        tafSummaryValue.textContent = `Aucune prévision TAF disponible pour ${icao}.`;
        if (neighborMeta && tafDecoderMeta) { tafDecoderMeta.hidden = false; tafDecoderMeta.textContent = neighborMeta; }
        return;
      }

      const decoded = parseTaf(rawTaf, icao);
      if (!decoded) {
        tafSummaryValue.textContent = "Prévision TAF non décodable automatiquement.";
        if (neighborMeta && tafDecoderMeta) { tafDecoderMeta.hidden = false; tafDecoderMeta.textContent = neighborMeta; }
        return;
      }

      tafSummaryValue.textContent = decoded.cancelled ? "TAF annulé" : (localAvailable ? "Prévision TAF décodée" : "TAF voisin décodé");
      if (tafMetaGrid) tafMetaGrid.hidden = false;
      if (decoded.issueDate && tafIssuedCard && tafIssuedValue) {
        tafIssuedCard.hidden = false;
        tafIssuedValue.textContent = formatUtcAndLocal(decoded.issueDate);
      }
      if (decoded.validity?.start && decoded.validity?.end && tafValidityCard && tafValidityValue) {
        tafValidityCard.hidden = false;
        tafValidityValue.textContent = `${formatUtcAndLocal(decoded.validity.start)} → ${formatUtcAndLocal(decoded.validity.end)}`;
      }
      if (tafModifierCard && tafModifierValue) {
        tafModifierCard.hidden = false;
        tafModifierValue.textContent = decoded.modifier && decoded.modifier !== "CNL"
          ? (decoded.modifier === "AMD" ? "TAF amendé" : decoded.modifier === "COR" ? "TAF corrigé" : decoded.modifier)
          : "TAF standard";
      }
      if (neighborMeta && tafDecoderMeta) { tafDecoderMeta.hidden = false; tafDecoderMeta.textContent = neighborMeta; }
      if (decoded.cancelled) return;

      const baseBullets = decoded.base.length ? decoded.base : ["Le message TAF est disponible en brut ci-dessous, mais aucun groupe standard exploitable n’a été reconnu."];
      if (tafBaseCount) tafBaseCount.textContent = String(baseBullets.length);
      if (tafBaseList) tafBaseList.innerHTML = baseBullets.map((item) => `<li>${item}</li>`).join("");
      if (decoded.changes.length && tafChangesSection && tafChangesList) {
        tafChangesSection.hidden = false;
        if (tafChangesCount) tafChangesCount.textContent = String(decoded.changes.length);
        tafChangesList.innerHTML = decoded.changes.map((group) => `\n            <div class="taf-timeline-item">\n              <strong class="taf-timeline-title">${group.title}</strong>\n              <ul class="taf-bullet-list taf-bullet-list--nested">\n                ${group.bullets.map((item) => `<li>${item}</li>`).join("")}\n              </ul>\n            </div>\n          `).join("");
      }
      if (decoded.temps.length && tafTempsSection && tafTempList) {
        tafTempsSection.hidden = false;
        if (tafTempsCount) tafTempsCount.textContent = String(decoded.temps.length);
        tafTempList.innerHTML = decoded.temps.map((item) => `<li>${item}</li>`).join("");
      }
      renderTafVisual(decoded);
      const hasVisualGroups = Array.isArray(decoded.visualGroups) && decoded.visualGroups.length > 0;
      if (tafDecodeBlock) tafDecodeBlock.hidden = hasVisualGroups;
    }

    function getAirportWeatherCode(airport) {
      const icao = normalizeCode(airport?.icao);
      if (isValidWeatherCode(icao)) return icao;

      const gpsCode = normalizeCode(airport?.gps_code);
      if (isValidWeatherCode(gpsCode)) return gpsCode;

      return "";
    }

    function normalizeAirportRecord(airport) {
      const weatherCode = getAirportWeatherCode(airport);
      const latitude = Number(airport?.latitude);
      const longitude = Number(airport?.longitude);

      return {
        ...airport,
        weatherCode,
        latitude,
        longitude,
        municipality: String(airport?.municipality || "").trim(),
        country: normalizeCode(airport?.iso_country || airport?.country || "FR"),
        sourceScope: "fr",
      };
    }

    function normalizeWorldAirportRecord(airport) {
      const weatherCode = normalizeCode(airport?.icao || airport?.weatherCode || airport?.gps_code || "");
      const latitude = Number(airport?.latitude);
      const longitude = Number(airport?.longitude);

      return {
        ...airport,
        weatherCode,
        icao: weatherCode,
        latitude,
        longitude,
        name: String(airport?.name || "").trim(),
        municipality: String(airport?.municipality || "").trim(),
        country: normalizeCode(airport?.country || airport?.iso_country || ""),
        type: String(airport?.type || "airport").trim(),
        sourceScope: "world",
      };
    }

    function isUsableAirport(airport) {
      return (
        airport &&
        airport.type !== "closed" &&
        airport.weatherCode &&
        Number.isFinite(airport.latitude) &&
        Number.isFinite(airport.longitude)
      );
    }

    function dedupeAirports(list) {
      const seen = new Set();

      return list.filter((airport) => {
        const key = airport.weatherCode;
        if (!key || seen.has(key)) return false;
        seen.add(key);
        return true;
      });
    }

    async function loadAirports() {
      if (airportsFrCache) return airportsFrCache;

      if (!airportsFrPromise) {
        airportsFrPromise = fetch(AIRPORTS_FR_URL)
          .then(async (res) => {
            if (!res.ok) {
              throw new Error("Impossible de charger la base France d’aérodromes.");
            }

            const data = await res.json();

            if (!Array.isArray(data)) {
              throw new Error("Format JSON inattendu pour la base France d’aérodromes.");
            }

            airportsFrCache = dedupeAirports(
              data.map(normalizeAirportRecord).filter(isUsableAirport)
            );

            return airportsFrCache;
          })
          .catch((error) => {
            airportsFrPromise = null;
            throw error;
          });
      }

      return airportsFrPromise;
    }

    async function loadWorldAirports() {
      if (airportsWorldCache) return airportsWorldCache;

      if (!airportsWorldPromise) {
        airportsWorldPromise = fetch(AIRPORTS_WORLD_URL)
          .then(async (res) => {
            if (!res.ok) {
              throw new Error("Impossible de charger la base mondiale d’aérodromes.");
            }

            const data = await res.json();

            if (!Array.isArray(data)) {
              throw new Error("Format JSON inattendu pour la base mondiale d’aérodromes.");
            }

            airportsWorldCache = dedupeAirports(
              data.map(normalizeWorldAirportRecord).filter(isUsableAirport)
            );

            return airportsWorldCache;
          })
          .catch(async (error) => {
            console.error(error);
            airportsWorldPromise = null;
            return loadAirports();
          });
      }

      return airportsWorldPromise;
    }

    async function findAirportByCode(code) {
      const normalized = normalizeCode(code);

      if (!normalized) return null;

      try {
        const airports = await loadWorldAirports();
        return (
          airports.find((airport) => airport.weatherCode === normalized) || null
        );
      } catch (error) {
        console.error(error);
        return null;
      }
    }

    async function findWorldAirportByCode(code) {
      const normalized = normalizeCode(code);

      if (!normalized) return null;

      try {
        const airports = await loadWorldAirports();
        return (
          airports.find((airport) => airport.weatherCode === normalized) || null
        );
      } catch (error) {
        console.error(error);
        return null;
      }
    }

    async function findAnyAirportByCode(code) {
      const localAirport = await findAirportByCode(code);
      if (localAirport) return localAirport;
      return findWorldAirportByCode(code);
    }

    function formatAirportDisplayName(airport, fallbackCode) {
      if (!airport) return fallbackCode || "—";

      const labelCode = airport.weatherCode || fallbackCode || "—";
      const municipality = airport.municipality
        ? ` — ${airport.municipality}`
        : "";
      const country =
        airport.sourceScope === "world" && airport.country
          ? ` (${airport.country})`
          : "";

      return `${airport.name} (${labelCode})${municipality}${country}`;
    }

    function formatMatchedDisplayName(matchedAirport, matchedUlm) {
      if (matchedAirport) {
        return formatAirportDisplayName(
          matchedAirport,
          matchedAirport.weatherCode
        );
      }

      if (matchedUlm?.name) {
        const codeLabel = matchedUlm.weatherCode || matchedUlm.code || "";
        return codeLabel
          ? `${matchedUlm.name} (${codeLabel})`
          : matchedUlm.name;
      }

      return "";
    }

    function normalizeUlmRecord(item) {
      const code = normalizeCode(item?.code || item?.source_id || "");
      const weatherCode = isValidWeatherCode(item?.weather_code)
        ? normalizeCode(item.weather_code)
        : "";

      return {
        ...item,
        code,
        weatherCode,
        latitude: Number(item?.latitude),
        longitude: Number(item?.longitude),
        platformType: item?.platform_type || "unknown",
        operationalLabel: item?.operational_label || "Plateforme spécifique",
        accessTags: Array.isArray(item?.access_tags) ? item.access_tags : [],
        weatherCapable: Boolean(weatherCode),
      };
    }

    function isUsableUlm(item) {
      return (
        item &&
        Number.isFinite(item.latitude) &&
        Number.isFinite(item.longitude) &&
        item.platformType !== "helistation"
      );
    }

    async function loadUlmBases() {
      if (ulmCache) return ulmCache;

      if (!ulmPromise) {
        ulmPromise = fetch(ULM_URL)
          .then(async (res) => {
            if (!res.ok) {
              throw new Error("Impossible de charger la base ULM.");
            }

            const data = await res.json();

            if (!Array.isArray(data)) {
              throw new Error("Format JSON inattendu pour la base ULM.");
            }

            ulmCache = data.map(normalizeUlmRecord).filter(isUsableUlm);
            return ulmCache;
          })
          .catch((error) => {
            ulmPromise = null;
            throw error;
          });
      }

      return ulmPromise;
    }

    async function findUlmByCode(code) {
      const normalized = normalizeCode(code);

      if (!normalized) return null;

      try {
        const ulmBases = await loadUlmBases();
        return (
          ulmBases.find(
            (item) =>
              item.code === normalized || item.weatherCode === normalized
          ) || null
        );
      } catch (error) {
        console.error(error);
        return null;
      }
    }

    function normalizeSearchText(value) {
      return String(value || "")
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .replace(/[’'`]/g, " ")
        .replace(/[^a-zA-Z0-9]+/g, " ")
        .trim()
        .toUpperCase()
        .replace(/\s+/g, " ");
    }

    function buildAirportSearchEntry(airport, basulmOverlay = null) {
      const targetCode = airport?.weatherCode || "";
      if (!targetCode) return null;

      const name = String(airport?.name || "").trim();
      const municipality = String(airport?.municipality || "").trim();
      const country = normalizeCode(airport?.country || airport?.iso_country || "");
      const metaParts = [targetCode];

      if (municipality) metaParts.push(municipality);
      if (country) metaParts.push(country);

      return {
        kind: "airport",
        targetCode,
        displayCode: targetCode,
        weatherCode: targetCode,
        code: targetCode,
        name,
        municipality,
        country,
        typeLabel: getAirportOperationalLabel(airport, basulmOverlay),
        metaLabel: metaParts.join(" · "),
        searchName: normalizeSearchText(name),
        searchMunicipality: normalizeSearchText(municipality),
        searchCountry: normalizeSearchText(country),
        searchCodes: [normalizeSearchText(targetCode)].filter(Boolean),
      };
    }

    function buildUlmSearchEntry(item) {
      const targetCode = normalizeCode(item?.code || item?.weatherCode || "");
      if (!targetCode) return null;

      const code = normalizeCode(item?.code || "");
      const weatherCode = normalizeCode(item?.weatherCode || "");
      const name = String(item?.name || "").trim();
      const metaParts = [code || weatherCode || targetCode];

      if (weatherCode && weatherCode !== code) {
        metaParts.push(`météo ${weatherCode}`);
      }

      return {
        kind: "ulm",
        targetCode,
        displayCode: code || weatherCode || targetCode,
        weatherCode,
        code,
        name,
        municipality: "",
        country: "FR",
        typeLabel: item?.operationalLabel || "Plateforme ULM",
        metaLabel: metaParts.join(" · "),
        searchName: normalizeSearchText(name),
        searchMunicipality: "",
        searchCountry: "FR",
        searchCodes: [code, weatherCode, targetCode]
          .map((value) => normalizeSearchText(value))
          .filter(Boolean),
      };
    }

    async function loadSearchIndex() {
      if (searchIndexCache) return searchIndexCache;

      if (!searchIndexPromise) {
        searchIndexPromise = Promise.all([loadWorldAirports(), loadUlmBases()])
          .then(([airports, ulmBases]) => {
            const basulmByWeatherCode = buildBasulmIndexByWeatherCode(ulmBases);

            const airportEntries = airports
              .map((airport) => {
                const overlay = basulmByWeatherCode.get(airport.weatherCode) || null;
                return buildAirportSearchEntry(airport, overlay);
              })
              .filter(Boolean);

            const ulmEntries = ulmBases.map(buildUlmSearchEntry).filter(Boolean);

            searchIndexCache = [...airportEntries, ...ulmEntries];
            return searchIndexCache;
          })
          .catch((error) => {
            searchIndexPromise = null;
            throw error;
          });
      }

      return searchIndexPromise;
    }

    function computeSearchScore(query, entry) {
      const normalizedQuery = normalizeSearchText(query);
      if (!normalizedQuery) return null;

      let score = 0;
      let matchKind = "";

      if (entry.searchCodes.includes(normalizedQuery)) {
        score = 1200;
        matchKind = "code_exact";
      } else if (entry.searchCodes.some((code) => code.startsWith(normalizedQuery))) {
        score = 1080;
        matchKind = "code_prefix";
      } else if (entry.searchName === normalizedQuery) {
        score = 980;
        matchKind = "name_exact";
      } else if (
        entry.searchMunicipality &&
        entry.searchMunicipality === normalizedQuery
      ) {
        score = 940;
        matchKind = "municipality_exact";
      } else if (entry.searchName.startsWith(normalizedQuery)) {
        score = 900;
        matchKind = "name_prefix";
      } else if (
        entry.searchMunicipality &&
        entry.searchMunicipality.startsWith(normalizedQuery)
      ) {
        score = 860;
        matchKind = "municipality_prefix";
      } else if (entry.searchCountry && entry.searchCountry === normalizedQuery) {
        score = 620;
        matchKind = "country_exact";
      } else {
        const nameWords = entry.searchName.split(" ").filter(Boolean);
        const cityWords = entry.searchMunicipality.split(" ").filter(Boolean);
        const anyWordPrefix = [...nameWords, ...cityWords].some((word) =>
          word.startsWith(normalizedQuery)
        );

        if (anyWordPrefix) {
          score = 810;
          matchKind = "word_prefix";
        } else {
          const allFields = [
            entry.searchName,
            entry.searchMunicipality,
            entry.searchCountry,
            ...entry.searchCodes,
          ]
            .filter(Boolean)
            .join(" ");

          if (allFields.includes(normalizedQuery)) {
            score = 760;
            matchKind = "partial";
          }
        }
      }

      if (!score) return null;

      if (entry.kind === "airport") score += 8;

      return { score, matchKind };
    }

    async function searchTerrainEntries(query, limit = 6) {
      const normalizedQuery = normalizeSearchText(query);
      if (normalizedQuery.length < 2) return [];

      const index = await loadSearchIndex();

      return index
        .map((entry) => {
          const scoring = computeSearchScore(query, entry);
          if (!scoring) return null;
          return { ...entry, ...scoring };
        })
        .filter(Boolean)
        .sort((a, b) => {
          if (b.score !== a.score) return b.score - a.score;
          if (a.kind !== b.kind) return a.kind === "airport" ? -1 : 1;

          const nameDiff = a.name.localeCompare(b.name, "fr", {
            sensitivity: "base",
          });
          if (nameDiff !== 0) return nameDiff;

          return a.displayCode.localeCompare(b.displayCode, "fr", {
            sensitivity: "base",
          });
        })
        .slice(0, limit);
    }

    function clearSearchFeedback() {
      if (!searchFeedback) return;
      searchFeedback.hidden = true;
      searchFeedback.textContent = "";
    }

    function setSearchFeedback(message) {
      if (!searchFeedback) return;
      if (!message) {
        clearSearchFeedback();
        return;
      }

      searchFeedback.hidden = false;
      searchFeedback.textContent = message;
    }

    function clearSearchSuggestions() {
      currentSearchResults = [];
      if (!searchSuggestions) return;
      searchSuggestions.hidden = true;
      searchSuggestions.innerHTML = "";
    }

    function applySearchSelection(selection) {
      if (!selection?.targetCode || !icaoInput) return;

      clearSearchFeedback();
      clearSearchSuggestions();
      icaoInput.value = selection.targetCode;
      loadMetar();
    }

    function renderSearchSuggestions(results) {
      currentSearchResults = Array.isArray(results) ? results : [];
      if (!searchSuggestions) return;

      if (!currentSearchResults.length) {
        clearSearchSuggestions();
        return;
      }

      searchSuggestions.hidden = false;
      searchSuggestions.innerHTML = "";

      currentSearchResults.forEach((item) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "tool-search-suggestion";
        button.setAttribute("role", "option");

        const kindLabel = item.kind === "airport" ? "Aérodrome" : "ULM";
        const metaLine = item.typeLabel
          ? `${item.metaLabel} · ${item.typeLabel}`
          : item.metaLabel;

        button.innerHTML = `
          <div class="tool-search-suggestion-top">
            <strong>${escapeHtml(item.name || item.displayCode)}</strong>
            <span class="tool-search-suggestion-badge">${escapeHtml(kindLabel)}</span>
          </div>
          <div class="tool-search-suggestion-meta">${escapeHtml(metaLine)}</div>
        `;

        button.addEventListener("mousedown", (event) => {
          event.preventDefault();
        });

        button.addEventListener("click", () => {
          applySearchSelection(item);
        });

        searchSuggestions.appendChild(button);
      });
    }

    async function refreshSearchSuggestions() {
      const rawQuery = String(icaoInput?.value || "").trim();
      clearSearchFeedback();

      if (!rawQuery) {
        clearSearchSuggestions();
        return;
      }

      if (isValidWeatherCode(rawQuery)) {
        clearSearchSuggestions();
        return;
      }

      if (normalizeSearchText(rawQuery).length < 2) {
        clearSearchSuggestions();
        return;
      }

      const requestValue = rawQuery;
      const results = await searchTerrainEntries(rawQuery, 6);

      if (String(icaoInput?.value || "").trim() !== requestValue) {
        return;
      }

      renderSearchSuggestions(results);
    }

    async function submitSearch() {
      const rawQuery = String(icaoInput?.value || "").trim();
      clearSearchFeedback();

      if (!rawQuery) {
        clearSearchSuggestions();
        syncIcaoInUrl("");
        metarOutput.textContent = "Entre un terrain, une ville ou un code OACI.";
        tafOutput.textContent = "Entre un terrain, une ville ou un code OACI.";
        resetDecoded();
        return;
      }

      const normalizedQuery = normalizeCode(rawQuery);
      if (isValidWeatherCode(normalizedQuery)) {
        clearSearchSuggestions();
        if (icaoInput) icaoInput.value = normalizedQuery;
        loadMetar();
        return;
      }

      const results = await searchTerrainEntries(rawQuery, 6);
      renderSearchSuggestions(results);

      if (!results.length) {
        setSearchFeedback(
          "Aucun terrain trouvé. Essaie un code OACI, un nom ou une ville."
        );
        metarOutput.textContent = `Aucun terrain trouvé pour « ${rawQuery} ». Essaie un code OACI, un nom ou une ville.`;
        tafOutput.textContent = "Aucune recherche météo lancée.";
        resetDecoded();
        return;
      }

      const top = results[0];
      const topCount = results.filter((item) => item.score === top.score).length;
      const singleClear =
        results.length === 1 ||
        ((top.matchKind === "code_exact" ||
          top.matchKind === "name_exact" ||
          top.matchKind === "municipality_exact") &&
          topCount === 1);

      if (singleClear) {
        applySearchSelection(top);
        return;
      }

      setSearchFeedback("Sélectionne un terrain dans la liste.");
    }

    function setLocateButtonState(isLoading) {
      if (!locateBtn) return;
      locateBtn.disabled = Boolean(isLoading);
      locateBtn.textContent = isLoading ? "Localisation..." : "Me localiser";
    }

    async function requestBrowserPosition() {
      if (!navigator.geolocation) {
        throw new Error("geolocation_not_supported");
      }

      return new Promise((resolve, reject) => {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            resolve({
              latitude: pos.coords.latitude,
              longitude: pos.coords.longitude,
            });
          },
          (error) => {
            if (error?.code === 1) {
              reject(new Error("geolocation_denied"));
              return;
            }

            if (error?.code === 2) {
              reject(new Error("geolocation_unavailable"));
              return;
            }

            if (error?.code === 3) {
              reject(new Error("geolocation_timeout"));
              return;
            }

            reject(new Error("geolocation_failed"));
          },
          {
            enableHighAccuracy: false,
            timeout: 10000,
            maximumAge: 120000,
          }
        );
      });
    }

    function buildLocationAirportEntry(airport, basulmOverlay, distanceKm) {
      const entry = buildAirportSearchEntry(airport, basulmOverlay);
      if (!entry) return null;

      return {
        ...entry,
        distanceKm,
        metaLabel: `${entry.metaLabel} · ${formatDistanceLabel(distanceKm)}`,
      };
    }

    function buildLocationUlmEntry(item, distanceKm) {
      const entry = buildUlmSearchEntry(item);
      if (!entry) return null;

      return {
        ...entry,
        distanceKm,
        metaLabel: `${entry.metaLabel} · ${formatDistanceLabel(distanceKm)}`,
      };
    }

    function buildEntryLocationResults(airports, ulmBases, center, limit = 3) {
      const basulmByWeatherCode = buildBasulmIndexByWeatherCode(ulmBases);

      const airportCandidates = airports
        .map((airport) => {
          const distanceKm = getDistanceKm(
            center.latitude,
            center.longitude,
            airport.latitude,
            airport.longitude
          );

          if (distanceKm > LOCATION_ENTRY_RADIUS_KM) return null;

          const overlay = basulmByWeatherCode.get(airport.weatherCode) || null;
          return buildLocationAirportEntry(airport, overlay, distanceKm);
        })
        .filter(Boolean)
        .sort((a, b) => a.distanceKm - b.distanceKm);

      const airportWeatherCodes = new Set(
        airportCandidates.map((item) => item.weatherCode).filter(Boolean)
      );

      const ulmCandidates = ulmBases
        .map((item) => {
          const distanceKm = getDistanceKm(
            center.latitude,
            center.longitude,
            item.latitude,
            item.longitude
          );

          if (distanceKm > LOCATION_ENTRY_RADIUS_KM) return null;
          if (item.weatherCode && airportWeatherCodes.has(item.weatherCode)) {
            return null;
          }

          return buildLocationUlmEntry(item, distanceKm);
        })
        .filter(Boolean)
        .sort((a, b) => a.distanceKm - b.distanceKm);

      const selected = [];
      const selectedKeys = new Set();

      const pushEntry = (entry) => {
        if (!entry) return;
        const key = `${entry.kind}:${entry.targetCode}`;
        if (selectedKeys.has(key)) return;
        selected.push(entry);
        selectedKeys.add(key);
      };

      pushEntry(airportCandidates[0] || null);
      pushEntry(airportCandidates[1] || null);
      pushEntry(ulmCandidates[0] || null);

      const overflow = [...airportCandidates.slice(2), ...ulmCandidates.slice(1)]
        .sort((a, b) => {
          if (a.distanceKm !== b.distanceKm) return a.distanceKm - b.distanceKm;
          if (a.kind !== b.kind) return a.kind === "airport" ? -1 : 1;
          return a.name.localeCompare(b.name, "fr", { sensitivity: "base" });
        });

      overflow.forEach((entry) => {
        if (selected.length >= limit) return;
        pushEntry(entry);
      });

      return selected.slice(0, limit);
    }

    async function locateFromEntry() {
      clearSearchSuggestions();
      setSearchFeedback("Localisation en cours...");
      setLocateButtonState(true);

      try {
        const center = await requestBrowserPosition();
        const [airports, ulmBases] = await Promise.all([
          loadWorldAirports(),
          loadUlmBases(),
        ]);

        const results = buildEntryLocationResults(
          airports,
          ulmBases,
          center,
          3
        );

        if (!results.length) {
          clearSearchSuggestions();
          setSearchFeedback(
            "Aucun terrain couvert trouvé près de votre position avec la base actuelle." 
          );
          return;
        }

        renderSearchSuggestions(results);
        setSearchFeedback("Terrains couverts près de votre position. Sélectionne un terrain.");
      } catch (error) {
        clearSearchSuggestions();

        if (error.message === "geolocation_not_supported") {
          setSearchFeedback("La géolocalisation n’est pas supportée sur cet appareil.");
          return;
        }

        if (error.message === "geolocation_denied") {
          setSearchFeedback("Géolocalisation refusée. Autorise la position ou saisis un terrain.");
          return;
        }

        if (
          error.message === "geolocation_unavailable" ||
          error.message === "geolocation_timeout" ||
          error.message === "geolocation_failed"
        ) {
          setSearchFeedback("Impossible de récupérer la position pour le moment.");
          return;
        }

        setSearchFeedback("Impossible de lancer la géolocalisation pour le moment.");
        console.error(error);
      } finally {
        setLocateButtonState(false);
      }
    }

function normalizeUlmDetailsRecord(item) {
      return {
        ...item,
        code: normalizeCode(item?.code || ""),
        operationalLabel: item?.operational_label || item?.operationalLabel || "Plateforme spécifique",
        accessTags: Array.isArray(item?.access_tags)
          ? item.access_tags
          : Array.isArray(item?.accessTags)
            ? item.accessTags
            : [],
        runways: Array.isArray(item?.runways) ? item.runways : [],
        radio: item?.radio || { documented: false, value: null },
        contact: item?.contact || {},
        notes: item?.notes || {},
        updatedAt: item?.updated_at || item?.updatedAt || null,
        sourceLabel: item?.source === "basulm_api" ? "BASULM" : "BASULM",
      };
    }

    async function loadUlmDetails() {
      if (ulmDetailsCache) return ulmDetailsCache;

      if (!ulmDetailsPromise) {
        ulmDetailsPromise = fetch(ULM_DETAILS_URL)
          .then(async (res) => {
            if (!res.ok) {
              throw new Error("Impossible de charger la base ULM détaillée.");
            }

            const data = await res.json();

            if (!Array.isArray(data)) {
              throw new Error("Format JSON inattendu pour la base ULM détaillée.");
            }

            ulmDetailsCache = data.map(normalizeUlmDetailsRecord);
            return ulmDetailsCache;
          })
          .catch((error) => {
            ulmDetailsPromise = null;
            throw error;
          });
      }

      return ulmDetailsPromise;
    }

    async function findUlmDetailsByCode(code) {
      const normalized = normalizeCode(code);
      if (!normalized) return null;

      try {
        const details = await loadUlmDetails();
        return details.find((item) => item.code === normalized) || null;
      } catch (error) {
        console.error(error);
        return null;
      }
    }

    function feetToMeters(value) {
      const parsed = Number(value);
      if (!Number.isFinite(parsed) || parsed <= 0) return null;
      return Math.round(parsed * 0.3048);
    }

    function formatRunwaySurfaceLabel(surface) {
      const value = String(surface || "").trim().toLowerCase();

      if (!value) return "surface non précisée";
      if (value.includes("herbe") || value.includes("grass") || value === "grs") {
        return "herbe";
      }
      if (
        value.includes("asphalt") ||
        value.includes("bitume") ||
        value.includes("concrete") ||
        value.includes("dur") ||
        value.includes("paved") ||
        value === "asp" ||
        value === "con"
      ) {
        return "dur";
      }
      if (value.includes("terre") || value.includes("earth")) return "terre";
      if (value.includes("gravel") || value.includes("grv")) return "gravier";
      if (value.includes("water")) return "eau";

      return String(surface).trim();
    }

    function formatAirportTypeLabel(type) {
      const value = String(type || "").trim().toLowerCase();

      if (value === "heliport") return "Hélistation";
      if (value === "seaplane_base") return "Hydrobase";
      if (value === "closed") return "Terrain fermé";
      if (value.includes("airport") || value.includes("aerodrome") || value.includes("aérodrome")) {
        return "Aérodrome";
      }

      return "Terrain";
    }

    function formatAirportRunwayIdent(runway) {
      const le = String(runway?.le_ident || "").trim();
      const he = String(runway?.he_ident || "").trim();
      if (le && he) return `${le}/${he}`;
      return le || he || "Piste";
    }

    function formatAirportRunwayEntry(runway) {
      const parts = [formatAirportRunwayIdent(runway)];
      const lengthM = feetToMeters(runway?.length_ft);
      const widthM = feetToMeters(runway?.width_ft);
      if (lengthM) parts.push(`${lengthM} m`);
      if (widthM) parts.push(`${widthM} m`);
      parts.push(formatRunwaySurfaceLabel(runway?.surface));
      return parts.join(" · ");
    }

    function formatUlmRunwayEntry(runway) {
      const parts = [];
      const ident = runway?.ident || runway?.orientation_raw || null;
      if (ident) parts.push(ident);
      if (runway?.length_m) parts.push(`${runway.length_m} m`);
      if (runway?.width_m) parts.push(`${runway.width_m} m`);
      parts.push(formatRunwaySurfaceLabel(runway?.surface));
      if (runway?.preferred_orientation_raw) {
        parts.push(`préférentielle ${runway.preferred_orientation_raw}`);
      }
      return parts.join(" · ");
    }

    function summarizeRunwayEntries(entries) {
      if (!Array.isArray(entries) || entries.length === 0) {
        return "Piste non documentée";
      }

      const limit = entries.length <= 5 ? entries.length : 4;
      const visible = entries.slice(0, limit);
      const suffix = entries.length > limit ? ` + ${entries.length - limit} autre(s)` : "";
      return `${visible.join(" / ")}${suffix}`;
    }

    function normalizeHeadingDegrees(value) {
      const parsed = Number(value);
      if (!Number.isFinite(parsed)) return null;
      const normalized = ((parsed % 360) + 360) % 360;
      return normalized;
    }

    function headingFromRunwayLabel(label) {
      const cleaned = String(label || "").trim().toUpperCase();
      const match = cleaned.match(/^(\d{2})/);
      if (!match) return null;
      const numeric = Number(match[1]);
      if (!Number.isFinite(numeric) || numeric < 1 || numeric > 36) return null;
      return normalizeHeadingDegrees((numeric % 36) * 10);
    }

    function reciprocalHeading(heading) {
      const normalized = normalizeHeadingDegrees(heading);
      if (normalized == null) return null;
      return normalizeHeadingDegrees(normalized + 180);
    }

    function parseOrientationPair(value) {
      const textValue = String(value || "").trim().toUpperCase();
      if (!textValue || textValue === "INCONNUE") return null;
      const parts = textValue.split(/\s*[\/-]\s*/).filter(Boolean);
      if (parts.length >= 2) {
        return {
          startLabel: parts[0],
          endLabel: parts[1],
          angleDeg: headingFromRunwayLabel(parts[0]),
        };
      }
      const heading = headingFromRunwayLabel(textValue);
      return heading == null
        ? null
        : {
            startLabel: textValue,
            endLabel: String(((Number(textValue.slice(0, 2)) + 18 - 1) % 36) + 1).padStart(2, "0"),
            angleDeg: heading,
          };
    }

    function preferredHeadingFromRaw(value) {
      const textValue = String(value || "").trim().toUpperCase();
      if (!textValue) return null;
      const parts = textValue.split(/\s*[\/-]\s*/).filter(Boolean);
      if (!parts.length) return null;
      return headingFromRunwayLabel(parts[0]);
    }

    function buildAirportRunwayVisuals(airport) {
      if (!airport || !Array.isArray(airport.runways)) return [];

      return airport.runways
        .map((runway) => {
          const startLabel = String(runway?.le_ident || "").trim().toUpperCase();
          const endLabel = String(runway?.he_ident || "").trim().toUpperCase();
          const angleDeg = headingFromRunwayLabel(startLabel);
          if (!startLabel || !endLabel || angleDeg == null) return null;
          return {
            key: `${startLabel}/${endLabel}`,
            startLabel,
            endLabel,
            angleDeg,
            reciprocalDeg: reciprocalHeading(angleDeg),
            lengthScore: Number(runway?.length_ft) || 0,
            preferredHeadingDeg: null,
            source: "airport",
          };
        })
        .filter(Boolean)
        .sort((a, b) => b.lengthScore - a.lengthScore)
        .slice(0, 5);
    }

    function buildUlmRunwayVisuals(details) {
      if (!details || !Array.isArray(details.runways)) return [];

      return details.runways
        .map((runway, index) => {
          const pair = parseOrientationPair(runway?.ident || runway?.orientation_raw || "");
          if (!pair || pair.angleDeg == null || !pair.startLabel || !pair.endLabel) return null;
          return {
            key: `${pair.startLabel}/${pair.endLabel}/${index}`,
            startLabel: pair.startLabel,
            endLabel: pair.endLabel,
            angleDeg: pair.angleDeg,
            reciprocalDeg: reciprocalHeading(pair.angleDeg),
            lengthScore: Number(runway?.length_m) || 0,
            preferredHeadingDeg: preferredHeadingFromRaw(runway?.preferred_orientation_raw),
            source: "ulm",
          };
        })
        .filter(Boolean)
        .sort((a, b) => b.lengthScore - a.lengthScore)
        .slice(0, 5);
    }

    function getTerrainRunwayVisuals(matchedAirport, matchedUlmDetails) {
      const airportVisuals = buildAirportRunwayVisuals(matchedAirport);
      if (airportVisuals.length) return airportVisuals;
      return buildUlmRunwayVisuals(matchedUlmDetails);
    }

    function getWindMetaLabel() {
      if (isCalmWind(currentWindSpeed)) {
        return "0 kt";
      }
      if (currentWindVariable && Number.isFinite(currentWindSpeed)) {
        return `Vent variable · ${currentWindSpeed} kt`;
      }
      if (Number.isFinite(currentWindDirection) && Number.isFinite(currentWindSpeed)) {
        return `Vent ${String(Math.round(currentWindDirection)).padStart(3, "0")}° · ${currentWindSpeed} kt`;
      }
      if (Number.isFinite(currentWindSpeed)) {
        return `${currentWindSpeed} kt`;
      }
      return "Vent indisponible";
    }

    function headingToPoint(cx, cy, radius, headingDeg) {
      const rad = (headingDeg * Math.PI) / 180;
      return {
        x: cx + Math.sin(rad) * radius,
        y: cy - Math.cos(rad) * radius,
      };
    }

    function smallestAngularDiff(a, b) {
      const diff = Math.abs(a - b) % 360;
      return diff > 180 ? 360 - diff : diff;
    }

    function getBestWindAlignedHeading(runways) {
      if (
        !Array.isArray(runways) ||
        !runways.length ||
        !Number.isFinite(currentWindDirection) ||
        isCalmWind(currentWindSpeed)
      ) {
        return null;
      }

      let best = null;
      for (const runway of runways) {
        const candidates = [runway.angleDeg, runway.reciprocalDeg].filter((v) => Number.isFinite(v));
        for (const candidate of candidates) {
          const score = smallestAngularDiff(candidate, currentWindDirection);
          if (!best || score < best.score) {
            best = { score, headingDeg: candidate, runwayKey: runway.key };
          }
        }
      }

      return best;
    }

    function escapeHtml(value) {
      return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function renderTerrainWindCard(matchedAirport, matchedUlmDetails) {
      if (!platformWindCard || !platformWindVisual || !platformWindMeta) return;

      const runways = getTerrainRunwayVisuals(matchedAirport, matchedUlmDetails);
      if (!runways.length) {
        platformWindCard.hidden = true;
        platformWindVisual.innerHTML = "";
        platformWindMeta.textContent = "Vent indisponible";
        return;
      }

      platformWindCard.hidden = false;
      platformWindMeta.textContent = getWindMetaLabel();

      const cx = 490;
      const cy = 282;
      const outerRadius = 228;
      const innerRadius = 164;
      const runLength = 206;
      const bestWind = getBestWindAlignedHeading(runways);

      const cardinalLabels = [
        { label: "N", heading: 360 },
        { label: "E", heading: 90 },
        { label: "S", heading: 180 },
        { label: "W", heading: 270 },
      ].map((cardinal) => {
        const pos = headingToPoint(cx, cy, outerRadius + 30, cardinal.heading);
        return `<text x="${pos.x}" y="${pos.y}" text-anchor="middle" dominant-baseline="middle" fill="rgba(175, 202, 226, 0.82)" font-size="13" font-weight="800">${cardinal.label}</text>`;
      }).join("");

      const ringMarkup = `
        <circle cx="${cx}" cy="${cy}" r="${outerRadius}" fill="none" stroke="rgba(132, 191, 237, 0.14)" stroke-width="2.2" />
        <circle cx="${cx}" cy="${cy}" r="${innerRadius}" fill="none" stroke="rgba(132, 191, 237, 0.10)" stroke-width="1.4" stroke-dasharray="7 10" />
        <circle cx="${cx}" cy="${cy}" r="44" fill="none" stroke="rgba(132, 191, 237, 0.08)" stroke-width="1.2" stroke-dasharray="6 9" />
      `;

      const runwayMarkup = runways.map((runway) => {
        const isBestAxis = bestWind && bestWind.runwayKey === runway.key;
        const isPreferredStart = Number.isFinite(runway.preferredHeadingDeg) && smallestAngularDiff(runway.preferredHeadingDeg, runway.angleDeg) < 1;
        const isPreferredEnd = Number.isFinite(runway.preferredHeadingDeg) && smallestAngularDiff(runway.preferredHeadingDeg, runway.reciprocalDeg) < 1;

        const start = headingToPoint(cx, cy, runLength, runway.angleDeg);
        const end = headingToPoint(cx, cy, runLength, runway.reciprocalDeg);
        const startLabelPos = headingToPoint(cx, cy, runLength + 30, runway.angleDeg);
        const endLabelPos = headingToPoint(cx, cy, runLength + 30, runway.reciprocalDeg);

        const glowStroke = isBestAxis ? "rgba(90, 224, 255, 0.42)" : "rgba(122, 147, 175, 0.14)";
        const stroke = isBestAxis ? "rgba(94, 231, 255, 0.98)" : "rgba(201, 214, 229, 0.86)";
        const coreStroke = isBestAxis ? "rgba(232, 249, 255, 0.99)" : "rgba(239, 245, 252, 0.52)";

        const prefStartDot = isPreferredStart
          ? `<circle cx="${start.x}" cy="${start.y}" r="6.8" fill="rgba(246, 178, 107, 0.92)" stroke="rgba(255,255,255,0.55)" stroke-width="1" />`
          : "";

        const prefEndDot = isPreferredEnd
          ? `<circle cx="${end.x}" cy="${end.y}" r="6.8" fill="rgba(246, 178, 107, 0.92)" stroke="rgba(255,255,255,0.55)" stroke-width="1" />`
          : "";

        return `
          <line x1="${start.x}" y1="${start.y}" x2="${end.x}" y2="${end.y}" stroke="${glowStroke}" stroke-width="${isBestAxis ? 24 : 14}" stroke-linecap="round" />
          <line x1="${start.x}" y1="${start.y}" x2="${end.x}" y2="${end.y}" stroke="${stroke}" stroke-width="${isBestAxis ? 10.8 : 6.2}" stroke-linecap="round" />
          <line x1="${start.x}" y1="${start.y}" x2="${end.x}" y2="${end.y}" stroke="${coreStroke}" stroke-width="${isBestAxis ? 2.4 : 1.4}" stroke-linecap="round" opacity="0.85" />
          ${prefStartDot}
          ${prefEndDot}
          <text x="${startLabelPos.x}" y="${startLabelPos.y}" text-anchor="middle" dominant-baseline="middle" fill="rgba(243,249,255,0.98)" font-size="18" font-weight="900">${escapeHtml(runway.startLabel)}</text>
          <text x="${endLabelPos.x}" y="${endLabelPos.y}" text-anchor="middle" dominant-baseline="middle" fill="rgba(243,249,255,0.98)" font-size="18" font-weight="900">${escapeHtml(runway.endLabel)}</text>
        `;
      }).join("");

      let windMarkup = '';
      let infoMarkup = '';
      if (isCalmWind(currentWindSpeed)) {
        windMarkup = `
          <circle cx="${cx}" cy="${cy}" r="14" fill="none" stroke="rgba(255, 183, 107, 0.92)" stroke-width="2.6" stroke-dasharray="4 5" />
          <circle cx="${cx}" cy="${cy}" r="5" fill="rgba(255, 183, 107, 0.88)" />
        `;
        infoMarkup = `
          <g transform="translate(24 24)">
            <rect x="0" y="0" width="118" height="36" rx="18" fill="rgba(6, 18, 31, 0.84)" stroke="rgba(255,255,255,0.10)" />
            <text x="54" y="21" text-anchor="middle" fill="rgba(255, 226, 182, 0.96)" font-size="13" font-weight="800">Vent calme</text>
          </g>
        `;
      } else if (Number.isFinite(currentWindDirection)) {
        const fromPoint = headingToPoint(cx, cy, outerRadius - 16, currentWindDirection);
        const toPoint = headingToPoint(cx, cy, 38, currentWindDirection);
        const relative = bestWind ? smallestAngularDiff(bestWind.headingDeg, currentWindDirection) : null;
        const headwind = (bestWind && Number.isFinite(currentWindSpeed)) ? Math.round(Math.cos((relative * Math.PI) / 180) * currentWindSpeed) : null
        const crosswind = (bestWind && Number.isFinite(currentWindSpeed)) ? Math.round(Math.sin((relative * Math.PI) / 180) * currentWindSpeed) : null
        const bestText = bestWind ? `Axe ${String(Math.round(bestWind.headingDeg / 10)).padStart(2, "0")} privilégié` : "Vent";
        const compText = (headwind !== null && crosswind !== null)
          ? `${Math.abs(headwind)} kt face/arrière · ${Math.abs(crosswind)} kt travers`
          : `${currentWindDirection}° · ${currentWindSpeed} kt`;

        windMarkup = `
          <defs>
            <filter id="windGlow">
              <feGaussianBlur stdDeviation="4.4" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
            <marker id="terrainWindArrowPremium" markerWidth="18" markerHeight="18" refX="13.5" refY="9" orient="auto" markerUnits="userSpaceOnUse">
              <path d="M0,0 L16,8 L0,16 L5.2,8 z" fill="#ffb86c" />
            </marker>
          </defs>
          <line x1="${fromPoint.x}" y1="${fromPoint.y}" x2="${toPoint.x}" y2="${toPoint.y}" stroke="rgba(255, 184, 108, 0.28)" stroke-width="18" stroke-linecap="round" filter="url(#windGlow)" />
          <line x1="${fromPoint.x}" y1="${fromPoint.y}" x2="${toPoint.x}" y2="${toPoint.y}" stroke="#ffb86c" stroke-width="7.8" stroke-linecap="round" marker-end="url(#terrainWindArrowPremium)" />
          <circle cx="${fromPoint.x}" cy="${fromPoint.y}" r="5.2" fill="#ffb86c" fill-opacity="0.94" />
        `;
        infoMarkup = `
          <g transform="translate(24 24)">
            <rect x="0" y="0" width="254" height="64" rx="22" fill="rgba(6, 18, 31, 0.84)" stroke="rgba(255,255,255,0.10)" />
            <text x="18" y="22" fill="rgba(255, 220, 184, 0.98)" font-size="15" font-weight="900">${escapeHtml(bestText)}</text>
            <text x="18" y="41" fill="rgba(224, 236, 248, 0.92)" font-size="13.5" font-weight="800">${escapeHtml(compText)}</text>
          </g>
        `;
      } else if (currentWindVariable) {
        windMarkup = `<circle cx="${cx}" cy="${cy}" r="14" fill="none" stroke="rgba(255, 183, 107, 0.92)" stroke-width="2.6" stroke-dasharray="5 5" />`;
        infoMarkup = `
          <g transform="translate(24 24)">
            <rect x="0" y="0" width="162" height="42" rx="21" fill="rgba(6, 18, 31, 0.84)" stroke="rgba(255,255,255,0.10)" />
            <text x="73" y="25" text-anchor="middle" fill="rgba(255, 226, 182, 0.96)" font-size="12" font-weight="800">Vent variable</text>
          </g>
        `;
      }

      platformWindVisual.innerHTML = `
        <svg viewBox="0 0 980 560" role="img" aria-label="Vent et pistes" class="terrain-visual-svg">
          <defs>
            <radialGradient id="terrainPanelBg" cx="50%" cy="50%" r="70%">
              <stop offset="0%" stop-color="rgba(44, 95, 138, 0.18)" />
              <stop offset="68%" stop-color="rgba(10, 20, 35, 0.08)" />
              <stop offset="100%" stop-color="rgba(7, 13, 24, 0)" />
            </radialGradient>
            <linearGradient id="terrainGlass" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="rgba(255,255,255,0.06)" />
              <stop offset="100%" stop-color="rgba(255,255,255,0.01)" />
            </linearGradient>
          </defs>
          <rect x="0" y="0" width="980" height="560" rx="46" fill="url(#terrainGlass)" />
          <rect x="0" y="0" width="980" height="560" rx="46" fill="url(#terrainPanelBg)" />
          ${ringMarkup}
          ${cardinalLabels}
          ${runwayMarkup}
          ${windMarkup}
          ${infoMarkup}
          <circle cx="${cx}" cy="${cy}" r="7" fill="rgba(255,255,255,0.08)" stroke="rgba(214, 232, 247, 0.18)" />
          <circle cx="${cx}" cy="${cy}" r="3.8" fill="rgba(244, 248, 252, 0.88)" />
        </svg>
      `;
    }

    function getAirportRunwayEntries(airport) {
      if (!airport || !Array.isArray(airport.runways)) return [];
      return airport.runways.map(formatAirportRunwayEntry).filter(Boolean);
    }

    function getUlmRunwayEntries(details) {
      if (!details || !Array.isArray(details.runways)) return [];
      return details.runways.map(formatUlmRunwayEntry).filter(Boolean);
    }

    function formatTerrainIdentity(matchedAirport, matchedUlm, matchedUlmDetails) {
      const typeLabel = matchedUlmDetails?.operationalLabel || matchedUlm?.operationalLabel || formatAirportTypeLabel(matchedAirport?.type);
      const accessLabel = formatAccessTags(matchedUlmDetails?.accessTags || matchedUlm?.accessTags || []);
      return accessLabel ? `${typeLabel} · ${accessLabel}` : typeLabel || "Terrain";
    }

    function formatContactSummary(contact = {}, airport = null, options = {}) {
      const publishedPhoneKeys = new Set(
        (options.publishedPhones || [])
          .map((value) => normalizePhoneComparisonKey(value))
          .filter(Boolean)
      );

      const extraPhones = getUniquePhoneValues([contact?.phone_1, contact?.phone_2]).filter(
        (value) => !publishedPhoneKeys.has(normalizePhoneComparisonKey(value))
      );

      const parts = [];
      if (contact?.website) parts.push(contact.website);
      if (airport?.home_link && !parts.includes(airport.home_link)) parts.push(airport.home_link);
      if (contact?.manager) parts.push(contact.manager);

      if (parts.length) return parts.join(" · ");
      if (extraPhones.length) return extraPhones.join(" · ");
      if (publishedPhoneKeys.size) return "Téléphone publié dans le bloc radio";
      return "Non documenté";
    }

    function formatSiteDetails(contact = {}, airport = null) {
      const parts = [];
      if (contact?.website) parts.push(contact.website);
      if (contact?.manager) parts.push(contact.manager);
      if (!parts.length && airport?.home_link) parts.push(airport.home_link);
      if (!parts.length && airport?.wikipedia_link) parts.push(airport.wikipedia_link);
      return parts.length ? parts.join(" · ") : "";
    }

    function formatNotesSummary(details) {
      const consignes = details?.notes?.consignes;
      const infos = details?.notes?.infos;
      if (consignes) return consignes;
      if (infos) return infos;
      return "";
    }

    function getTerrainSourceMeta(matchedAirport, matchedUlmDetails) {
      if (matchedAirport && matchedUlmDetails) {
        return {
          badge: "Base France · BASULM",
          note: "Terrains : base France / BASULM.",
        };
      }
      if (matchedUlmDetails) {
        return {
          badge: "BASULM",
          note: "Terrains : BASULM.",
        };
      }
      if (matchedAirport?.sourceScope === "world") {
        return {
          badge: "Base monde",
          note: "Terrains : base monde.",
        };
      }
      return {
        badge: "Base France",
        note: "Terrains : base France.",
      };
    }

    function isFrenchOfficialDocsEligible(matchedAirport, matchedUlm, matchedUlmDetails) {
      if (matchedAirport) {
        return normalizeCode(matchedAirport.country || matchedAirport.iso_country || "") === "FR";
      }
      if (matchedUlmDetails || matchedUlm) return false;
      return false;
    }

    function getTerrainOfficialCode(matchedAirport, matchedUlm, matchedUlmDetails) {
      const code = normalizeCode(
        matchedAirport?.weatherCode ||
        matchedAirport?.icao ||
        matchedUlmDetails?.weatherCode ||
        matchedUlmDetails?.code ||
        matchedUlm?.weatherCode ||
        matchedUlm?.code ||
        ""
      );
      return isValidWeatherCode(code) ? code : "";
    }

    function toHostedDocUrl(path) {
      if (!path) return "";
      try {
        return new URL(path, window.location.origin).href;
      } catch (_error) {
        return path;
      }
    }

    function buildOfficialDocsUrls(matchedAirport, matchedUlm, matchedUlmDetails) {
      if (!isFrenchOfficialDocsEligible(matchedAirport, matchedUlm, matchedUlmDetails)) {
        return null;
      }

      const code = getTerrainOfficialCode(matchedAirport, matchedUlm, matchedUlmDetails);
      if (!code) return null;

      const vacUrl = HOSTED_VAC_CODES.has(code)
        ? toHostedDocUrl(`${SIA_VAC_AD_BASE_URL}AD-2.${code}.pdf`)
        : "";
      const aipUrl = HOSTED_AIP_AD_CODES.has(code)
        ? toHostedDocUrl(`${SIA_AIP_AD_BASE_URL}FR-AD-2.${code}-fr-FR.pdf`)
        : "";

      if (!vacUrl && !aipUrl) return null;

      return { vacUrl, aipUrl };
    }

    function openOfficialDoc(url) {
      if (!url) return;
      window.open(url, "_blank", "noopener,noreferrer");
    }

    function setOfficialDocButtonState(element, href, label) {
      if (!element) return;
      if (!href) {
        element.hidden = true;
        element.removeAttribute("data-doc-url");
        element.removeAttribute("aria-label");
        return;
      }
      element.hidden = false;
      element.setAttribute("data-doc-url", href);
      element.setAttribute("aria-label", label);
    }

    function renderOfficialDocs(matchedAirport, matchedUlm, matchedUlmDetails) {
      if (!platformDocsPanel) return;

      const urls = buildOfficialDocsUrls(matchedAirport, matchedUlm, matchedUlmDetails);
      if (!urls) {
        platformDocsPanel.hidden = true;
        setOfficialDocButtonState(platformVacBtn, "", "");
        setOfficialDocButtonState(platformAipBtn, "", "");
        return;
      }

      setOfficialDocButtonState(platformVacBtn, urls.vacUrl, "Ouvrir la VAC terrain dans un nouvel onglet");
      setOfficialDocButtonState(platformAipBtn, urls.aipUrl, "Ouvrir la fiche AIP AD dans un nouvel onglet");
      platformDocsPanel.hidden = !urls.vacUrl && !urls.aipUrl;
    }

    function resetPlatformBlock() {
      if (platformBlock) platformBlock.hidden = true;
      if (platformSourceValue) platformSourceValue.textContent = "—";
      if (platformTypeValue) platformTypeValue.textContent = "—";
      if (platformContactValue) platformContactValue.textContent = "—";
      if (platformRunwaysValue) platformRunwaysValue.textContent = "—";
      if (platformRadioValue) platformRadioValue.textContent = "—";
      if (platformSiteValue) platformSiteValue.textContent = "—";
      if (platformNotesValue) platformNotesValue.textContent = "—";
      if (platformUpdatedValue) platformUpdatedValue.textContent = "—";
      if (platformSourceNote) {
        platformSourceNote.textContent = "Terrains : base monde · France / BASULM.";
      }
      if (platformDocsPanel) platformDocsPanel.hidden = true;
      setOfficialDocButtonState(platformVacBtn, "", "");
      setOfficialDocButtonState(platformAipBtn, "", "");
      if (platformDetailsDisclosure) {
        platformDetailsDisclosure.hidden = true;
        platformDetailsDisclosure.open = false;
      }
      if (platformRadioLine) platformRadioLine.hidden = true;
      if (platformSiteLine) platformSiteLine.hidden = true;
      if (platformNotesLine) platformNotesLine.hidden = true;
      if (platformUpdatedLine) platformUpdatedLine.hidden = true;
    }

    function renderPlatformBlock(matchedAirport, matchedUlm, matchedUlmDetails) {
      if (
        !platformBlock ||
        !platformSourceValue ||
        !platformTypeValue ||
        !platformRunwaysValue ||
        !platformContactValue ||
        !platformSourceNote
      ) {
        return;
      }

      if (!matchedAirport && !matchedUlm && !matchedUlmDetails) {
        resetPlatformBlock();
        return;
      }

      const sourceMeta = getTerrainSourceMeta(matchedAirport, matchedUlmDetails);
      const airportRunwayEntries = getAirportRunwayEntries(matchedAirport);
      const ulmRunwayEntries = getUlmRunwayEntries(matchedUlmDetails);
      const runwayEntries = airportRunwayEntries.length ? airportRunwayEntries : ulmRunwayEntries;
      const siteDetails = formatSiteDetails(matchedUlmDetails?.contact || {}, matchedAirport);
      const notesSummary = formatNotesSummary(matchedUlmDetails);
      const publishedPhones = formatPublishedPhones(matchedUlmDetails);
      const radioSummary = matchedUlmDetails?.radio?.documented && matchedUlmDetails?.radio?.value
        ? matchedUlmDetails.radio.value
        : "";
      const updatedSummary = matchedUlmDetails?.updatedAt || "";

      platformSourceValue.textContent = sourceMeta.badge;
      platformTypeValue.textContent = formatTerrainIdentity(
        matchedAirport,
        matchedUlm,
        matchedUlmDetails
      );
      platformRunwaysValue.textContent = summarizeRunwayEntries(runwayEntries);
      platformContactValue.textContent = formatContactSummary(
        matchedUlmDetails?.contact || {},
        matchedAirport,
        { publishedPhones }
      );
      renderTerrainWindCard(matchedAirport, matchedUlmDetails);
      renderOfficialDocs(matchedAirport, matchedUlm, matchedUlmDetails);
      platformSourceNote.textContent = sourceMeta.note;

      const hasDetails = Boolean(siteDetails || notesSummary || radioSummary || updatedSummary);

      if (platformRadioLine) platformRadioLine.hidden = !radioSummary;
      if (platformSiteLine) platformSiteLine.hidden = !siteDetails;
      if (platformNotesLine) platformNotesLine.hidden = !notesSummary;
      if (platformUpdatedLine) platformUpdatedLine.hidden = !updatedSummary;

      if (platformRadioValue) platformRadioValue.textContent = radioSummary || "—";
      if (platformSiteValue) platformSiteValue.textContent = siteDetails || "—";
      if (platformNotesValue) platformNotesValue.textContent = notesSummary || "—";
      if (platformUpdatedValue) platformUpdatedValue.textContent = updatedSummary || "—";

      if (platformDetailsDisclosure) {
        platformDetailsDisclosure.hidden = !hasDetails;
        if (!hasDetails) platformDetailsDisclosure.open = false;
      }

      platformBlock.hidden = false;
    }

function normalizeFrequencyItem(entry) {
      return {
        ...entry,
        frequency_type: String(entry?.frequency_type || "").trim(),
        label: String(entry?.label || "").trim(),
        description: String(entry?.description || "").trim(),
        service_code: String(entry?.service_code || "").trim(),
        sector: String(entry?.sector || "").trim(),
        remark: String(entry?.remark || "").trim(),
        suppletive: String(entry?.suppletive || "").trim(),
        frequency_mhz: Number(entry?.frequency_mhz),
      };
    }

    function normalizeFrequencyRecord(item) {
      return {
        ...item,
        airport_ident: normalizeCode(item?.airport_ident || ""),
        weather_code: normalizeCode(item?.weather_code || ""),
        airport_name: String(item?.airport_name || "").trim(),
        frequencies: Array.isArray(item?.frequencies)
          ? item.frequencies.map(normalizeFrequencyItem)
          : [],
        primary_frequency: item?.primary_frequency
          ? normalizeFrequencyItem(item.primary_frequency)
          : null,
      };
    }

    async function loadFrequencies() {
      if (frequenciesCache) return frequenciesCache;

      if (!frequenciesPromise) {
        frequenciesPromise = fetch(FREQUENCIES_URL)
          .then(async (res) => {
            if (!res.ok) {
              throw new Error("Impossible de charger la base fréquences.");
            }

            const data = await res.json();

            if (!Array.isArray(data)) {
              throw new Error("Format JSON inattendu pour la base fréquences.");
            }

            frequenciesCache = data.map(normalizeFrequencyRecord);
            return frequenciesCache;
          })
          .catch((error) => {
            frequenciesPromise = null;
            throw error;
          });
      }

      return frequenciesPromise;
    }

    async function findFrequencyByCode(code) {
      const normalized = normalizeCode(code);
      if (!normalized) return null;

      try {
        const allFrequencies = await loadFrequencies();

        return (
          allFrequencies.find(
            (item) =>
              item.weather_code === normalized ||
              item.airport_ident === normalized
          ) || null
        );
      } catch (error) {
        console.error(error);
        return null;
      }
    }

    function formatFrequencyMhz(value) {
      const parsed = Number(value);
      return Number.isFinite(parsed) ? `${parsed.toFixed(3)} MHz` : "";
    }

    function normalizeRadioText(value) {
      return String(value || "").trim().replace(/\s+/g, " ");
    }

    function normalizePhoneComparisonKey(value) {
      return normalizeRadioText(value)
        .replace(/[^0-9+]/g, "")
        .replace(/^00/, "+");
    }

    function getUniquePhoneValues(values = []) {
      const seen = new Set();

      return values
        .map((value) => normalizeRadioText(value))
        .filter(Boolean)
        .filter((value) => {
          const key = normalizePhoneComparisonKey(value);
          if (!key || seen.has(key)) return false;
          seen.add(key);
          return true;
        });
    }

    function getRadioServiceKey(frequency) {
      const rawType = String(frequency?.frequency_type || "")
        .trim()
        .toLowerCase();

      const rawLabel = normalizeRadioText(
        `${frequency?.label || ""} ${frequency?.description || ""}`
      ).toUpperCase();

      if (rawLabel.includes("D-ATIS") || rawLabel.includes("ATIS")) {
        return "atis";
      }

      if (
        rawLabel.includes("PREVOL") ||
        rawLabel.includes("PRÉVOL") ||
        rawLabel.includes("PREFLIGHT") ||
        rawLabel.includes("PRE-FLIGHT")
      ) {
        return "preflight";
      }

      if (rawLabel.includes("TRAFIC") || rawLabel.includes("TRAFFIC")) {
        return "traffic";
      }

      if (
        rawLabel.includes("GND") ||
        rawLabel.includes("GROUND") ||
        rawLabel.includes("SOL")
      ) {
        return "ground";
      }

      if (
        rawLabel.includes("APP") ||
        rawLabel.includes("APPROACH") ||
        rawLabel.includes("APPROCHE")
      ) {
        return "approach";
      }

      if (
        rawLabel.includes("INFO") ||
        rawLabel.includes("INFORMATION") ||
        rawLabel.includes("AFIS") ||
        rawLabel.includes("FIS")
      ) {
        return "information";
      }

      if (
        rawLabel.includes("AUTO-INFORMATION") ||
        rawLabel.includes("AUTO INFORMATION") ||
        rawLabel.includes("AUTO-INFO") ||
        rawLabel.includes("AUTO INFO") ||
        rawLabel.includes("A/A") ||
        rawLabel.includes("UNICOM") ||
        rawLabel.includes("CTAF")
      ) {
        return "air_to_air";
      }

      if (
        rawLabel.includes("DEP") ||
        rawLabel.includes("DEPART") ||
        rawLabel.includes("DÉPART") ||
        rawLabel.includes("DEPARTURE")
      ) {
        return "departure";
      }

      if (
        rawLabel.includes("ARR") ||
        rawLabel.includes("ARRIVEE") ||
        rawLabel.includes("ARRIVÉE") ||
        rawLabel.includes("ARRIVAL")
      ) {
        return "arrival";
      }

      if (
        rawLabel.includes("TWR") ||
        rawLabel.includes("TOUR") ||
        rawLabel.includes("TOWER")
      ) {
        return "tower";
      }

      if (rawType === "tower" || rawType === "twr") return "tower";
      if (rawType === "ground" || rawType === "gnd") return "ground";
      if (rawType === "approach" || rawType === "app") return "approach";
      if (
        rawType === "information" ||
        rawType === "afis" ||
        rawType === "info" ||
        rawType === "fis"
      ) {
        return "information";
      }
      if (rawType === "atis") return "atis";
      if (
        rawType === "air_to_air" ||
        rawType === "air-to-air" ||
        rawType === "ctaf" ||
        rawType === "unicom"
      ) {
        return "air_to_air";
      }
      if (rawType === "departure" || rawType === "dep") return "departure";
      if (rawType === "arrival" || rawType === "arr") return "arrival";
      if (rawType === "radar" || rawType === "rad") return "radar";
      if (rawType === "control" || rawType === "acc" || rawType === "acs") {
        return "control";
      }

      return rawType || "other";
    }

    function getRadioServiceLabel(frequency) {
      const rawLabel = normalizeRadioText(
        `${frequency?.label || ""} ${frequency?.description || ""}`
      ).toUpperCase();
      const serviceKey = getRadioServiceKey(frequency);

      if (rawLabel.includes("AFIS")) return "AFIS";

      switch (serviceKey) {
        case "tower":
          return "Tour";
        case "ground":
          return "Sol";
        case "approach":
          return "Approche";
        case "information":
          return "Info";
        case "atis":
          return "ATIS";
        case "air_to_air":
          return "Auto-information";
        case "preflight":
          return "Prévol";
        case "traffic":
          return "Trafic";
        case "departure":
          return "Départ";
        case "arrival":
          return "Arrivée";
        default:
          return "Radio";
      }
    }

    function getRadioServicePriorityByLabel(serviceLabel) {
      const normalized = normalizeRadioText(serviceLabel).toLowerCase();

      if (normalized === "tour") return 1;
      if (normalized === "afis") return 2;
      if (normalized === "info") return 3;
      if (normalized === "sol") return 4;
      if (normalized === "approche") return 5;
      if (normalized === "trafic") return 6;
      if (normalized === "auto-information") return 7;
      if (normalized === "départ" || normalized === "depart") return 8;
      if (normalized === "arrivée" || normalized === "arrivee") return 9;
      if (normalized === "prévol" || normalized === "prevol") return 10;
      if (normalized === "atis") return 99;
      return 98;
    }

    function getRadioServicePriority(frequency) {
      return getRadioServicePriorityByLabel(getRadioServiceLabel(frequency));
    }

    function shouldHideFrequencyEntry(entry) {
      const serviceCode = normalizeCode(entry?.service_code || "");
      const labelText = normalizeRadioText(
        `${entry?.label || ""} ${entry?.description || ""}`
      ).toUpperCase();
      const mhz = Number(entry?.frequency_mhz);

      if (!Number.isFinite(mhz) || mhz <= 0) return true;
      if (serviceCode === "VDF") return true;
      if (labelText.includes("GONIO")) return true;
      if (labelText.includes("HOMER")) return true;

      return false;
    }

    function cleanOfficialQualifierText(value) {
      return normalizeRadioText(value)
        .replace(/#/g, " · ")
        .replace(/Secteur\/Sector/gi, "Secteur")
        .replace(/et\/and/gi, " et ")
        .replace(/à\/to/gi, " à ")
        .replace(/\bCanal\s+8\.33\b/gi, "")
        .replace(/\bCanal\s+25\b/gi, "")
        .replace(/\s*·\s*·\s*/g, " · ")
        .replace(/\s+/g, " ")
        .replace(/[.;]+$/g, "")
        .trim();
    }

    function normalizeSivQualifierText(value) {
      return cleanOfficialQualifierText(value)
        .replace(/\bSIV\s+/gi, "SIV ")
        .replace(/\s+et\s+/gi, " et ")
        .replace(/\s*\/\s*/g, " / ")
        .replace(/\s+/g, " ")
        .trim();
    }

    function extractOfficialQualifierFromRemark(remark) {
      const cleaned = cleanOfficialQualifierText(remark);
      if (!cleaned) return "";

      const sectorWithSivMatch = cleaned.match(
        /Secteur\s+([A-Z0-9.]+)\s*\((SIV[^)]+)\)/i
      );
      if (sectorWithSivMatch?.[1] && sectorWithSivMatch?.[2]) {
        return `Secteur ${sectorWithSivMatch[1]} (${normalizeSivQualifierText(
          sectorWithSivMatch[2]
        )})`;
      }

      const sectorOnlyMatch = cleaned.match(/Secteur\s+([A-Z0-9.]+)/i);
      if (sectorOnlyMatch?.[1]) {
        return `Secteur ${sectorOnlyMatch[1]}`;
      }

      const infoRadarMatch = cleaned.match(
        /Information\/Radar\s+(SIV\s+[^·]+)/i
      );
      if (infoRadarMatch?.[1]) {
        return normalizeSivQualifierText(infoRadarMatch[1]);
      }

      const sivMatch = cleaned.match(
        /(SIV\s+[0-9.]+(?:\s*(?:et|\/|à)\s*(?:SIV\s*)?[0-9.]+(?:\.[0-9]+)?)*)/i
      );
      if (sivMatch?.[1]) {
        return normalizeSivQualifierText(sivMatch[1]);
      }

      return "";
    }

    function getOfficialFrequencyBaseLabel(entry) {
      const label = normalizeRadioText(entry?.label || "");
      const description = normalizeRadioText(entry?.description || "");
      const serviceLabel = getRadioServiceLabel(entry);

      if (label) return label;
      if (description) return description;

      if (
        serviceLabel === "ATIS" ||
        serviceLabel === "Sol" ||
        serviceLabel === "Tour" ||
        serviceLabel === "Approche" ||
        serviceLabel === "Info" ||
        serviceLabel === "Auto-information" ||
        serviceLabel === "Prévol" ||
        serviceLabel === "Trafic"
      ) {
        return serviceLabel;
      }

      return "Radio";
    }

    function getOfficialSectorSuffix(entry) {
      const directSector = cleanOfficialQualifierText(entry?.sector || "");
      if (directSector) return directSector;

      const remarkQualifier = extractOfficialQualifierFromRemark(
        entry?.remark || ""
      );
      if (remarkQualifier) return remarkQualifier;

      const suppletive = cleanOfficialQualifierText(entry?.suppletive || "");
      if (suppletive && normalizeCode(suppletive) !== "NON") {
        return suppletive;
      }

      return "";
    }

    function getOperationalFrequencyLabel(entry) {
      const baseLabel = getOfficialFrequencyBaseLabel(entry);
      const sectorSuffix = getOfficialSectorSuffix(entry);

      if (!sectorSuffix) return baseLabel;

      return `${baseLabel} — ${sectorSuffix}`;
    }

    function getDisplayFrequencyKey(entry) {
      return [
        getOperationalFrequencyLabel(entry),
        formatFrequencyMhz(entry?.frequency_mhz),
      ].join("|");
    }

    function getFrequencyDetailScore(entry) {
      return (
        (normalizeRadioText(getOfficialSectorSuffix(entry)) ? 100 : 0) +
        (normalizeRadioText(entry?.remark || "") ? 10 : 0) +
        Math.min(
          normalizeRadioText(getOfficialFrequencyBaseLabel(entry)).length,
          40
        )
      );
    }

    function buildDisplayFrequencies(frequencies = []) {
      const visibleFrequencies = frequencies.filter(
        (entry) => !shouldHideFrequencyEntry(entry)
      );

      const grouped = new Map();

      visibleFrequencies.forEach((entry) => {
        const mhzLabel = formatFrequencyMhz(entry?.frequency_mhz);
        if (!mhzLabel) return;

        const baseKey = normalizeRadioText(
          getOfficialFrequencyBaseLabel(entry)
        ).toUpperCase();

        const groupKey = [baseKey, mhzLabel].join("|");

        if (!grouped.has(groupKey)) {
          grouped.set(groupKey, []);
        }

        grouped.get(groupKey).push(entry);
      });

      const reduced = [];

      grouped.forEach((entries) => {
        const qualifiedEntries = entries.filter((entry) =>
          normalizeRadioText(getOfficialSectorSuffix(entry))
        );

        const sourceEntries =
          qualifiedEntries.length > 0 ? qualifiedEntries : entries;

        const bestByQualifier = new Map();

        sourceEntries.forEach((entry) => {
          const qualifierKey =
            normalizeRadioText(getOfficialSectorSuffix(entry)).toLowerCase() ||
            "__default__";

          const current = bestByQualifier.get(qualifierKey);

          if (
            current == null ||
            getFrequencyDetailScore(entry) > getFrequencyDetailScore(current)
          ) {
            bestByQualifier.set(qualifierKey, entry);
          }
        });

        reduced.push(...bestByQualifier.values());
      });

      const dedupedByService = new Map();

      reduced.forEach((entry) => {
        const key = getServiceDedupFrequencyKey(entry);
        const current = dedupedByService.get(key);

        if (
          current == null ||
          getFrequencyDetailScore(entry) > getFrequencyDetailScore(current)
        ) {
          dedupedByService.set(key, entry);
        }
      });

      return [...dedupedByService.values()].sort((a, b) => {
        const serviceDiff =
          getRadioServicePriority(a) - getRadioServicePriority(b);
        if (serviceDiff !== 0) return serviceDiff;

        const labelDiff = getOperationalFrequencyLabel(a).localeCompare(
          getOperationalFrequencyLabel(b),
          "fr",
          { sensitivity: "base" }
        );
        if (labelDiff !== 0) return labelDiff;

        const freqA = Number(a?.frequency_mhz);
        const freqB = Number(b?.frequency_mhz);

        if (Number.isFinite(freqA) && Number.isFinite(freqB) && freqA !== freqB) {
          return freqA - freqB;
        }

        return 0;
      });
    }

    function formatPublishedPhones(details = null) {
      return getUniquePhoneValues([
        details?.contact?.phone_1,
        details?.contact?.phone_2,
      ]);
    }

    function getAtisDisplayEntries(displayFrequencies = []) {
      return displayFrequencies.filter(
        (entry) => getRadioServiceLabel(entry) === "ATIS"
      );
    }

    function getPrimaryRadioCandidates(displayFrequencies = []) {
      return displayFrequencies.filter(
        (entry) => getRadioServiceLabel(entry) !== "ATIS"
      );
    }

    function getPrimaryOperationalPriority(entry) {
      const normalized = normalizeRadioText(getRadioServiceLabel(entry)).toLowerCase();

      if (normalized === "tour") return 1;
      if (normalized === "afis") return 2;
      if (normalized === "info") return 3;
      if (normalized === "auto-information") return 4;
      if (normalized === "trafic") return 5;
      if (normalized === "approche") return 6;
      if (normalized === "sol") return 7;
      if (normalized === "départ" || normalized === "depart") return 8;
      if (normalized === "arrivée" || normalized === "arrivee") return 9;
      if (normalized === "prévol" || normalized === "prevol") return 10;
      return 11;
    }

    function isSamePrimaryFrequency(entry, primaryFrequency) {
      if (!entry || !primaryFrequency) return false;

      return (
        formatFrequencyMhz(entry.frequency_mhz) ===
          formatFrequencyMhz(primaryFrequency.frequency_mhz) &&
        normalizeRadioText(getOfficialFrequencyBaseLabel(entry)) ===
          normalizeRadioText(getOfficialFrequencyBaseLabel(primaryFrequency))
      );
    }

    function selectPrimaryOperationalFrequency(primaryCandidates = [], primaryFrequency = null) {
      if (!Array.isArray(primaryCandidates) || !primaryCandidates.length) return null;

      return [...primaryCandidates].sort((a, b) => {
        const priorityDiff =
          getPrimaryOperationalPriority(a) - getPrimaryOperationalPriority(b);
        if (priorityDiff !== 0) return priorityDiff;

        const primaryMatchDiff =
          Number(isSamePrimaryFrequency(b, primaryFrequency)) -
          Number(isSamePrimaryFrequency(a, primaryFrequency));
        if (primaryMatchDiff !== 0) return primaryMatchDiff;

        const detailDiff = getFrequencyDetailScore(b) - getFrequencyDetailScore(a);
        if (detailDiff !== 0) return detailDiff;

        const labelDiff = getOperationalFrequencyLabel(a).localeCompare(
          getOperationalFrequencyLabel(b),
          "fr",
          { sensitivity: "base" }
        );
        if (labelDiff !== 0) return labelDiff;

        const freqA = Number(a?.frequency_mhz);
        const freqB = Number(b?.frequency_mhz);
        if (Number.isFinite(freqA) && Number.isFinite(freqB) && freqA !== freqB) {
          return freqA - freqB;
        }

        return 0;
      })[0] || null;
    }

    function getServiceDedupFrequencyKey(entry) {
      return [
        normalizeRadioText(getRadioServiceLabel(entry)).toLowerCase(),
        formatFrequencyMhz(entry?.frequency_mhz),
        normalizeRadioText(getOfficialSectorSuffix(entry)).toLowerCase(),
      ].join("|");
    }

    function renderFrequencyPanel(record, fallbackRadio = null, matchedUlmDetails = null) {
      if (!radioValue || !radioTypeValue || !radioLabelValue) return;

      if (radioList) radioList.innerHTML = "";
      if (radioSupportBlock) radioSupportBlock.hidden = true;
      if (radioAtisCard) radioAtisCard.hidden = true;
      if (radioPhoneCard) radioPhoneCard.hidden = true;
      if (radioSecondaryBlock) {
        radioSecondaryBlock.hidden = true;
        radioSecondaryBlock.open = false;
      }
      if (radioSecondaryCount) radioSecondaryCount.textContent = "0";

      const publishedPhones = formatPublishedPhones(matchedUlmDetails);

      const renderPublishedPhone = () => {
        if (!radioSupportBlock || !radioPhoneCard || !publishedPhones.length) return;

        radioSupportBlock.hidden = false;
        radioPhoneCard.hidden = false;
        if (radioPhoneValue) radioPhoneValue.textContent = publishedPhones.join(" / ");
        if (radioPhoneLabel) {
          radioPhoneLabel.textContent = "Téléphone publié pour le terrain.";
        }
        if (radioPhoneSourceValue) {
          radioPhoneSourceValue.textContent = matchedUlmDetails ? "Source terrain publiée" : "Publié pour le terrain";
        }
      };

      const renderAtis = (atisEntry) => {
        if (!radioSupportBlock || !radioAtisCard || !atisEntry) return;

        radioSupportBlock.hidden = false;
        radioAtisCard.hidden = false;
        if (radioAtisValue) {
          radioAtisValue.textContent = formatFrequencyMhz(atisEntry.frequency_mhz) || "—";
        }
        if (radioAtisLabel) {
          radioAtisLabel.textContent = getOperationalFrequencyLabel(atisEntry);
        }
        if (radioAtisSourceValue) {
          radioAtisSourceValue.textContent = "Information arrivée / départ";
        }
      };

      const setUnavailable = () => {
        radioTypeValue.textContent = "Radio";
        radioValue.textContent = "Non disponible";
        radioLabelValue.textContent =
          "Aucune fréquence publiée trouvée pour ce terrain.";
        if (radioSourceValue) {
          radioSourceValue.textContent =
            "Radio : SIA / BASULM.";
        }
        renderPublishedPhone();
      };

      const renderBasulmFallback = () => {
        if (!fallbackRadio?.documented || !fallbackRadio?.value) {
          setUnavailable();
          return;
        }

        radioTypeValue.textContent = "Radio BASULM";
        radioValue.textContent = fallbackRadio.value;
        radioLabelValue.textContent =
          "Fréquence publiée BASULM pour la plateforme.";
        if (radioSourceValue) {
          radioSourceValue.textContent = "Radio : BASULM.";
        }
        renderPublishedPhone();
      };

      if (
        !record ||
        !Array.isArray(record.frequencies) ||
        record.frequencies.length === 0
      ) {
        renderBasulmFallback();
        return;
      }

      const allFrequencies = Array.isArray(record.frequencies)
        ? record.frequencies
        : [];

      const displayFrequencies = buildDisplayFrequencies(allFrequencies);

      if (!displayFrequencies.length) {
        renderBasulmFallback();
        return;
      }

      const atisEntries = getAtisDisplayEntries(displayFrequencies);
      const primaryCandidates = getPrimaryRadioCandidates(displayFrequencies);

      const primaryVisibleMatch = record.primary_frequency
        ? primaryCandidates.find((entry) => isSamePrimaryFrequency(entry, record.primary_frequency)) || null
        : null;

      const primaryFrequency =
        selectPrimaryOperationalFrequency(primaryCandidates, primaryVisibleMatch || record.primary_frequency) ||
        atisEntries[0] ||
        null;

      if (!primaryFrequency) {
        renderBasulmFallback();
        return;
      }

      const inferredAfis = Boolean(
        matchedUlmDetails?.notes?.consignes &&
        /\bAFIS\b/i.test(matchedUlmDetails.notes.consignes) &&
        getRadioServiceLabel(primaryFrequency) === "Info"
      );

      radioTypeValue.textContent = inferredAfis
        ? "AFIS"
        : getRadioServiceLabel(primaryFrequency);
      radioValue.textContent =
        formatFrequencyMhz(primaryFrequency.frequency_mhz) || "—";
      radioLabelValue.textContent = getOperationalFrequencyLabel(primaryFrequency);
      if (radioSourceValue) {
        radioSourceValue.textContent = "Radio : SIA / BASULM.";
      }

      const primaryKey = getDisplayFrequencyKey(primaryFrequency);
      const atisKey = atisEntries[0] ? getDisplayFrequencyKey(atisEntries[0]) : null;

      const secondaryFrequencies = displayFrequencies.filter((entry) => {
        const entryKey = getDisplayFrequencyKey(entry);
        if (entryKey === primaryKey) return false;
        if (atisKey && entryKey === atisKey) return false;
        return true;
      });

      if (atisEntries.length) {
        const highlightedAtis = atisEntries.find(
          (entry) => getDisplayFrequencyKey(entry) !== primaryKey
        ) || atisEntries[0];
        if (highlightedAtis && getDisplayFrequencyKey(highlightedAtis) !== primaryKey) {
          renderAtis(highlightedAtis);
        }
      }

      renderPublishedPhone();

      if (!radioList || secondaryFrequencies.length === 0) return;

      if (radioSecondaryBlock) {
        radioSecondaryBlock.hidden = false;
        radioSecondaryBlock.open = false;
      }
      if (radioSecondaryCount) {
        radioSecondaryCount.textContent = String(secondaryFrequencies.length);
      }

      secondaryFrequencies.forEach((entry) => {
        const item = document.createElement("li");

        item.innerHTML = `
          <div>
            <strong>${getOperationalFrequencyLabel(entry)}</strong>
          </div>
          <span>${formatFrequencyMhz(entry.frequency_mhz) || "—"}</span>
        `;

        radioList.appendChild(item);
      });
    }

function getDistanceKm(lat1, lon1, lat2, lon2) {
      const toRad = (value) => (value * Math.PI) / 180;
      const R = 6371;

      const dLat = toRad(lat2 - lat1);
      const dLon = toRad(lon2 - lon1);

      const a =
        Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(toRad(lat1)) *
          Math.cos(toRad(lat2)) *
          Math.sin(dLon / 2) *
          Math.sin(dLon / 2);

      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      return R * c;
    }

    function formatDistanceLabel(distanceKm) {
      if (!Number.isFinite(distanceKm)) return "";
      const distanceNm = distanceKm / 1.852;
      return `${distanceNm.toFixed(0)} NM · ${distanceKm.toFixed(1)} km`;
    }

    function formatReferenceIdentity(reference) {
      if (!reference?.airport) return "";

      const code = reference.airport.weatherCode || reference.snapshot?.icao || "";
      const name = reference.airport.name || code || "Terrain voisin";

      return code ? `${name} (${code})` : name;
    }

    function buildNeighborContextMeta(reference) {
      if (!reference) {
        return "Terrain sans METAR / TAF local.";
      }

      const parts = ["Terrain sans METAR / TAF local"];
      const distanceLabel = formatDistanceLabel(reference.distanceKm);
      if (distanceLabel) parts.push(distanceLabel);

      return parts.join(" · ");
    }

    function formatNeighborStatus(reference) {
      const identity = formatReferenceIdentity(reference);

      if (reference?.snapshot?.fltCat === "VFR") {
        return `🟢 Météo voisine VFR — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "MVFR") {
        return `🟡 Météo voisine MVFR — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "IFR") {
        return `🔴 Météo voisine IFR — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "LIFR") {
        return `🚨 Météo voisine LIFR — ${identity}`;
      }

      return `Repère météo voisin — ${identity}`;
    }

function formatNeighborFlightCategory(reference) {
  const category = reference?.snapshot?.fltCat;
  return formatWeatherCategoryLabel(category);
}

    function buildNeighborMetarOutput(reference, targetCode, fallbackMessage) {
      if (!reference?.snapshot?.rawOb) return fallbackMessage;

      const identity = formatReferenceIdentity(reference);
      const distanceLabel = formatDistanceLabel(reference.distanceKm);

      return `Aucun METAR publié pour ${targetCode}.
Repère voisin retenu : ${identity}${distanceLabel ? ` — ${distanceLabel}` : ""}.

${reference.snapshot.rawOb}`;
    }

    function buildNeighborTafOutput(reference, targetCode, fallbackMessage) {
      if (!reference) return fallbackMessage;

      const identity = formatReferenceIdentity(reference);
      const distanceLabel = formatDistanceLabel(reference.distanceKm);

      if (reference?.snapshot?.taf) {
        return `Aucun TAF publié pour ${targetCode}.
Repère voisin retenu : ${identity}${distanceLabel ? ` — ${distanceLabel}` : ""}.

${reference.snapshot.taf}`;
      }

      return `Aucun TAF publié pour ${targetCode}.
Repère voisin retenu : ${identity}${distanceLabel ? ` — ${distanceLabel}` : ""}.

TAF voisin indisponible sur ce terrain de référence.`;
    }

    function buildNeighborTafSummary(reference) {
      if (!reference) return "Prévision indisponible";

      const identity = formatReferenceIdentity(reference);

      if (!reference?.snapshot?.taf) {
        return `Prévision voisine indisponible — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "VFR") {
        return `🟢 Tendance météo voisine VFR — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "MVFR") {
        return `🟡 Tendance météo voisine MVFR — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "IFR") {
        return `🔴 Tendance météo voisine IFR — ${identity}`;
      }

      if (reference?.snapshot?.fltCat === "LIFR") {
        return `🚨 Tendance météo voisine LIFR — ${identity}`;
      }

      return `Prévision voisine disponible — ${identity}`;
    }

    function getAirportOperationalLabel(airport, basulmOverlay) {
      if (basulmOverlay?.operationalLabel) return basulmOverlay.operationalLabel;

      if (airport.type === "large_airport") return "Aérodrome principal";
      if (airport.type === "medium_airport") return "Aérodrome";
      if (airport.type === "small_airport") return "Aérodrome";
      return "Plateforme aéronautique";
    }

    function formatAccessTags(tags = []) {
      const labels = [];

      if (tags.includes("open_to_ulm")) labels.push("Ouvert aux ULM");
      if (tags.includes("authorization_required")) {
        labels.push("Autorisation obligatoire");
      }
      if (tags.includes("private")) labels.push("Privé");
      if (tags.includes("restricted")) labels.push("Restrictions");
      if (tags.includes("specific_rules")) labels.push("Règles spécifiques");
      if (tags.includes("in_service")) labels.push("En service");

      return labels.join(" · ");
    }

    function buildBasulmIndexByWeatherCode(ulmBases) {
      const map = new Map();

      ulmBases.forEach((item) => {
        if (!item.weatherCode) return;
        if (!map.has(item.weatherCode)) {
          map.set(item.weatherCode, item);
        }
      });

      return map;
    }

async function fetchWeatherSnapshot(icao) {
  const normalized = normalizeCode(icao);
  if (!normalized) return null;

  try {
    const res = await fetch(
      `${WORKER_URL}?icao=${encodeURIComponent(normalized)}`
    );

    if (!res.ok) return null;

    const data = await res.json();

    if (!Array.isArray(data) || data.length === 0) return null;

    const item = data[0];

    if (!item || typeof item !== "object" || !item.rawOb) return null;

    return {
      icao: normalized,
      rawOb: item.rawOb || "",
      taf: item.taf || "",
      fltCat: item.fltCat || "",
      wdir: item.wdir ?? null,
      wspd: item.wspd ?? null,
      visib: item.visib ?? null,
      cover: item.cover ?? "",
      clouds: Array.isArray(item.clouds) ? item.clouds : [],
      temp: item.temp ?? null,
      dewp: item.dewp ?? null,
      altim: item.altim ?? null,
    };
  } catch (error) {
    console.error(error);
    return null;
  }
}

    function formatWeatherReferenceMeta(snapshot) {
      const parts = [];

      if (snapshot?.wdir && snapshot?.wspd != null) {
        const windDirection = String(snapshot.wdir).trim().toUpperCase() === "VRB"
          ? "Vent variable"
          : `Vent ${String(Math.round(Number(snapshot.wdir))).padStart(3, "0")}°`;
        parts.push(`${windDirection} · ${snapshot.wspd} kt`);
      } else if (snapshot?.wspd != null) {
        parts.push(`Vent ${snapshot.wspd} kt`);
      }

      if (snapshot?.visib != null) {
        parts.push(formatVisibility(snapshot.visib));
      }

      parts.push(snapshot?.taf ? "TAF disponible" : "TAF indisponible");
      return parts.join(" · ");
    }

    function getWeatherReferenceCategory(snapshot) {
      const category = String(snapshot?.fltCat || "").trim().toUpperCase();
      const label = formatWeatherCategoryLabel(category || "Non disponible");
      const cssKey = category ? category.toLowerCase() : "unknown";
      return { label, cssKey };
    }

    function formatWeatherReferencePlace(airport) {
      const parts = [];
      if (airport?.municipality) parts.push(airport.municipality);
      if (airport?.country) parts.push(airport.country);
      return parts.join(" · ");
    }

    function getWeatherReferenceCenter(matchedAirport, matchedUlm) {
      if (
        matchedAirport &&
        Number.isFinite(matchedAirport.latitude) &&
        Number.isFinite(matchedAirport.longitude)
      ) {
        return {
          latitude: matchedAirport.latitude,
          longitude: matchedAirport.longitude,
        };
      }

      if (
        matchedUlm &&
        Number.isFinite(matchedUlm.latitude) &&
        Number.isFinite(matchedUlm.longitude)
      ) {
        return {
          latitude: matchedUlm.latitude,
          longitude: matchedUlm.longitude,
        };
      }

      return null;
    }

    async function findNearbyWeatherReferences(
      targetCode,
      matchedAirport,
      matchedUlm
    ) {
      const center = getWeatherReferenceCenter(matchedAirport, matchedUlm);
      if (!center) return [];

      try {
        const airports = await loadAirports();

        const nearbyCandidates = airports
          .filter((airport) => airport.weatherCode !== normalizeCode(targetCode))
          .map((airport) => ({
            airport,
            distanceKm: getDistanceKm(
              center.latitude,
              center.longitude,
              airport.latitude,
              airport.longitude
            ),
          }))
          .filter((item) => item.distanceKm <= WEATHER_REFERENCE_MAX_KM)
          .sort((a, b) => a.distanceKm - b.distanceKm)
          .slice(0, 12);

        if (nearbyCandidates.length === 0) return [];

        const candidateResults = await Promise.all(
          nearbyCandidates.map(async (item) => {
            const snapshot = await fetchWeatherSnapshot(item.airport.weatherCode);

            return snapshot
              ? {
                  airport: item.airport,
                  distanceKm: item.distanceKm,
                  snapshot,
                }
              : null;
          })
        );

        return candidateResults.filter(Boolean).slice(0, 3);
      } catch (error) {
        console.error(error);
        return [];
      }
    }

    async function loadWeatherReferences(
      targetCode,
      matchedAirport,
      matchedUlm,
      precomputedReferences = null
    ) {
      if (!weatherRefsBlock || !weatherRefsList) return;

      const references =
        precomputedReferences ||
        (await findNearbyWeatherReferences(targetCode, matchedAirport, matchedUlm));

      if (!references || references.length === 0) {
        showWeatherReferencesMessage(
          "Aucun repère météo publié trouvé dans un rayon de 50 NM autour de ce terrain."
        );
        return;
      }

      weatherRefsBlock.hidden = false;
      weatherRefsList.innerHTML = "";

      references.forEach((reference) => {
        const li = document.createElement("li");
        li.className = "weather-ref-item";

        const category = getWeatherReferenceCategory(reference.snapshot);
        const placeLabel = formatWeatherReferencePlace(reference.airport);
        const codeLabel = escapeHtml(reference.airport.weatherCode || "—");
        const nameLabel = escapeHtml(reference.airport.name || codeLabel);
        const placeMarkup = placeLabel
          ? `<div class="weather-ref-place">${escapeHtml(placeLabel)}</div>`
          : "";
        const metaLabel = escapeHtml(formatWeatherReferenceMeta(reference.snapshot));
        const distanceLabel = escapeHtml(formatDistanceLabel(reference.distanceKm));
        const categoryLabel = escapeHtml(category.label);

        li.innerHTML = `
          <button type="button" class="weather-ref-card weather-ref-card--clickable">
            <div class="weather-ref-headline">
              <div class="weather-ref-id-block">
                <strong class="weather-ref-code">${codeLabel}</strong>
                <div class="weather-ref-name">${nameLabel}</div>
              </div>
              <span class="weather-ref-distance">${distanceLabel}</span>
            </div>
            ${placeMarkup}
            <div class="weather-ref-meta-row">
              <span class="weather-ref-category weather-ref-category--${category.cssKey}">${categoryLabel}</span>
              <span class="weather-ref-meta">${metaLabel}</span>
            </div>
            <div class="weather-ref-footer">
              <span class="weather-ref-action">Voir METAR / TAF</span>
            </div>
          </button>
        `;

        const button = li.querySelector("button");

        button?.addEventListener("click", () => {
          icaoInput.value = reference.airport.weatherCode;
          loadMetar();
          window.scrollTo({ top: 0, behavior: "smooth" });
        });

        weatherRefsList.appendChild(li);
      });
    }

async function applyMissingLocalWeatherState({
  icao,
  matchedAirport,
  matchedUlm,
  matchedUlmDetails,
  matchedFrequency,
  metarMessage,
  tafMessage,
  emptyStatusMessage,
}) {
  const references = await findNearbyWeatherReferences(
    icao,
    matchedAirport,
    matchedUlm
  );
  const primaryReference = references[0] || null;

  resetDecoded();
  renderPlatformBlock(matchedAirport, matchedUlm, matchedUlmDetails);

  nameValue.textContent =
    formatMatchedDisplayName(matchedAirport, matchedUlm) || icao;
  renderFrequencyPanel(matchedFrequency, matchedUlmDetails?.radio || null, matchedUlmDetails);

  if (primaryReference) {
    statusValue.textContent = formatNeighborStatus(primaryReference);

    currentWindSpeed = Number.isFinite(Number(primaryReference.snapshot?.wspd))
      ? Number(primaryReference.snapshot?.wspd)
      : null;
    currentWindVariable =
      String(primaryReference.snapshot?.wdir || "").trim().toUpperCase() === "VRB";
    currentWindDirection =
      isCalmWind(currentWindSpeed) || currentWindVariable
        ? null
        : Number.isFinite(Number(primaryReference.snapshot?.wdir))
          ? Number(primaryReference.snapshot?.wdir)
          : null;

    windValue.textContent = formatWind(
      primaryReference.snapshot?.wdir,
      primaryReference.snapshot?.wspd
    );
    visibilityValue.textContent = formatVisibility(
      primaryReference.snapshot?.visib
    );
    cloudsValue.textContent = formatClouds(primaryReference.snapshot);
    if (cloudsMeta) {
      const detail = formatCloudsMeta(primaryReference.snapshot);
      cloudsMeta.textContent = detail;
      cloudsMeta.hidden = !detail;
    }
    tempValue.textContent = formatTemp(
      primaryReference.snapshot?.temp,
      primaryReference.snapshot?.dewp
    );
    pressureValue.textContent = formatPressure(
      primaryReference.snapshot?.altim
    );

    fltCatValue.textContent = formatNeighborFlightCategory(primaryReference);

    metarOutput.textContent = buildNeighborMetarOutput(
      primaryReference,
      icao,
      metarMessage
    );
    tafOutput.textContent = buildNeighborTafOutput(
      primaryReference,
      icao,
      tafMessage
    );
    renderTafDecoded({
      rawTaf: primaryReference.snapshot?.taf || "",
      icao,
      localAvailable: false,
      neighborMeta: `Repère voisin retenu : ${formatReferenceIdentity(primaryReference)}${formatDistanceLabel(primaryReference.distanceKm) ? ` — ${formatDistanceLabel(primaryReference.distanceKm)}` : ""}.`,
    });
    updateWeatherFreshnessNotes({
      rawMetar: primaryReference.snapshot?.rawOb || "",
      rawTaf: primaryReference.snapshot?.taf || "",
    });
  } else {
    statusValue.textContent = emptyStatusMessage;
    windValue.textContent = "Non disponible";
    visibilityValue.textContent = "Non disponible";
    cloudsValue.textContent = "Non disponible";
    if (cloudsMeta) { cloudsMeta.textContent = ""; cloudsMeta.hidden = true; }
    tempValue.textContent = "Non disponible";
    pressureValue.textContent = "Non disponible";
    fltCatValue.textContent = "Non disponible";
    metarOutput.textContent = metarMessage;
    tafOutput.textContent = tafMessage;
    renderTafDecoded({ rawTaf: "", icao, localAvailable: false });
    hideWeatherFreshnessNotes();
    currentWindDirection = null;
    currentWindSpeed = null;
    currentWindVariable = false;
  }

  renderTerrainWindCard(matchedAirport, matchedUlmDetails);

  await loadWeatherReferences(
    icao,
    matchedAirport,
    matchedUlm,
    references
  );
  await prefetchNearbySummary();
}

    async function resolveNearbyCenter() {
      const enteredCode = normalizeCode(icaoInput?.value);

      if (enteredCode) {
        const matchedAirport = await findAnyAirportByCode(enteredCode);
        if (matchedAirport) {
          return {
            latitude: matchedAirport.latitude,
            longitude: matchedAirport.longitude,
            label: `Terrains autour de ${matchedAirport.weatherCode} — ${matchedAirport.name}`,
          };
        }

        const matchedUlm = await findUlmByCode(enteredCode);
        if (matchedUlm) {
          return {
            latitude: matchedUlm.latitude,
            longitude: matchedUlm.longitude,
            label: `Terrains autour de ${matchedUlm.code} — ${matchedUlm.name}`,
          };
        }
      }

      const position = await requestBrowserPosition();

      return {
        latitude: position.latitude,
        longitude: position.longitude,
        label: "Terrains autour de votre position",
      };
    }


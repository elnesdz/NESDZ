    function decodeWind(windStr, magneticVariation) {
      if (!windStr || windStr === "Calme") return {
        readable: "Calme",
        dir: null,
        speed: 0
      };
      let readable = "Inconnu";
      let dir = null;
      let speed = 0;
      const windMatch = windStr.match(/(\d{3}|VRB)(\d{2,3})(?:G(\d{2,3}))?KT/);
      if (windMatch) {
        const [, windDir, windSpeed, gustSpeed] = windMatch;
        dir = windDir === "VRB" ? null : parseInt(windDir, 10);
        speed = parseInt(windSpeed, 10);
        const gust = gustSpeed ? parseInt(gustSpeed, 10) : 0;
        let magneticDir = null;
        if (dir !== null && magneticVariation !== undefined) {
          magneticDir = (dir - magneticVariation + 360) % 360;
        }
        readable = `${dir !== null ? `${Math.round(magneticDir ?? dir).toString().padStart(3, '0')}°` : 'VRB'} / ${speed} kt${gust ? ` (raf. ${gust} kt)` : ''}`;
      }
      return {
        readable,
        dir,
        speed
      };
    }
    
    function formatVisibility(vis) {
      if (vis === "10" || vis === "9999") return "> 10 km";
      if (vis === "CAVOK") return "CAVOK";
      if (!isNaN(parseInt(vis))) return `${parseInt(vis)} m`;
      return "Inconnue";
    }
    
    function getFlightCategory(visibility, ceiling) {
      const visMeters = visibility === "> 10 km" || visibility === "CAVOK" ? 9999 : parseInt(visibility);
      if (visMeters < 1500 || ceiling < 500) return "LIFR";
      if (visMeters < 5000 || ceiling < 1000) return "IFR";
      if (visMeters < 8000 || ceiling < 3000) return "MVFR";
      return "VFR";
    }
    
    function decodeCloud(cloudStr) {
      if (!cloudStr || ["NSC", "NCD", "CLR"].includes(cloudStr)) return {
        coverage: "Aucun nuage significatif",
        base: Infinity,
        details: ""
      };
      const coverageMap = {
        FEW: "Peu de nuages",
        SCT: "Nuages épars",
        BKN: "Nuages fragmentés",
        OVC: "Ciel couvert"
      };
      const cloudMatch = cloudStr.match(/^(FEW|SCT|BKN|OVC)(\d{3})(CB|TCU)?/);
      if (cloudMatch) {
        const [, coverage, baseFt, type] = cloudMatch;
        const base = parseInt(baseFt, 10) * 100;
        const details = type ? ` (${type === 'CB' ? 'Cumulonimbus' : 'Cumulus bourgeonnant'})` : '';
        return {
          coverage: `${coverageMap[coverage]} à ${base} ft`,
          base,
          details
        };
      }
      if (cloudStr.startsWith("VV")) {
        const baseFt = cloudStr.substring(2);
        if (!isNaN(parseInt(baseFt))) {
          const base = parseInt(baseFt, 10) * 100;
          return {
            coverage: `Visibilité verticale ${base} ft`,
            base,
            details: ""
          };
        }
      }
      return {
        coverage: "Inconnu",
        base: Infinity,
        details: ""
      };
    }
    
    function findCeiling(clouds) {
      let ceiling = Infinity;
      let ceilingStr = "Pas de plafond";
      for (const cloud of clouds) {
        const cloudMatch = cloud.match(/^(BKN|OVC)(\d{3})/);
        if (cloudMatch) {
          const base = parseInt(cloudMatch[2], 10) * 100;
          if (base < ceiling) {
            ceiling = base;
            ceilingStr = `${cloudMatch[1]} à ${base} ft`;
          }
        } else if (cloud.startsWith("VV")) {
          const baseFt = cloud.substring(2);
          if (!isNaN(parseInt(baseFt))) {
            const base = parseInt(baseFt, 10) * 100;
            if (base < ceiling) {
              ceiling = base;
              ceilingStr = `Vis. vert. ${base} ft`;
            }
          }
        }
      }
      return {
        base: ceiling,
        str: ceilingStr
      };
    }
    
    function parseMetar(data, magneticVariation) {
      resetDecoded();
      if (!data || !data.raw_text) {
        metarOutput.textContent = "Aucun METAR trouvé pour ce terrain.";
        statusValue.textContent = "Données indisponibles";
        statusValue.className = "cat-badge cat-badge--unknown";
        return;
      }
      metarOutput.textContent = data.raw_text;
      const metarDate = new Date(data.observation_time);
      const now = new Date();
      const ageMinutes = Math.round((now - metarDate) / 60000);
      let statusText = `METAR de ${metarDate.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })} Z`;
      if (ageMinutes >= 0) {
        statusText += ` (il y a ${ageMinutes} min)`;
        weatherFreshnessNote.textContent = statusText;
        weatherFreshnessNote.hidden = false;
      } else {
        weatherFreshnessNote.hidden = true;
      }
      statusValue.textContent = statusText;
      let allClouds = data.clouds.map(c => c.raw).join(" ");
      let ceilingObj = findCeiling(data.clouds.map(c => c.raw));
      if (data.conditions && data.conditions.length > 0) {
        allClouds = allClouds + " " + data.conditions.map(c => c.raw).join(" ");
      }
      cloudsValue.textContent = data.clouds.length > 0 ? data.clouds.map(c => decodeCloud(c.raw).coverage).join(", ") : "Ciel clair";
      if (ceilingObj.base !== Infinity) {
        cloudsMeta.textContent = `Plafond : ${ceilingObj.str}`;
        cloudsMeta.hidden = false;
      }
      const windData = decodeWind(data.wind ? data.wind.raw : "Calme", magneticVariation);
      windValue.textContent = windData.readable;
      currentWindDirection = windData.dir;
      const vis = data.visibility ? formatVisibility(data.visibility.raw) : "Inconnue";
      visibilityValue.textContent = vis;
      const temp = data.temperature ? `${data.temperature.celsius}°C` : "N/A";
      const dewpoint = data.dewpoint ? `${data.dewpoint.celsius}°C` : "N/A";
      tempValue.textContent = `${temp} / ${dewpoint}`;
      const pressure = data.barometer ? `${Math.round(data.barometer.hpa)} hPa` : "N/A";
      pressureValue.textContent = pressure;
      const fltCat = getFlightCategory(vis, ceilingObj.base);
      fltCatValue.textContent = fltCat;
      fltCatValue.className = `cat-badge cat-badge--${fltCat.toLowerCase()}`;
    }
    
    function getRunwayIdentifiers(runway) {
      return [runway.le_ident, runway.he_ident].filter(Boolean);
    }
    
    function calculateWindComponents(windDirection, windSpeed, runwayHeading) {
      if (windDirection === null) return {
        crosswind: 0,
        headwind: windSpeed
      };
      const angle = (windDirection - runwayHeading + 360) % 360;
      const crosswind = Math.abs(windSpeed * Math.sin(angle * Math.PI / 180));
      const headwind = windSpeed * Math.cos(angle * Math.PI / 180);
      return {
        crosswind: Math.round(crosswind),
        headwind: Math.round(headwind)
      };
    }
    
    function findBestRunway(runways, windDirection, windSpeed) {
      if (!windDirection || runways.length === 0) return null;
      let bestRunway = null;
      let minCrosswind = Infinity;
      let maxHeadwind = -Infinity;
      runways.forEach(runway => {
        const identifiers = getRunwayIdentifiers(runway);
        identifiers.forEach(ident => {
          const runwayHeading = parseInt(ident, 10) * 10;
          if (!isNaN(runwayHeading)) {
            const {
              crosswind,
              headwind
            } = calculateWindComponents(windDirection, windSpeed, runwayHeading);
            if (headwind > maxHeadwind || (headwind === maxHeadwind && crosswind < minCrosswind)) {
              maxHeadwind = headwind;
              minCrosswind = crosswind;
              bestRunway = {
                ident,
                crosswind,
                headwind
              };
            }
          }
        });
      });
      return bestRunway;
    }
    
    function renderRunwayWindVisual(runways, windDirection, windSpeed) {
      platformWindVisual.innerHTML = "";
      if (!windDirection || runways.length === 0) {
        platformWindCard.hidden = true;
        return;
      }
      const windAngle = windDirection;
      const windSpeedKnots = windSpeed;
      const container = document.createElement('div');
      container.className = 'runway-visual-container';
      const windArrow = document.createElement('div');
      windArrow.className = 'wind-arrow';
      windArrow.style.transform = `rotate(${windAngle - 90}deg)`;
      windArrow.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>`;
      const windLabel = document.createElement('div');
      windLabel.className = 'wind-label';
      windLabel.textContent = `${windSpeedKnots} kt`;
      const bestRunway = findBestRunway(runways, windDirection, windSpeed);
      let activeRunwayHeading = null;
      if (bestRunway) {
        activeRunwayHeading = parseInt(bestRunway.ident, 10) * 10;
        const headwindComponent = bestRunway.headwind > 0 ? `Face: ${Math.round(bestRunway.headwind)} kt` : `Arrière: ${Math.abs(Math.round(bestRunway.headwind))} kt`;
        const crosswindComponent = `Travers: ${Math.round(bestRunway.crosswind)} kt (${bestRunway.crosswind > 0 ? (bestRunway.headwind > 0 ? (windDirection - activeRunwayHeading + 360) % 360 > 180 ? 'G' : 'D' : 'G') : ''})`;
        platformWindMeta.textContent = `Piste suggérée ${bestRunway.ident} | ${headwindComponent} | ${crosswindComponent}`;
      } else {
        platformWindMeta.textContent = "Aucune piste favorable trouvée.";
      }
      runways.forEach(runway => {
        const runwayElement = document.createElement('div');
        runwayElement.className = 'runway-line';
        if (runway.le_ident) {
          const runwayHeading = parseInt(runway.le_ident, 10) * 10;
          runwayElement.style.transform = `rotate(${runwayHeading}deg)`;
          if (activeRunwayHeading && Math.abs(runwayHeading - activeRunwayHeading) < 10) {
            runwayElement.classList.add('active');
          }
          const leLabel = document.createElement('span');
          leLabel.className = 'runway-label le';
          leLabel.textContent = runway.le_ident;
          const heLabel = document.createElement('span');
          heLabel.className = 'runway-label he';
          heLabel.textContent = runway.he_ident;
          runwayElement.appendChild(leLabel);
          runwayElement.appendChild(heLabel);
          container.appendChild(runwayElement);
        }
      });
      container.appendChild(windArrow);
      container.appendChild(windLabel);
      platformWindVisual.appendChild(container);
      platformWindCard.hidden = false;
    }
    
    function parseTaf(data, magneticVariation) {
      clearTafDecoded();
      if (!data || !data.raw_text) {
        tafOutput.textContent = "Aucun TAF trouvé pour ce terrain.";
        tafSummaryValue.textContent = "Données indisponibles";
        return;
      }
      tafOutput.textContent = data.raw_text;
      const tafDate = new Date(data.issue_time);
      const startDate = new Date(data.start_time);
      const endDate = new Date(data.end_time);
      const now = new Date();
      const ageMinutes = Math.round((now - tafDate) / 60000);
      tafIssuedValue.textContent = `${tafDate.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' })} ${tafDate.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })} Z`;
      tafIssuedCard.hidden = false;
      tafValidityValue.textContent = `${startDate.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })} Z → ${endDate.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })} Z`;
      tafValidityCard.hidden = false;
      if (data.raw_text.includes("AMD")) {
        tafModifierValue.textContent = "Amendé";
        tafModifierCard.hidden = false;
      } else if (data.raw_text.includes("COR")) {
        tafModifierValue.textContent = "Corrigé";
        tafModifierCard.hidden = false;
      }
      tafMetaGrid.hidden = false;
      tafDecoderMeta.textContent = `Prévision émise il y a ${ageMinutes} min.`;
      tafDecoderMeta.hidden = false;
      const baseForecast = data.forecast[0];
      const windData = decodeWind(baseForecast.wind ? baseForecast.wind.raw : "Calme", magneticVariation);
      const vis = baseForecast.visibility ? formatVisibility(baseForecast.visibility.raw) : "Inconnue";
      const clouds = baseForecast.clouds.length > 0 ? baseForecast.clouds.map(c => decodeCloud(c.raw).coverage).join(", ") : "Ciel clair";
      tafSummaryValue.textContent = `${windData.readable} | ${vis} | ${clouds}`;
      renderTafVisual(data.forecast[0], magneticVariation);
      tafVisualBlock.hidden = false;
      const changes = data.forecast.slice(1);
      if (changes.length > 0) {
        tafChangesList.innerHTML = changes.map(f => renderForecastChange(f, magneticVariation)).join("");
        tafChangesCount.textContent = changes.length;
        tafChangesSection.hidden = false;
      }
      if (data.temperature && data.temperature.length > 0) {
        tafTempList.innerHTML = data.temperature.map(t => `<li><strong>${new Date(t.valid_time).toLocaleTimeString('fr-FR', { hour: '2-digit' })}h Z:</strong> ${t.surface_temp.celsius}°C</li>`).join("");
        tafTempsCount.textContent = data.temperature.length;
        tafTempsSection.hidden = false;
      }
      tafDecodeBlock.hidden = false;
    }
    
    function renderTafVisual(forecast, magneticVariation) {
      tafVisualOverview.innerHTML = "";
      const windData = decodeWind(forecast.wind ? forecast.wind.raw : "Calme", magneticVariation);
      const vis = forecast.visibility ? formatVisibility(forecast.visibility.raw) : "Inconnue";
      const ceilingObj = findCeiling(forecast.clouds.map(c => c.raw));
      const fltCat = getFlightCategory(vis, ceilingObj.base);
      const items = [{
        label: 'Vent',
        value: windData.readable
      }, {
        label: 'Visibilité',
        value: vis
      }, {
        label: 'Plafond',
        value: ceilingObj.str
      }, {
        label: 'Catégorie',
        value: `<span class="cat-badge cat-badge--${fltCat.toLowerCase()}">${fltCat}</span>`
      }, ];
      tafVisualOverview.innerHTML = items.map(item => `<div class="taf-visual-item"><span class="taf-visual-label">${item.label}</span><strong class="taf-visual-value">${item.value}</strong></div>`).join("");
    }
    
    function renderForecastChange(forecast, magneticVariation) {
      const type = forecast.raw.split(" ")[0];
      const start = new Date(forecast.start_time);
      const end = new Date(forecast.end_time);
      const windData = decodeWind(forecast.wind ? forecast.wind.raw : "Calme", magneticVariation);
      const vis = forecast.visibility ? formatVisibility(forecast.visibility.raw) : "Inconnue";
      const clouds = forecast.clouds.length > 0 ? forecast.clouds.map(c => decodeCloud(c.raw).coverage).join(", ") : "Ciel clair";
      const weather = forecast.conditions ? forecast.conditions.map(c => c.raw).join(" ") : "";
      return `
        <div class="taf-timeline-item">
          <div class="taf-timeline-marker taf-timeline-marker--${type.toLowerCase()}">${type}</div>
          <div class="taf-timeline-content">
            <div class="taf-timeline-head">
              <strong>${start.toLocaleTimeString('fr-FR', { hour: '2-digit' })}h - ${end.toLocaleTimeString('fr-FR', { hour: '2-digit' })}h Z</strong>
            </div>
            <ul class="taf-timeline-details">
              ${windData.readable !== "Calme" ? `<li><strong>Vent:</strong> ${windData.readable}</li>` : ''}
              ${vis !== "Inconnue" ? `<li><strong>Visibilité:</strong> ${vis}</li>` : ''}
              ${clouds !== "Ciel clair" ? `<li><strong>Nuages:</strong> ${clouds}</li>` : ''}
              ${weather ? `<li><strong>Temps significatif:</strong> ${weather}</li>` : ''}
            </ul>
          </div>
        </div>
      `;
    }
    
    async function submitSearch() {
      const icao = icaoInput.value.trim().toUpperCase();
      if (!icao) return;
      resetDecoded();
      clearTafDecoded();
      clearNotamCockpit();
      const airport = findAirportData(icao);
      if (airport) {
        nameValue.textContent = `${airport.name} (${airport.icao_code})`;
        currentMagneticVariation = airport.magnetic_variation_deg;
        displayPlatformInfo(airport);
        const nearby = findNearby(airport.latitude_deg, airport.longitude_deg, LOCATION_ENTRY_RADIUS_KM);
        displayNearbyAirports(nearby, nearbyAirports);
        if (nearby.length > 0) {
          nearbySummary.textContent = `Trouvé ${nearby.length} terrains dans un rayon de ${LOCATION_ENTRY_RADIUS_KM} km.`;
          nearbySummary.hidden = false;
        } else {
          nearbySummary.hidden = true;
        }
      } else {
        nameValue.textContent = icao;
        currentMagneticVariation = 0;
        resetPlatformBlock();
      }
      try {
        const [metarData, tafData, notamData] = await Promise.all([getMetar(icao), getTaf(icao), getNotams(icao)]);
        if (metarData.error || !metarData.data || metarData.data.length === 0) {
          handleWeatherFallback(icao);
        } else {
          parseMetar(metarData.data[0], currentMagneticVariation);
        }
        if (tafData.error || !tafData.data || tafData.data.length === 0) {
          tafOutput.textContent = "Aucun TAF officiel pour ce terrain.";
          tafSummaryValue.textContent = "Données indisponibles";
        } else {
          parseTaf(tafData.data[0], currentMagneticVariation);
        }
        if (notamData && notamData.length > 0) {
          currentNotamData = notamData;
          renderNotamCockpit(notamData);
        } else {
          notamStatusText.textContent = "Aucun NOTAM trouvé pour ce terrain.";
        }
      } catch (error) {
        console.error("Error fetching weather data:", error);
        statusValue.textContent = "Erreur de connexion";
        metarOutput.textContent = "Impossible de charger les données météo.";
        tafOutput.textContent = "Impossible de charger les prévisions.";
        notamStatusText.textContent = "Impossible de charger les NOTAM.";
      }
    }
    
    async function handleWeatherFallback(icao) {
      statusValue.textContent = "Pas de METAR direct, recherche...";
      const airport = findAirportData(icao);
      if (airport && airport.latitude_deg && airport.longitude_deg) {
        const nearby = findNearby(airport.latitude_deg, airport.longitude_deg, WEATHER_REFERENCE_MAX_KM);
        for (const near of nearby) {
          try {
            const metarData = await getMetar(near.icao_code);
            if (!metarData.error && metarData.data && metarData.data.length > 0) {
              parseMetar(metarData.data[0], currentMagneticVariation);
              statusValue.textContent = `METAR de ${near.icao_code} (${Math.round(near.distance)} km)`;
              return;
            }
          } catch (e) {
            continue;
          }
        }
      }
      statusValue.textContent = "Aucune station météo à proximité";
    }
    
    function debounce(func, delay) {
      let timeout;
      return function(...args) {
        const context = this;
        clearTimeout(timeout);
        timeout = setTimeout(() => func.apply(context, args), delay);
      };
    }
    
    function searchTerrainEntries(query) {
      if (!searchIndex || query.length < 2) {
        searchSuggestions.hidden = true;
        return;
      }
      const results = searchIndex.filter(a => a.name.toLowerCase().includes(query.toLowerCase()) || (a.icao_code && a.icao_code.toLowerCase().includes(query.toLowerCase())) || (a.municipality && a.municipality.toLowerCase().includes(query.toLowerCase()))).slice(0, 5);
      searchSuggestions.innerHTML = "";
      if (results.length > 0) {
        results.forEach(res => {
          const li = document.createElement("li");
          li.className = "tool-search-suggestion";
          li.setAttribute('role', 'option');
          li.innerHTML = `<strong>${res.name}</strong> (${res.icao_code || res.ident}) - ${res.municipality || res.iso_country}`;
          li.addEventListener("click", () => {
            icaoInput.value = res.icao_code || res.ident;
            searchSuggestions.hidden = true;
            submitSearch();
          });
          searchSuggestions.appendChild(li);
        });
        searchSuggestions.hidden = false;
      } else {
        searchSuggestions.hidden = true;
      }
    }
    
    function findAirportData(icao) {
      if (!searchIndex) return null;
      const upperIcao = icao.toUpperCase();
      let airport = searchIndex.find(a => a.icao_code === upperIcao || a.ident === upperIcao);
      if (!airport) {
        const ulm = ulmDetailsCache.find(u => u.ident === upperIcao);
        if (ulm) {
          airport = { ...ulm,
            icao_code: ulm.ident,
            source: 'ulm'
          };
        }
      }
      return airport;
    }
    
    function formatFrequency(freq) {
      return (parseInt(freq) / 1000).toFixed(3);
    }
    
    function displayPlatformInfo(airport) {
      resetPlatformBlock();
      platformBlock.hidden = false;
      let sourceText = "Base de données mondiale";
      if (airport.source === "fr") {
        sourceText = "Données SIA";
      } else if (airport.source === "ulm") {
        sourceText = "Données BASULM";
      }
      platformSourceValue.textContent = sourceText;
      let typeText = airport.type ? airport.type.replace(/_/g, ' ') : "Non spécifié";
      if (airport.access) {
        typeText += ` (${airport.access})`;
      }
      platformTypeValue.textContent = typeText;
      if (airport.runways && airport.runways.length > 0) {
        platformRunwaysValue.textContent = airport.runways.map(r => `${r.le_ident}/${r.he_ident} - ${r.length_ft} ft - ${r.surface}`).join(" | ");
        if (currentWindDirection) {
          renderRunwayWindVisual(airport.runways, currentWindDirection, decodeWind(windValue.textContent).speed);
        }
      } else {
        platformRunwaysValue.textContent = "Aucune piste répertoriée.";
      }
      let contactHtml = "";
      if (airport.home_link) contactHtml += `<a href="${airport.home_link}" target="_blank" rel="noopener noreferrer">Site web</a>`;
      if (airport.wikipedia_link) contactHtml += `${contactHtml ? ' | ' : ''}<a href="${airport.wikipedia_link}" target="_blank" rel="noopener noreferrer">Wikipédia</a>`;
      platformContactValue.innerHTML = contactHtml || "Aucun contact disponible.";
      displayRadioInfo(airport.icao_code);
      if (HOSTED_VAC_CODES.has(airport.icao_code)) {
        platformVacBtn.hidden = false;
        platformVacBtn.onclick = () => window.open(`${SIA_VAC_AD_BASE_URL}${airport.icao_code}.pdf`, '_blank');
        platformDocsPanel.hidden = false;
      }
      if (HOSTED_AIP_AD_CODES.has(airport.icao_code)) {
        platformAipBtn.hidden = false;
        platformAipBtn.onclick = () => window.open(`${SIA_AIP_AD_BASE_URL}AD-2.${airport.icao_code}.pdf`, '_blank');
        platformDocsPanel.hidden = false;
      }
    }
    
    function displayRadioInfo(icao) {
      radioValue.textContent = "N/A";
      radioTypeValue.textContent = "Radio";
      radioLabelValue.textContent = "";
      radioSourceValue.textContent = "";
      radioSupportBlock.hidden = true;
      radioAtisCard.hidden = true;
      radioPhoneCard.hidden = true;
      radioSecondaryBlock.hidden = true;
      radioList.innerHTML = "";
      if (!frequenciesCache) return;
      const freqData = frequenciesCache.find(f => f.icao_code === icao);
      if (!freqData) return;
      const primaryFreq = freqData.frequencies.find(f => ["A/A", "AFIS", "TWR"].includes(f.type)) || freqData.frequencies[0];
      if (primaryFreq) {
        radioValue.textContent = formatFrequency(primaryFreq.frequency_mhz * 1000);
        radioTypeValue.textContent = primaryFreq.type;
        radioLabelValue.textContent = primaryFreq.name;
        radioSourceValue.textContent = freqData.source;
      }
      const atisFreq = freqData.frequencies.find(f => f.type === "ATIS");
      if (atisFreq) {
        radioAtisValue.textContent = formatFrequency(atisFreq.frequency_mhz * 1000);
        radioAtisLabel.textContent = atisFreq.name;
        radioAtisSourceValue.textContent = freqData.source;
        radioAtisCard.hidden = false;
        radioSupportBlock.hidden = false;
      }
      const phoneContact = freqData.contacts ? freqData.contacts.find(c => c.type === "A/A" || c.type === "Tél") : null;
      if (phoneContact) {
        radioPhoneValue.textContent = phoneContact.number;
        radioPhoneLabel.textContent = phoneContact.name;
        radioPhoneSourceValue.textContent = freqData.source;
        radioPhoneCard.hidden = false;
        radioSupportBlock.hidden = false;
      }
      const otherFreqs = freqData.frequencies.filter(f => f !== primaryFreq && f !== atisFreq);
      if (otherFreqs.length > 0) {
        radioList.innerHTML = otherFreqs.map(f => `<li class="radio-list-item"><strong>${f.type}</strong><span>${formatFrequency(f.frequency_mhz * 1000)}</span><span>${f.name}</span></li>`).join("");
        radioSecondaryCount.textContent = otherFreqs.length;
        radioSecondaryBlock.hidden = false;
      }
    }
    
    function classifyNotam(notam) {
      const text = notam.all.toUpperCase();
      if (text.includes("TWY") || text.includes("TAXIWAY")) return "circ";
      if (text.includes("RWY") || text.includes("PISTE")) return "piste";
      if (text.includes("AD AP") || text.includes("AERODROME")) return "ad";
      if (text.includes("FREQ") || text.includes("ATIS") || text.includes("TWR")) return "com";
      if (text.includes("ILS") || text.includes("VOR") || text.includes("NDB") || text.includes("PAPI")) return "nav";
      if (text.includes("OBST") || text.includes("CRANE") || text.includes("GRUE")) return "obst";
      if (text.includes("DANGER") || text.includes("PROHIBITED") || text.includes("RESTRICTED")) return "espace";
      return "autre";
    }
    
    function getNotamTitle(notam) {
      const qcodeMatch = notam.all.match(/Q=([A-Z\/ ]+)/);
      if (!qcodeMatch) return "Information générale";
      const qcodeParts = qcodeMatch[1].split('/');
      const qline = qcodeParts[0].trim();
      const subject = qline.substring(2, 4);
      const condition = qline.substring(4, 5);
      const subjectMap = {
        FA: "Aérodrome",
        FC: "Communication",
        FF: "Lutte incendie",
        FL: "L balisage",
        FP: "Départ",
        FT: "Zone terminale",
        LA: "Lumières",
        LC: "Circulation",
        SA: "Infos",
        AP: "Avitaillement",
        XX: "Autre"
      };
      const conditionMap = {
        C: "fermé",
        U: "inutilisable",
        W: "travaux",
        A: "activé",
        O: "obstrué",
        S: "hors service"
      };
      return `${subjectMap[subject] || 'NOTAM'} ${conditionMap[condition] || ''}`.trim();
    }
    
    function renderNotamCockpit(notams) {
      clearNotamCockpit();
      if (!notams || notams.length === 0) {
        notamStatusText.textContent = "Aucun NOTAM trouvé.";
        return;
      }
      const sortedNotams = notams.sort((a, b) => (b.isImportant ? 1 : 0) - (a.isImportant ? 1 : 0) || new Date(b.startDate) - new Date(a.startDate));
      const importantCount = sortedNotams.filter(n => n.isImportant).length;
      notamActiveCount.textContent = `${sortedNotams.length} actif(s)`;
      if (importantCount > 0) {
        notamImportantCount.textContent = `${importantCount} important(s)`;
        notamImportantCount.hidden = false;
      }
      notamStatusText.textContent = "Briefing réglementaire pour le terrain.";
      const visibleNotams = sortedNotams.slice(0, 4);
      visibleNotams.forEach(notam => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `notam-cockpit-item notam-cockpit-item--${classifyNotam(notam)}`;
        if (notam.isImportant) {
          btn.classList.add('notam-cockpit-item--important');
        }
        btn.dataset.notamId = notam.id;
        const from = new Date(notam.startDate).toLocaleDateString('fr-FR', {
          day: '2-digit',
          month: '2-digit'
        });
        const to = notam.until ? new Date(notam.until).toLocaleDateString('fr-FR', {
          day: '2-digit',
          month: '2-digit'
        }) : 'PERM';
        btn.innerHTML = `<span class="notam-item-title">${getNotamTitle(notam)}</span><span class="notam-item-meta">${from} → ${to}</span>`;
        notamCockpitGrid.appendChild(btn);
      });
      if (sortedNotams.length > 4) {
        notamAllBtn.textContent = `Afficher les ${sortedNotams.length - 4} autres NOTAM`;
        notamAllBtn.hidden = false;
      }
    }
    
    function showAllNotams() {
      notamCockpitGrid.innerHTML = "";
      currentNotamData.forEach(notam => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `notam-cockpit-item notam-cockpit-item--${classifyNotam(notam)}`;
        if (notam.isImportant) {
          btn.classList.add('notam-cockpit-item--important');
        }
        btn.dataset.notamId = notam.id;
        const from = new Date(notam.startDate).toLocaleDateString('fr-FR', {
          day: '2-digit',
          month: '2-digit'
        });
        const to = notam.until ? new Date(notam.until).toLocaleDateString('fr-FR', {
          day: '2-digit',
          month: '2-digit'
        }) : 'PERM';
        btn.innerHTML = `<span class="notam-item-title">${getNotamTitle(notam)}</span><span class="notam-item-meta">${from} → ${to}</span>`;
        notamCockpitGrid.appendChild(btn);
      });
      notamAllBtn.hidden = true;
    }
    
    function displayNotamDetail(notamId) {
      const notam = currentNotamData.find(n => n.id === notamId);
      if (!notam) return;
      notamDetailDock.innerHTML = `
        <div class="notam-detail-card">
          <div class="notam-detail-head">
            <h3>${getNotamTitle(notam)}</h3>
            <button id="closeNotamDetailBtn" class="notam-detail-close" aria-label="Fermer le détail">&times;</button>
          </div>
          <pre class="notam-detail-text">${notam.all}</pre>
        </div>
      `;
      document.getElementById('closeNotamDetailBtn').addEventListener('click', () => {
        notamDetailDock.innerHTML = "";
      });
    }
    
    function initNotamCockpitInteractions() {
      notamCockpitGrid.addEventListener('click', e => {
        const target = e.target.closest('.notam-cockpit-item');
        if (target && target.dataset.notamId) {
          displayNotamDetail(target.dataset.notamId);
        }
      });
      notamAllBtn.addEventListener('click', showAllNotams);
    }
    
    document.addEventListener("DOMContentLoaded", async () => {
      await initData();
      if (icaoInput.value) {
          submitSearch();
      }
      icaoInput.addEventListener("keyup", debounce(e => {
        if (e.key === 'Enter') {
          searchSuggestions.hidden = true;
          submitSearch();
        } else {
          searchTerrainEntries(e.target.value);
        }
      }, 300));
      document.addEventListener("click", e => {
        if (!e.target.closest('.tool-search-col')) {
          searchSuggestions.hidden = true;
        }
      });
      loadMetarBtn.addEventListener("click", submitSearch);
      locateBtn.addEventListener("click", () => {
        navigator.geolocation.getCurrentPosition(async pos => {
          const {
            latitude,
            longitude
          } = pos.coords;
          const nearby = findNearby(latitude, longitude, 5);
          if (nearby.length > 0) {
            icaoInput.value = nearby[0].icao_code;
            submitSearch();
          } else {
            searchFeedback.textContent = "Aucun terrain à proximité.";
            searchFeedback.hidden = false;
          }
        }, err => {
          console.warn(`ERROR(${err.code}): ${err.message}`);
          searchFeedback.textContent = "La géolocalisation a échoué.";
          searchFeedback.hidden = false;
        });
      });
      nearbyBtn.addEventListener("click", () => {
        const isExpanded = nearbyBtn.getAttribute("aria-expanded") === "true";
        nearbyBtn.setAttribute("aria-expanded", !isExpanded);
        nearbyPanel.hidden = isExpanded;
      });
      initNotamCockpitInteractions();
    });
  </script>


---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Outils pilote" description="Météo aviation, METAR, TAF et aérodromes à proximité.">

<section class="container" style="padding: 20px 0;">
  <div class="card">
    <div class="pad">

      <h1>Outils pilote</h1>

      <!-- INPUT OACI -->
      <div class="tool-block">
        <label>Code OACI</label>
        <div class="row">
          <input id="icaoInput" placeholder="Ex : LFPN" />
          <button onclick="loadMetar()">Voir METAR / TAF</button>
        </div>
      </div>

      <!-- RESULT METAR -->
      <div class="tool-block">
        <h2>METAR / TAF</h2>
        <pre id="metarOutput">Aucune donnée</pre>
      </div>

      <!-- AERODROMES PROCHES -->
      <div class="tool-block">
        <h2>Aérodromes à proximité</h2>
        <button onclick="getLocation()">Autour de moi</button>
        <ul id="nearbyAirports"></ul>
      </div>

    </div>
  </div>
</section>

<script>
async function loadMetar() {
  const icao = document.getElementById("icaoInput").value.trim().toUpperCase();
  const output = document.getElementById("metarOutput");

  if (!icao) {
    output.textContent = "Entre un code OACI.";
    return;
  }

  try {
    const res = await fetch(
      "https://aviationweather.gov/api/data/metar?ids=" + icao + "&format=raw"
    );
    const data = await res.text();

    if (!data) {
      output.textContent = "Aucune donnée trouvée.";
      return;
    }

    output.textContent = data;

  } catch (e) {
    output.textContent = "Erreur lors de la récupération.";
  }
}

function getLocation() {
  const list = document.getElementById("nearbyAirports");

  if (!navigator.geolocation) {
    list.innerHTML = "<li>Géolocalisation non supportée</li>";
    return;
  }

  navigator.geolocation.getCurrentPosition(async (pos) => {
    const lat = pos.coords.latitude;
    const lon = pos.coords.longitude;

    // Simulation simple pour l’instant
    list.innerHTML = `
      <li>Position : ${lat.toFixed(2)}, ${lon.toFixed(2)}</li>
      <li>(Étape suivante : vraie base aérodromes)</li>
    `;
  });
}
</script>

<style>
.tool-block {
  margin-top: 20px;
}

.tool-block input {
  padding: 10px;
  border-radius: 8px;
  border: 1px solid rgba(255,255,255,0.1);
  background: rgba(255,255,255,0.05);
  color: white;
}

.tool-block button {
  padding: 10px 14px;
  border-radius: 8px;
  background: var(--accent);
  border: none;
  color: white;
  cursor: pointer;
}

pre {
  background: rgba(0,0,0,0.4);
  padding: 10px;
  border-radius: 8px;
  overflow-x: auto;
}
</style>

</BaseLayout>

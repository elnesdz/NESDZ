---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import ModelCard from "../components/ModelCard.astro";
import { getCollection } from "astro:content";
import { FEATURED_TAG_KEYS, MODEL_TAGS, getTagByKey } from "../lib/tags";

const allArticles = (await getCollection("articles"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => {
    const dateA = a.data.updated ?? a.data.date;
    const dateB = b.data.updated ?? b.data.date;
    return dateB.valueOf() - dateA.valueOf();
  });

const featured = allArticles.find((a) => a.data.featured) ?? allArticles[0];
const latest = allArticles.slice(0, 5);

const allModels = await getCollection("models");

const editorialStatusPriority = {
  enrichie: 0,
  "en-cours": 1,
  "a-completer": 2,
};

const models = [...allModels]
  .sort((a, b) => {
    const priorityA = editorialStatusPriority[a.data.editorialStatus] ?? 99;
    const priorityB = editorialStatusPriority[b.data.editorialStatus] ?? 99;

    return (
      priorityA - priorityB ||
      a.data.name.localeCompare(b.data.name, "fr", { sensitivity: "base" })
    );
  })
  .slice(0, 4);

function slugify(input) {
  return String(input)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

// Tags existants (pour éviter les liens morts)
const tagSlugs = new Set();
for (const a of allArticles) {
  for (const t of a.data.tags ?? []) tagSlugs.add(slugify(t));
}
for (const m of allModels) {
  for (const t of m.data.tags ?? []) tagSlugs.add(slugify(t));
}

const featuredCategorySlug = featured ? slugify(featured.data.category) : "";
const featuredCategoryIsTag = featuredCategorySlug ? tagSlugs.has(featuredCategorySlug) : false;

const securiteSlug = slugify("Sécurité");
const securiteIsTag = tagSlugs.has(securiteSlug);

// Thèmes Home → Journal
const homeJournalThemes = FEATURED_TAG_KEYS
  .map((key) => {
    const tag = getTagByKey(key);
    if (!tag) return null;

    const count = allArticles.filter((article) =>
      (article.data.tags ?? []).some((t) => slugify(t) === key)
    ).length;

    if (count === 0) return null;

    return {
      key,
      label: tag.label,
      count,
    };
  })
  .filter(Boolean)
  .slice(0, 6);

// Thèmes Home → Modèles
const homeModelThemes = MODEL_TAGS
  .map((tag) => {
    const count = allModels.filter((model) =>
      (model.data.tags ?? []).some((t) => slugify(t) === tag.key)
    ).length;

    if (count === 0) return null;

    return {
      key: tag.key,
      label: tag.label,
      count,
    };
  })
  .filter(Boolean)
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, "fr", { sensitivity: "base" }))
  .slice(0, 6);
---
<style>
  .home-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .home-hero-grid {
      grid-template-columns: minmax(0, 1.7fr) minmax(320px, 0.9fr);
    }
  }
</style>
<BaseLayout
  title="Accueil"
  description="NESDZ : édito, articles et annuaire des ULM (fiches techniques + vidéos)."
  <section class="hero">
    <div class="container home-hero-grid">
      <article class="card hero-card">
        <div class="meta">
          <a class="pill" href="/journal/">Journal</a>
          <a class="pill" href="/modeles/">Annuaire ULM</a>
          <span class="pill">Vidéos</span>

          {securiteIsTag ? (
            <a class="pill" href={`/tags/${securiteSlug}/`}>Sécurité</a>
          ) : (
            <span class="pill">Sécurité</span>
          )}
        </div>

        <h1>ULM & ultra-léger : le journal qui vole au ras des nuages.</h1>

        <p class="lead">
          NESDZ est un carnet de vol collectif : édito, articles et fiches modèles,
          pour apprendre, comparer, rêver… et garder la tête froide quand le vent se lève.
        </p>

        <div class="actions">
          <a class="btn" href="/journal/">Lire le journal</a>
          <a class="btn" href="/modeles/">Explorer l’annuaire</a>
        </div>

        <hr class="sep" />

        {featured && (
          <div>
            <div class="row" style="justify-content:space-between;align-items:center;flex-wrap:wrap;">
              <div class="row" style="gap:10px;flex-wrap:wrap;">
                <span class="badge">À la une</span>

                {featuredCategoryIsTag ? (
                  <a class="pill" href={`/tags/${featuredCategorySlug}/`}>{featured.data.category}</a>
                ) : (
                  <span class="pill">{featured.data.category}</span>
                )}
              </div>

              <span class="pill">{featured.data.date.toLocaleDateString("fr-FR")}</span>
            </div>

            {featured.data.image && (
              <img
                src={featured.data.image}
                alt={featured.data.title}
                class="hero-cover"
              />
            )}

            <h2 style="margin-top:10px;">{featured.data.title}</h2>
            <p>{featured.data.description}</p>
            <a class="btn" href={`/journal/${featured.slug}/`}>Ouvrir l’article</a>
          </div>
        )}
      </article>

      <aside class="hero-aside">
        <div class="card">
          <div class="pad">
            <div class="row" style="justify-content:space-between;align-items:center;">
              <h2 style="margin:0;">Derniers articles</h2>
              <span class="pill">5</span>
            </div>

<ul class="mt-4 space-y-6">
  {latest.map((article) => {
    const displayDate = article.data.updated ?? article.data.date;
    const isUpdated = Boolean(article.data.updated);

    return (
      <li>
        <a
          href={`/journal/${article.slug}/`}
          class="group block"
        >
          <div class="mb-1 text-xs text-neutral-500">
            {isUpdated && (
              <span class="mr-2 text-cyan-400">Mis à jour</span>
            )}
            <time datetime={new Date(displayDate).toISOString()}>
              {new Date(displayDate).toLocaleDateString("fr-FR", {
                day: "numeric",
                month: "short",
                year: "numeric",
              })}
            </time>
          </div>

          <h3 class="text-base font-semibold leading-snug text-white transition group-hover:text-cyan-300">
            {article.data.title}
          </h3>

          {article.data.description && (
            <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-neutral-400">
              {article.data.description}
            </p>
          )}
        </a>
      </li>
    );
  })}
</ul>
          </div>
        </div>

        <div class="card">
          <div class="pad">
            <div class="row" style="justify-content:space-between;align-items:center;">
              <h2 style="margin:0;">Modèles en vedette</h2>
              <span class="pill">{models.length}</span>
            </div>

            <div class="list" style="margin-top:12px;">
              {models.map((m) => (
                <ModelCard
                  href={`/modeles/${m.slug}/`}
                  name={m.data.name}
                  manufacturer={m.data.manufacturer}
                  category={m.data.category}
                  seats={m.data.seats}
                  engine={m.data.engine}
                  cruiseKmh={m.data.cruiseKmh}
                  tags={m.data.tags}
                  editorialStatus={m.data.editorialStatus}
                />
              ))}
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {(homeJournalThemes.length > 0 || homeModelThemes.length > 0) && (
    <section class="container" style="padding: 8px 0 18px;">
      <div class="card">
        <div class="pad">
          <div class="row" style="justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
            <h2 style="margin:0;">Explorer par thèmes</h2>
            <span class="pill">{homeJournalThemes.length + homeModelThemes.length} entrées</span>
          </div>

          <p style="margin:8px 0 0; color:var(--muted);">
            Une porte d’entrée rapide vers les grands sujets du journal et les profils de machines de l’annuaire.
          </p>

          <div class="grid grid-2" style="margin-top:14px;gap:14px;">
            <div class="card" style="box-shadow:none;">
              <div class="pad">
                <div class="row" style="justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
                  <h3 style="margin:0;">Journal</h3>
                  <span class="pill">{homeJournalThemes.length}</span>
                </div>

                <p style="margin:8px 0 0; color:var(--muted);">
                  Pilotage, sécurité, météo, navigation, essai, comparatif…
                </p>

                <div class="row" style="gap:10px;flex-wrap:wrap;margin-top:12px;">
                  {homeJournalThemes.map((tag) => (
                    <a
                      class="pill"
                      href={`/tags/${tag.key}/`}
                      title={`Voir le tag ${tag.label}`}
                      style="text-decoration:none;"
                    >
                      {tag.label} · {tag.count}
                    </a>
                  ))}
                </div>
              </div>
            </div>

            <div class="card" style="box-shadow:none;">
              <div class="pad">
                <div class="row" style="justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
                  <h3 style="margin:0;">Modèles ULM</h3>
                  <span class="pill">{homeModelThemes.length}</span>
                </div>

                <p style="margin:8px 0 0; color:var(--muted);">
                  Voyage, école, STOL, polyvalence, matériaux et profils d’usage.
                </p>

                <div class="row" style="gap:10px;flex-wrap:wrap;margin-top:12px;">
                  {homeModelThemes.map((tag) => (
                    <a
                      class="pill"
                      href={`/tags/${tag.key}/`}
                      title={`Voir le tag ${tag.label}`}
                      style="text-decoration:none;"
                    >
                      {tag.label} · {tag.count}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="container" style="padding: 8px 0 26px;">
    <div class="card">
      <div class="pad">
        <h2>La promesse NESDZ</h2>

        <div class="grid grid-3" style="margin-top:12px;">
          <div class="card" style="box-shadow:none;">
            <div class="pad">
              <h3>Clarté</h3>
              <p>
                Des fiches techniques lisibles, des articles structurés, des sources quand c’est nécessaire.
              </p>
            </div>
          </div>

          <div class="card" style="box-shadow:none;">
            <div class="pad">
              <h3>Sécurité</h3>
              <p>
                Le style, c’est bien. Les marges, c’est mieux. On garde toujours un œil sur les bonnes pratiques.
              </p>
            </div>
          </div>

          <div class="card" style="box-shadow:none;">
            <div class="pad">
              <h3>Plaisir</h3>
              <p>
                Parce que l’ULM est une école de liberté — et une excuse légale pour parler météo au café.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

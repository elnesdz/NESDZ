---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import { ARTICLE_TAGS } from "../../lib/tags";

const slugify = (input) =>
  String(input)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const articles = (await getCollection("articles"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => {
    const dateA = a.data.updated ?? a.data.date;
    const dateB = b.data.updated ?? b.data.date;
    return dateB.valueOf() - dateA.valueOf();
  });

const categories = Array.from(new Set(articles.map((a) => a.data.category))).sort();
const DEFAULT_ARTICLE_IMAGE = "/logo.png";

const explorerTags = ARTICLE_TAGS
  .map((tag) => {
    const count = articles.filter((article) =>
      (article.data.tags ?? []).some((t) => slugify(t) === tag.key)
    ).length;

    return {
      ...tag,
      count,
    };
  })
  .filter((tag) => tag.count > 0)
  .sort(
    (a, b) =>
      Number(Boolean(b.featured)) - Number(Boolean(a.featured)) ||
      b.count - a.count ||
      a.label.localeCompare(b.label, "fr", { sensitivity: "base" })
  );
---

<BaseLayout title="Journal" description="Articles ULM : essais, sécurité, réglementation, voyages, technique.">
  <section class="container" style="padding: 28px 0 10px;">
    <div class="row" style="justify-content:space-between;align-items:flex-end;flex-wrap:wrap;">
      <div>
        <h1 style="margin:0 0 8px;">Journal</h1>
        <p class="lead">Des articles pour voler plus fin, rêver plus loin, et éviter les “tiens, bizarre…” en approche.</p>
      </div>
      <div class="row" style="gap:8px;flex-wrap:wrap;">
        {categories.map((c) => <span class="pill">{c}</span>)}
      </div>
    </div>
  </section>

  <section class="container" style="padding: 10px 0 14px;">
    <div class="card">
      <div class="pad">
        <div class="list">
          {articles.map((a) => (
            <ArticleCard
              href={`/journal/${a.slug}/`}
              title={a.data.title}
              description={a.data.description}
              date={a.data.date}
              updated={a.data.updated}
              category={a.data.category}
              tags={a.data.tags}
              image={a.data.image ?? DEFAULT_ARTICLE_IMAGE}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  {explorerTags.length > 0 && (
    <section class="container" style="padding: 6px 0 26px;">
      <div class="card">
        <div class="pad">
          <div class="row" style="justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
            <h2 style="margin:0;">Explorer par tags</h2>
            <span class="pill">{explorerTags.length} tags</span>
          </div>

          <p style="margin:8px 0 0; color:var(--muted);">
            Navigue dans le journal par thèmes de vol, sécurité, technique, navigation ou retour d’expérience.
          </p>

          <div class="row" style="gap:10px;flex-wrap:wrap;margin-top:14px;">
            {explorerTags.map((tag) => (
              <a
                class="pill"
                href={`/tags/${tag.key}/`}
                title={`Voir le tag ${tag.label}`}
                style="text-decoration:none;"
              >
                {tag.label} · {tag.count}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ModelCard from "../../components/ModelCard.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = (await getCollection("articles")).filter((a) => !a.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const d = entry.data.date.toLocaleDateString("fr-FR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const updated = entry.data.updated
  ? entry.data.updated.toLocaleDateString("fr-FR", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;

const slugify = (input) =>
  String(input)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

// Fallback author (certains articles n'ont pas le champ)
const authorName = entry.data.author ?? "NESDZ";

// URL absolue du site (stable, comme sitemap/robots)
const SITE = "https://nesdz.com";
const canonicalUrl = `${SITE}/journal/${entry.slug}/`;

// --- Modèles liés (tags article ↔ tags modèles)
const models = await getCollection("models");
const articleTagSlugs = new Set(
  (entry.data.tags ?? []).map((t) => slugify(t)).filter(Boolean)
);

const relatedModels = models
  .map((m) => {
    const modelTagSlugs = (m.data.tags ?? []).map((t) => slugify(t)).filter(Boolean);
    const score = modelTagSlugs.filter((s) => articleTagSlugs.has(s)).length;
    return { m, score };
  })
  .filter((x) => x.score > 0)
  .sort(
    (a, b) =>
      b.score - a.score ||
      a.m.data.name.localeCompare(b.m.data.name, "fr", { sensitivity: "base" })
  )
  .slice(0, 4)
  .map((x) => x.m);

// --- Précédent / Suivant (tri updated ?? date)
const articlesAll = (await getCollection("articles"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => {
    const dateA = a.data.updated ?? a.data.date;
    const dateB = b.data.updated ?? b.data.date;
    return dateB.valueOf() - dateA.valueOf();
  });

const currentIndex = articlesAll.findIndex((a) => a.slug === entry.slug);

const prevArticle = currentIndex > 0 ? articlesAll[currentIndex - 1] : null;
const nextArticle =
  currentIndex >= 0 && currentIndex < articlesAll.length - 1
    ? articlesAll[currentIndex + 1]
    : null;

// --- JSON-LD Article (SEO)
const imageAbs = entry.data.image ? new URL(entry.data.image, SITE).href : null;

const jsonLd: any = {
  "@context": "https://schema.org",
  "@type": "Article",
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: new Date(entry.data.date).toISOString(),
  author: {
    "@type": "Person",
    name: authorName,
  },
  publisher: {
    "@type": "Organization",
    name: "NESDZ",
    logo: {
      "@type": "ImageObject",
      url: `${SITE}/logo.png`,
    },
  },
};

if (entry.data.updated) {
  jsonLd.dateModified = new Date(entry.data.updated).toISOString();
}

if (imageAbs) {
  jsonLd.image = [imageAbs];
}

// --- JSON-LD BreadcrumbList (SEO)
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Accueil",
      item: `${SITE}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Journal",
      item: `${SITE}/journal/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: entry.data.title,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  canonical={canonicalUrl}
>
  <article class="container" style="padding: 28px 0 26px;">
    <div class="card">
      <div class="pad">
        <!-- JSON-LD (SEO) -->
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbJsonLd)}
        ></script>

        <!-- Fil d'Ariane (Option A) -->
        <nav class="meta" aria-label="Fil d’Ariane" style="margin:0 0 10px; flex-wrap:wrap;">
          <a href="/" style="color:inherit;text-decoration:none;opacity:.9;">Accueil</a>
          <span class="sep" style="opacity:.7;">›</span>
          <a href="/journal/" style="color:inherit;text-decoration:none;opacity:.9;">Journal</a>
          <span class="sep" style="opacity:.7;">›</span>
          <span style="opacity:.85;">{entry.data.title}</span>
        </nav>

        <div class="row" style="justify-content:space-between;flex-wrap:wrap;">
          <div class="row" style="gap:10px;flex-wrap:wrap;">
            <span class="badge">{entry.data.category}</span>

            {(entry.data.tags ?? []).map((t) => (
              <a class="pill" href={"/tags/" + slugify(t) + "/"} title={"Tag : " + t}>
                {t}
              </a>
            ))}
          </div>

          <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <span class="pill">{d}</span>
            {updated && <span class="pill">Mis à jour : {updated}</span>}
          </div>
        </div>

        <h1 style="margin-top:14px;">{entry.data.title}</h1>
        <p class="lead" style="margin-top:6px;">{entry.data.description}</p>

        <div class="meta">
          <span>Publié le {new Date(entry.data.date).toLocaleDateString("fr-FR")}</span>
          {entry.data.updated && <span class="sep">•</span>}
          {entry.data.updated && (
            <span>Mis à jour le {new Date(entry.data.updated).toLocaleDateString("fr-FR")}</span>
          )}
        </div>

        {entry.data.image && (
          <img src={entry.data.image} alt={entry.data.title} class="cover" loading="lazy" />
        )}

        <hr class="sep" />

        <div class="prose">
          <Content />
        </div>

        {relatedModels.length > 0 && (
          <div style="margin-top:18px;">
            <div
              class="row"
              style="justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;"
            >
              <h2 style="margin:0;">Modèles liés</h2>
              <span class="pill">{relatedModels.length}</span>
            </div>

            <p style="margin:8px 0 0; color:var(--muted);">
              Des fiches ULM en lien avec les thèmes de cet article.
            </p>

            <div class="list" style="margin-top:12px;">
              {relatedModels.map((m) => (
                <ModelCard
                  href={`/modeles/${m.slug}/`}
                  name={m.data.name}
                  manufacturer={m.data.manufacturer}
                  category={m.data.category}
                  seats={m.data.seats}
                  engine={m.data.engine}
                  cruiseKmh={m.data.cruiseKmh}
                  tags={m.data.tags}
                />
              ))}
            </div>
          </div>
        )}

{(prevArticle || nextArticle) && (
  <div style="margin-top:22px;">
    <h2 style="margin:0 0 10px;">Continuer la lecture</h2>

    <div class="grid grid-2 article-nav-grid" style="gap:12px;">
      {prevArticle ? (
        <a class="card article-nav-card" href={`/journal/${prevArticle.slug}/`}>
          <div class="pad article-nav-card__pad">
            <div class="pill article-nav-card__kicker">← Précédent</div>
            <div class="t article-nav-card__title">{prevArticle.data.title}</div>
            <div class="s article-nav-card__desc">{prevArticle.data.description}</div>
          </div>
        </a>
      ) : (
        <div></div>
      )}

      {nextArticle ? (
        <a class="card article-nav-card" href={`/journal/${nextArticle.slug}/`}>
          <div class="pad article-nav-card__pad">
            <div class="pill article-nav-card__kicker">Suivant →</div>
            <div class="t article-nav-card__title">{nextArticle.data.title}</div>
            <div class="s article-nav-card__desc">{nextArticle.data.description}</div>
          </div>
        </a>
      ) : (
        <div></div>
      )}
    </div>
  </div>
)}

        <hr class="sep" />

        <div class="row" style="justify-content:space-between;flex-wrap:wrap;">
          <a class="btn" href="/journal/">← Retour au journal</a>
          <span class="pill">Auteur : {authorName}</span>
        </div>
      </div>
    </div>
  </article>
<style>
  .article-nav-grid {
    margin-top: 2px;
  }

  .article-nav-card {
    position: relative;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    transition:
      background-color 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      transform 0.18s ease;
  }

  .article-nav-card:hover,
  .article-nav-card:focus-visible {
    background: rgba(139, 220, 255, 0.05);
    border-color: rgba(139, 220, 255, 0.18);
    box-shadow:
      inset 0 0 0 1px rgba(139, 220, 255, 0.10),
      0 10px 24px rgba(10, 24, 38, 0.14);
    transform: translateY(-1px);
  }

  .article-nav-card__pad {
    min-height: 190px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .article-nav-card__kicker {
    display: inline-flex;
    align-self: flex-start;
    margin-bottom: 12px;
  }

  .article-nav-card__title {
    line-height: 1.4;
    transition: color 0.18s ease;
  }

  .article-nav-card:hover .article-nav-card__title,
  .article-nav-card:focus-visible .article-nav-card__title {
    color: #8bdcff;
  }

  .article-nav-card__desc {
    margin-top: 10px;
    line-height: 1.62;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 720px) {
    .article-nav-card__pad {
      min-height: auto;
    }

    .article-nav-card__desc {
      -webkit-line-clamp: 5;
    }
  }
</style>
</BaseLayout>

---
import "../styles/global.css";

const { title, description, image, canonical } = Astro.props;

const siteTitle = title
  ? `${title} · NESDZ`
  : "NESDZ · Journal ULM & Aviation Ultra-Légère";

const siteDescription =
  description ??
  "Journal et annuaire des modèles d’ULM : édito, articles, fiches techniques et vidéos.";

// Base absolue du site (Astro.site si configuré, sinon origine de l’URL courante)
const base = (Astro.site ? Astro.site.href : Astro.url.origin) as string;

// Canonical : toujours absolu, sans query/hash, et avec / si c’est une “route dossier”
const rawCanonical = canonical ?? Astro.url;
const canonicalURL =
  typeof rawCanonical === "string"
    ? new URL(rawCanonical, base)
    : new URL(rawCanonical.toString());

canonicalURL.search = "";
canonicalURL.hash = "";

// Ajoute un trailing slash si c’est une route “dossier” (pas un fichier .xml/.png/...)
const path = canonicalURL.pathname;
const looksLikeFile = path.includes(".");
if (!looksLikeFile && !path.endsWith("/")) canonicalURL.pathname = `${path}/`;

// OG image : toujours absolue
const ogImagePath =
  typeof image === "string" && image.trim().length > 0 ? image : "/logo.png";
const ogImageUrl = new URL(ogImagePath, base).href;

// OG type : article sur les pages /journal/<slug>/
const pathname = Astro.url.pathname;
const isArticlePage = pathname.startsWith("/journal/") && pathname !== "/journal/";
const ogType = isArticlePage ? "article" : "website";
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="theme-color" content="#0b1118" />

    <link rel="canonical" href={canonicalURL.href} />

    <!-- OpenGraph -->
    <meta property="og:site_name" content="NESDZ" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>

  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href="/" aria-label="Accueil NESDZ">
          <img src="/logo.png" alt="Logo NESDZ" class="logo" />
          <div class="stack brand-text" style="gap:2px">
            <strong>NESDZ</strong>
            <span class="brand-subtitle">
              ULM · Ultra-léger · Passion
            </span>
          </div>
        </a>

        <div class="nav-right">
          <nav class="navlinks" aria-label="Navigation principale">
            <a href="/journal/">Journal</a>
            <a href="/modeles/">Annuaire ULM</a>
            <a href="/edito/">Édito</a>
            <a href="/a-propos/">À propos</a>
          </nav>

<a
  href="/outils/"
  class={`service-cta ${pathname.startsWith("/outils/") || pathname === "/outils" ? "is-active" : ""}`}
  aria-label="Accéder au service météo et terrains"
>
  Météo & terrains
</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="row" style="justify-content:space-between;flex-wrap:wrap;gap:12px;">
          <small>© {new Date().getFullYear()} NESDZ — Journal ULM & Aviation ultra légère.</small>

          <div class="row" style="gap:12px;flex-wrap:wrap;">
            <a href="/tags/" style="font-size:12px;color:var(--muted);text-decoration:none;">Tags</a>
            <small>Construit avec Astro · rapide comme une finale bien tenue.</small>
          </div>
        </div>
      </div>
    </footer>

    <style>
      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand-subtitle {
        font-size: 12px;
        color: var(--muted);
        margin-top: -2px;
      }

      .nav-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 18px;
        flex-wrap: wrap;
      }

      .navlinks {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
      }

      .navlinks a {
        color: rgba(255, 255, 255, 0.86);
        text-decoration: none;
        font-size: 0.98rem;
        line-height: 1.2;
        transition: color 0.18s ease, opacity 0.18s ease;
      }

      .navlinks a:hover {
        color: white;
      }

.service-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 10px 15px;
  border-radius: 999px;
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.01em;
  color: #eef9ff;
  background: linear-gradient(
    180deg,
    rgba(103, 183, 224, 0.16) 0%,
    rgba(103, 183, 224, 0.08) 100%
  );
  border: 1px solid rgba(103, 183, 224, 0.30);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.05),
    0 0 0 1px rgba(103, 183, 224, 0.03);
  white-space: nowrap;
  transition:
    transform 0.18s ease,
    background 0.18s ease,
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    color 0.18s ease;
}

.service-cta:hover,
.service-cta:focus-visible {
  transform: translateY(-1px);
  color: #f7fcff;
  background: linear-gradient(
    180deg,
    rgba(103, 183, 224, 0.22) 0%,
    rgba(103, 183, 224, 0.12) 100%
  );
  border-color: rgba(103, 183, 224, 0.42);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.06),
    0 6px 18px rgba(33, 84, 112, 0.16);
}

.service-cta.is-active {
  color: #ffffff;
  background: linear-gradient(
    180deg,
    rgba(103, 183, 224, 0.30) 0%,
    rgba(103, 183, 224, 0.18) 100%
  );
  border-color: rgba(133, 208, 245, 0.52);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.08),
    0 8px 24px rgba(35, 98, 132, 0.18);
}

.service-cta.is-active:hover,
.service-cta.is-active:focus-visible {
  background: linear-gradient(
    180deg,
    rgba(103, 183, 224, 0.34) 0%,
    rgba(103, 183, 224, 0.22) 100%
  );
  border-color: rgba(133, 208, 245, 0.60);
}

      @media (max-width: 900px) {
        .nav-inner {
          gap: 18px;
        }

        .nav-right {
          gap: 14px;
        }

        .navlinks {
          gap: 14px;
        }
      }

      @media (max-width: 720px) {
        .nav-inner {
          display: flex;
          flex-direction: column;
          align-items: stretch;
          gap: 14px;
        }

        .brand {
          display: flex;
          align-items: center;
          gap: 12px;
        }

        .brand .logo {
          width: 72px;
          height: 72px;
          flex: 0 0 auto;
        }

        .brand-text {
          min-width: 0;
        }

        .brand-text strong {
          font-size: 1.15rem;
          line-height: 1.1;
        }

        .nav-right {
          display: flex;
          flex-direction: column;
          align-items: stretch;
          gap: 12px;
        }

        .navlinks {
          display: flex;
          flex-wrap: wrap;
          gap: 10px 18px;
          justify-content: flex-start;
          align-items: center;
        }

        .navlinks a {
          font-size: 1rem;
          line-height: 1.2;
          white-space: nowrap;
        }

        .service-cta {
          width: 100%;
          min-height: 44px;
        }
      }
    </style>
  </body>
</html>

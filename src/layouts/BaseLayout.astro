---
import "../styles/global.css";

const { title, description, image, canonical } = Astro.props;

const siteTitle = title
  ? `${title} · NESDZ`
  : "NESDZ · Journal ULM & Aviation Ultra-Légère";

const siteDescription =
  description ??
  "Journal et annuaire des modèles d’ULM : édito, articles, fiches techniques et vidéos.";

const base = (Astro.site ? Astro.site.href : Astro.url.origin) as string;

const rawCanonical = canonical ?? Astro.url;
const canonicalURL =
  typeof rawCanonical === "string"
    ? new URL(rawCanonical, base)
    : new URL(rawCanonical.toString());

canonicalURL.search = "";
canonicalURL.hash = "";

const path = canonicalURL.pathname;
const looksLikeFile = path.includes(".");
if (!looksLikeFile && !path.endsWith("/")) canonicalURL.pathname = `${path}/`;

const ogImagePath =
  typeof image === "string" && image.trim().length > 0 ? image : "/logo.png";
const ogImageUrl = new URL(ogImagePath, base).href;

const pathname = Astro.url.pathname;
const isArticlePage = pathname.startsWith("/journal/") && pathname !== "/journal/";
const ogType = isArticlePage ? "article" : "website";
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="theme-color" content="#0b1118" />

    <link rel="canonical" href={canonicalURL.href} />

    <meta property="og:site_name" content="NESDZ" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>

  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href="/" aria-label="Accueil NESDZ">
          <img src="/logo.png" alt="Logo NESDZ" class="logo" />
          <div class="stack brand-text" style="gap:2px">
            <strong>NESDZ</strong>
            <span class="brand-subtitle">ULM · Ultra-léger · Passion</span>
          </div>
        </a>

        <div class="nav-spotlight">
          <a
            href="/outils/"
            class={`service-cta service-cta--spotlight ${pathname.startsWith("/outils/") || pathname === "/outils" ? "is-active" : ""}`}
            aria-label="Accéder au briefing vol"
          >
            Briefing vol
          </a>
        </div>

        <div class="nav-right">
          <nav class="navlinks" aria-label="Navigation principale">
            <a href="/" class={pathname === "/" ? "is-current" : ""}>Accueil</a>
            <a href="/journal/" class={pathname.startsWith("/journal/") || pathname === "/journal" ? "is-current" : ""}>Journal</a>
            <a href="/modeles/" class={pathname.startsWith("/modeles/") || pathname === "/modeles" ? "is-current" : ""}>Annuaire ULM</a>
            <a href="/edito/" class={pathname.startsWith("/edito/") || pathname === "/edito" ? "is-current" : ""}>Édito</a>
            <a href="/a-propos/" class={pathname.startsWith("/a-propos/") || pathname === "/a-propos" ? "is-current" : ""}>À propos</a>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="row" style="justify-content:space-between;flex-wrap:wrap;gap:12px;">
          <small>© {new Date().getFullYear()} NESDZ — Journal ULM & Aviation ultra légère.</small>

          <div class="row" style="gap:12px;flex-wrap:wrap;">
            <a href="/tags/" style="font-size:12px;color:var(--muted);text-decoration:none;">Tags</a>
            <small>Construit avec Astro · rapide comme une finale bien tenue.</small>
          </div>
        </div>
      </div>
    </footer>

    <style>
      .nav-inner {
        display: grid;
        grid-template-columns: auto minmax(260px, 1fr) auto;
        align-items: center;
        gap: 22px;
      }

      .brand-subtitle {
        font-size: 12px;
        color: var(--muted);
        margin-top: -2px;
      }

      .nav-spotlight {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .nav-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
      }

      .navlinks {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .navlinks a {
        color: rgba(255, 255, 255, 0.78);
        text-decoration: none;
        font-size: 0.98rem;
        line-height: 1.2;
        transition: color 0.18s ease, opacity 0.18s ease;
      }

      .navlinks a:hover,
      .navlinks a.is-current {
        color: white;
      }

      .navlinks a.is-current {
        font-weight: 700;
      }

      .service-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 12px 20px;
        border-radius: 999px;
        text-decoration: none;
        font-size: 1rem;
        font-weight: 800;
        line-height: 1;
        letter-spacing: 0.012em;
        color: #ffffff;
        background: linear-gradient(
          180deg,
          rgba(166, 229, 255, 0.72) 0%,
          rgba(103, 183, 224, 0.42) 100%
        );
        border: 1px solid rgba(235, 248, 255, 1);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.20),
          0 0 0 1px rgba(133, 208, 245, 0.18),
          0 16px 38px rgba(40, 110, 145, 0.36),
          0 0 48px rgba(128, 216, 250, 0.20);
        text-shadow: 0 1px 0 rgba(6, 12, 18, 0.32);
        white-space: nowrap;
        transition:
          transform 0.18s ease,
          background 0.18s ease,
          border-color 0.18s ease,
          box-shadow 0.18s ease,
          color 0.18s ease,
          filter 0.18s ease;
      }

      .service-cta--spotlight {
        min-height: 50px;
        padding: 14px 32px;
        min-width: min(340px, 100%);
        font-size: 1.04rem;
        letter-spacing: 0.014em;
      }

      .service-cta:hover,
      .service-cta:focus-visible {
        transform: translateY(-1px);
        color: #ffffff;
        background: linear-gradient(
          180deg,
          rgba(150, 221, 250, 0.62) 0%,
          rgba(97, 174, 220, 0.38) 100%
        );
        border-color: rgba(220, 245, 255, 0.98);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.18),
          0 0 0 1px rgba(103, 183, 224, 0.12),
          0 14px 34px rgba(34, 100, 136, 0.32),
          0 0 44px rgba(117, 212, 252, 0.16);
        filter: saturate(1.04);
      }

      .service-cta.is-active {
        color: #ffffff;
        background: linear-gradient(
          180deg,
          rgba(166, 229, 255, 0.72) 0%,
          rgba(103, 183, 224, 0.42) 100%
        );
        border-color: rgba(235, 248, 255, 1);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.20),
          0 0 0 1px rgba(133, 208, 245, 0.18),
          0 16px 38px rgba(40, 110, 145, 0.36),
          0 0 48px rgba(128, 216, 250, 0.20);
      }

      .service-cta.is-active:hover,
      .service-cta.is-active:focus-visible {
        background: linear-gradient(
          180deg,
          rgba(176, 234, 255, 0.80) 0%,
          rgba(111, 190, 230, 0.48) 100%
        );
        border-color: rgba(245, 252, 255, 1);
      }

      @media (max-width: 1080px) {
        .nav-inner {
          grid-template-columns: auto 1fr;
          grid-template-areas:
            "brand spotlight"
            "nav nav";
          gap: 16px 20px;
        }

        .brand {
          grid-area: brand;
        }

        .nav-spotlight {
          grid-area: spotlight;
          justify-content: flex-end;
        }

        .nav-right {
          grid-area: nav;
          justify-content: center;
        }
      }

      @media (max-width: 720px) {
        .nav-inner {
          display: flex;
          flex-direction: column;
          align-items: stretch;
          gap: 14px;
        }

        .brand {
          display: flex;
          align-items: center;
          gap: 12px;
        }

        .brand .logo {
          width: 72px;
          height: 72px;
          flex: 0 0 auto;
        }

        .brand-text {
          min-width: 0;
        }

        .brand-text strong {
          font-size: 1.15rem;
          line-height: 1.1;
        }

        .nav-spotlight {
          justify-content: center;
        }

        .nav-right {
          display: flex;
          flex-direction: column;
          align-items: stretch;
          gap: 12px;
        }

        .navlinks {
          display: flex;
          flex-wrap: wrap;
          gap: 10px 18px;
          justify-content: flex-start;
          align-items: center;
        }

        .navlinks a {
          font-size: 1rem;
          line-height: 1.2;
          white-space: nowrap;
        }

        .service-cta,
        .service-cta--spotlight {
          width: 100%;
          min-width: 0;
          min-height: 48px;
        }
      }
    </style>
  </body>
</html>

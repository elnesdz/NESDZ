---
import "../styles/global.css";

const { title, description, image, canonical } = Astro.props;

const siteTitle = title
  ? `${title} · NESDZ`
  : "NESDZ · Journal ULM & Aviation Ultra-Légère";

const siteDescription =
  description ??
  "Journal et annuaire des modèles d’ULM : édito, articles, fiches techniques et vidéos.";

const base = (Astro.site ? Astro.site.href : Astro.url.origin) as string;

const rawCanonical = canonical ?? Astro.url;
const canonicalURL =
  typeof rawCanonical === "string"
    ? new URL(rawCanonical, base)
    : new URL(rawCanonical.toString());

canonicalURL.search = "";
canonicalURL.hash = "";

const path = canonicalURL.pathname;
const looksLikeFile = path.includes(".");
if (!looksLikeFile && !path.endsWith("/")) canonicalURL.pathname = `${path}/`;

const ogImagePath =
  typeof image === "string" && image.trim().length > 0 ? image : "/logo.png";
const ogImageUrl = new URL(ogImagePath, base).href;

const pathname = Astro.url.pathname;
const isArticlePage = pathname.startsWith("/journal/") && pathname !== "/journal/";
const ogType = isArticlePage ? "article" : "website";
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="theme-color" content="#0b1118" />

    <link rel="canonical" href={canonicalURL.href} />

    <meta property="og:site_name" content="NESDZ" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>

  <body class="nesdz-premium-ui">
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href="/" aria-label="Accueil NESDZ">
          <img src="/logo.png" alt="Logo NESDZ" class="logo" />
          <div class="stack brand-text" style="gap:2px">
            <strong>NESDZ</strong>
            <span class="brand-subtitle">ULM · Ultra-léger · Passion</span>
          </div>
        </a>

        <div class="nav-spotlight">
          <a
            href="/outils/"
            class={`service-cta service-cta--spotlight ${pathname.startsWith("/outils/") || pathname === "/outils" ? "is-active" : ""}`}
            aria-label="Accéder au briefing vol"
          >
            Briefing vol
          </a>
        </div>

        <div class="nav-right">
          <nav class="navlinks" aria-label="Navigation principale">
            <a href="/" class={pathname === "/" ? "is-current" : ""}>Accueil</a>
            <a href="/journal/" class={pathname.startsWith("/journal/") || pathname === "/journal" ? "is-current" : ""}>Journal</a>
            <a href="/modeles/" class={pathname.startsWith("/modeles/") || pathname === "/modeles" ? "is-current" : ""}>Annuaire ULM</a>
            <a href="/edito/" class={pathname.startsWith("/edito/") || pathname === "/edito" ? "is-current" : ""}>Édito</a>
            <a href="/a-propos/" class={pathname.startsWith("/a-propos/") || pathname === "/a-propos" ? "is-current" : ""}>À propos</a>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="row" style="justify-content:space-between;flex-wrap:wrap;gap:12px;">
          <small>© {new Date().getFullYear()} NESDZ — Journal ULM & Aviation ultra légère.</small>

          <div class="row" style="gap:12px;flex-wrap:wrap;">
            <a href="/tags/" style="font-size:12px;color:var(--muted);text-decoration:none;">Tags</a>
          </div>
        </div>
      </div>
    </footer>

        <style>
      .nav-inner {
        display: grid;
        grid-template-columns: auto minmax(250px, 1fr) auto;
        align-items: center;
        gap: 20px;
      }

      .brand-subtitle {
        font-size: 12px;
        color: rgba(154,169,196,.82);
        margin-top: -2px;
        white-space: nowrap;
      }

      .nav-spotlight {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .nav-spotlight::before {
        content: "";
        position: absolute;
        inset: -12px -22px;
        border-radius: 999px;
        background: radial-gradient(circle, rgba(33,183,255,.16), transparent 72%);
        pointer-events: none;
        filter: blur(10px);
      }

      .nav-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
      }

      .navlinks {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .navlinks a {
        color: rgba(244, 248, 255, 0.78);
        text-decoration: none;
        font-size: 0.92rem;
        line-height: 1.2;
        padding: 8px 10px;
        border-radius: 14px;
        border: 1px solid transparent;
        transition: color 0.18s ease, opacity 0.18s ease, background 0.18s ease, border-color .18s ease;
      }

      .navlinks a:hover,
      .navlinks a.is-current {
        color: white;
        background: rgba(255,255,255,.04);
        border-color: rgba(171,214,255,.08);
      }

      .navlinks a.is-current {
        font-weight: 700;
      }

      .service-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 52px;
        padding: 12px 22px;
        border-radius: 999px;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 800;
        line-height: 1;
        letter-spacing: 0.012em;
        color: #ffffff;
        background: linear-gradient(180deg, rgba(149,222,255,.94) 0%, rgba(52,177,237,.92) 100%);
        border: 1px solid rgba(245,251,255,.92);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.28),
          0 0 0 1px rgba(133, 208, 245, 0.22),
          0 14px 34px rgba(12, 86, 130, 0.30),
          0 0 56px rgba(72, 194, 255, 0.22);
        text-shadow: 0 1px 0 rgba(6, 12, 18, 0.26);
        white-space: nowrap;
        transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, color 0.18s ease, filter 0.18s ease;
      }

      .service-cta--spotlight {
        min-height: 52px;
        padding: 16px 34px;
        min-width: min(316px, 100%);
        font-size: 1.05rem;
        letter-spacing: 0.014em;
      }

      .service-cta:hover,
      .service-cta:focus-visible {
        transform: translateY(-1px);
        color: #ffffff;
        background: linear-gradient(180deg, rgba(169,230,255,.98) 0%, rgba(64,186,245,.96) 100%);
        border-color: rgba(250, 253, 255, 0.98);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.24),
          0 0 0 1px rgba(133, 208, 245, 0.22),
          0 14px 36px rgba(12, 86, 130, 0.32),
          0 0 60px rgba(72, 194, 255, 0.26);
        filter: saturate(1.04);
      }

      .service-cta.is-active {
        color: #ffffff;
      }

      @media (max-width: 1080px) {
        .nav-inner {
          grid-template-columns: auto 1fr;
          grid-template-areas:
            "brand spotlight"
            "nav nav";
          gap: 16px 18px;
        }

        .brand { grid-area: brand; }
        .nav-spotlight { grid-area: spotlight; justify-content: flex-end; }
        .nav-right { grid-area: nav; justify-content: center; }
      }

      @media (max-width: 720px) {
        .nav-inner {
          display: flex;
          flex-direction: column;
          align-items: stretch;
          gap: 14px;
        }

        .brand {
          display: flex;
          align-items: center;
          gap: 12px;
        }

        .brand .logo {
          width: 62px;
          height: 62px;
          flex: 0 0 auto;
        }

        .brand-text { min-width: 0; }
        .brand-text strong {
          font-size: 1.2rem;
          line-height: 1.08;
        }
        .brand-subtitle {
          white-space: normal;
          line-height: 1.3;
        }

        .nav-spotlight { justify-content: center; }
        .nav-right {
          display: flex;
          flex-direction: column;
          align-items: stretch;
          gap: 10px;
        }

        .navlinks {
          display: flex;
          flex-wrap: wrap;
          gap: 10px 12px;
          justify-content: flex-start;
          align-items: center;
        }

        .navlinks a {
          font-size: 0.95rem;
          line-height: 1.2;
          white-space: nowrap;
        }

        .service-cta,
        .service-cta--spotlight {
          width: 100%;
          min-width: 0;
          min-height: 56px;
        }
      }
    </style>
  </body>
</html>

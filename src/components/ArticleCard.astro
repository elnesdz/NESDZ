---
const { href, title, description, date, updated, category, tags, image } = Astro.props;

const publishedDate = new Date(date);
const updatedDate = updated ? new Date(updated) : null;
const displayDate = updatedDate ?? publishedDate;

const pretty = displayDate.toLocaleDateString("fr-FR", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const dateLabel = updatedDate ? `Mis à jour le ${pretty}` : pretty;

function slugify(input) {
  return String(input)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

const tagLinks = (tags ?? [])
  .slice(0, 3)
  .map((label) => ({ label, slug: slugify(label) }))
  .filter((t) => t.slug);
---

<article class="item">
  <a class="itemLink" href={href} aria-label={`Ouvrir l’article : ${title}`}></a>

  <div class="itemContent">
    {image ? (
      <div class="itemMedia">
        <img class="itemThumb" src={image} alt={title} loading="lazy" />
      </div>
    ) : null}

    <div class="itemBody">
      <div class="itemHead">
        <div class="itemText">
          <div class="t itemTitle">{title}</div>
          <div class="s itemDescription">{description}</div>
        </div>

        <span class="pill itemDate">{dateLabel}</span>
      </div>

      <div class="itemMeta">
        <span class="badge">{category}</span>

        {tagLinks.map((t) => (
          <a class="pill tagLink" href={`/tags/${t.slug}/`} title={`Tag : ${t.label}`}>
            {t.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</article>

<style>
  .item {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
    padding: 16px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.02);
    transition:
      background-color 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      transform 0.18s ease;
  }

  .item:hover,
  .item:focus-within {
    background: rgba(139, 220, 255, 0.05);
    border-color: rgba(139, 220, 255, 0.18);
    box-shadow:
      inset 0 0 0 1px rgba(139, 220, 255, 0.10),
      0 10px 24px rgba(10, 24, 38, 0.16);
    transform: translateY(-1px);
  }

  .itemLink {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 18px;
    cursor: pointer;
  }

  .itemContent {
    position: relative;
    z-index: 0;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .itemMedia {
    min-width: 0;
  }

  .itemThumb {
    width: 100%;
    display: block;
    border-radius: 16px;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: rgba(255, 255, 255, 0.03);
  }

  .itemBody {
    min-width: 0;
  }

  .itemHead {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
  }

  .itemText {
    min-width: 0;
    flex: 1;
  }

  .itemTitle {
    line-height: 1.35;
    transition: color 0.18s ease;
  }

  .item:hover .itemTitle,
  .item:focus-within .itemTitle {
    color: #8bdcff;
  }

  .itemDescription {
    margin-top: 8px;
    line-height: 1.65;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .itemDate {
    white-space: normal;
    flex: 0 0 auto;
    max-width: 128px;
    text-align: center;
    align-self: flex-start;
  }

  .itemMeta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  .tagLink {
    position: relative;
    z-index: 2;
  }

  @media (max-width: 720px) {
    .item {
      padding: 14px;
    }

    .itemContent {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .itemThumb {
      width: 100%;
      max-width: 100%;
      height: auto;
    }

    .itemHead {
      flex-direction: column;
      align-items: flex-start;
    }

    .itemDate {
      max-width: none;
      text-align: left;
    }

    .itemDescription {
      -webkit-line-clamp: 5;
    }
  }
</style>

---
const { href, title, description, date, updated, category, tags, image } = Astro.props;

const publishedDate = new Date(date);
const updatedDate = updated ? new Date(updated) : null;
const displayDate = updatedDate ?? publishedDate;

const pretty = displayDate.toLocaleDateString("fr-FR", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const dateLabel = updatedDate ? `Mis à jour le ${pretty}` : pretty;

function slugify(input) {
  return String(input)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

const tagLinks = (tags ?? [])
  .slice(0, 3)
  .map((label) => ({ label, slug: slugify(label) }))
  .filter((t) => t.slug);
---

<article class="item">
  <a class="itemLink" href={href} aria-label={`Ouvrir l’article : ${title}`}></a>

  <div class="itemContent">
    {image ? (
      <div class="itemMedia">
        <img class="itemThumb" src={image} alt={title} loading="lazy" />
      </div>
    ) : null}

    <div class="itemBody">
      <div class="itemHead">
        <div class="itemText">
          <div class="t itemTitle">{title}</div>
          <div class="s itemDescription">{description}</div>
        </div>

        <span class="pill itemDate">{dateLabel}</span>
      </div>

      <div class="itemMeta">
        <span class="badge">{category}</span>

        {tagLinks.map((t) => (
          <a class="pill tagLink" href={`/tags/${t.slug}/`} title={`Tag : ${t.label}`}>
            {t.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</article>

<style>
  .item {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
    padding: 0;
    border: 1px solid rgba(182, 222, 255, 0.09);
    border-radius: 26px;
    background:
      linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.012) 22%),
      linear-gradient(180deg, rgba(8,18,36,.92), rgba(5,12,24,.96));
    overflow: hidden;
    box-shadow: 0 24px 62px rgba(0,0,0,.28);
    transition: background-color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }

  .item::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(380px 160px at 10% 0%, rgba(127,220,255,.08), transparent 60%);
  }

  .item:hover,
  .item:focus-within {
    border-color: rgba(127,220,255,.20);
    box-shadow: 0 0 0 1px rgba(127,220,255,.08), 0 30px 72px rgba(0,0,0,.34);
    transform: translateY(-2px);
  }

  .itemLink {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: 26px;
    cursor: pointer;
  }

  .itemContent {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 0;
    align-items: stretch;
  }

  .itemMedia {
    min-width: 0;
    height: 100%;
    padding: 16px;
  }

  .itemThumb {
    width: 100%;
    height: 100%;
    min-height: 188px;
    display: block;
    border-radius: 20px;
    object-fit: cover;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255,255,255,.06);
  }

  .itemBody {
    display: grid;
    gap: 16px;
    padding: 18px 18px 18px 6px;
  }

  .itemHead {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .itemText {
    min-width: 0;
  }

  .itemTitle {
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.15;
    font-weight: 800;
    color: #f5fbff;
    margin-bottom: 10px;
  }

  .itemDescription {
    font-size: 1rem;
    line-height: 1.72;
    color: rgba(231,238,245,.76);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .itemDate {
    white-space: nowrap;
    background: rgba(7, 24, 49, 0.78);
    color: #d7efff;
    border-color: rgba(127,220,255,.16);
    font-weight: 700;
  }

  .itemMeta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .tagLink {
    position: relative;
    z-index: 3;
    color: rgba(231,238,245,.84);
  }

  .tagLink:hover {
    border-color: rgba(127,220,255,.20);
    color: #fff;
  }

  @media (max-width: 900px) {
    .itemContent {
      grid-template-columns: 1fr;
    }

    .itemMedia {
      padding: 16px 16px 0;
    }

    .itemThumb {
      min-height: 210px;
      aspect-ratio: 16 / 9;
    }

    .itemBody {
      padding: 18px 16px 18px;
    }

    .itemHead {
      flex-direction: column;
      align-items: flex-start;
    }

    .itemDate {
      white-space: normal;
    }
  }

  @media (max-width: 560px) {
    .item {
      border-radius: 22px;
    }

    .itemLink {
      border-radius: 22px;
    }

    .itemMedia {
      padding: 14px 14px 0;
    }

    .itemThumb {
      min-height: 180px;
      border-radius: 18px;
    }

    .itemBody {
      gap: 14px;
      padding: 16px 14px 16px;
    }

    .itemTitle {
      font-size: 1.16rem;
    }

    .itemDescription {
      -webkit-line-clamp: 3;
      font-size: 0.98rem;
      line-height: 1.62;
    }
  }
</style>

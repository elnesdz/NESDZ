---
const { href, title, description, date, updated, category, tags, image } = Astro.props;

const publishedDate = new Date(date);
const updatedDate = updated ? new Date(updated) : null;
const displayDate = updatedDate ?? publishedDate;

const pretty = displayDate.toLocaleDateString("fr-FR", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const dateLabel = updatedDate ? `Mis à jour le ${pretty}` : pretty;

function slugify(input) {
  return String(input)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

const tagLinks = (tags ?? [])
  .slice(0, 3)
  .map((label) => ({ label, slug: slugify(label) }))
  .filter((t) => t.slug);
---

<article class="item">
  <a class="itemLink" href={href} aria-label={`Ouvrir l’article : ${title}`}></a>

  <div class="itemContent">
    {image ? (
      <div class="itemMedia">
        <img class="itemThumb" src={image} alt={title} loading="lazy" />
      </div>
    ) : null}

    <div class="itemBody">
      <div class="itemHead">
        <div class="itemText">
          <div class="t">{title}</div>
          <div class="s">{description}</div>
        </div>

        <span class="pill itemDate">{dateLabel}</span>
      </div>

      <div class="itemMeta">
        <span class="badge">{category}</span>

        {tagLinks.map((t) => (
          <a class="pill tagLink" href={`/tags/${t.slug}/`} title={`Tag : ${t.label}`}>
            {t.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</article>

<style>
  .item {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .itemLink {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .itemContent {
    position: relative;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }

  .itemMedia {
    min-width: 0;
  }

  .itemThumb {
    width: 100%;
    display: block;
  }

  .itemBody {
    min-width: 0;
  }

  .itemHead {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
  }

  .itemText {
    min-width: 0;
    flex: 1;
  }

  .itemDate {
    white-space: normal;
    flex: 0 0 auto;
    max-width: 120px;
    text-align: center;
  }

  .itemMeta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  .tagLink {
    position: relative;
    z-index: 2;
  }

  @media (max-width: 720px) {
    .itemContent {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .itemThumb {
      width: 100%;
      max-width: 100%;
      height: auto;
    }

    .itemHead {
      flex-direction: column;
      align-items: flex-start;
    }

    .itemDate {
      max-width: none;
      text-align: left;
    }
  }
</style>

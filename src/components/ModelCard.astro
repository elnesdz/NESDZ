---
const {
  href,
  name,
  manufacturer,
  category,
  seats,
  engine,
  cruiseKmh,
  tags,
  editorialStatus,
} = Astro.props;

const slugify = (input) =>
  String(input)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const editorialStatusLabels = {
  "en-cours": "En cours",
  enrichie: "Enrichie",
  "a-completer": "À compléter",
};

const editorialStatusTitle = {
  "en-cours": "Statut éditorial : fiche en cours",
  enrichie: "Statut éditorial : fiche enrichie",
  "a-completer": "Statut éditorial : données à compléter",
};

const editorialStatusLabel = editorialStatus
  ? editorialStatusLabels[editorialStatus] ?? null
  : null;

const editorialStatusTooltip = editorialStatus
  ? editorialStatusTitle[editorialStatus] ?? null
  : null;
---

<article class="item">
  <a class="itemLink" href={href} aria-label={`Ouvrir la fiche modèle : ${name}`}></a>

  <div class="itemContent">
    <div class="itemHead">
      <div class="itemText">
        <div class="t">{name}</div>
        <div class="s">
          {(manufacturer ? `${manufacturer} · ` : "")}{category} · {seats} place{seats > 1 ? "s" : ""}
          {engine ? ` · ${engine}` : ""}
          {cruiseKmh ? ` · Croisière ~${cruiseKmh} km/h` : ""}
        </div>
      </div>

      <div class="itemStatus">
        {editorialStatusLabel ? (
          <span
            class="pill"
            aria-label={editorialStatusTooltip}
            title={editorialStatusTooltip}
          >
            {editorialStatusLabel}
          </span>
        ) : (
          <span class="pill">Fiche</span>
        )}
      </div>
    </div>

    <div class="itemMeta">
      {(tags ?? []).slice(0, 4).map((t) => (
        <a class="pill tagLink" href={"/tags/" + slugify(t) + "/"} title={"Tag : " + t}>
          {t}
        </a>
      ))}
    </div>
  </div>
</article>

<style>
  .item {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
    border: 1px solid rgba(182, 222, 255, 0.09);
    border-radius: 24px;
    background:
      linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.012) 24%),
      linear-gradient(180deg, rgba(8,18,36,.92), rgba(5,12,24,.96));
    box-shadow: 0 22px 60px rgba(0,0,0,.26);
    overflow: hidden;
    transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
  }

  .item:hover,
  .item:focus-within {
    border-color: rgba(127,220,255,.20);
    box-shadow: 0 0 0 1px rgba(127,220,255,.08), 0 30px 72px rgba(0,0,0,.34);
    transform: translateY(-2px);
  }

  .itemLink {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: 24px;
  }

  .itemContent {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 16px;
    padding: 18px;
  }

  .itemHead {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
  }

  .itemText {
    min-width: 0;
    flex: 1;
  }

  .itemText .t {
    font-size: 1.2rem;
    line-height: 1.16;
    font-weight: 800;
    color: #f5fbff;
    margin-bottom: 8px;
  }

  .itemText .s {
    font-size: 0.98rem;
    line-height: 1.68;
    color: rgba(231,238,245,.74);
  }

  .itemStatus {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    flex: 0 0 auto;
  }

  .itemStatus .pill {
    background: rgba(7, 24, 49, 0.78);
    color: #d7efff;
    border-color: rgba(127,220,255,.16);
    font-weight: 700;
  }

  .itemMeta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tagLink {
    position: relative;
    z-index: 3;
  }

  @media (max-width: 560px) {
    .item {
      border-radius: 22px;
    }

    .itemLink {
      border-radius: 22px;
    }

    .itemContent {
      padding: 16px;
      gap: 14px;
    }

    .itemHead {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

---
const {
  href,
  name,
  manufacturer,
  category,
  seats,
  engine,
  cruiseKmh,
  tags,
  editorialStatus,
} = Astro.props;

const slugify = (input) =>
  String(input)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const editorialStatusLabels = {
  "en-cours": "En cours",
  enrichie: "Enrichie",
  "a-completer": "À compléter",
};

const editorialStatusTitle = {
  "en-cours": "Statut éditorial : fiche en cours",
  enrichie: "Statut éditorial : fiche enrichie",
  "a-completer": "Statut éditorial : données à compléter",
};

const editorialStatusLabel = editorialStatus
  ? editorialStatusLabels[editorialStatus] ?? null
  : null;

const editorialStatusTooltip = editorialStatus
  ? editorialStatusTitle[editorialStatus] ?? null
  : null;
---

<article class="item">
  <a class="itemLink" href={href} aria-label={`Ouvrir la fiche modèle : ${name}`}></a>

  <div class="itemContent">
    <div class="itemHead">
      <div class="itemText">
        <div class="t">{name}</div>
        <div class="s">
          {(manufacturer ? `${manufacturer} · ` : "")}{category} · {seats} place{seats > 1 ? "s" : ""}
          {engine ? ` · ${engine}` : ""}
          {cruiseKmh ? ` · Croisière ~${cruiseKmh} km/h` : ""}
        </div>
      </div>

      <div class="itemStatus">
        {editorialStatusLabel ? (
          <span
            class="pill"
            aria-label={editorialStatusTooltip}
            title={editorialStatusTooltip}
          >
            {editorialStatusLabel}
          </span>
        ) : (
          <span class="pill">Fiche</span>
        )}
      </div>
    </div>

    <div class="itemMeta">
      {(tags ?? []).slice(0, 4).map((t) => (
        <a class="pill tagLink" href={"/tags/" + slugify(t) + "/"} title={"Tag : " + t}>
          {t}
        </a>
      ))}
    </div>
  </div>
</article>

<style>
  .item {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .itemLink {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .itemContent {
    position: relative;
  }

  .itemHead {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .itemText {
    min-width: 0;
    flex: 1;
  }

  .itemStatus {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    flex: 0 0 auto;
  }

  .itemMeta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  .tagLink {
    position: relative;
    z-index: 2;
  }

  @media (max-width: 720px) {
    .itemHead {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .itemStatus {
      justify-content: flex-start;
      width: 100%;
    }
  }
</style>
